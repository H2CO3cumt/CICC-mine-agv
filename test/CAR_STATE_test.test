<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="//==========================================================&#xa;// 功能仿真临时缩短0.5s换向等待&#xa;//&#xa;// 正式工程仍为：&#xa;// GO_BACK_MAX = 25_000_000-1&#xa;// GO_IDLE_MAX = 25_000_000-1&#xa;//==========================================================&#xa;defparam CAR_STATE0.GO_BACK_MAX = 20;&#xa;defparam CAR_STATE0.GO_IDLE_MAX = 20;&#xa;&#xa;// 按键编码&#xa;//==========================================================&#xa;localparam DIGIT2 = 9'b111_111_101;   // 前进&#xa;localparam DIGIT3 = 9'b111_111_011;   // 蓝牙模式&#xa;localparam DIGIT4 = 9'b111_110_111;   // 左转&#xa;localparam DIGIT5 = 9'b111_101_111;   // 停止&#xa;localparam DIGIT6 = 9'b111_011_111;   // 右转&#xa;localparam DIGIT8 = 9'b101_111_111;   // 后退&#xa;localparam DIGIT9 = 9'b011_111_111;   // 循迹模式&#xa;//==========================================================&#xa;// 50 MHz时钟&#xa;// 按你的要求使用 always&#xa;//==========================================================&#xa;initial clk_50m = 0;&#xa;always #10 clk_50m = ~clk_50m;&#xa;&#xa;&#xa;//==========================================================&#xa;// 仿真激励&#xa;//==========================================================&#xa;initial begin&#xa;&#xa;    en_1k = 1;&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value  = DIGIT5;&#xa;    key_cmd    = 9'b111_111_111;&#xa;    key_sensor = 9'b111_111_111;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    load_ready = 1;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    // 等待缩短后的换向保护时间完成&#xa;    #500;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景1：普通前进命令&#xa;    //&#xa;    // 无故障时：&#xa;    // GO = 0001&#xa;    // en = 1&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景1：普通前进命令 ==========&quot;);&#xa;&#xa;    key_value = DIGIT2;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;正常前进：车辆状态=%b 运行使能=%b final_key=%b&quot;,&#xa;        car_state1,&#xa;        en,&#xa;        CAR_STATE0.final_key&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景2：瓦斯安全停车&#xa;    //&#xa;    // CAR_STATE本身没有gas_alarm接口&#xa;    // 上游瓦斯模块最终通过force_stop要求停车&#xa;    //&#xa;    // 保持前进命令不变&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景2：瓦斯强制停车 ==========&quot;);&#xa;&#xa;    // key_value仍然保持前进&#xa;    force_stop = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;瓦斯停车：人工命令=%b force_stop=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        key_value,&#xa;        force_stop,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;    force_stop = 0;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景3：前向障碍停车&#xa;    //&#xa;    // 保持前进命令有效&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景3：前向障碍停车 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    #500;&#xa;&#xa;    key_value = DIGIT2;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;障碍前：车辆状态=%b 运行使能=%b&quot;,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;    distance_vld_go = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;前向障碍：前进命令=%b 前障碍=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        key_value,&#xa;        distance_vld_go,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景4：后向障碍停车&#xa;    //&#xa;    // 保持后退命令有效&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景4：后向障碍停车 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    // 等待goback_flag允许进入BACK&#xa;    #500;&#xa;&#xa;    key_value = DIGIT8;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;正常后退：车辆状态=%b 运行使能=%b&quot;,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;    distance_vld_back = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;后向障碍：后退命令=%b 后障碍=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        key_value,&#xa;        distance_vld_back,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景5：超载停车&#xa;    //&#xa;    // 保持前进命令有效&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景5：超载强制停车 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    #500;&#xa;&#xa;    key_value = DIGIT2;&#xa;&#xa;    #100;&#xa;&#xa;    overload_state = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;超载停车：前进命令=%b 超载=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        key_value,&#xa;        overload_state,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景6：载荷故障停车&#xa;    //&#xa;    // settletime_fault来自称重安全模块&#xa;    // 保持前进命令有效&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景6：载荷故障强制停车 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    #500;&#xa;&#xa;    key_value = DIGIT2;&#xa;&#xa;    #100;&#xa;&#xa;    settletime_fault = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;载荷故障：前进命令=%b 载荷故障=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        key_value,&#xa;        settletime_fault,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景7：自动循迹请求下前向障碍&#xa;    //&#xa;    // key_value = DIGIT9&#xa;    // sensor_lock = 1&#xa;    //&#xa;    // selected_key自动变成DIGIT2，即自动前进&#xa;    //&#xa;    // 验证安全条件同样能够覆盖自动运动请求&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景7：自动循迹模式安全覆盖 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    #500;&#xa;&#xa;    // 进入传感器循迹模式&#xa;    key_value = DIGIT9;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;自动循迹：sensor_lock=%b selected_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        sensor_lock,&#xa;        CAR_STATE0.selected_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;    // 自动前进过程中出现前方障碍&#xa;    distance_vld_go = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;自动模式遇障：sensor_lock=%b 前障碍=%b final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        sensor_lock,&#xa;        distance_vld_go,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景8：多安全条件同时有效&#xa;    //&#xa;    // CAR_STATE没有停车原因编码输出，&#xa;    // 因此这里只验证：&#xa;    //&#xa;    // 多个安全条件同时有效时，&#xa;    // final_key仍被压成DIGIT5，&#xa;    // 状态机安全返回IDLE。&#xa;    //&#xa;    // 停车原因优先级应单独仿真STOP_DETECTING。&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景8：多故障同时有效 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;&#xa;    key_value = DIGIT5;&#xa;&#xa;    force_stop        = 0;&#xa;    distance_vld_go   = 0;&#xa;    distance_vld_back = 0;&#xa;    overload_state    = 0;&#xa;    settletime_fault  = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    #500;&#xa;&#xa;    key_value = DIGIT2;&#xa;&#xa;    #100;&#xa;&#xa;    // 同时出现多个停车条件&#xa;    force_stop        = 1;&#xa;    distance_vld_go   = 1;&#xa;    overload_state    = 1;&#xa;    settletime_fault  = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;多故障：force_stop=%b 前障碍=%b 载荷故障=%b 超载=%b&quot;,&#xa;        force_stop,&#xa;        distance_vld_go,&#xa;        settletime_fault,&#xa;        overload_state&#xa;    );&#xa;&#xa;    $display(&#xa;        &quot;停车结果：final_key=%b 车辆状态=%b 运行使能=%b&quot;,&#xa;        CAR_STATE0.final_key,&#xa;        car_state1,&#xa;        en&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 仿真结束&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;状态编码：IDLE=0000 GO=0001 BACK=0010 LEFT=0100 RIGHT=1000&quot;);&#xa;    $display(&quot;停车按键DIGIT5=111101111&quot;);&#xa;&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== CAR_STATE 仿真结束 ==========&quot;);&#xa;&#xa;    #100;&#xa;    $finish;&#xa;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="CAR_STATE_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="CAR_STATE" Code="&#xa;//car_state;&#xa;parameter IDLE=4'b0000;&#xa;parameter GO=4'b0001;&#xa;parameter BACK=4'b0010;&#xa;parameter LEFT=4'b0100;&#xa;parameter RIGHT=4'b1000;&#xa;//key_value&#xa;parameter DIGIT1=9'b111_111_110;&#xa;parameter DIGIT2=9'b111_111_101;&#xa;parameter DIGIT3=9'b111_111_011;&#xa;parameter DIGIT4=9'b111_110_111;&#xa;parameter DIGIT5=9'b111_101_111;&#xa;parameter DIGIT6=9'b111_011_111;&#xa;parameter DIGIT7=9'b110_111_111;&#xa;parameter DIGIT8=9'b101_111_111;&#xa;parameter DIGIT9=9'b011_111_111;&#xa;parameter GO_BACK_MAX=25_000_000-1;&#xa;parameter GO_IDLE_MAX=25_000_000-1;&#xa;reg [27:0] cnt_go_back;//从任何挡位到BACK得是XX-IDLE-BACK的路径，防止炸管&#xa;reg goback_flag;&#xa;reg [27:0] cnt_go_idle;&#xa;reg goidle_flag;//同上，只不过是从BACK到GO/LEFT/RIGHT需要触发这个逻辑,也就是说从IDLE到正转的任何状态都得经过0.5s&#xa;reg [8:0]final_key;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;cnt_go_back&lt;=0;&#xa;        goback_flag&lt;=1;//车刚插上钥匙，肯定可以直接挂倒挡&#xa;            end&#xa;            else if(cstate==IDLE)begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_back&lt;GO_BACK_MAX)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_back&lt;=cnt_go_back+1;&#xa;                            goback_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_back&lt;=cnt_go_back;&#xa;            &#x9;&#x9;&#x9;&#x9;goback_flag&lt;=1;                        &#xa;                        end                         &#xa;                    end&#xa;            else begin&#xa;            if(cstate==BACK)  begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=1;&#xa;            end&#xa;            else begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=0;            &#xa;            end&#xa;            end&#xa;            &#x9;&#x9;&#x9;&#xa;end&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst) begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;&#xa;    end &#xa;    else if(cstate==IDLE) begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_idle&lt;GO_IDLE_MAX-1)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle+1;&#xa;                            goidle_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle;&#xa;            &#x9;&#x9;&#x9;&#x9;goidle_flag&lt;=1;     &#xa;    end&#xa;    end&#xa;    else if(cstate==BACK)begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=0;    &#x9;&#xa;    end&#xa;    else begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;    &#xa;    end&#xa;end&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    bt_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b111_111_011)&#xa;                bt_lock&lt;=1;&#xa;                else if()&#xa;                end&#xa;end*/&#xa;&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    sensor_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b011_111_111||key_cmd==9'b011_111_111)&#xa;                sensor_lock&lt;=1;&#xa;                else if(key_cmd==9'b111_111_011)&#xa;                &#x9;&#x9;&#x9;sensor_lock&lt;=0;//只能远程取消&#xa;                end&#xa;end*/&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    sensor_lock&lt;=0;&#xa;    bt_lock&lt;=0;&#xa;    end&#xa; else    if(en_1k)begin&#xa;    &#x9;&#x9;if(key_value==9'b111_111_011)begin&#xa;            bt_lock&lt;=1;&#xa;            &#x9;&#x9;if(key_cmd==9'b011_111_111)begin&#xa;                   sensor_lock&lt;=1; &#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                end&#xa;                else if(key_cmd==9'b111_111_011)begin&#xa;                &#x9;&#x9;bt_lock&lt;=1;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;                else if(key_cmd==9'b111_111_110) begin&#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;            end&#xa;       else if(key_value==9'b011_111_111)&#xa;    &#x9;&#x9;&#x9;&#x9;sensor_lock&lt;=1;&#xa;    end&#xa;end&#xa;wire [8:0]selected_key=bt_lock?(key_cmd):(sensor_lock?9'b111_111_101:key_value);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    final_key&lt;=DIGIT5;//默认停止；&#xa;    else begin&#xa;    &#x9;&#x9;if(en_1k)&#xa;             begin &#xa;            if(force_stop)&#xa;            final_key&lt;=DIGIT5;&#xa;            else if(&#xa;            distance_vld_go&amp;&amp;(selected_key==DIGIT2||selected_key==DIGIT4||selected_key==DIGIT6)&#xa;)&#xa;final_key&lt;=DIGIT5;                  &#xa;            &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if(distance_vld_back&amp;&amp;selected_key==DIGIT8)&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                                     else if(settletime_fault) &#xa;                                    &#x9;&#x9;final_key&lt;=DIGIT5;  &#xa;                                       else if(overload_state)&#xa;                                    &#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;else  begin &#xa;                                        final_key&lt;=selected_key;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xa;                    end&#xa;            end&#xa;    end&#xa;reg [3:0]cstate;//当前时钟状态；&#xa;reg [3:0]nstate;//下一时钟状态；&#xa;//wire [8:0]final_key=9'b0;//(key_cmd!=0)?key_cmd:key_value;//蓝牙命令优先于物理逻辑&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin &#xa;&#x9;if(rst)&#xa;    cstate&lt;=IDLE;&#xa;    else begin if(en_1k)&#xa;    cstate&lt;=nstate;&#xa;    else cstate&lt;=cstate;&#xa;    end&#xa;end&#xa;always @ (*)&#xa;begin &#xa;case( final_key) &#xa;    DIGIT2: if(goidle_flag)nstate=GO;//前进&#xa;else nstate=IDLE;&#xa;DIGIT4:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==RIGHT||cstate==LEFT)nstate=LEFT;//左拐&#xa;else nstate=IDLE;&#xa;DIGIT5:nstate=IDLE;//停止&#xa;DIGIT6:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==LEFT||cstate==RIGHT)nstate=RIGHT;//右拐&#xa;else nstate=IDLE;&#xa;DIGIT8: if(goback_flag) nstate=BACK;&#xa;else nstate=IDLE;//后退&#xa;    default:nstate=cstate;&#xa;endcase&#xa;end&#xa;assign car_state1=cstate;&#xa;assign en=(cstate==GO||cstate==BACK||cstate==LEFT||cstate==RIGHT)?1:0;&#xa;&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="CAR_STATE0" Parameters="" Parent="CAR_STATE_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1k" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.0409091"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.15"/>
  <Port Color="#7fffd4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_value" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.259091"/>
  <Port Color="#f0ffff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="output" Name="car_state1" Parent="CAR_STATE0" Side="right" Width="30" X="0.85" Y="0.131818"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="en" Parent="CAR_STATE0" Side="right" Width="30" X="0.85" Y="0.331818"/>
  <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.368182"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.477273"/>
  <Port Color="#ffebcd" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_sensor" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.586364"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="force_stop" Parent="CAR_STATE0" Side="left" Width="30" X="-0.15" Y="0.695455"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="bt_lock" Parent="CAR_STATE0" Side="right" Width="30" X="0.85" Y="0.531818"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sensor_lock" Parent="CAR_STATE0" Side="right" Width="30" X="0.85" Y="0.731818"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="CAR_STATE0" Side="bottom" Width="30" X="-0.15" Y="0.863636"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_back" Parent="CAR_STATE0" Side="bottom" Width="30" X="0.125" Y="0.863636"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="CAR_STATE0" Side="bottom" Width="30" X="0.325" Y="0.863636"/>
  <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settletime_fault" Parent="CAR_STATE0" Side="bottom" Width="30" X="0.525" Y="0.863636"/>
