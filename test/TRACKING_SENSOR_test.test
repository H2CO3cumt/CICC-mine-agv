 <Wire Datasize="8" Datatype="wire" From="TRACKING_SENSOR_test>sensor_fault" Name="TRACKING_SENSOR0_sensor_fault" Parent="TRACKING_SENSOR_test" To="TRACKING_SENSOR_test#TRACKING_SENSOR0>sensor_fault"/>
