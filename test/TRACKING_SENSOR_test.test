 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="en_10k" Parent="TRACKING_SENSOR_test" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
