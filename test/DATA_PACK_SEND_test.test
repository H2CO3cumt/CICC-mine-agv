e = 2'b11;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd30;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;control_mode=%b step30发送=%02h&quot;,&#xa;        control_mode,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    // load_event_state&#xa;    load_event_state = 2'b10;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd31;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;load_event_state=%b step31发送=%02h&quot;,&#xa;        load_event_state,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    // vibration_data&#xa;    vibration_data = 16'hBE_EF;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd38;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;vibration_data=%04h step38低字节=%02h&quot;,&#xa;        vibration_data,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd39;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;vibration_data=%04h step39高字节=%02h&quot;,&#xa;        vibration_data,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    // stall_state&#xa;    stall_state = 2'b01;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd41;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;stall_state=%b step41发送=%02h&quot;,&#xa;        stall_state,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    // stall_alarm = 1&#xa;    stall_alarm = 1;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd42;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;stall_alarm=%b step42发送=%02h&quot;,&#xa;        stall_alarm,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    // stall_alarm = 0&#xa;    stall_alarm = 0;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd42;&#xa;    en_500 = 1;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;stall_alarm=%b step42重新发送=%02h&quot;,&#xa;        stall_alarm,&#xa;        tx_data&#xa;    );&#xa;&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;&#xa;    #40;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景3：最近五次停车原因移位&#xa;    //&#xa;    // 连续输入六个：&#xa;    //&#xa;    // 1,2,5,6,3,4&#xa;    //&#xa;    // 最终：&#xa;    // fault0=4&#xa;    // fault1=3&#xa;    // fault2=6&#xa;    // fault3=5&#xa;    // fault4=2&#xa;    //&#xa;    // 最早的1被移出&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景3：最近五次停车原因移位 ==========&quot;);&#xa;&#xa;&#xa;    // 第1次：1&#xa;    curr_stop = 8'd1;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件1：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    // 第2次：2&#xa;    curr_stop = 8'd2;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件2：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    // 第3次：5&#xa;    curr_stop = 8'd5;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件3：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    // 第4次：6&#xa;    curr_stop = 8'd6;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件4：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    // 第5次：3&#xa;    curr_stop = 8'd3;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件5：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    // 第6次：4&#xa;    curr_stop = 8'd4;&#xa;    new_stop_event = 1;&#xa;&#xa;    #20;&#xa;&#xa;    new_stop_event = 0;&#xa;&#xa;    #20;&#xa;&#xa;    $display(&#xa;        &quot;事件6：%d %d %d %d %d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    $display(&quot;&quot;);&#xa;    $display(&#xa;        &quot;最终最近五次：fault0=%d fault1=%d fault2=%d fault3=%d fault4=%d&quot;,&#xa;        DATA_PACK_SEND0.fault_0,&#xa;        DATA_PACK_SEND0.fault_1,&#xa;        DATA_PACK_SEND0.fault_2,&#xa;        DATA_PACK_SEND0.fault_3,&#xa;        DATA_PACK_SEND0.fault_4&#xa;    );&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景4：停车记录协议发送&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景4：停车记录发送顺序 ==========&quot;);&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd6;&#xa;    en_500 = 1;&#xa;    #20;&#xa;    $display(&quot;step6  fault0=%d 发送=%02h&quot;,&#xa;        DATA_PACK_SEND0.fault_0, tx_data);&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd7;&#xa;    en_500 = 1;&#xa;    #20;&#xa;    $display(&quot;step7  fault1=%d 发送=%02h&quot;,&#xa;        DATA_PACK_SEND0.fault_1, tx_data);&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd8;&#xa;    en_500 = 1;&#xa;    #20;&#xa;    $display(&quot;step8  fault2=%d 发送=%02h&quot;,&#xa;        DATA_PACK_SEND0.fault_2, tx_data);&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd9;&#xa;    en_500 = 1;&#xa;    #20;&#xa;    $display(&quot;step9  fault3=%d 发送=%02h&quot;,&#xa;        DATA_PACK_SEND0.fault_3, tx_data);&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;    #20;&#xa;&#xa;&#xa;    force DATA_PACK_SEND0.step = 8'd10;&#xa;    en_500 = 1;&#xa;    #20;&#xa;    $display(&quot;step10 fault4=%d 发送=%02h&quot;,&#xa;        DATA_PACK_SEND0.fault_4, tx_data);&#xa;    en_500 = 0;&#xa;    release DATA_PACK_SEND0.step;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 结束&#xa;    //======================================================&#xa;    #100;&#xa;&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== DATA_PACK_SEND 仿真结束 ==========&quot;);&#xa;&#xa;    $finish;&#xa;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="DATA_PACK_SEND_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="DATA_PACK_SEND" Code="//本来我是把FAULT_LOGGER模块单独写的，但是超过了20个模块的限额，所以只能把FAULT_LOGGER放这里写的&#xa;reg [2:0]fault_0;&#xa;reg [2:0]fault_1;&#xa;reg [2:0]fault_2;&#xa;reg [2:0]fault_3;&#xa;reg [2:0]fault_4;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;   if(rst)begin&#xa;      fault_4&lt;=0;&#xa;      fault_3&lt;=0;&#xa;      fault_2&lt;=0;&#xa;      fault_1&lt;=0;&#xa;      fault_0&lt;=0;&#xa;      end&#xa;      else begin&#xa;        if(new_stop_event)begin&#xa;              fault_4&lt;=fault_3;&#xa;              fault_3&lt;=fault_2;&#xa;              fault_2&lt;=fault_1;&#xa;              fault_1&lt;=fault_0;&#xa;              fault_0&lt;=curr_stop;&#xa;              end&#xa;      end&#xa;  end&#xa;reg [7:0]step;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    tx_data&lt;=0;&#xa;    tx_data_vld&lt;=0;&#xa;    step&lt;=0;&#xa;    end&#xa;    else if(en_500)&#xa;    begin&#xa;    step&lt;=(step==43)?0:step+1;&#xa;    tx_data_vld&lt;=1;&#xa;    case(step)&#xa;    0:tx_data&lt;=8'hAA;&#xa;    1:tx_data&lt;={4'd0,car_state};&#xa;    2:tx_data&lt;={5'd0,heavy_load_state,overload_state,gas_alarm};&#xa;    3:tx_data&lt;=weight_data[23:16];&#xa;    4:tx_data&lt;=weight_data[15:8];&#xa;    5:tx_data&lt;=weight_data[7:0];&#xa;    6:tx_data&lt;=fault_0;&#xa;    7:tx_data&lt;=fault_1;&#xa;    8:tx_data&lt;=fault_2;&#xa;    9:tx_data&lt;=fault_3;&#xa;    10:tx_data&lt;=fault_4;&#xa;    11:tx_data&lt;=distance_mm1[7:0];&#xa;     12:tx_data&lt;=distance_mm1[15:8];&#xa;    13:tx_data&lt;=distance_mm2[7:0];&#xa;    14:tx_data&lt;=distance_mm2[15:8];&#xa;    15:tx_data&lt;=actual_speed_left[7:0];&#xa;        16:tx_data&lt;=actual_speed_left[15:8];&#xa;            17:tx_data&lt;=actual_speed_right[7:0];&#xa;                18:tx_data&lt;=actual_speed_right[15:8];&#xa;                    19:tx_data&lt;=target_speed_l[7:0];&#xa;                    20:tx_data&lt;=target_speed_l[15:8];&#xa;                    21:tx_data&lt;=target_speed_r[7:0];&#xa;                    22:tx_data&lt;=target_speed_r[15:8];&#xa;              23:tx_data&lt;={4'd0,error_mpu};&#xa;24:tx_data&lt;={7'd0,mpu_dir}; &#xa;25:tx_data&lt;={7'd0, mpu_dir_z};&#xa;26:tx_data&lt;={4'd0,error_mpu_z} ;&#xa;27:tx_data&lt;={7'd0,sensor_lost};// sensor_lost,&#xa;28:tx_data&lt;={ sensor_fault};//,&#xa;29:tx_data&lt;={4'd0,track_confidence};// track_confidence,&#xa;30:tx_data&lt;={6'd0,control_mode};// [1:0] control_mode,&#xa;31:tx_data&lt;={6'd0,load_event_state};//load_event_state,&#xa;32:tx_data&lt;={7'd0,load_event_toggle};// load_event_toggle,&#xa;33:tx_data&lt;=load_change_amount[7:0];&#xa;34:tx_data&lt;=load_change_amount[15:8];&#xa;35:tx_data&lt;=load_change_amount[23:16];&#xa;36:tx_data&lt;={7'd0,settle_timeout_fault};&#xa;37:tx_data&lt;={7'd0,overload_state};&#xa;38:tx_data&lt;=vibration_data[7:0];&#xa;39:tx_data&lt;=vibration_data[15:8];&#xa;40:tx_data&lt;={7'd0,vibration_vld};&#xa;41:tx_data&lt;={6'd0,stall_state};&#xa;42:tx_data&lt;={7'd0,stall_alarm};&#xa;    43:tx_data&lt;=8'h55;&#xa;    default:begin&#xa;    tx_data&lt;=0;&#xa;    step&lt;=0;&#xa;    tx_data_vld&lt;=0;&#xa;    end&#xa;    endcase&#xa;    end&#xa;    else tx_data_vld&lt;=0;&#xa;end" Color="#d3d3d3" Comment="" Height="220" Name="DATA_PACK_SEND0" Parameters="" Parent="DATA_PACK_SEND_test" Type="model" Width="200" X="700" Y="430">
