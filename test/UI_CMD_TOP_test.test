<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam MAX_10k=5_000-1;&#xa;reg [15:0]cnt_10k;&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_10k&lt;=0;&#xa;    en_10k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_10k==MAX_10k) begin&#xa;            cnt_10k&lt;=0;&#xa;            en_10k&lt;=1;&#xa;            end&#xa;         else begin cnt_10k&lt;=cnt_10k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_10k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;task send_key;&#xa;&#x9;input [8:0]key;&#xa;    input mode;//1是正常消抖成功，0是消抖不成功&#xa;    begin&#xa;$display(&quot;[在第%0tns],模拟按键信号开始,并且模式为%b&quot;,$time,mode);&#xa;&#x9;if(mode==1) begin//真实的情况是抖几下-最终按下-松开&#xa;    key_in=key;&#xa;    #1_000;&#xa;    key_in=9'b111_111_111;&#xa;    #1_000;&#xa;    key_in=key;&#xa;    #1_000;&#xa;    key_in=9'b111_111_111;&#xa;    #1_000;//抖几下&#xa;    key_in=key;&#xa;    #400_000;//最终按下&#xa;$display(&quot;[在第%0tns],模式:%b,最终按下的结果是key:9'b%b,key_value:9'b%b&quot;,$time,mode,key,key_value);&#xa;    key_in=9'b111_111_111;&#xa;    #400_000;//松开     &#xa;    end&#xa;    else begin&#xa;    &#x9;if(mode==0) begin&#xa;     key_in=key;&#xa;    #100_000;&#xa;    key_in=9'b111_111_111;&#xa;    #200_000;&#xa;         key_in=key;&#xa;    #100_000;&#xa;    key_in=9'b111_111_111;&#xa;    #400_000;&#xa;$display(&quot;[在第%0tns],模式:%b,key:9'b%b,key_value:9'b%b&quot;,$time,mode,key,key_value);&#xa;        end    &#xa;    end&#xa;$display(&quot;[在第%0tns],模拟按键信号结束&quot;,$time);&#xa;    end&#xa;endtask&#xa;localparam MAX_500=1_000-1;&#xa;localparam MAX_2k=25-1;&#xa;localparam MAX_1=50_000-1;//缩小1000倍&#xa;reg [19:0]cnt_500;&#xa;reg [15:0]cnt_2k;&#xa;reg [27:0]cnt_1;&#xa;initial clk_50m=0;&#xa;always #10 clk_50m=~clk_50m;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_500&lt;=0;&#xa;    en_500&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_500==MAX_500) begin&#xa;            cnt_500&lt;=0;&#xa;            en_500&lt;=1;&#xa;            end&#xa;         else begin cnt_500&lt;=cnt_500+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_500&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_2k&lt;=0;&#xa;    en_2k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_2k==MAX_2k) begin&#xa;            cnt_2k&lt;=0;&#xa;            en_2k&lt;=1;&#xa;            end&#xa;         else begin cnt_2k&lt;=cnt_2k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_2k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_1&lt;=0;&#xa;    en_1&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_1==MAX_1) begin&#xa;            cnt_1&lt;=0;&#xa;            en_1&lt;=1;&#xa;            end&#xa;         else begin cnt_1&lt;=cnt_1+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_1&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;initial begin&#xa;rst=1;&#xa;key_in=9'b111_111_111;&#xa;car_state=4'b0000;&#xa;gas_alarm=0;&#xa;#105;&#xa;rst=0;&#xa;//场景1,按键消抖成功,进入GO状态&#xa;send_key(9'b111_111_101,1);&#xa;car_state=4'b0001;&#xa;#20_000_000;&#xa;//场景2，按键消抖不成功,仍然处于GO状态&#xa;send_key(9'b111_101_111,0);&#xa;car_state=4'b0001;&#xa;#20_000_000;&#xa;//场景3，按键消抖成功，进入RIGHT状态，并且gas_alarm为1;&#xa;send_key(9'b111_011_111,1);&#xa;car_state=4'b1000;&#xa;gas_alarm=1;&#xa;#20_000_000;&#xa;//场景4，按键消抖成功，进入LEFT状态，并且gas_alarm为1;&#xa;send_key(9'b111_110_111,1);&#xa;car_state=4'b0100;&#xa;gas_alarm=1;&#xa;#20_000_000;&#xa;//场景5,按键消抖成功,进入IDLE状态,gas_alarm为0&#xa;send_key(9'b111_101_111,1);&#xa;car_state=4'b0000;&#xa;gas_alarm=0;&#xa;#20_000_000;&#xa;//场景5,按键消抖成功,进入BACK状态,gas_alarm为0&#xa;send_key(9'b101_111_111,1);&#xa;car_state=4'b0010;&#xa;gas_alarm=0;&#xa;#20_000_000;&#xa;$finish;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="UI_CMD_TOP_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="UI_CMD_TOP" Code="" Color="#d3d3d3" Comment="" Height="220" Name="UI_CMD_TOP0" Parameters="" Parent="UI_CMD_TOP_test" Type="model" Width="200" X="700" Y="430">
