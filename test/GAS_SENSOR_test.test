<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="defparam GAS_SENSOR0.WARMUP_TIME=25_000;&#xa;defparam GAS_SENSOR0.FILTER_TIME=500;&#xa;initial clk_50m=0;&#xa;always #10 clk_50m=~clk_50m;&#xa;initial begin&#xa;rst=1;&#xa;#100;&#xa;rst=0;&#xa;end&#xa;task send_gas;&#xa;&#x9;input integer do_low_time;//瓦斯浓度超标持续的时间&#xa;    input integer do_high_time;//瓦斯浓度不超标持续的时间&#xa;   begin&#xa;$display(&quot;[在第%0tns],瓦斯检测开始工作&quot;,$time);&#xa;    do=0;&#xa;    #do_low_time;&#xa;$display(&quot;[在第%0tns],传感器检测结果为gas_alarm:%b,force_stop:%b&quot;,$time,gas_alarm,force_stop);&#xa;    do=1;&#xa;    #do_high_time;&#xa;    end&#xa;endtask&#xa;initial begin&#xa;do=1;&#xa;#105;//等复位&#xa;//场景1，系统刚开始还在预热阶段，瓦斯浓度超标2.5s，不超标2.5s，这里我说的是实际时间，也就是我工程实践用的WARMUP_TIME&#xa;//和FILTER_TIME时间，不要搞混了，这里的时间是预热时间缩小10000倍，滤波时间缩小了1000倍&#xa; $display(&quot;[场景1]预热阶段超标测试开始&quot;);&#xa;send_gas(250_000,250_000);&#xa;//场景2，系统过了预热阶段，但是瓦斯浓度出现误差，也就是没过数字滤波时间，瓦斯浓度就降下去了,这里我设持续0.01s&#xa; $display(&quot;[场景2]毛刺验证开始&quot;);&#xa;send_gas(1_000,1_000);&#xa;send_gas(1_000,1_000);&#xa;send_gas(1_000,1_000);&#xa;//场景3，系统过了预热阶段，瓦斯浓度超标1s，不超标1s&#xa; $display(&quot;[场景3]瓦斯浓度超标验证开始&quot;);&#xa;send_gas(1_000_000,1_000_000);&#xa;//场景4，do已经恢复为1，但报警应保持&#xa; $display(&quot;[场景4]输入恢复后的报警锁存结果：gas_alarm:%b, force_stop:%b&quot;,&#xa; gas_alarm,force_stop);&#xa;    #10_000;&#xa;//场景5：重新复位，解除锁存报警&#xa; $display(&quot;[场景5]复位解除报警验证开始&quot;);&#xa;rst=1;&#xa; #100;&#xa; rst=0;&#xa; #100;&#xa;   $display(&quot;[场景5结束]gas_alarm:%b, force_stop:%b&quot;,&#xa;             gas_alarm,force_stop);&#xa;$finish;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="GAS_SENSOR_test" Parent="0" Timescale="1ns/1ns" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="GAS_SENSOR" Code="//因为cnt_warmup是从0开始计算的，我的设想是cnt_warmup==WARMUP_TIME-1时就达到了最大值，下一步应该在时序逻辑里cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;,也就是说我第一次cnt_warmup==WARMUP_TIME-1的时候，啥都没发生，因为cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;是非阻塞赋值，我下一时钟到达的时候我cnt_warmup第二次等于WARMUP_TIME-1，也就是相当于上一个周期结束了，这是第二个周期的第1秒（从1开始算），此时warmup_done为1，比较合理&#xa;parameter WARMUP_TIME=250_000_000;//预热时间为5s，先让MQ4内部化学反应充分&#xa;parameter FILTER_TIME=500_000;//数字滤波时间为10ms,尽量减少毛刺的影响，防止出现小车抽搐等现象的发生&#xa;reg [27:0]cnt_warmup;//计算有没有过预热时间&#xa;reg warmup_done;//1表示过了预热时间&#xa;reg [19:0]cnt_filter;//计算有没有过数字滤波时间&#xa;reg filter_done;//1表示过了数字滤波时间&#xa;reg do1;&#xa;reg do2;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    do1&lt;=1;&#xa;    do2&lt;=1;&#xa;    end &#xa;    else begin&#xa;    &#x9;do2&lt;=do1;&#xa;    do1&lt;=do;&#xa;    end&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_warmup&lt;=0;&#xa;    warmup_done&lt;=0;&#xa;    end&#xa;    else if(~warmup_done) begin&#xa;    &#x9;&#x9;if(cnt_warmup&lt;WARMUP_TIME-1) &#xa;    &#x9;&#x9;&#x9;cnt_warmup&lt;=cnt_warmup+1;&#xa;          else begin&#xa;        &#x9;&#x9;cnt_warmup&lt;=WARMUP_TIME-1;&#xa;             warmup_done&lt;=1;&#xa;            end&#xa;        end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_filter&lt;=0;&#xa;    filter_done&lt;=0;&#xa;    end&#xa;    else if(warmup_done) begin&#xa;    &#x9;&#x9;&#x9;if(~do2) begin&#xa;    &#x9;&#x9;&#x9;&#x9;if(cnt_filter&lt;FILTER_TIME-1) begin&#xa;                    cnt_filter&lt;=cnt_filter+1;&#xa;                    filter_done&lt;=filter_done;&#xa;//上面filter_done&lt;=filter_done的意思是还没完成数字滤波的时候filter_done保持原值，比如在系统刚开始的时候&#xa;//瓦斯浓度达标，但是还没完成数字滤波，filter_done为复位时的0&#xa;//瓦斯浓度超标，并且迟迟未退散，那我filter_done保持第一次数字滤波后的值，也就是1，防止发生脉冲信号，导致小车一抽一抽的&#xa;                    end&#xa;                 else begin&#xa;                &#x9;&#x9;cnt_filter&lt;=0;&#xa;                     filter_done&lt;=1;&#xa;                end&#xa;    &#x9;&#x9;end&#xa;            else begin&#xa;            &#x9;&#x9;filter_done&lt;=0;&#xa;                 cnt_filter&lt;=0;&#xa;            end  &#xa;            end          &#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;gas_alarm&lt;=0;&#xa;        force_stop&lt;=0;&#xa;    end&#xa;    else if(filter_done)begin&#xa;    &#x9;&#x9;gas_alarm&lt;=1;&#xa;        force_stop&lt;=1;    &#xa;    end&#xa;    &#x9;&#x9;else begin&#xa;    &#x9;&#x9;gas_alarm&lt;=gas_alarm;&#xa;        force_stop&lt;=force_stop;    &#xa;    end  &#xa;end" Color="#d3d3d3" Comment="" Height="220" Name="GAS_SENSOR0" Parameters="" Parent="GAS_SENSOR_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="GAS_SENSOR0" Side="left" Width="30" X="-0.15" Y="0.181818"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="GAS_SENSOR0" Side="left" Width="30" X="-0.15" Y="0.431818"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="do" Parent="GAS_SENSOR0" Side="left" Width="30" X="-0.15" Y="0.681818"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="gas_alarm" Parent="GAS_SENSOR0" Side="right" Width="30" X="0.85" Y="0.263636"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="force_stop" Parent="GAS_SENSOR0" Side="right" Width="30" X="0.85" Y="0.595455"/>
 </Module>
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="clk_50m" Parent="GAS_SENSOR_test" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="rst" Parent="GAS_SENSOR_test" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="do" Parent="GAS_SENSOR_test" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="gas_alarm" Parent="GAS_SENSOR_test" Side="right" Width="30" X="0.98125" Y="0.319444"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="force_stop" Parent="GAS_SENSOR_test" Side="right" Width="30" X="0.98125" Y="0.652778"/>
 <Wire Datasize="1" Datatype="wire" From="GAS_SENSOR_test>clk_50m" Name="GAS_SENSOR_test_clk_50m" Parent="GAS_SENSOR_test" To="GAS_SENSOR_test#GAS_SENSOR0>clk_50m"/>
 <Wire Datasize="1" Datatype="wire" From="GAS_SENSOR_test>rst" Name="GAS_SENSOR_test_rst" Parent="GAS_SENSOR_test" To="GAS_SENSOR_test#GAS_SENSOR0>rst"/>
 <Wire Datasize="1" Datatype="wire" From="GAS_SENSOR_test>do" Name="GAS_SENSOR_test_do" Parent="GAS_SENSOR_test" To="GAS_SENSOR_test#GAS_SENSOR0>do"/>
 <Wire Datasize="1" Datatype="wire" From="GAS_SENSOR_test>gas_alarm" Name="GAS_SENSOR0_gas_alarm" Parent="GAS_SENSOR_test" To="GAS_SENSOR_test#GAS_SENSOR0>gas_alarm"/>
 <Wire Datasize="1" Datatype="wire" From="GAS_SENSOR_test>force_stop" Name="GAS_SENSOR0_force_stop" Parent="GAS_SENSOR_test" To="GAS_SENSOR_test#GAS_SENSOR0>force_stop"/>
</Module>
