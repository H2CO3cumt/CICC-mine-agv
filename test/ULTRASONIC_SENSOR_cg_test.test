<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="defparam ULTRASONIC_SENSOR_cg0.WAIT_TIME       = 20;&#xa;defparam ULTRASONIC_SENSOR_cg0.OVER_TIME       = 20;&#xa;defparam ULTRASONIC_SENSOR_cg0.TRIG_TIME       = 5;&#xa;defparam ULTRASONIC_SENSOR_cg0.MAX_MEASURE_CNT = 100;&#xa;&#xa;&#xa;//==========================================================&#xa;// 50 MHz时钟&#xa;//==========================================================&#xa;initial &#xa;    clk_50m = 0;&#xa;    always #10 clk_50m = ~clk_50m;&#xa;&#xa;&#xa;&#xa;//==========================================================&#xa;// 仿真激励&#xa;//==========================================================&#xa;initial begin&#xa;&#xa;    rst = 1;&#xa;    echo_1 = 0;&#xa;    echo_2 = 0;&#xa;    car_state = 4'b0000;&#xa;    heavy_load_state = 0;&#xa;&#xa;    #100;&#xa;    rst = 0;&#xa;    #100;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景1：轻载前进&#xa;    //&#xa;    // OBSTACLE_ON  = 400 mm&#xa;    // OBSTACLE_OFF = 450 mm&#xa;    //&#xa;    // 验证：&#xa;    // 安全区 -> 危险区 -> 迟滞区 -> 安全区&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景1：轻载前进迟滞避障 ==========&quot;);&#xa;&#xa;    car_state = 4'b0001;&#xa;    heavy_load_state = 0;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;轻载前进阈值：报警阈值=%d 解除阈值=%d&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_ON,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_OFF&#xa;    );&#xa;&#xa;&#xa;    // 安全区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd600;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd600;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;安全区：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 进入危险区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd350;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd350;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;进入危险区：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 进入迟滞区&#xa;    // 400 &lt; 425 &lt; 450&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd425;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd425;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;迟滞区：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 回到安全区&#xa;    // 模拟已经获得连续安全确认&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd500;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd500;&#xa;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag1 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag2 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag3 = 1'b1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重新进入安全区：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag1;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag2;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag3;&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景2：重载前进&#xa;    //&#xa;    // ON  = 450 mm&#xa;    // OFF = 500 mm&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景2：重载前进 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    car_state = 4'b0001;&#xa;    heavy_load_state = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重载前进阈值：报警阈值=%d 解除阈值=%d&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_ON,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_OFF&#xa;    );&#xa;&#xa;&#xa;    // 440mm：&#xa;    // 对轻载前进并不是危险区&#xa;    // 对重载前进已经小于450mm&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd440;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd440;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重载前进：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景3：轻载后退&#xa;    //&#xa;    // ON  = 450 mm&#xa;    // OFF = 500 mm&#xa;    //&#xa;    // 后退使用后向超声波通道&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景3：轻载后退 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    car_state = 4'b0010;&#xa;    heavy_load_state = 0;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;轻载后退阈值：报警阈值=%d 解除阈值=%d&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_ON,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_OFF&#xa;    );&#xa;&#xa;&#xa;    // 危险区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2_mid = 16'd430;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2     = 16'd430;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;后退危险区：距离=%d 后向避障=%b&quot;,&#xa;        distance_2,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;&#xa;    // 迟滞区 450~500mm&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2_mid = 16'd470;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2     = 16'd470;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;后退迟滞区：距离=%d 后向避障=%b&quot;,&#xa;        distance_2,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;&#xa;    // 回到安全区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2_mid = 16'd550;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2     = 16'd550;&#xa;&#xa;    force ULTRASONIC_SENSOR_cg0.back_flag1 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.back_flag2 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.back_flag3 = 1'b1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;后退重新安全：距离=%d 后向避障=%b&quot;,&#xa;        distance_2,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.back_flag1;&#xa;    release ULTRASONIC_SENSOR_cg0.back_flag2;&#xa;    release ULTRASONIC_SENSOR_cg0.back_flag3;&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_2_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_2;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景4：重载转向&#xa;    //&#xa;    // ON  = 500 mm&#xa;    // OFF = 550 mm&#xa;    //&#xa;    // 左右转向都使用前向通道&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景4：重载转向 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    car_state = 4'b0100;       // 左转&#xa;    heavy_load_state = 1;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重载转向阈值：报警阈值=%d 解除阈值=%d&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_ON,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_OFF&#xa;    );&#xa;&#xa;&#xa;    // 480 &lt; 500，进入危险状态&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd480;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd480;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重载转向危险区：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 再验证右转使用相同阈值&#xa;    car_state = 4'b1000;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;重载右转阈值：报警阈值=%d 解除阈值=%d 前向避障=%b&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_ON,&#xa;        ULTRASONIC_SENSOR_cg0.OBSTACLE_OFF,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景5：单次异常回波&#xa;    //&#xa;    // 三次距离：&#xa;    // 600、600、100&#xa;    //&#xa;    // 100mm为一次异常值&#xa;    // 三点中值应该仍然为600mm&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景5：单次异常回波 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    car_state = 4'b0001;&#xa;    heavy_load_state = 0;&#xa;&#xa;    // 这三个是独立reg，不是数组，可以force&#xa;    force ULTRASONIC_SENSOR_cg0.distance_mm1_1 = 16'd600;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_mm1_2 = 16'd600;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_mm1_3 = 16'd100;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;三次测距=%d、%d、%d 中值=%d 前向避障=%b&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.distance_mm1_1,&#xa;        ULTRASONIC_SENSOR_cg0.distance_mm1_2,&#xa;        ULTRASONIC_SENSOR_cg0.distance_mm1_3,&#xa;        ULTRASONIC_SENSOR_cg0.distance_1_mid,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_mm1_1;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_mm1_2;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_mm1_3;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景6：连续安全确认&#xa;    //&#xa;    // 先报警&#xa;    // 然后距离超过OBSTACLE_OFF&#xa;    //&#xa;    // 第1、2次安全确认时仍保持报警&#xa;    // 第3次确认完成后才解除&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景6：连续安全确认 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    car_state = 4'b0001;&#xa;    heavy_load_state = 0;&#xa;&#xa;&#xa;    // 先进入危险区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd350;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd350;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;危险状态：距离=%d 前向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 距离恢复到安全范围&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd600;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd600;&#xa;&#xa;&#xa;    // 第一次安全确认&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag1 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag2 = 1'b0;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag3 = 1'b0;&#xa;&#xa;    #40;&#xa;&#xa;    $display(&#xa;        &quot;安全确认1：确认位=%b%b%b 前向避障=%b&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag3,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag2,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 第二次安全确认&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag1 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag2 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag3 = 1'b0;&#xa;&#xa;    #40;&#xa;&#xa;    $display(&#xa;        &quot;安全确认2：确认位=%b%b%b 前向避障=%b&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag3,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag2,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    // 第三次安全确认&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag1 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag2 = 1'b1;&#xa;    force ULTRASONIC_SENSOR_cg0.go_flag3 = 1'b1;&#xa;&#xa;    #40;&#xa;&#xa;    $display(&#xa;        &quot;安全确认3：确认位=%b%b%b 前向避障=%b&quot;,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag3,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag2,&#xa;        ULTRASONIC_SENSOR_cg0.go_flag1,&#xa;        distance_vld_go&#xa;    );&#xa;&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag1;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag2;&#xa;    release ULTRASONIC_SENSOR_cg0.go_flag3;&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 场景7：前后通道切换&#xa;    //&#xa;    // 前进：使用前向通道&#xa;    // 后退：使用后向通道&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== 场景7：前后通道切换 ==========&quot;);&#xa;&#xa;    rst = 1;&#xa;    #100;&#xa;    rst = 0;&#xa;&#xa;    heavy_load_state = 0;&#xa;&#xa;&#xa;    // 前进&#xa;    car_state = 4'b0001;&#xa;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1_mid = 16'd350;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_1     = 16'd350;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;前进状态：前向距离=%d 前向避障=%b 后向避障=%b&quot;,&#xa;        distance_1,&#xa;        distance_vld_go,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;&#xa;    // 切换到后退&#xa;    car_state = 4'b0010;&#xa;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2_mid = 16'd600;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2     = 16'd600;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;切换后退安全区：后向距离=%d 前向避障=%b 后向避障=%b&quot;,&#xa;        distance_2,&#xa;        distance_vld_go,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;&#xa;    // 后方进入危险区&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2_mid = 16'd400;&#xa;    force ULTRASONIC_SENSOR_cg0.distance_2     = 16'd400;&#xa;&#xa;    #100;&#xa;&#xa;    $display(&#xa;        &quot;后退危险区：后向距离=%d 前向避障=%b 后向避障=%b&quot;,&#xa;        distance_2,&#xa;        distance_vld_go,&#xa;        distance_vld_back&#xa;    );&#xa;&#xa;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_1;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_2_mid;&#xa;    release ULTRASONIC_SENSOR_cg0.distance_2;&#xa;&#xa;&#xa;    //======================================================&#xa;    // 仿真结束&#xa;    //======================================================&#xa;    $display(&quot;&quot;);&#xa;    $display(&quot;========== ULTRASONIC_SENSOR_cg 仿真结束 ==========&quot;);&#xa;&#xa;    #100;&#xa;    $finish;&#xa;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="ULTRASONIC_SENSOR_cg_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="ULTRASONIC_SENSOR_cg" Code="&#xa;  //----Code starts here: integrated by Robei-----&#xa;  parameter OVER_TIME=2_500_000;&#xa;  parameter WAIT_TIME=3_000_000;&#xa;  parameter TRIG_TIME=750;&#xa;  parameter IDLE=4'b0000;&#xa;  parameter SEND_TRIG=4'b0001;&#xa;  parameter WAIT_ECHO=4'b0010;&#xa;  parameter MEASURE=4'b0100;&#xa;  parameter CALC=4'b1000;&#xa;  parameter MAX_MEASURE_CNT=1_500_000;&#xa; // parameter OBSTACLE_ON=400;&#xa;  //parameter OBSTACLE_OFF=450;//基础双阈&#xa;parameter OBSTACLE_MARGIN=50;&#xa;parameter basic_mm=400;&#xa;//wire [15:0]OBSTACLE_ON=(heavy_load_state)?((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?550:500):((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?500:450);&#xa;wire [15:0]OBSTACLE_ON=(heavy_load_state)?((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?basic_mm+2*OBSTACLE_MARGIN:basic_mm+OBSTACLE_MARGIN):((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?basic_mm+OBSTACLE_MARGIN:basic_mm);&#xa;wire [15:0]OBSTACLE_OFF=OBSTACLE_ON+OBSTACLE_MARGIN;//危险程度得和测量值的程度相反&#xa;  wire flag_go=(car_state==4'b0001||car_state==4'b0100||car_state==4'b1000);&#xa;  wire flag_back=(car_state==4'b0010);&#xa;  wire flag_idle=(car_state==4'b0000);&#xa;  reg [15:0]distance_mm1;&#xa;  reg [15:0]distance_mm2;&#xa;  reg echo1_1;&#xa;  reg echo1_2;&#xa;  reg [23:0]cnt1;&#xa;  reg [3:0]cstate1;&#xa;  reg [3:0]nstate1;&#xa;  //reg [15:0]distance_mm1;&#xa;  reg echo2_1;&#xa;  reg echo2_2;&#xa;  reg [23:0]cnt2;&#xa;  reg [3:0]cstate2;&#xa;  reg [3:0]nstate2;&#xa;  //reg [15:0]distance_mm2;&#xa;  reg [1:0]step;&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;          cstate1&lt;=IDLE;&#xa;          cstate2&lt;=IDLE;&#xa;          end&#xa;      else begin&#xa;      &#x9;&#x9;if(group_pulse)begin&#xa;                  cstate1&lt;=IDLE;&#xa;      cstate2&lt;=IDLE;&#xa;              end&#xa;      else begin    cstate1&lt;=nstate1;&#xa;          cstate2&lt;=nstate2;&#xa;          end&#xa;          end&#xa;  end&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;          &#x9;&#x9;&#x9;echo1_1&lt;=0;&#xa;          echo1_2&lt;=0;&#xa;                  echo2_1&lt;=0;&#xa;          echo2_2&lt;=0;&#xa;      end&#xa;      else begin&#xa;          &#x9;&#x9;&#x9;echo1_2&lt;=echo1_1;&#xa;          echo1_1&lt;=echo_1;&#xa;                  echo2_2&lt;=echo2_1;&#xa;          echo2_1&lt;=echo_2;&#xa;      end&#xa;  end&#xa;  always @ ( * )&#xa;  begin&#xa;  &#x9;nstate1=cstate1;&#xa;      &#x9;nstate2=cstate2;&#xa;      if(step==1&amp;&amp;(flag_go||flag_idle))&#xa;      case( cstate1)&#xa;          IDLE:if(cnt1==WAIT_TIME-1) nstate1=SEND_TRIG;&#xa;          else nstate1=IDLE;&#xa;          SEND_TRIG:if(cnt1==TRIG_TIME-1)nstate1=WAIT_ECHO;&#xa;          else nstate1=SEND_TRIG;&#xa;          WAIT_ECHO:if(echo1_2==1) nstate1=MEASURE;&#xa;          else begin&#xa;              if(cnt1&lt;OVER_TIME-1) nstate1=WAIT_ECHO;&#xa;              else nstate1=IDLE;&#xa;          end&#xa;          MEASURE:if(echo1_2==1&amp;&amp; cnt1&lt;MAX_MEASURE_CNT-1) nstate1=MEASURE;&#xa;          else nstate1=CALC;&#xa;          CALC: begin nstate1=IDLE;&#xa;          end&#xa;          default:  begin nstate1=IDLE;&#xa;          end&#xa;      endcase&#xa;                  if(step==2&amp;&amp;(flag_back||flag_idle))&#xa;      case( cstate2)&#xa;          IDLE:if(cnt2==WAIT_TIME-1) nstate2=SEND_TRIG;&#xa;          else nstate2=IDLE;&#xa;          SEND_TRIG:if(cnt2==TRIG_TIME-1)nstate2=WAIT_ECHO;&#xa;          else nstate2=SEND_TRIG;&#xa;          WAIT_ECHO:if(echo2_2==1) nstate2=MEASURE;&#xa;          else begin&#xa;              if(cnt2&lt;OVER_TIME-1) nstate2=WAIT_ECHO;&#xa;              else nstate2=IDLE;&#xa;          end&#xa;          MEASURE:if(echo2_2==1&amp;&amp; cnt2&lt;MAX_MEASURE_CNT-1) nstate2=MEASURE;&#xa;          else nstate2=CALC;&#xa;          CALC: begin nstate2=IDLE;&#xa;          end&#xa;          default:  begin nstate2=IDLE;&#xa;          end&#xa;      endcase&#xa;                  &#xa;  end&#xa;  reg [2:0]group_now;&#xa;  reg [2:0]group_last;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst)begin&#xa;      group_now&lt;=0;&#xa;      group_last&lt;=0;&#xa;      end&#xa;      else begin&#xa;      group_now&lt;={flag_idle,flag_back,flag_go};&#xa;      group_last&lt;=group_now;&#xa;      end&#xa;  end&#xa;  reg [15:0]distance_mm1_1;&#xa;  reg [15:0]distance_mm1_2;&#xa;  reg [15:0]distance_mm1_3;&#xa;  reg [15:0]distance_mm2_1;&#xa;  reg [15:0]distance_mm2_2;&#xa;  reg [15:0]distance_mm2_3;&#xa;  wire group_pulse=group_now[2]^group_last[2]||group_now[1]^group_last[1]||group_now[0]^group_last[0];&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;      step&lt;=1;&#xa;          trig_1&lt;=0;&#xa;          cnt1&lt;=0;&#xa;          distance_mm1&lt;=0;&#xa;                  trig_2&lt;=0;&#xa;          cnt2&lt;=0;&#xa;          distance_mm2&lt;=0;&#xa;          distance_mm1_1&lt;=0;&#xa;  distance_mm1_2&lt;=0;&#xa;  distance_mm1_3&lt;=0;&#xa;  distance_mm2_1&lt;=0;&#xa;  distance_mm2_2&lt;=0;&#xa;  distance_mm2_3&lt;=0;&#xa;  go_flag1&lt;=1;&#xa;  go_flag2&lt;=1;&#xa;  go_flag3&lt;=1;&#xa;  back_flag1&lt;=1;&#xa;  back_flag2&lt;=1;&#xa;  back_flag3&lt;=1;&#xa;      end&#xa;      else &#x9;if(flag_idle) &#xa;      begin &#xa;         if(group_pulse)begin&#xa;      step&lt;=1;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;     else   if(step==1) begin//1&#x9;&#xa;      case(cstate1)&#xa;          IDLE:if(cnt1&lt;WAIT_TIME-1) cnt1&lt;=cnt1+1;&#xa;          else cnt1&lt;=0;&#xa;          SEND_TRIG:if(cnt1&lt;TRIG_TIME-1) begin cnt1&lt;=cnt1+1;&#xa;              trig_1&lt;=1;&#xa;          end&#xa;          else begin cnt1&lt;=0;&#xa;              trig_1&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo1_2==1) cnt1&lt;=0;&#xa;          else begin if(cnt1&lt;OVER_TIME-1)cnt1&lt;=cnt1+1;&#xa;              else begin cnt1&lt;=0;&#xa;                  distance_mm1&lt;=0;&#xa;                  step&lt;=2;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt1&lt;=cnt1+1;&#xa;          CALC: begin distance_mm1&lt;=((cnt1+1)*223)>>16;&#xa;                          distance_mm1_1&lt;=distance_mm1;&#xa;                  distance_mm1_2&lt;=distance_mm1_1;&#xa;                  distance_mm1_3&lt;=distance_mm1_2;&#xa;              cnt1&lt;=0; &#xa;              step&lt;=2; if(distance_vld_go) begin&#xa;                      go_flag1&lt;=(distance_1>OBSTACLE_OFF &amp;&amp; mid_value1[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag2&lt;=go_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag3&lt;=go_flag2;&#xa;                          end &#xa;                          else begin&#xa;                          go_flag1&lt;=0;&#xa;                          go_flag2&lt;=0;&#xa;                          go_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt1&lt;=0;&#xa;              distance_mm1&lt;=0;&#xa;                              distance_mm1_1&lt;=0;&#xa;                  distance_mm1_2&lt;=0;&#xa;                  distance_mm1_3&lt;=0;&#xa;              step&lt;=1;&#xa;              go_flag1&lt;=0;&#xa;              go_flag2&lt;=0;&#xa;              go_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//1&#xa;     else  if(step==2) begin//2&#xa;      &#x9;case(cstate2)&#xa;          IDLE:if(cnt2&lt;WAIT_TIME-1) cnt2&lt;=cnt2+1;&#xa;          else cnt2&lt;=0;&#xa;          SEND_TRIG:if(cnt2&lt;TRIG_TIME-1) begin cnt2&lt;=cnt2+1;&#xa;              trig_2&lt;=1;&#xa;          end&#xa;          else begin cnt2&lt;=0;&#xa;              trig_2&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo2_2==1) cnt2&lt;=0;&#xa;          else begin if(cnt2&lt;OVER_TIME-1)cnt2&lt;=cnt2+1;&#xa;              else begin cnt2&lt;=0;&#xa;                  distance_mm2&lt;=0;&#xa;                  step&lt;=1;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt2&lt;=cnt2+1;&#xa;          CALC: begin distance_mm2&lt;=((cnt2+1)*223)>>16;&#xa;                          distance_mm2_1&lt;=distance_mm2;&#xa;                  distance_mm2_2&lt;=distance_mm2_1;&#xa;                  distance_mm2_3&lt;=distance_mm2_2;&#xa;              cnt2&lt;=0;&#xa;              step&lt;=1; if(distance_vld_back) begin&#xa;                      back_flag1&lt;=(distance_2>OBSTACLE_OFF &amp;&amp; mid_value2[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag2&lt;=back_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag3&lt;=back_flag2;end&#xa;                          else begin&#xa;                          back_flag1&lt;=0;&#xa;                          back_flag2&lt;=0;&#xa;                          back_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt2&lt;=0;&#xa;              distance_mm2&lt;=0;&#xa;                  distance_mm2_1&lt;=0;&#xa;                  distance_mm2_2&lt;=0;&#xa;                  distance_mm2_3&lt;=0;&#xa;              step&lt;=1;&#xa;              back_flag1&lt;=0;&#xa;              back_flag2&lt;=0;&#xa;              back_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//2&#xa;      end&#xa;      else&#xa;       begin  if(flag_go) begin &#xa;      if(group_pulse)begin&#xa;      step&lt;=1;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;     else  if(step>=2)&#xa;      &#x9;&#x9;step&lt;=1;&#xa;     else   if(step==1) begin//1&#x9;&#xa;      case(cstate1)&#xa;          IDLE:if(cnt1&lt;WAIT_TIME-1) cnt1&lt;=cnt1+1;&#xa;          else cnt1&lt;=0;&#xa;          SEND_TRIG:if(cnt1&lt;TRIG_TIME-1) begin cnt1&lt;=cnt1+1;&#xa;              trig_1&lt;=1;&#xa;          end&#xa;          else begin cnt1&lt;=0;&#xa;              trig_1&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo1_2==1) cnt1&lt;=0;&#xa;          else begin if(cnt1&lt;OVER_TIME-1)cnt1&lt;=cnt1+1;&#xa;              else begin cnt1&lt;=0;&#xa;                  distance_mm1&lt;=0;&#xa;                  step&lt;=1;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt1&lt;=cnt1+1;&#xa;          CALC: begin distance_mm1&lt;=((cnt1+1)*223)>>16;&#xa;                                  distance_mm1_1&lt;=distance_mm1;&#xa;                  distance_mm1_2&lt;=distance_mm1_1;&#xa;                  distance_mm1_3&lt;=distance_mm1_2;&#xa;              cnt1&lt;=0;&#xa;              step&lt;=1;&#x9;&#x9;if(distance_vld_go) begin&#xa;                        go_flag1&lt;=(distance_1>OBSTACLE_OFF &amp;&amp; mid_value1[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag2&lt;=go_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag3&lt;=go_flag2;end&#xa;                          else begin&#xa;                          &#x9;&#x9;go_flag1&lt;=0;&#xa;                                  go_flag2&lt;=0;&#xa;                                  go_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt1&lt;=0;&#xa;              distance_mm1&lt;=0;&#xa;                              distance_mm1_1&lt;=0;&#xa;                  distance_mm1_2&lt;=0;&#xa;                  distance_mm1_3&lt;=0;&#xa;              step&lt;=1;&#xa;              go_flag1&lt;=0;&#xa;              go_flag2&lt;=0;&#xa;              go_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//1&#xa;   end&#xa;      else if(flag_back) begin &#xa;          if(group_pulse)begin&#xa;      step&lt;=2;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;   else    if(step!=2)&#xa;      &#x9;&#x9;step&lt;=2;&#xa;    else    if(step==2) begin//4&#xa;      &#x9;case(cstate2)&#xa;          IDLE:if(cnt2&lt;WAIT_TIME-1) cnt2&lt;=cnt2+1;&#xa;          else cnt2&lt;=0;&#xa;          SEND_TRIG:if(cnt2&lt;TRIG_TIME-1) begin cnt2&lt;=cnt2+1;&#xa;              trig_2&lt;=1;&#xa;          end&#xa;          else begin cnt2&lt;=0;&#xa;              trig_2&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo2_2==1) cnt2&lt;=0;&#xa;          else begin if(cnt2&lt;OVER_TIME-1)cnt2&lt;=cnt2+1;&#xa;              else begin cnt2&lt;=0;&#xa;                  distance_mm2&lt;=0;&#xa;                  step&lt;=2;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt2&lt;=cnt2+1;&#xa;          CALC: begin distance_mm2&lt;=((cnt2+1)*223)>>16;&#xa;                          distance_mm2_1&lt;=distance_mm2;&#xa;                  distance_mm2_2&lt;=distance_mm2_1;&#xa;                  distance_mm2_3&lt;=distance_mm2_2;&#xa;              cnt2&lt;=0;&#xa;              step&lt;=2;&#x9;&#x9;if(distance_vld_back) begin&#xa;                      back_flag1&lt;=(distance_2>OBSTACLE_OFF &amp;&amp; mid_value2[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag2&lt;=back_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag3&lt;=back_flag2;end &#xa;                          else begin&#xa;                          back_flag1&lt;=0;&#xa;                          back_flag2&lt;=0;&#xa;                          back_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt2&lt;=0;&#xa;              distance_mm2&lt;=0;&#xa;                                              distance_mm2_1&lt;=0;&#xa;                  distance_mm2_2&lt;=0;&#xa;                  distance_mm2_3&lt;=0;&#xa;              step&lt;=2;&#xa;              back_flag1&lt;=0;&#xa;              back_flag2&lt;=0;&#xa;              back_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//4&#xa;    end&#xa;  end &#xa;  end&#xa;  wire [15:0]distance_1_max=(distance_mm1_1>distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_1>distance_mm1_3?distance_mm1_1:distance_mm1_3)://1>2的情况下1还>3，那就是1最大&#xa;                          (distance_mm1_2&lt;distance_mm1_3?distance_mm1_3:distance_mm1_2);//1&lt;2的情况下2＜3，2＞3&#xa;  wire [15:0]distance_2_max=(distance_mm2_1>distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_1>distance_mm2_3?distance_mm2_1:distance_mm2_3)://1>2的情况下1还>3，那就是1最大&#xa;                          (distance_mm2_2&lt;distance_mm2_3?distance_mm2_3:distance_mm2_2);//1&lt;2的情况下2＜3，2＞3&#xa;  wire [15:0]distance_1_min=(distance_mm1_1&lt;distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_2&lt;distance_mm1_3?                        //1小于2的情况下2小于3，最小的就是1&#xa;                          distance_mm1_1:(distance_mm1_1>distance_mm1_3)&#x9;&#x9;//1小于2的情况下2大于3，那就比较1和3&#xa;                          ?distance_mm1_3:distance_mm1_1):&#xa;                          (distance_mm1_2>distance_mm1_3?distance_mm1_3:distance_mm1_2);//1大于2的情况下2大于3，最小的就是3，否则最小的就是2&#xa;  wire [15:0]distance_2_min=(distance_mm2_1&lt;distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_2&lt;distance_mm2_3?                        //1小于2的情况下2小于3，最小的就是1&#xa;                          distance_mm2_1:(distance_mm2_1>distance_mm2_3)&#x9;&#x9;//1小于2的情况下2大于3，那就比较1和3&#xa;                          ?distance_mm2_3:distance_mm2_1):&#xa;                          (distance_mm2_2>distance_mm2_3?distance_mm2_3:distance_mm2_2);//1大于2的情况下2大于3，最小的就是3，否则最小的就是2&#xa;  wire [15:0]distance_1_mid=(distance_mm1_1>distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_2>distance_mm1_3?distance_mm1_2:&#xa;                          &#x9;distance_mm1_1>distance_mm1_3?distance_mm1_3:distance_mm1_1):&#xa;                             (distance_mm1_2&lt;distance_mm1_3?distance_mm1_2:&#xa;                          distance_mm1_1&lt;distance_mm1_3?distance_mm1_3:distance_mm1_1);&#xa;   wire [15:0]distance_2_mid=(distance_mm2_1>distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_2>distance_mm2_3?distance_mm2_2:&#xa;                          &#x9;distance_mm2_1>distance_mm2_3?distance_mm2_3:distance_mm2_1):&#xa;                           (distance_mm2_2&lt;distance_mm2_3?distance_mm2_2:&#xa;                          distance_mm2_1&lt;distance_mm2_3?distance_mm2_3:distance_mm2_1);&#x9;&#xa;  wire [18:0]sum_all1={3'd0,mid_value1[0]}&#xa;  &#x9;&#x9;&#x9;    +{3'd0,mid_value1[1]}&#xa;                  +{3'd0,mid_value1[2]}&#xa;                  +{3'd0,mid_value1[3]}&#xa;                  +{3'd0,mid_value1[4]}&#xa;                  +{3'd0,mid_value1[5]}&#xa;                  +{3'd0,mid_value1[6]}                &#xa;                  +{3'd0,mid_value1[7]};//用于均值的和&#xa;  reg [15:0]mid_value1[7:0];//&#xa;  wire [18:0]sum_all2={3'd0,mid_value2[0]}&#xa;  &#x9;&#x9;&#x9;    +{3'd0,mid_value2[1]}&#xa;                  +{3'd0,mid_value2[2]}&#xa;                  +{3'd0,mid_value2[3]}&#xa;                  +{3'd0,mid_value2[4]}&#xa;                  +{3'd0,mid_value2[5]}&#xa;                  +{3'd0,mid_value2[6]}                &#xa;                  +{3'd0,mid_value2[7]};//用于均值的和&#xa;  reg [15:0]mid_value2[7:0];//&#xa;  assign distance_1=sum_all1>>3;&#xa;  assign distance_2=sum_all2>>3;&#xa;  always @ ( posedge clk_50m or posedge rst )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      mid_value1[7]&lt;=0;&#xa;      mid_value1[6]&lt;=0;&#xa;      mid_value1[5]&lt;=0;&#xa;      mid_value1[4]&lt;=0;                                   &#xa;      mid_value1[3]&lt;=0;&#xa;      mid_value1[2]&lt;=0;&#xa;      mid_value1[1]&lt;=0;&#xa;      mid_value1[0]&lt;=0;&#xa;      mid_value2[7]&lt;=0;&#xa;      mid_value2[6]&lt;=0;&#xa;      mid_value2[5]&lt;=0;&#xa;      mid_value2[4]&lt;=0;                                   &#xa;      mid_value2[3]&lt;=0;&#xa;      mid_value2[2]&lt;=0;&#xa;      mid_value2[1]&lt;=0;&#xa;      mid_value2[0]&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(cstate1==CALC) begin&#xa;      mid_value1[7]&lt;=mid_value1[6];&#xa;      mid_value1[6]&lt;=mid_value1[5];&#xa;      mid_value1[5]&lt;=mid_value1[4];&#xa;      mid_value1[4]&lt;=mid_value1[3];&#xa;      mid_value1[3]&lt;=mid_value1[2];&#xa;      mid_value1[2]&lt;=mid_value1[1];&#xa;      mid_value1[1]&lt;=mid_value1[0];&#xa;      mid_value1[0]&lt;=distance_1_mid;&#xa;      end&#xa;      else&#xa;      &#x9;&#x9;if(cstate2==CALC) begin&#xa;      mid_value2[7]&lt;=mid_value2[6];&#xa;      mid_value2[6]&lt;=mid_value2[5];&#xa;      mid_value2[5]&lt;=mid_value2[4];&#xa;      mid_value2[4]&lt;=mid_value2[3];&#xa;      mid_value2[3]&lt;=mid_value2[2];&#xa;      mid_value2[2]&lt;=mid_value2[1];&#xa;      mid_value2[1]&lt;=mid_value2[0];&#xa;      mid_value2[0]&lt;=distance_2_mid; &#xa;      end&#xa;      end&#xa;  end&#xa;  //之前三次一致有点重复了，我就删除了&#xa;  reg go_flag1;&#xa;  reg go_flag2;&#xa;  reg go_flag3;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      distance_vld_go&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(flag_idle||flag_go) begin&#xa;              if(distance_vld_go==1) begin&#xa;              &#x9;&#x9;if(distance_1>OBSTACLE_OFF ) begin//慢速解除&#xa;                      distance_vld_go&lt;=~(go_flag1 &amp;&amp; go_flag2 &amp;&amp; go_flag3); end&#xa;                          end&#xa;               else if(distance_1_mid&lt;OBSTACLE_ON) begin//快速报警&#xa;              &#x9;&#x9;&#x9;distance_vld_go&lt;=1;&#xa;                          end&#xa;              end&#xa;      end&#xa;  end&#xa;  &#xa;  reg back_flag1;&#xa;  reg back_flag2;&#xa;  reg back_flag3;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      distance_vld_back&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(flag_idle||flag_back) begin&#xa;              if(distance_vld_back==1) begin&#xa;              &#x9;&#x9;if(distance_2>OBSTACLE_OFF ) begin&#xa;                      distance_vld_back&lt;=~(back_flag1 &amp;&amp; back_flag2 &amp;&amp; back_flag3);&#xa;                          end&#xa;                          end&#xa;               else if(distance_2_mid&lt;OBSTACLE_ON) begin&#xa;              &#x9;&#x9;&#x9;distance_vld_back&lt;=1;&#xa;                          end&#xa;              end&#xa;      end&#xa;  end&#xa;  &#xa;&#xa;  &#xa;  &#xa;&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="ULTRASONIC_SENSOR_cg0" Parameters="" Parent="ULTRASONIC_SENSOR_cg_test" Type="model" Width="200" X="700" Y="430">
