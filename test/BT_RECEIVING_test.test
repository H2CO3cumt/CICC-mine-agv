<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="parameter UART_BIT_TIME = 8680; &#xa;reg [7:0]rx_byte;&#xa;//时钟与周期使能信号生成&#xa;    initial clk_50m = 0;&#xa;    always #10 clk_50m = ~clk_50m; // 50MHz 时钟&#xa;&#xa;    reg [19:0] pulse_cnt;&#xa;    always @(posedge clk_50m or posedge rst) begin&#xa;        if (rst) begin&#xa;            pulse_cnt &lt;= 0;&#xa;            en_500 &lt;= 0;&#xa;        end else begin&#xa;            if (pulse_cnt == 100_000-1) begin&#xa;                pulse_cnt &lt;= 0;&#xa;                en_500 &lt;= 1;&#xa;            end else begin&#xa;                pulse_cnt &lt;= pulse_cnt + 1;&#xa;                en_500 &lt;= 0;&#xa;            end&#xa;        end&#xa;    end&#xa;//TASK定义&#xa;//系统初始化&#xa;task sys_reset;&#xa;begin&#xa;$display(&quot;/n [%0t ns] [INIT] ===System Reset Start===&quot;,$time);&#xa;rst=1;&#xa;load_state=0;&#xa;distance_vld=0;&#xa;gas_alarm=0;&#xa;key_value=9'b111_111_111;&#xa;key_sensor=9'b111_111_111;&#xa;key_cmd=9'b111_111_111;&#xa;weight_data=24'h0; &#xa;car_state=4'b0000;&#xa;#200;&#xa;rst=0;&#xa;#1000;&#xa;$display(&quot;/n [%0t ns] [INIT] ===System Reset End===&quot;,$time);&#xa;end&#xa;endtask&#xa;//改变小车状态以及载重&#xa;task state_weight(&#xa;    input [3:0]w_state,&#xa;    input [23:0]w_weight);&#xa;begin&#xa;car_state=w_state;&#xa;weight_data=w_weight;&#xa;#50_000;&#xa;$display(&quot;/n [%0t ns] [DRIVER] car_state=%b,weight_data=0x%h,&quot;,$time,w_state,w_weight);&#xa;end    &#xa;endtask&#xa;//改变gas_alarm,distance_vld,&#xa;task trigger_fault(&#xa;    input gas,&#xa;    input distance&#xa;);&#xa;begin&#xa;gas_alarm=gas;&#xa;distance_vld=distance;&#xa;#150_000;&#xa;car_state=4'b0000;&#xa;#150_000;&#xa;gas_alarm=0;&#xa;distance_vld=0;&#xa;#150_000;&#xa;car_state=4'b0001;&#xa;$display(&quot;/n [%0t ns] [FAULT] gas_alarm=%b,distance_vld=%b&quot;,$time,gas,distance);&#xa;end&#xa;endtask&#xa;//UART_RX&#xa;integer i;&#xa;always @ ( negedge tx )&#xa;begin &#xa; #(UART_BIT_TIME/2);&#xa;&#x9;if(tx==0) begin&#xa;    &#x9;&#x9; #UART_BIT_TIME;&#xa;            for(i=0;i&lt;8;i=i+1) begin&#xa;            rx_byte[i]=tx;&#xa;            #UART_BIT_TIME;&#xa;            end &#xa;$display(&quot;/n [%0t ns] [UART_RX] Captured Data=8'h%h&quot;,$time,rx_byte);&#xa;    end&#xa;end&#xa;initial begin&#xa;sys_reset();&#xa;#24_100_000;&#xa;//场景1，小车正常前进，载重24'h123456&#xa;state_weight(4'b0001,24'h123456);&#xa;#24_000_000;&#xa;//场景2，小车遭遇distance_vld&#xa;trigger_fault(0,1);&#xa;#24_000_000;&#xa;//场景3，极限测试，小车同时遭遇gas_alarm与distance_vld&#xa;trigger_fault(1,1);&#xa;#24_000_000;&#xa;$finish;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="BT_RECEIVING_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
