  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="SEG_LED_BUZZ0" Side="left" Width="30" X="-0.15" Y="0.545455"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_2k" Parent="SEG_LED_BUZZ0" Side="left" Width="30" X="-0.15" Y="0.668182"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="buzz_out" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.3"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1" Parent="SEG_LED_BUZZ0" Side="left" Width="30" X="-0.15" Y="0.790909"/>
  <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="go" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.422727"/>
  <Port Color="#deb887" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.545455"/>
  <Port Color="#5f9ea0" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.668182"/>
  <Port Color="#7fff00" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="back" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.790909"/>
