  <Port Color="#f5f5dc" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="sel" Parent="SEG_LED_BUZZ0" Side="right" Width="30" X="0.85" Y="0.0545455"/>
