<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam MAX_500=1_000-1;&#xa;localparam MAX_2k=25-1;&#xa;localparam MAX_1=50_000-1;//缩小1000倍&#xa;reg [19:0]cnt_500;&#xa;reg [15:0]cnt_2k;&#xa;reg [27:0]cnt_1;&#xa;initial clk_50m=0;&#xa;always #10 clk_50m=~clk_50m;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_500&lt;=0;&#xa;    en_500&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_500==MAX_500) begin&#xa;            cnt_500&lt;=0;&#xa;            en_500&lt;=1;&#xa;            end&#xa;         else begin cnt_500&lt;=cnt_500+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_500&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_2k&lt;=0;&#xa;    en_2k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_2k==MAX_2k) begin&#xa;            cnt_2k&lt;=0;&#xa;            en_2k&lt;=1;&#xa;            end&#xa;         else begin cnt_2k&lt;=cnt_2k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_2k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_1&lt;=0;&#xa;    en_1&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_1==MAX_1) begin&#xa;            cnt_1&lt;=0;&#xa;            en_1&lt;=1;&#xa;            end&#xa;         else begin cnt_1&lt;=cnt_1+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_1&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;initial begin&#xa;rst=1;&#xa;#105;&#xa;rst=0;&#xa;car_state=4'b0000;&#xa;gas_alarm=1;&#xa;#20_000_000;&#xa;car_state=4'b0001;&#xa;gas_alarm=0;&#xa;#12_000_000;&#xa;car_state=4'b0010;&#xa;#12_000_000;&#xa;car_state=4'b0100;&#xa;#12_000_000;&#xa;car_state=4'b1000;&#xa;#12_000_000;&#xa;$finish;&#xa;end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="SEG_LED_BUZZ_test" Parent="0" Timescale="1ns/1ns" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="SEG_LED_BUZZ" Code="//因为模块限额，我只能把原先的SEL_SEG,LED,BUZZ模块融合，请谅解&#xa;//SEL_SEG部分&#xa;  //   // 数字段码&#xa;    parameter  SEG_0    = 8'hC0;  // 数字 0&#xa;    parameter  SEG_1    = 8'hF9;  // 数字 1&#xa;    parameter  SEG_2    = 8'hA4;  // 数字 2&#xa;    parameter  SEG_3    = 8'hB0;  // 数字 3&#xa;    parameter  SEG_4    = 8'h99;  // 数字 4&#xa;    parameter  SEG_5    = 8'h92;  // 数字 5&#xa;    parameter  SEG_6    = 8'h82;  // 数字 6&#xa;    parameter  SEG_7    = 8'hF8;  // 数字 7&#xa;    parameter  SEG_8    = 8'h80;  // 数字 8&#xa;    parameter  SEG_9    = 8'h90;  // 数字 9&#xa;    // 熄灭码 (全灭)&#xa;    parameter  SEG_OFF  = 8'hFF;  // 数码管全灭&#xa;    parameter IDLE=4'b0000;&#xa;    parameter GO=4'b0001;&#xa;    parameter BACK=4'b0010;&#xa;    parameter LEFT=4'b0100;&#xa;    parameter RIGHT=4'b1000;&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        &#x9;&#x9;sel&lt;=6'b111_110;&#xa;         else if(en_500)&#xa;         sel&lt;={sel[4:0],sel[5]};&#xa;    end&#xa;    always @ ( * )&#xa;&#x9; begin&#xa;        &#x9;case( car_state)&#xa;        IDLE:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        &#xa;        GO:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_1;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        BACK:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_1;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        LEFT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_1;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        RIGHT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_1;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end   &#xa;                default:seg=SEG_6;&#xa;            endcase&#xa;&#xa;        end &#xa;//BUZZ部分&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst)&#xa;buzz_out&lt;=0;&#xa;else begin&#x9;if(en_2k) begin&#xa;&#x9;&#x9;&#x9;&#x9;if(car_state==4'b0100||car_state==4'b1000||car_state==4'b0010||gas_alarm) &#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;buzz_out&lt;=~buzz_out;&#xa;                   else buzz_out&lt;=0;&#xa;                        end&#xa;                end&#xa;&#xa;end&#xa; //LED部分&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;  begin &#xa;   if(rst) begin&#xa;    go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      else begin if(en_1)&#xa;      case( car_state)&#xa;      4'b0000:begin&#xa;   go&lt;=2'b11;&#xa;   back&lt;=2'b11;&#xa;   right&lt;=2'b11;&#xa;      left&lt;=2'b11;&#xa;      end&#xa;      4'b0001:begin &#xa;  go&lt;=~go;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0010:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=~back;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0100:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=~left;&#xa;      end&#xa;      4'b1000:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=~right;&#xa;      left&lt;=2'b00;&#xa;  &#xa;      end&#xa;          default:  begin&#xa;          go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end &#xa;      endcase&#xa;      &#xa;      end    &#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="SEG_LED_BUZZ0" Parameters="" Parent="SEG_LED_BUZZ_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="SEG_LED_BUZZ0" Side="left" Width="30" X="-0.15" Y="0.0545455"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_500" Parent="SEG_LED_BUZZ0" Side="left" Width="30" X="-0.15" Y="0.177273"/>
