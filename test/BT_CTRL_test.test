<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="initial clk_50m=0;&#xa;always #10 clk_50m=~clk_50m;&#xa;task send_byte(&#xa;    input [7:0]data,&#xa;    input real drift_ratio);&#xa;integer i;&#xa;real bit_time;&#xa;begin&#xa;bit_time=8680.55*drift_ratio;&#xa; rx=0;&#xa;#bit_time;&#xa;&#x9;&#x9;for(i=0;i&lt;8;i=i+1) begin&#xa;&#x9;&#x9;rx=data[i];&#xa;        #bit_time;&#xa;        end &#xa;      rx=1;&#xa;    #bit_time;&#xa;end&#xa;endtask&#xa;always @ (posedge clk_50m  )&#xa;begin &#xa;&#x9;if(BT_CTRL0.rx_data_vld==1)&#xa;    $display(&quot;[在%0tns 成功捕获],开发板收到了有效数据%h&quot;,$time,BT_CTRL0.rx_data);&#xa;end&#xa;//测试开始&#xa;initial begin&#xa;rx=1;&#xa;rst=1;&#xa;#100;&#xa;rst=0;&#xa;//测试1，在正常波特率的情况下能否背靠背收数据&#xa;#10_000;&#xa;$display(&quot; [在%0tns],===第一次测试开始===&quot;,$time);&#xa;send_byte(8'hAA,1.0);&#xa;send_byte(8'hBB,1.0);&#xa;$display(&quot; [在%0tns],===第一次测试结束===&quot;,$time);&#xa;#10_000;&#xa;//测试2，发送方时钟慢了3%，让每个 bit 拖长 3%&#xa;$display(&quot; [在%0tns],===第二次测试开始===&quot;,$time);&#xa;send_byte(8'hCC,1.03);&#xa;#10_000;&#xa;$display(&quot; [在%0tns],===第二次测试结束===&quot;,$time);&#xa;//测试3，发送方时钟慢了6%，给它发 8'h00（全0，容易和起始位混淆），让每个 bit 拖长 6%&#xa;$display(&quot; [在%0tns],===第三次测试开始===&quot;,$time);&#xa;send_byte(8'h00,1.06);&#xa;#10_000;&#xa;$display(&quot;[在%0tns],===第三次测试结束===&quot;,$time);&#xa;//测试4，假毛刺，我先给rx一个15ns的低电平，然后再让他回到高电平，看它会不会以为刚才真的是一个起始位然后乱收数据&#xa;//然后我再给他一个数据，看模块刚才有没有因为毛刺死机&#xa;$display(&quot;[在%0tns],===第四次测试开始===&quot;,$time);&#xa;rx=0;&#xa;#15;&#xa;rx=1;&#xa;#3_000_000;&#xa;//正常情况下rx_data的数据应该就是我上一次给它发的数据，并且不会捕获成功&#xa;send_byte(8'haa,0.95);&#xa;#10_000;&#xa;$display(&quot; [在%0tns],===第四次测试结束===&quot;,$time);&#xa;$finish;&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="BT_CTRL_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="BT_CTRL" Code="localparam CLOCK=50_000_000;//系统时钟频率&#xa;localparam BAUD=115200;//波特率；&#xa;localparam CHECK_BIT=&quot;None&quot;;//无校验位&#xa;parameter MAX_1BAUD=CLOCK/BAUD;//一个波特率所要经历的时钟周期&#xa;parameter IDLE=5'b00000;&#xa;parameter START=5'b00001;&#xa;parameter DATA=5'b00010;&#xa;parameter CHECK=5'b00100;&#xa;reg [15:0]cnt_baud;//计算baud有没有到达MAX_1BAUD&#xa;reg [3:0]cnt_bit;//计算bit有没有达到max_bit;&#xa;reg [3:0]max_bit;//bit的最大值，根据不同状态所决定&#xa;reg [4:0]cstate;//当前状态&#xa;reg [4:0]nstate;//下一时钟状态&#xa;reg rx_check;//校验位的实际值&#xa;reg [7:0]rx_temp;//类似于仓库，存储要发送的数据&#xa;reg rx_r1;&#xa;reg rx_r2; &#xa;wire rx_nege;//用于rx下降沿检测&#xa;wire add_baud;&#xa;wire end_baud;//波特率开始，结束计算&#xa;wire add_bit;&#xa;wire end_bit;//bit开始，结束运算&#xa;wire IDLE_START=(cstate==IDLE) &amp;&amp; rx_nege;&#xa;wire START_DATA=(cstate==START)&amp;&amp; end_bit;&#xa;wire DATA_CHECK=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT!=&quot;None&quot;);&#xa;wire DATA_IDLE=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT==&quot;None&quot;);&#xa;wire CHECK_IDLE=(cstate==CHECK)&amp;&amp; end_bit;&#xa;//wire check_val;//校验位的正确值;经计算得到&#xa;wire add_bit1;&#xa;wire add_bit2;//检测end_baud的上升沿&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;rx_r1&lt;=1;&#xa;        rx_r2&lt;=1;&#xa;            end&#xa;     else begin&#xa;    &#x9;    rx_r1&lt;=rx;&#xa;        rx_r2&lt;=rx_r1;&#xa;    end&#xa;end&#xa;assign rx_nege=~rx_r1 &amp;&amp; rx_r2;//检测rx刚刚经历了下降沿  &#xa;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_baud&lt;=0;&#xa;     else if(add_baud)begin&#xa;    &#x9;&#x9;&#x9;if(end_baud)&#xa;                cnt_baud&lt;=0; &#xa;            else cnt_baud&lt;=cnt_baud+1;                &#xa;    end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_baud&lt;=0;    &#xa;end&#xa;assign add_baud=cstate!=IDLE;&#xa;assign end_baud=add_baud &amp;&amp; (cnt_baud==MAX_1BAUD-1);&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:max_bit=0;&#xa;    START:max_bit=1;&#xa;    DATA:max_bit=8;&#xa;    CHECK:max_bit=1;&#xa;        default: max_bit=0   ;&#xa;    endcase&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_bit&lt;=0;&#xa;     else if(add_bit)begin&#xa;    &#x9;&#x9;&#x9;if(end_bit)&#xa;                cnt_bit&lt;=0; &#xa;            else cnt_bit&lt;=cnt_bit+1;                &#xa;    &#x9;&#x9;&#x9;end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_bit&lt;=cnt_bit;    &#xa;end&#xa;assign add_bit=end_baud;&#xa;assign end_bit=add_bit &amp;&amp; (cnt_bit==max_bit-1);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;cstate&lt;=IDLE;&#xa;    else cstate&lt;=nstate;&#xa;end&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:if(IDLE_START)&#xa;    &#x9;&#x9;&#x9;nstate=START;&#xa;         else nstate=cstate;&#xa;    START:if( cnt_baud==MAX_1BAUD>>1 &amp;&amp; rx_r2==1)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=IDLE;&#xa;   else begin if(START_DATA)&#xa;    &#x9;&#x9;&#x9;nstate=DATA;&#xa;          else nstate=cstate;&#xa;        end&#xa;    &#x9;DATA:if(DATA_CHECK)&#xa;        &#x9;&#x9;nstate=CHECK;&#xa;          else  begin if(DATA_IDLE)&#xa;        &#x9;&#x9;&#x9;nstate=IDLE;&#xa;                    else nstate=cstate;&#xa;                    end&#xa;    &#x9;CHECK:if(CHECK_IDLE)&#xa;        &#x9;&#x9;nstate=IDLE;&#xa;           else nstate=cstate;&#x9;&#x9;   &#xa;        default: nstate=IDLE;&#xa;    endcase&#xa;end &#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;rx_temp&lt;=0;&#xa;    else  begin if(cstate==DATA &amp;&amp; cnt_baud== MAX_1BAUD>>1)&#xa;    rx_temp[cnt_bit]&lt;=rx_r2;&#xa;    else rx_temp&lt;=rx_temp;&#xa;    end&#xa;end&#xa;assign rx_data=rx_temp;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)&#xa;    rx_check&lt;=0;&#xa;    else if(cstate==CHECK &amp;&amp; cnt_baud==MAX_1BAUD>>1)&#xa;    &#x9;&#x9;rx_check&lt;=rx_r2;&#xa;end&#xa;assign rx_data_vld=DATA_IDLE;&#xa;//原来的CMD_PARSER模块&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin if(rst)&#xa;&#x9;key_cmd&lt;=9'b111_111_111;&#xa;    else  begin if(rx_data_vld) begin&#xa;&#x9;&#x9;case( rx_data)&#xa;        8'h46 : key_cmd &lt;= 9'b111_111_101; // 'F' GO&#xa;        8'h42 : key_cmd &lt;= 9'b101_111_111; // 'B' BACK&#xa;        8'h4C : key_cmd &lt;= 9'b111_110_111; // 'L' LEFT&#xa;        8'h52 : key_cmd &lt;= 9'b111_011_111; // 'R' RIGHT&#xa;        8'h53 : key_cmd &lt;= 9'b111_101_111; // 'S' IDLE&#xa;            default: key_cmd&lt;=key_cmd;&#xa;        endcase&#xa;        end&#xa;        else key_cmd&lt;=key_cmd; &#xa;        end&#xa;end" Color="#d3d3d3" Comment="" Height="220" Name="BT_CTRL0" Parameters="" Parent="BT_CTRL_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="BT_CTRL0" Side="left" Width="30" X="-0.15" Y="0.181818"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="BT_CTRL0" Side="left" Width="30" X="-0.15" Y="0.431818"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rx" Parent="BT_CTRL0" Side="left" Width="30" X="-0.15" Y="0.681818"/>
  <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="reg" Description="" Height="30" Inout="output" Name="key_cmd" Parent="BT_CTRL0" Side="right" Width="30" X="0.85" Y="0.431818"/>
  <Port Color="#f5f5dc" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data" Parent="BT_CTRL0" Side="top" Width="30" X="0.255" Y="-0.136364"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data_vld" Parent="BT_CTRL0" Side="top" Width="30" X="0.585" Y="-0.136364"/>
 </Module>
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="clk_50m" Parent="BT_CTRL_test" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="rst" Parent="BT_CTRL_test" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="rx" Parent="BT_CTRL_test" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="output" Name="key_cmd" Parent="BT_CTRL_test" Side="right" Width="30" X="0.98125" Y="0.486111"/>
 <Wire Datasize="1" Datatype="wire" From="BT_CTRL_test>clk_50m" Name="BT_CTRL_test_clk_50m" Parent="BT_CTRL_test" To="BT_CTRL_test#BT_CTRL0>clk_50m"/>
 <Wire Datasize="1" Datatype="wire" From="BT_CTRL_test>rst" Name="BT_CTRL_test_rst" Parent="BT_CTRL_test" To="BT_CTRL_test#BT_CTRL0>rst"/>
 <Wire Datasize="1" Datatype="wire" From="BT_CTRL_test>rx" Name="BT_CTRL_test_rx" Parent="BT_CTRL_test" To="BT_CTRL_test#BT_CTRL0>rx"/>
 <Wire Datasize="9" Datatype="wire" From="BT_CTRL_test>key_cmd" Name="BT_CTRL0_key_cmd" Parent="BT_CTRL_test" To="BT_CTRL_test#BT_CTRL0>key_cmd"/>
</Module>
