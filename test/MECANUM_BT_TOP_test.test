<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="initial&#xa;begin &#xa; &#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;  #100 $finish;&#xa;end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="MECANUM_BT_TOP_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="MECANUM_BT_TOP" Code="    parameter integer MAPPING_CONFIGURED  = 0;&#xa;    parameter integer M1_WHEEL            = 4;&#xa;    parameter integer M2_WHEEL            = 4;&#xa;    parameter integer M3_WHEEL            = 4;&#xa;    parameter integer M4_WHEEL            = 4;&#xa;    parameter integer M1_INVERT           = 0;&#xa;    parameter integer M2_INVERT           = 0;&#xa;    parameter integer M3_INVERT           = 0;&#xa;    parameter integer M4_INVERT           = 0;&#xa;        parameter integer CLK_FREQ            = 50_000_000; // Hz，系统时钟频率&#xa;    parameter integer UART_BAUD           = 115_200;    // bit/s，UART 8N1 波特率&#xa;    parameter integer CONTROL_HZ          = 1_000;      // Hz，运动控制更新频率&#xa;    parameter integer PWM_FREQ            = 20_000;     // Hz，电机 PWM 频率&#xa;    parameter integer WATCHDOG_TIME_MS    = 200;        // ms，合法帧失联停车时间&#xa;    parameter integer POR_TIME_MS         = 50;         // ms，内部上电复位保持时间&#xa;    parameter integer ACC_STEP            = 2;          // 每 ms 加速百分比点&#xa;    parameter integer DEC_STEP            = 4;          // 每 ms 减速百分比点&#xa;    parameter integer DEAD_TIME_MS        = 5;          // ms，换向前全桥关闭时间&#xa;    parameter integer MAX_PWM_PERCENT     = 40;         // %，正常模式最大 PWM 占空比&#xa;    parameter integer MOTOR_TEST_MODE     = 0;          // 1=逐个电机测试；0=蓝牙控制&#xa;    parameter integer TEST_PWM_PERCENT    = 15;         // %，电机测试模式 PWM 占空比&#xa;    &#xa;    localparam integer UART_X16_FREQ    = UART_BAUD * 16;&#xa;    localparam integer CONTROL_DIV      = CLK_FREQ / CONTROL_HZ;&#xa;    localparam integer PWM_PERIOD       = CLK_FREQ / PWM_FREQ;&#xa;    localparam integer WATCHDOG_CYCLES  = (CLK_FREQ / 1000) * WATCHDOG_TIME_MS;&#xa;    localparam integer POR_CYCLES       = (CLK_FREQ / 1000) * POR_TIME_MS;&#xa;    localparam integer TEST_PHASE_CYCLES= CLK_FREQ; // 每个运行/停止阶段 1 秒&#xa;    localparam integer TEST_DUTY_COUNT  = (PWM_PERIOD * TEST_PWM_PERCENT) / 100;&#xa;&#xa;    localparam [2:0] UART_IDLE  = 3'd0;&#xa;    localparam [2:0] UART_START = 3'd1;&#xa;    localparam [2:0] UART_DATA  = 3'd2;&#xa;    localparam [2:0] UART_STOP  = 3'd3;&#xa;    localparam [2:0] UART_RECOVER = 3'd4;&#xa;&#xa;    localparam [2:0] FRAME_SEARCH = 3'd0;&#xa;    localparam [2:0] FRAME_X      = 3'd1;&#xa;    localparam [2:0] FRAME_Y      = 3'd2;&#xa;    localparam [2:0] FRAME_R      = 3'd3;&#xa;    localparam [2:0] FRAME_FLAGS  = 3'd4;&#xa;    localparam [2:0] FRAME_CHECK  = 3'd5;&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 仅用于整数绝对值、最大值、映射和斜坡的组合函数。&#xa;    // -------------------------------------------------------------------------&#xa;    function integer abs_integer;&#xa;        input integer value;&#xa;        begin&#xa;            if (value &lt; 0)&#xa;                abs_integer = -value;&#xa;            else&#xa;                abs_integer = value;&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer max4_abs;&#xa;        input integer a;&#xa;        input integer b;&#xa;        input integer c;&#xa;        input integer d;&#xa;        integer result;&#xa;        begin&#xa;            result = abs_integer(a);&#xa;            if (abs_integer(b) > result)&#xa;                result = abs_integer(b);&#xa;            if (abs_integer(c) > result)&#xa;                result = abs_integer(c);&#xa;            if (abs_integer(d) > result)&#xa;                result = abs_integer(d);&#xa;            max4_abs = result;&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer select_wheel;&#xa;        input integer wheel_id;&#xa;        input integer fl_value;&#xa;        input integer fr_value;&#xa;        input integer rl_value;&#xa;        input integer rr_value;&#xa;        begin&#xa;            case (wheel_id)&#xa;                0: select_wheel = fl_value;&#xa;                1: select_wheel = fr_value;&#xa;                2: select_wheel = rl_value;&#xa;                3: select_wheel = rr_value;&#xa;                default: select_wheel = 0;&#xa;            endcase&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer slew_next;&#xa;        input integer current_value;&#xa;        input integer target_value;&#xa;        input integer acceleration_step;&#xa;        input integer deceleration_step;&#xa;        integer step_value;&#xa;        begin&#xa;            if (target_value == current_value) begin&#xa;                slew_next = current_value;&#xa;            end else begin&#xa;                if (abs_integer(target_value) > abs_integer(current_value))&#xa;                    step_value = acceleration_step;&#xa;                else&#xa;                    step_value = deceleration_step;&#xa;&#xa;                if (target_value > current_value) begin&#xa;                    if ((current_value + step_value) > target_value)&#xa;                        slew_next = target_value;&#xa;                    else&#xa;                        slew_next = current_value + step_value;&#xa;                end else begin&#xa;                    if ((current_value - step_value) &lt; target_value)&#xa;                        slew_next = target_value;&#xa;                    else&#xa;                        slew_next = current_value - step_value;&#xa;                end&#xa;            end&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer pwm_duty_count;&#xa;        input integer speed_percent;&#xa;        integer magnitude;&#xa;        begin&#xa;            magnitude = abs_integer(speed_percent);&#xa;            if (magnitude > 100)&#xa;                magnitude = 100;&#xa;            pwm_duty_count = (magnitude * PWM_PERIOD * MAX_PWM_PERCENT) / 10000;&#xa;        end&#xa;    endfunction&#xa;&#xa;    assign H2_1_UART_TX = 1'b1;&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 内部 Power-On Reset。&#xa;    // 这里依赖目标 FPGA 对“配置时寄存器初值”的综合支持。&#xa;    // 若器件不保证该特性，必须改用芯片 GSR/POR 或外部复位，详见 README。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] por_counter = 32'd0;&#xa;    reg        por_reset   = 1'b1;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            if (por_counter >= (POR_CYCLES - 1)) begin&#xa;                por_counter &lt;= por_counter;&#xa;                por_reset   &lt;= 1'b0;&#xa;            end else begin&#xa;                por_counter &lt;= por_counter + 1'b1;&#xa;                por_reset   &lt;= 1'b1;&#xa;            end&#xa;        end else begin&#xa;            por_counter &lt;= por_counter;&#xa;            por_reset   &lt;= 1'b0;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // UART 接收输入两级同步。&#xa;    // -------------------------------------------------------------------------&#xa;    reg uart_rx_meta;&#xa;    reg uart_rx_sync;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_rx_meta &lt;= 1'b1;&#xa;            uart_rx_sync &lt;= 1'b1;&#xa;        end else begin&#xa;            uart_rx_meta &lt;= H2_2_UART_RX;&#xa;            uart_rx_sync &lt;= uart_rx_meta;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 分数累加器产生 16 倍波特率采样使能。&#xa;    // 默认参数下平均采样频率严格为 1,843,200 Hz，不依赖 434 的粗略整除。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] uart_phase_accumulator;&#xa;    reg        uart_x16_tick;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_phase_accumulator &lt;= 32'd0;&#xa;            uart_x16_tick          &lt;= 1'b0;&#xa;        end else begin&#xa;            if (uart_phase_accumulator >= (CLK_FREQ - UART_X16_FREQ)) begin&#xa;                uart_phase_accumulator &lt;= uart_phase_accumulator&#xa;                                          + UART_X16_FREQ - CLK_FREQ;&#xa;                uart_x16_tick          &lt;= 1'b1;&#xa;            end else begin&#xa;                uart_phase_accumulator &lt;= uart_phase_accumulator + UART_X16_FREQ;&#xa;                uart_x16_tick          &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // UART 115200 8N1 接收状态机：起始位中点确认、数据位中心采样、停止位检查。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [2:0]  uart_state;&#xa;    reg [4:0]  uart_subtick_count;&#xa;    reg [2:0]  uart_bit_index;&#xa;    reg [7:0]  uart_shift_register;&#xa;    reg [7:0]  uart_byte;&#xa;    reg        uart_byte_valid;&#xa;    reg [31:0] uart_framing_error_count;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_state               &lt;= UART_IDLE;&#xa;            uart_subtick_count       &lt;= 5'd0;&#xa;            uart_bit_index           &lt;= 3'd0;&#xa;            uart_shift_register      &lt;= 8'd0;&#xa;            uart_byte                &lt;= 8'd0;&#xa;            uart_byte_valid          &lt;= 1'b0;&#xa;            uart_framing_error_count &lt;= 32'd0;&#xa;        end else begin&#xa;            uart_byte_valid &lt;= 1'b0;&#xa;&#xa;            case (uart_state)&#xa;                UART_IDLE: begin&#xa;                    uart_subtick_count &lt;= 5'd0;&#xa;                    uart_bit_index     &lt;= 3'd0;&#xa;                    if (uart_rx_sync == 1'b0)&#xa;                        uart_state &lt;= UART_START;&#xa;                end&#xa;&#xa;                UART_START: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd7) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            if (uart_rx_sync == 1'b0) begin&#xa;                                uart_state     &lt;= UART_DATA;&#xa;                                uart_bit_index &lt;= 3'd0;&#xa;                            end else begin&#xa;                                uart_state &lt;= UART_IDLE;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_DATA: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_shift_register[uart_bit_index] &lt;= uart_rx_sync;&#xa;                            if (uart_bit_index == 3'd7) begin&#xa;                                uart_bit_index &lt;= 3'd0;&#xa;                                uart_state     &lt;= UART_STOP;&#xa;                            end else begin&#xa;                                uart_bit_index &lt;= uart_bit_index + 1'b1;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_STOP: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_state         &lt;= UART_IDLE;&#xa;                            if (uart_rx_sync == 1'b1) begin&#xa;                                uart_byte       &lt;= uart_shift_register;&#xa;                                uart_byte_valid &lt;= 1'b1;&#xa;                            end else begin&#xa;                                uart_framing_error_count &lt;= uart_framing_error_count + 1'b1;&#xa;                                // 错误停止位后不能立刻把持续低电平当作新起始位。&#xa;                                // 先等待一整个 bit 的空闲高电平，再恢复到 IDLE。&#xa;                                uart_state &lt;= UART_RECOVER;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_RECOVER: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_rx_sync == 1'b0) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                        end else if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_state         &lt;= UART_IDLE;&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                default: begin&#xa;                    uart_state         &lt;= UART_IDLE;&#xa;                    uart_subtick_count &lt;= 5'd0;&#xa;                    uart_bit_index     &lt;= 3'd0;&#xa;                end&#xa;            endcase&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 6 字节二进制控制帧解析。&#xa;    // AA, X+100, Y+100, R+100, FLAGS, CHECKSUM。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [2:0]  frame_state;&#xa;    reg [7:0]  frame_x_byte;&#xa;    reg [7:0]  frame_y_byte;&#xa;    reg [7:0]  frame_r_byte;&#xa;    reg [7:0]  frame_flags_byte;&#xa;    reg [7:0]  frame_checksum;&#xa;    reg [7:0]  received_x_byte;&#xa;    reg [7:0]  received_y_byte;&#xa;    reg [7:0]  received_r_byte;&#xa;    reg [7:0]  received_flags_byte;&#xa;    reg        frame_valid;&#xa;    reg [31:0] valid_frame_count;&#xa;    reg [31:0] invalid_frame_count;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            frame_state         &lt;= FRAME_SEARCH;&#xa;            frame_x_byte        &lt;= 8'd0;&#xa;            frame_y_byte        &lt;= 8'd0;&#xa;            frame_r_byte        &lt;= 8'd0;&#xa;            frame_flags_byte    &lt;= 8'd0;&#xa;            frame_checksum      &lt;= 8'd0;&#xa;            received_x_byte     &lt;= 8'd100;&#xa;            received_y_byte     &lt;= 8'd100;&#xa;            received_r_byte     &lt;= 8'd100;&#xa;            received_flags_byte &lt;= 8'd0;&#xa;            frame_valid         &lt;= 1'b0;&#xa;            valid_frame_count   &lt;= 32'd0;&#xa;            invalid_frame_count &lt;= 32'd0;&#xa;        end else begin&#xa;            frame_valid &lt;= 1'b0;&#xa;&#xa;            if (uart_byte_valid) begin&#xa;                case (frame_state)&#xa;                    FRAME_SEARCH: begin&#xa;                        if (uart_byte == 8'hAA) begin&#xa;                            frame_checksum &lt;= 8'hAA;&#xa;                            frame_state    &lt;= FRAME_X;&#xa;                        end&#xa;                    end&#xa;&#xa;                    FRAME_X: begin&#xa;                        frame_x_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_Y;&#xa;                    end&#xa;&#xa;                    FRAME_Y: begin&#xa;                        frame_y_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_R;&#xa;                    end&#xa;&#xa;                    FRAME_R: begin&#xa;                        frame_r_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_FLAGS;&#xa;                    end&#xa;&#xa;                    FRAME_FLAGS: begin&#xa;                        frame_flags_byte &lt;= uart_byte;&#xa;                        frame_checksum   &lt;= frame_checksum + uart_byte;&#xa;                        frame_state      &lt;= FRAME_CHECK;&#xa;                    end&#xa;&#xa;                    FRAME_CHECK: begin&#xa;                        frame_state &lt;= FRAME_SEARCH;&#xa;                        if ((frame_x_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (frame_y_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (frame_r_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (uart_byte == frame_checksum)) begin&#xa;                            received_x_byte     &lt;= frame_x_byte;&#xa;                            received_y_byte     &lt;= frame_y_byte;&#xa;                            received_r_byte     &lt;= frame_r_byte;&#xa;                            received_flags_byte &lt;= frame_flags_byte;&#xa;                            frame_valid         &lt;= 1'b1;&#xa;                            valid_frame_count   &lt;= valid_frame_count + 1'b1;&#xa;                        end else begin&#xa;                            invalid_frame_count &lt;= invalid_frame_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;&#xa;                    default: begin&#xa;                        frame_state &lt;= FRAME_SEARCH;&#xa;                    end&#xa;                endcase&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 合法帧命令寄存与 200 ms watchdog。&#xa;    // 只有 frame_valid 才喂狗；急停帧把三轴立即清零并保留急停标志。&#xa;    // -------------------------------------------------------------------------&#xa;    integer joystick_x;&#xa;    integer joystick_y;&#xa;    integer joystick_r;&#xa;    reg [7:0] control_flags;&#xa;    reg [31:0] watchdog_counter;&#xa;    reg        watchdog_alive;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            joystick_x      &lt;= 0;&#xa;            joystick_y      &lt;= 0;&#xa;            joystick_r      &lt;= 0;&#xa;            control_flags   &lt;= 8'd0;&#xa;            watchdog_counter&lt;= 32'd0;&#xa;            watchdog_alive  &lt;= 1'b0;&#xa;        end else if (frame_valid) begin&#xa;            watchdog_counter &lt;= 32'd0;&#xa;            watchdog_alive   &lt;= 1'b1;&#xa;            control_flags    &lt;= received_flags_byte;&#xa;            if (received_flags_byte[0]) begin&#xa;                joystick_x &lt;= 0;&#xa;                joystick_y &lt;= 0;&#xa;                joystick_r &lt;= 0;&#xa;            end else begin&#xa;                joystick_x &lt;= received_x_byte - 100;&#xa;                joystick_y &lt;= received_y_byte - 100;&#xa;                joystick_r &lt;= received_r_byte - 100;&#xa;            end&#xa;        end else if (watchdog_alive) begin&#xa;            if (watchdog_counter >= (WATCHDOG_CYCLES - 1)) begin&#xa;                watchdog_counter &lt;= watchdog_counter;&#xa;                watchdog_alive   &lt;= 1'b0;&#xa;                joystick_x       &lt;= 0;&#xa;                joystick_y       &lt;= 0;&#xa;                joystick_r       &lt;= 0;&#xa;                control_flags    &lt;= 8'd0;&#xa;            end else begin&#xa;                watchdog_counter &lt;= watchdog_counter + 1'b1;&#xa;            end&#xa;        end else begin&#xa;            watchdog_counter &lt;= 32'd0;&#xa;            watchdog_alive   &lt;= 1'b0;&#xa;            joystick_x       &lt;= 0;&#xa;            joystick_y       &lt;= 0;&#xa;            joystick_r       &lt;= 0;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 1 kHz 控制使能和 20 kHz PWM 载波计数器。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] control_counter;&#xa;    reg        control_tick;&#xa;    reg [31:0] pwm_counter;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            control_counter &lt;= 32'd0;&#xa;            control_tick    &lt;= 1'b0;&#xa;        end else begin&#xa;            if (control_counter >= (CONTROL_DIV - 1)) begin&#xa;                control_counter &lt;= 32'd0;&#xa;                control_tick    &lt;= 1'b1;&#xa;            end else begin&#xa;                control_counter &lt;= control_counter + 1'b1;&#xa;                control_tick    &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            pwm_counter &lt;= 32'd0;&#xa;        end else begin&#xa;            if (pwm_counter >= (PWM_PERIOD - 1))&#xa;                pwm_counter &lt;= 32'd0;&#xa;            else&#xa;                pwm_counter &lt;= pwm_counter + 1'b1;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 麦克纳姆解算：每个 1 kHz control_tick 捕获一次新命令。&#xa;    // max_abs>100 时使用最多 100 个 50 MHz 周期的迭代减法求商，复用小型&#xa;    // 加减比较逻辑，避免综合出四个大组合除法器。最坏约 2 us，小于 1 ms 周期。&#xa;    // -------------------------------------------------------------------------&#xa;    localparam [1:0] NORM_IDLE   = 2'd0;&#xa;    localparam [1:0] NORM_DIVIDE = 2'd1;&#xa;    localparam [1:0] NORM_MAP    = 2'd2;&#xa;&#xa;    integer raw_fl;&#xa;    integer raw_fr;&#xa;    integer raw_rl;&#xa;    integer raw_rr;&#xa;    integer max_abs_value;&#xa;    integer wheel_fl;&#xa;    integer wheel_fr;&#xa;    integer wheel_rl;&#xa;    integer wheel_rr;&#xa;    integer target_m1;&#xa;    integer target_m2;&#xa;    integer target_m3;&#xa;    integer target_m4;&#xa;    integer current_m1;&#xa;    integer current_m2;&#xa;    integer current_m3;&#xa;    integer current_m4;&#xa;    integer dead_m1;&#xa;    integer dead_m2;&#xa;    integer dead_m3;&#xa;    integer dead_m4;&#xa;    reg [1:0] norm_state;&#xa;    integer norm_divisor;&#xa;    integer norm_remainder_fl;&#xa;    integer norm_remainder_fr;&#xa;    integer norm_remainder_rl;&#xa;    integer norm_remainder_rr;&#xa;    integer norm_quotient_fl;&#xa;    integer norm_quotient_fr;&#xa;    integer norm_quotient_rl;&#xa;    integer norm_quotient_rr;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            current_m1        &lt;= 0;&#xa;            current_m2        &lt;= 0;&#xa;            current_m3        &lt;= 0;&#xa;            current_m4        &lt;= 0;&#xa;            dead_m1           &lt;= 0;&#xa;            dead_m2           &lt;= 0;&#xa;            dead_m3           &lt;= 0;&#xa;            dead_m4           &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            current_m1        &lt;= 0;&#xa;            current_m2        &lt;= 0;&#xa;            current_m3        &lt;= 0;&#xa;            current_m4        &lt;= 0;&#xa;            dead_m1           &lt;= 0;&#xa;            dead_m2           &lt;= 0;&#xa;            dead_m3           &lt;= 0;&#xa;            dead_m4           &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else if ((!watchdog_alive) || control_flags[0] ||&#xa;                     (MAPPING_CONFIGURED == 0)) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            current_m1        &lt;= 0;&#xa;            current_m2        &lt;= 0;&#xa;            current_m3        &lt;= 0;&#xa;            current_m4        &lt;= 0;&#xa;            dead_m1           &lt;= 0;&#xa;            dead_m2           &lt;= 0;&#xa;            dead_m3           &lt;= 0;&#xa;            dead_m4           &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else begin&#xa;            // 原始矢量、统一归一化和轮位映射状态机。&#xa;            case (norm_state)&#xa;                NORM_IDLE: begin&#xa;                    if (control_tick) begin&#xa;                        raw_fl &lt;= joystick_y + joystick_x + joystick_r;&#xa;                        raw_fr &lt;= joystick_y - joystick_x - joystick_r;&#xa;                        raw_rl &lt;= joystick_y - joystick_x + joystick_r;&#xa;                        raw_rr &lt;= joystick_y + joystick_x - joystick_r;&#xa;                        max_abs_value &lt;= max4_abs(&#xa;                            joystick_y + joystick_x + joystick_r,&#xa;                            joystick_y - joystick_x - joystick_r,&#xa;                            joystick_y - joystick_x + joystick_r,&#xa;                            joystick_y + joystick_x - joystick_r&#xa;                        );&#xa;&#xa;                        if (max4_abs(&#xa;                                joystick_y + joystick_x + joystick_r,&#xa;                                joystick_y - joystick_x - joystick_r,&#xa;                                joystick_y - joystick_x + joystick_r,&#xa;                                joystick_y + joystick_x - joystick_r&#xa;                            ) > 100) begin&#xa;                            norm_divisor &lt;= max4_abs(&#xa;                                joystick_y + joystick_x + joystick_r,&#xa;                                joystick_y - joystick_x - joystick_r,&#xa;                                joystick_y - joystick_x + joystick_r,&#xa;                                joystick_y + joystick_x - joystick_r&#xa;                            );&#xa;                            norm_remainder_fl &lt;= abs_integer(&#xa;                                joystick_y + joystick_x + joystick_r) * 100;&#xa;                            norm_remainder_fr &lt;= abs_integer(&#xa;                                joystick_y - joystick_x - joystick_r) * 100;&#xa;                            norm_remainder_rl &lt;= abs_integer(&#xa;                                joystick_y - joystick_x + joystick_r) * 100;&#xa;                            norm_remainder_rr &lt;= abs_integer(&#xa;                                joystick_y + joystick_x - joystick_r) * 100;&#xa;                            norm_quotient_fl &lt;= 0;&#xa;                            norm_quotient_fr &lt;= 0;&#xa;                            norm_quotient_rl &lt;= 0;&#xa;                            norm_quotient_rr &lt;= 0;&#xa;                            norm_state &lt;= NORM_DIVIDE;&#xa;                        end else begin&#xa;                            wheel_fl &lt;= joystick_y + joystick_x + joystick_r;&#xa;                            wheel_fr &lt;= joystick_y - joystick_x - joystick_r;&#xa;                            wheel_rl &lt;= joystick_y - joystick_x + joystick_r;&#xa;                            wheel_rr &lt;= joystick_y + joystick_x - joystick_r;&#xa;                            norm_divisor &lt;= 0;&#xa;                            norm_remainder_fl &lt;= 0;&#xa;                            norm_remainder_fr &lt;= 0;&#xa;                            norm_remainder_rl &lt;= 0;&#xa;                            norm_remainder_rr &lt;= 0;&#xa;                            norm_quotient_fl &lt;= 0;&#xa;                            norm_quotient_fr &lt;= 0;&#xa;                            norm_quotient_rl &lt;= 0;&#xa;                            norm_quotient_rr &lt;= 0;&#xa;                            norm_state &lt;= NORM_MAP;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_DIVIDE: begin&#xa;                    if ((norm_remainder_fl &lt; norm_divisor) &amp;&amp;&#xa;                        (norm_remainder_fr &lt; norm_divisor) &amp;&amp;&#xa;                        (norm_remainder_rl &lt; norm_divisor) &amp;&amp;&#xa;                        (norm_remainder_rr &lt; norm_divisor)) begin&#xa;                        if (raw_fl &lt; 0)&#xa;                            wheel_fl &lt;= -norm_quotient_fl;&#xa;                        else&#xa;                            wheel_fl &lt;= norm_quotient_fl;&#xa;                        if (raw_fr &lt; 0)&#xa;                            wheel_fr &lt;= -norm_quotient_fr;&#xa;                        else&#xa;                            wheel_fr &lt;= norm_quotient_fr;&#xa;                        if (raw_rl &lt; 0)&#xa;                            wheel_rl &lt;= -norm_quotient_rl;&#xa;                        else&#xa;                            wheel_rl &lt;= norm_quotient_rl;&#xa;                        if (raw_rr &lt; 0)&#xa;                            wheel_rr &lt;= -norm_quotient_rr;&#xa;                        else&#xa;                            wheel_rr &lt;= norm_quotient_rr;&#xa;                        norm_state &lt;= NORM_MAP;&#xa;                    end else begin&#xa;                        if (norm_remainder_fl >= norm_divisor) begin&#xa;                            norm_remainder_fl &lt;= norm_remainder_fl - norm_divisor;&#xa;                            norm_quotient_fl  &lt;= norm_quotient_fl + 1;&#xa;                        end&#xa;                        if (norm_remainder_fr >= norm_divisor) begin&#xa;                            norm_remainder_fr &lt;= norm_remainder_fr - norm_divisor;&#xa;                            norm_quotient_fr  &lt;= norm_quotient_fr + 1;&#xa;                        end&#xa;                        if (norm_remainder_rl >= norm_divisor) begin&#xa;                            norm_remainder_rl &lt;= norm_remainder_rl - norm_divisor;&#xa;                            norm_quotient_rl  &lt;= norm_quotient_rl + 1;&#xa;                        end&#xa;                        if (norm_remainder_rr >= norm_divisor) begin&#xa;                            norm_remainder_rr &lt;= norm_remainder_rr - norm_divisor;&#xa;                            norm_quotient_rr  &lt;= norm_quotient_rr + 1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_MAP: begin&#xa;                    if (M1_INVERT != 0)&#xa;                        target_m1 &lt;= -select_wheel(M1_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m1 &lt;=  select_wheel(M1_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M2_INVERT != 0)&#xa;                        target_m2 &lt;= -select_wheel(M2_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m2 &lt;=  select_wheel(M2_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M3_INVERT != 0)&#xa;                        target_m3 &lt;= -select_wheel(M3_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m3 &lt;=  select_wheel(M3_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M4_INVERT != 0)&#xa;                        target_m4 &lt;= -select_wheel(M4_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m4 &lt;=  select_wheel(M4_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    norm_state &lt;= NORM_IDLE;&#xa;                end&#xa;&#xa;                default: begin&#xa;                    norm_state &lt;= NORM_IDLE;&#xa;                end&#xa;            endcase&#xa;&#xa;            // 每 1 ms 更新一次实际轮速斜坡；新目标在归一化完成后供下个 tick 使用。&#xa;            if (control_tick) begin&#xa;                if (dead_m1 > 0) begin&#xa;                    current_m1 &lt;= 0;&#xa;                    dead_m1    &lt;= dead_m1 - 1;&#xa;                end else if (((current_m1 > 0) &amp;&amp; (target_m1 &lt; 0)) ||&#xa;                             ((current_m1 &lt; 0) &amp;&amp; (target_m1 > 0))) begin&#xa;                    if (abs_integer(current_m1) &lt;= DEC_STEP) begin&#xa;                        current_m1 &lt;= 0;&#xa;                        dead_m1    &lt;= DEAD_TIME_MS;&#xa;                    end else begin&#xa;                        current_m1 &lt;= slew_next(current_m1, 0, ACC_STEP, DEC_STEP);&#xa;                    end&#xa;                end else begin&#xa;                    current_m1 &lt;= slew_next(current_m1, target_m1, ACC_STEP, DEC_STEP);&#xa;                end&#xa;&#xa;                if (dead_m2 > 0) begin&#xa;                    current_m2 &lt;= 0;&#xa;                    dead_m2    &lt;= dead_m2 - 1;&#xa;                end else if (((current_m2 > 0) &amp;&amp; (target_m2 &lt; 0)) ||&#xa;                             ((current_m2 &lt; 0) &amp;&amp; (target_m2 > 0))) begin&#xa;                    if (abs_integer(current_m2) &lt;= DEC_STEP) begin&#xa;                        current_m2 &lt;= 0;&#xa;                        dead_m2    &lt;= DEAD_TIME_MS;&#xa;                    end else begin&#xa;                        current_m2 &lt;= slew_next(current_m2, 0, ACC_STEP, DEC_STEP);&#xa;                    end&#xa;                end else begin&#xa;                    current_m2 &lt;= slew_next(current_m2, target_m2, ACC_STEP, DEC_STEP);&#xa;                end&#xa;&#xa;                if (dead_m3 > 0) begin&#xa;                    current_m3 &lt;= 0;&#xa;                    dead_m3    &lt;= dead_m3 - 1;&#xa;                end else if (((current_m3 > 0) &amp;&amp; (target_m3 &lt; 0)) ||&#xa;                             ((current_m3 &lt; 0) &amp;&amp; (target_m3 > 0))) begin&#xa;                    if (abs_integer(current_m3) &lt;= DEC_STEP) begin&#xa;                        current_m3 &lt;= 0;&#xa;                        dead_m3    &lt;= DEAD_TIME_MS;&#xa;                    end else begin&#xa;                        current_m3 &lt;= slew_next(current_m3, 0, ACC_STEP, DEC_STEP);&#xa;                    end&#xa;                end else begin&#xa;                    current_m3 &lt;= slew_next(current_m3, target_m3, ACC_STEP, DEC_STEP);&#xa;                end&#xa;&#xa;                if (dead_m4 > 0) begin&#xa;                    current_m4 &lt;= 0;&#xa;                    dead_m4    &lt;= dead_m4 - 1;&#xa;                end else if (((current_m4 > 0) &amp;&amp; (target_m4 &lt; 0)) ||&#xa;                             ((current_m4 &lt; 0) &amp;&amp; (target_m4 > 0))) begin&#xa;                    if (abs_integer(current_m4) &lt;= DEC_STEP) begin&#xa;                        current_m4 &lt;= 0;&#xa;                        dead_m4    &lt;= DEAD_TIME_MS;&#xa;                    end else begin&#xa;                        current_m4 &lt;= slew_next(current_m4, 0, ACC_STEP, DEC_STEP);&#xa;                    end&#xa;                end else begin&#xa;                    current_m4 &lt;= slew_next(current_m4, target_m4, ACC_STEP, DEC_STEP);&#xa;                end&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 电机测试模式：M1运行1秒/停1秒/M2运行1秒/停1秒/.../循环。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] test_phase_counter;&#xa;    reg [2:0]  test_phase;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            test_phase_counter &lt;= 32'd0;&#xa;            test_phase         &lt;= 3'd0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            if (test_phase_counter >= (TEST_PHASE_CYCLES - 1)) begin&#xa;                test_phase_counter &lt;= 32'd0;&#xa;                if (test_phase == 3'd7)&#xa;                    test_phase &lt;= 3'd0;&#xa;                else&#xa;                    test_phase &lt;= test_phase + 1'b1;&#xa;            end else begin&#xa;                test_phase_counter &lt;= test_phase_counter + 1'b1;&#xa;            end&#xa;        end else begin&#xa;            test_phase_counter &lt;= 32'd0;&#xa;            test_phase         &lt;= 3'd0;&#xa;        end&#xa;    end&#xa;&#xa;    // PWM 占空比采用当前斜坡速度；组合逻辑只含常数除法。&#xa;    integer duty_m1;&#xa;    integer duty_m2;&#xa;    integer duty_m3;&#xa;    integer duty_m4;&#xa;&#xa;    always @* begin&#xa;        duty_m1 = pwm_duty_count(current_m1);&#xa;        duty_m2 = pwm_duty_count(current_m2);&#xa;        duty_m3 = pwm_duty_count(current_m3);&#xa;        duty_m4 = pwm_duty_count(current_m4);&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 最终电机输出。每一路均使用 if/else 互斥产生 FI/BI，禁止同时有效。&#xa;    // 急停和 watchdog 失效直接覆盖斜坡状态，在下一个 50 MHz 边沿关闭输出。&#xa;    // -------------------------------------------------------------------------&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            M1_FI &lt;= 1'b0;&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= 1'b0;&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= 1'b0;&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= 1'b0;&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            M1_FI &lt;= ((test_phase == 3'd0) &amp;&amp; (pwm_counter &lt; TEST_DUTY_COUNT));&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= ((test_phase == 3'd2) &amp;&amp; (pwm_counter &lt; TEST_DUTY_COUNT));&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= ((test_phase == 3'd4) &amp;&amp; (pwm_counter &lt; TEST_DUTY_COUNT));&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= ((test_phase == 3'd6) &amp;&amp; (pwm_counter &lt; TEST_DUTY_COUNT));&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else if ((!watchdog_alive) || control_flags[0] ||&#xa;                     (MAPPING_CONFIGURED == 0)) begin&#xa;            M1_FI &lt;= 1'b0;&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= 1'b0;&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= 1'b0;&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= 1'b0;&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else begin&#xa;            if (current_m1 > 0) begin&#xa;                M1_FI &lt;= (pwm_counter &lt; duty_m1);&#xa;                M1_BI &lt;= 1'b0;&#xa;            end else if (current_m1 &lt; 0) begin&#xa;                M1_FI &lt;= 1'b0;&#xa;                M1_BI &lt;= (pwm_counter &lt; duty_m1);&#xa;            end else begin&#xa;                M1_FI &lt;= 1'b0;&#xa;                M1_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m2 > 0) begin&#xa;                M2_FI &lt;= (pwm_counter &lt; duty_m2);&#xa;                M2_BI &lt;= 1'b0;&#xa;            end else if (current_m2 &lt; 0) begin&#xa;                M2_FI &lt;= 1'b0;&#xa;                M2_BI &lt;= (pwm_counter &lt; duty_m2);&#xa;            end else begin&#xa;                M2_FI &lt;= 1'b0;&#xa;                M2_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m3 > 0) begin&#xa;                M3_FI &lt;= (pwm_counter &lt; duty_m3);&#xa;                M3_BI &lt;= 1'b0;&#xa;            end else if (current_m3 &lt; 0) begin&#xa;                M3_FI &lt;= 1'b0;&#xa;                M3_BI &lt;= (pwm_counter &lt; duty_m3);&#xa;            end else begin&#xa;                M3_FI &lt;= 1'b0;&#xa;                M3_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m4 > 0) begin&#xa;                M4_FI &lt;= (pwm_counter &lt; duty_m4);&#xa;                M4_BI &lt;= 1'b0;&#xa;            end else if (current_m4 &lt; 0) begin&#xa;                M4_FI &lt;= 1'b0;&#xa;                M4_BI &lt;= (pwm_counter &lt; duty_m4);&#xa;            end else begin&#xa;                M4_FI &lt;= 1'b0;&#xa;                M4_BI &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="MECANUM_BT_TOP0" Parameters="" Parent="MECANUM_BT_TOP_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="CLK_50M" Parent="MECANUM_BT_TOP0" Side="left" Width="30" X="-0.15" Y="0.263636"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="H2_2_UART_RX" Parent="MECANUM_BT_TOP0" Side="left" Width="30" X="-0.15" Y="0.595455"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="H2_1_UART_TX" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.0409091"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="M1_FI" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.15"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="M1_BI" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.259091"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="M2_BI" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.368182"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="M2_FI" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.477273"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="M3_BI" Parent="MECANUM_BT_TOP0" Side="right" Width="30" X="0.85" Y="0.586364"/>
