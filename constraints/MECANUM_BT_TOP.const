<!DOCTYPE Robei>
<Module Class="module" Code="" Color="#d3d3d3" Device="xc7a50tfgg484" Family="artix7" Height="1080" Name="MECANUM_BT_TOP" Parent="0" Type="const" Vendor="AMD" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="MECANUM_BT_TOP" Code="  parameter integer CLK_FREQ            = 50_000_000; // Hz，系统时钟频率&#xa;    parameter integer UART_BAUD           = 115_200;    // bit/s，UART 8N1 波特率&#xa;    parameter integer CONTROL_HZ          = 1_000;      // Hz，运动控制更新频率&#xa;    parameter integer PWM_FREQ            = 20_000;     // Hz，电机 PWM 频率&#xa;    parameter integer WATCHDOG_TIME_MS    = 200;        // ms，合法帧失联停车时间&#xa;    parameter integer POR_TIME_MS         = 50;         // ms，内部上电复位保持时间&#xa;    parameter integer ACC_STEP            = 2;          // 每 ms 加速百分比点&#xa;    parameter integer DEC_STEP            = 4;          // 每 ms 减速百分比点&#xa;    parameter integer DEAD_TIME_MS        = 5;          // ms，换向前全桥关闭时间&#xa;    parameter integer MAX_PWM_PERCENT     = 80;         // %，最大 PWM 占空比&#xa;    parameter integer MOTOR_TEST_MODE     = 0;          // 1=逐个电机测试；0=蓝牙控制&#xa;    parameter integer TEST_PWM_PERCENT    = 15;         // %，测试模式占空比&#xa;&#xa;    // 赛车式控制和编码器闭环参数。&#xa;    parameter integer QUICK_TURN_THROTTLE_PERCENT = 60; // %，急弯油门保留比例&#xa;    parameter integer QUICK_TURN_STEER_PERCENT = 140;   // %，急弯转向增益&#xa;    parameter integer ENCODER_CLOSED_LOOP_ENABLE = 1;   // 1=编码器PI；0=开环&#xa;    parameter integer GEAR_RATIO          = 30;         // 减速比&#xa;    parameter integer ENCODER_BASE_PPR     = 11;         // 电机轴每相脉冲/圈&#xa;    parameter integer ENCODER_CPR_X4       = ENCODER_BASE_PPR * GEAR_RATIO * 4;&#xa;                                                         // count/输出轴圈&#xa;    parameter integer MOTOR_MAX_RPM        = 330;        // rpm，最高输出转速&#xa;    parameter integer SPEED_SAMPLE_MS      = 10;         // ms，测速和PI周期&#xa;    parameter integer MAX_TARGET_COUNTS    =&#xa;        (ENCODER_CPR_X4 * MOTOR_MAX_RPM * SPEED_SAMPLE_MS *&#xa;         MAX_PWM_PERCENT) / 6_000_000;                  // count/测速窗&#xa;    parameter integer FEEDFORWARD_PWM_PERCENT = 55;     // %，满目标前馈PWM&#xa;    parameter integer PI_KP_NUM            = 20;         // Kp分子&#xa;    parameter integer PI_KI_NUM            = 1;          // Ki分子&#xa;    parameter integer PI_GAIN_DIV          = 20;         // PI统一分母&#xa;    parameter integer PI_INTEGRAL_LIMIT    = 600;        // count，积分限幅&#xa;    parameter integer STALL_MIN_TARGET_PERCENT = 25;    // %，堵转检测最低目标&#xa;    parameter integer STALL_MAX_COUNTS     = 1;          // count/测速窗&#xa;    parameter integer STALL_TIMEOUT_MS     = 500;        // ms，堵转超时&#xa;&#xa;    // ================================&#xa;    // 车轮编号及方向校准区&#xa;    // ================================&#xa;    // 轮位编号：0=FL左前，1=FR右前，2=RL左后，3=RR右后，4=未配置。&#xa;    // 正向定义：轮子朝小车头部方向滚动。&#xa;    parameter integer MAPPING_CONFIGURED = 1;&#xa;    parameter integer M1_WHEEL           = 0;&#xa;    parameter integer M2_WHEEL           = 1;&#xa;    parameter integer M3_WHEEL           = 3;&#xa;    parameter integer M4_WHEEL           = 2;&#xa;    parameter integer M1_INVERT          = 0;&#xa;    parameter integer M2_INVERT          = 1;&#xa;    parameter integer M3_INVERT          = 1;&#xa;    parameter integer M4_INVERT          = 0;&#xa;&#xa;    localparam integer UART_X16_FREQ    = UART_BAUD * 16;&#xa;    localparam integer CONTROL_DIV      = CLK_FREQ / CONTROL_HZ;&#xa;    localparam integer PWM_PERCENT_TICK_FREQ = PWM_FREQ * 100;&#xa;    localparam integer WATCHDOG_CYCLES  = (CLK_FREQ / 1000) * WATCHDOG_TIME_MS;&#xa;    localparam integer POR_CYCLES       = (CLK_FREQ / 1000) * POR_TIME_MS;&#xa;    localparam integer TEST_PHASE_CYCLES= CLK_FREQ; // 每个运行/停止阶段 1 秒&#xa;    localparam integer SPEED_SAMPLE_CYCLES = (CLK_FREQ / 1000) * SPEED_SAMPLE_MS;&#xa;    localparam integer STALL_SAMPLE_LIMIT =&#xa;        (STALL_TIMEOUT_MS + SPEED_SAMPLE_MS - 1) / SPEED_SAMPLE_MS;&#xa;&#xa;    localparam [2:0] UART_IDLE  = 3'd0;&#xa;    localparam [2:0] UART_START = 3'd1;&#xa;    localparam [2:0] UART_DATA  = 3'd2;&#xa;    localparam [2:0] UART_STOP  = 3'd3;&#xa;    localparam [2:0] UART_RECOVER = 3'd4;&#xa;&#xa;    localparam [2:0] FRAME_SEARCH = 3'd0;&#xa;    localparam [2:0] FRAME_X      = 3'd1;&#xa;    localparam [2:0] FRAME_Y      = 3'd2;&#xa;    localparam [2:0] FRAME_R      = 3'd3;&#xa;    localparam [2:0] FRAME_FLAGS  = 3'd4;&#xa;    localparam [2:0] FRAME_CHECK  = 3'd5;&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 仅用于整数绝对值、最大值、映射和斜坡的组合函数。&#xa;    // -------------------------------------------------------------------------&#xa;    function integer abs_integer;&#xa;        input integer value;&#xa;        begin&#xa;            if (value &lt; 0)&#xa;                abs_integer = -value;&#xa;            else&#xa;                abs_integer = value;&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer max4_abs;&#xa;        input integer a;&#xa;        input integer b;&#xa;        input integer c;&#xa;        input integer d;&#xa;        integer result;&#xa;        begin&#xa;            result = abs_integer(a);&#xa;            if (abs_integer(b) > result)&#xa;                result = abs_integer(b);&#xa;            if (abs_integer(c) > result)&#xa;                result = abs_integer(c);&#xa;            if (abs_integer(d) > result)&#xa;                result = abs_integer(d);&#xa;            max4_abs = result;&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer select_wheel;&#xa;        input integer wheel_id;&#xa;        input integer fl_value;&#xa;        input integer fr_value;&#xa;        input integer rl_value;&#xa;        input integer rr_value;&#xa;        begin&#xa;            case (wheel_id)&#xa;                0: select_wheel = fl_value;&#xa;                1: select_wheel = fr_value;&#xa;                2: select_wheel = rl_value;&#xa;                3: select_wheel = rr_value;&#xa;                default: select_wheel = 0;&#xa;            endcase&#xa;        end&#xa;    endfunction&#xa;&#xa;    function integer quadrature_step;&#xa;        input [1:0] previous_ab;&#xa;        input [1:0] current_ab;&#xa;        begin&#xa;            case ({previous_ab, current_ab})&#xa;                4'b0001, 4'b0111, 4'b1110, 4'b1000:&#xa;                    quadrature_step = 1;&#xa;                4'b0010, 4'b1011, 4'b1101, 4'b0100:&#xa;                    quadrature_step = -1;&#xa;                default:&#xa;                    quadrature_step = 0;&#xa;            endcase&#xa;        end&#xa;    endfunction&#xa;&#xa;    function [7:0] telemetry_count_byte;&#xa;        input integer measured_counts_value;&#xa;        begin&#xa;            if (measured_counts_value > 255)&#xa;                telemetry_count_byte = 8'hFF;&#xa;            else if (measured_counts_value &lt; 0)&#xa;                telemetry_count_byte = 8'h00;&#xa;            else&#xa;                telemetry_count_byte = measured_counts_value[7:0];&#xa;        end&#xa;    endfunction&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 编码器、PI、故障与遥测寄存器。所有可能为负数的状态继续只使用integer。&#xa;    // -------------------------------------------------------------------------&#xa;    reg m1_a_meta, m1_a_sync, m1_b_meta, m1_b_sync;&#xa;    reg m2_a_meta, m2_a_sync, m2_b_meta, m2_b_sync;&#xa;    reg m3_a_meta, m3_a_sync, m3_b_meta, m3_b_sync;&#xa;    reg m4_a_meta, m4_a_sync, m4_b_meta, m4_b_sync;&#xa;    reg [1:0] encoder_prev_m1;&#xa;    reg [1:0] encoder_prev_m2;&#xa;    reg [1:0] encoder_prev_m3;&#xa;    reg [1:0] encoder_prev_m4;&#xa;    integer encoder_total_m1;&#xa;    integer encoder_total_m2;&#xa;    integer encoder_total_m3;&#xa;    integer encoder_total_m4;&#xa;    integer encoder_invalid_m1;&#xa;    integer encoder_invalid_m2;&#xa;    integer encoder_invalid_m3;&#xa;    integer encoder_invalid_m4;&#xa;&#xa;    reg [31:0] speed_sample_counter;&#xa;    integer encoder_previous_total_m1;&#xa;    integer encoder_previous_total_m2;&#xa;    integer encoder_previous_total_m3;&#xa;    integer encoder_previous_total_m4;&#xa;    integer measured_counts_m1;&#xa;    integer measured_counts_m2;&#xa;    integer measured_counts_m3;&#xa;    integer measured_counts_m4;&#xa;    integer pi_integral_m1;&#xa;    integer pi_integral_m2;&#xa;    integer pi_integral_m3;&#xa;    integer pi_integral_m4;&#xa;    integer pi_pwm_m1;&#xa;    integer pi_pwm_m2;&#xa;    integer pi_pwm_m3;&#xa;    integer pi_pwm_m4;&#xa;    integer stall_samples_m1;&#xa;    integer stall_samples_m2;&#xa;    integer stall_samples_m3;&#xa;    integer stall_samples_m4;&#xa;    reg     encoder_fault;&#xa;    reg [7:0] telemetry_sequence;&#xa;    reg [7:0] control_flags;&#xa;    reg       watchdog_alive;&#xa;    integer current_m1;&#xa;    integer current_m2;&#xa;    integer current_m3;&#xa;    integer current_m4;&#xa;&#xa;    // PI 运算被拆成多拍执行。10 ms 内最多只占用几千个时钟，&#xa;    // 但任意一个时钟周期都只包含一次加/减/比较，避免组合乘除法关键路径。&#xa;    localparam [4:0] PI_IDLE       = 5'd0;&#xa;    localparam [4:0] PI_ABS_DELTA  = 5'd1;&#xa;    localparam [4:0] PI_LOAD       = 5'd2;&#xa;    localparam [4:0] PI_SCALE_ADD  = 5'd3;&#xa;    localparam [4:0] PI_SCALE_DIV  = 5'd4;&#xa;    localparam [4:0] PI_INTEGRAL   = 5'd5;&#xa;    localparam [4:0] PI_KP_ADD     = 5'd6;&#xa;    localparam [4:0] PI_KI_ADD     = 5'd7;&#xa;    localparam [4:0] PI_GAIN_DIVIDE= 5'd8;&#xa;    localparam [4:0] PI_OUTPUT     = 5'd9;&#xa;    localparam [4:0] PI_STORE      = 5'd10;&#xa;    localparam [4:0] PI_INTEGRAL_CLAMP = 5'd11;&#xa;    localparam [4:0] PI_GAIN_DIV_POS = 5'd12;&#xa;    localparam [4:0] PI_GAIN_DIV_NEG = 5'd13;&#xa;&#xa;    reg [4:0] pi_state;&#xa;    reg [1:0] pi_motor_index;&#xa;    integer encoder_delta_m1;&#xa;    integer encoder_delta_m2;&#xa;    integer encoder_delta_m3;&#xa;    integer encoder_delta_m4;&#xa;    integer pi_work_target;&#xa;    integer pi_work_measured;&#xa;    integer pi_work_integral_before;&#xa;    integer pi_work_integral;&#xa;    integer pi_integral_sum;&#xa;    integer pi_work_error;&#xa;    integer pi_scale_count;&#xa;    integer pi_target_remainder;&#xa;    integer pi_feedforward_remainder;&#xa;    integer pi_target_quotient;&#xa;    integer pi_feedforward_quotient;&#xa;    integer pi_gain_count;&#xa;    integer pi_gain_sum;&#xa;    integer pi_gain_quotient;&#xa;    integer pi_work_output;&#xa;&#xa;    reg [7:0] tx_seen_sequence;&#xa;    reg [3:0] tx_frame_index;&#xa;    reg       tx_frame_active;&#xa;    reg       tx_prepare_active;&#xa;    reg [3:0] tx_checksum_index;&#xa;    reg [7:0] tx_checksum_accumulator;&#xa;    reg       tx_byte_busy;&#xa;    reg [3:0] tx_bit_index;&#xa;    reg [9:0] tx_shift_register;&#xa;    reg [31:0] tx_phase_accumulator;&#xa;    reg [7:0] tx_selected_byte;&#xa;    reg [7:0] tx_b0, tx_b1, tx_b2, tx_b3, tx_b4, tx_b5;&#xa;    reg [7:0] tx_b6, tx_b7, tx_b8, tx_b9, tx_b10, tx_b11;&#xa;    reg [31:0] por_counter = 32'd0;&#xa;    reg        por_reset   = 1'b1;&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 内部 Power-On Reset。&#xa;    // 这里依赖目标 FPGA 对“配置时寄存器初值”的综合支持。&#xa;    // 若器件不保证该特性，必须改用芯片 GSR/POR 或外部复位，详见 README。&#xa;    // -------------------------------------------------------------------------&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            if (por_counter >= (POR_CYCLES - 1)) begin&#xa;                por_counter &lt;= por_counter;&#xa;                por_reset   &lt;= 1'b0;&#xa;            end else begin&#xa;                por_counter &lt;= por_counter + 1'b1;&#xa;                por_reset   &lt;= 1'b1;&#xa;            end&#xa;        end else begin&#xa;            por_counter &lt;= por_counter;&#xa;            por_reset   &lt;= 1'b0;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 10 ms编码器测速、四路独立PI和堵转/断线保护。&#xa;    // 乘法和除法全部改成共享的多拍“重复加法/减法”，消除原先的超长路径。&#xa;    // PI只控制PWM幅值；实际正反方向仍由经过映射、斜坡和死区的current_mx决定。&#xa;    // FLAGS.bit2 连续置1可清除编码器故障锁存，清除时车辆必须先处于零命令。&#xa;    // -------------------------------------------------------------------------&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            speed_sample_counter      &lt;= 32'd0;&#xa;            encoder_previous_total_m1 &lt;= 0;&#xa;            encoder_previous_total_m2 &lt;= 0;&#xa;            encoder_previous_total_m3 &lt;= 0;&#xa;            encoder_previous_total_m4 &lt;= 0;&#xa;            measured_counts_m1        &lt;= 0;&#xa;            measured_counts_m2        &lt;= 0;&#xa;            measured_counts_m3        &lt;= 0;&#xa;            measured_counts_m4        &lt;= 0;&#xa;            pi_integral_m1             &lt;= 0;&#xa;            pi_integral_m2             &lt;= 0;&#xa;            pi_integral_m3             &lt;= 0;&#xa;            pi_integral_m4             &lt;= 0;&#xa;            pi_pwm_m1                  &lt;= 0;&#xa;            pi_pwm_m2                  &lt;= 0;&#xa;            pi_pwm_m3                  &lt;= 0;&#xa;            pi_pwm_m4                  &lt;= 0;&#xa;            stall_samples_m1           &lt;= 0;&#xa;            stall_samples_m2           &lt;= 0;&#xa;            stall_samples_m3           &lt;= 0;&#xa;            stall_samples_m4           &lt;= 0;&#xa;            encoder_fault              &lt;= 1'b0;&#xa;            telemetry_sequence         &lt;= 8'd0;&#xa;            pi_state                   &lt;= PI_IDLE;&#xa;            pi_motor_index             &lt;= 2'd0;&#xa;            encoder_delta_m1           &lt;= 0;&#xa;            encoder_delta_m2           &lt;= 0;&#xa;            encoder_delta_m3           &lt;= 0;&#xa;            encoder_delta_m4           &lt;= 0;&#xa;            pi_work_target             &lt;= 0;&#xa;            pi_work_measured           &lt;= 0;&#xa;            pi_work_integral_before    &lt;= 0;&#xa;            pi_work_integral           &lt;= 0;&#xa;            pi_integral_sum            &lt;= 0;&#xa;            pi_work_error              &lt;= 0;&#xa;            pi_scale_count             &lt;= 0;&#xa;            pi_target_remainder        &lt;= 0;&#xa;            pi_feedforward_remainder   &lt;= 0;&#xa;            pi_target_quotient         &lt;= 0;&#xa;            pi_feedforward_quotient    &lt;= 0;&#xa;            pi_gain_count              &lt;= 0;&#xa;            pi_gain_sum                &lt;= 0;&#xa;            pi_gain_quotient           &lt;= 0;&#xa;            pi_work_output             &lt;= 0;&#xa;        end else begin&#xa;            if (control_flags[2]) begin&#xa;                encoder_fault    &lt;= 1'b0;&#xa;                stall_samples_m1 &lt;= 0;&#xa;                stall_samples_m2 &lt;= 0;&#xa;                stall_samples_m3 &lt;= 0;&#xa;                stall_samples_m4 &lt;= 0;&#xa;                pi_integral_m1   &lt;= 0;&#xa;                pi_integral_m2   &lt;= 0;&#xa;                pi_integral_m3   &lt;= 0;&#xa;                pi_integral_m4   &lt;= 0;&#xa;                pi_pwm_m1        &lt;= 0;&#xa;                pi_pwm_m2        &lt;= 0;&#xa;                pi_pwm_m3        &lt;= 0;&#xa;                pi_pwm_m4        &lt;= 0;&#xa;                pi_state         &lt;= PI_IDLE;&#xa;                speed_sample_counter &lt;= 32'd0;&#xa;            end else if ((MOTOR_TEST_MODE != 0) || (!watchdog_alive) ||&#xa;                         control_flags[0] || encoder_fault ||&#xa;                         (MAPPING_CONFIGURED == 0)) begin&#xa;                speed_sample_counter &lt;= 32'd0;&#xa;                pi_state             &lt;= PI_IDLE;&#xa;                pi_integral_m1       &lt;= 0;&#xa;                pi_integral_m2       &lt;= 0;&#xa;                pi_integral_m3       &lt;= 0;&#xa;                pi_integral_m4       &lt;= 0;&#xa;                pi_pwm_m1            &lt;= 0;&#xa;                pi_pwm_m2            &lt;= 0;&#xa;                pi_pwm_m3            &lt;= 0;&#xa;                pi_pwm_m4            &lt;= 0;&#xa;                stall_samples_m1     &lt;= 0;&#xa;                stall_samples_m2     &lt;= 0;&#xa;                stall_samples_m3     &lt;= 0;&#xa;                stall_samples_m4     &lt;= 0;&#xa;            end else begin&#xa;                case (pi_state)&#xa;                    PI_IDLE: begin&#xa;                        if (speed_sample_counter >= (SPEED_SAMPLE_CYCLES - 1)) begin&#xa;                            speed_sample_counter &lt;= 32'd0;&#xa;                            encoder_delta_m1 &lt;= encoder_total_m1 - encoder_previous_total_m1;&#xa;                            encoder_delta_m2 &lt;= encoder_total_m2 - encoder_previous_total_m2;&#xa;                            encoder_delta_m3 &lt;= encoder_total_m3 - encoder_previous_total_m3;&#xa;                            encoder_delta_m4 &lt;= encoder_total_m4 - encoder_previous_total_m4;&#xa;                            encoder_previous_total_m1 &lt;= encoder_total_m1;&#xa;                            encoder_previous_total_m2 &lt;= encoder_total_m2;&#xa;                            encoder_previous_total_m3 &lt;= encoder_total_m3;&#xa;                            encoder_previous_total_m4 &lt;= encoder_total_m4;&#xa;                            pi_state &lt;= PI_ABS_DELTA;&#xa;                        end else begin&#xa;                            speed_sample_counter &lt;= speed_sample_counter + 1'b1;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_ABS_DELTA: begin&#xa;                        measured_counts_m1 &lt;= abs_integer(encoder_delta_m1);&#xa;                        measured_counts_m2 &lt;= abs_integer(encoder_delta_m2);&#xa;                        measured_counts_m3 &lt;= abs_integer(encoder_delta_m3);&#xa;                        measured_counts_m4 &lt;= abs_integer(encoder_delta_m4);&#xa;                        pi_motor_index &lt;= 2'd0;&#xa;                        pi_state &lt;= PI_LOAD;&#xa;                    end&#xa;&#xa;                    PI_LOAD: begin&#xa;                        pi_target_remainder      &lt;= 0;&#xa;                        pi_feedforward_remainder &lt;= 0;&#xa;                        pi_target_quotient       &lt;= 0;&#xa;                        pi_feedforward_quotient  &lt;= 0;&#xa;                        case (pi_motor_index)&#xa;                            2'd0: begin&#xa;                                pi_work_target &lt;= abs_integer(current_m1);&#xa;                                pi_scale_count &lt;= abs_integer(current_m1);&#xa;                                pi_work_measured &lt;= measured_counts_m1;&#xa;                                pi_work_integral_before &lt;= pi_integral_m1;&#xa;                            end&#xa;                            2'd1: begin&#xa;                                pi_work_target &lt;= abs_integer(current_m2);&#xa;                                pi_scale_count &lt;= abs_integer(current_m2);&#xa;                                pi_work_measured &lt;= measured_counts_m2;&#xa;                                pi_work_integral_before &lt;= pi_integral_m2;&#xa;                            end&#xa;                            2'd2: begin&#xa;                                pi_work_target &lt;= abs_integer(current_m3);&#xa;                                pi_scale_count &lt;= abs_integer(current_m3);&#xa;                                pi_work_measured &lt;= measured_counts_m3;&#xa;                                pi_work_integral_before &lt;= pi_integral_m3;&#xa;                            end&#xa;                            default: begin&#xa;                                pi_work_target &lt;= abs_integer(current_m4);&#xa;                                pi_scale_count &lt;= abs_integer(current_m4);&#xa;                                pi_work_measured &lt;= measured_counts_m4;&#xa;                                pi_work_integral_before &lt;= pi_integral_m4;&#xa;                            end&#xa;                        endcase&#xa;                        pi_state &lt;= PI_SCALE_ADD;&#xa;                    end&#xa;&#xa;                    PI_SCALE_ADD: begin&#xa;                        if (pi_scale_count > 0) begin&#xa;                            pi_target_remainder &lt;= pi_target_remainder + MAX_TARGET_COUNTS;&#xa;                            if (ENCODER_CLOSED_LOOP_ENABLE != 0)&#xa;                                pi_feedforward_remainder &lt;= pi_feedforward_remainder +&#xa;                                                            FEEDFORWARD_PWM_PERCENT;&#xa;                            else&#xa;                                pi_feedforward_remainder &lt;= pi_feedforward_remainder +&#xa;                                                            MAX_PWM_PERCENT;&#xa;                            pi_scale_count &lt;= pi_scale_count - 1;&#xa;                        end else begin&#xa;                            pi_state &lt;= PI_SCALE_DIV;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_SCALE_DIV: begin&#xa;                        if ((pi_target_remainder &lt; 100) &amp;&amp;&#xa;                            (pi_feedforward_remainder &lt; 100)) begin&#xa;                            if ((ENCODER_CLOSED_LOOP_ENABLE == 0) ||&#xa;                                (pi_work_target == 0)) begin&#xa;                                pi_work_integral &lt;= 0;&#xa;                                if (pi_work_target == 0)&#xa;                                    pi_work_output &lt;= 0;&#xa;                                else&#xa;                                    pi_work_output &lt;= pi_feedforward_quotient;&#xa;                                pi_state &lt;= PI_STORE;&#xa;                            end else begin&#xa;                                pi_work_error &lt;= pi_target_quotient - pi_work_measured;&#xa;                                pi_state &lt;= PI_INTEGRAL;&#xa;                            end&#xa;                        end else begin&#xa;                            if (pi_target_remainder >= 100) begin&#xa;                                pi_target_remainder &lt;= pi_target_remainder - 100;&#xa;                                pi_target_quotient  &lt;= pi_target_quotient + 1;&#xa;                            end&#xa;                            if (pi_feedforward_remainder >= 100) begin&#xa;                                pi_feedforward_remainder &lt;= pi_feedforward_remainder - 100;&#xa;                                pi_feedforward_quotient  &lt;= pi_feedforward_quotient + 1;&#xa;                            end&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_INTEGRAL: begin&#xa;                        pi_integral_sum &lt;= pi_work_integral_before + pi_work_error;&#xa;                        pi_state &lt;= PI_INTEGRAL_CLAMP;&#xa;                    end&#xa;&#xa;                    PI_INTEGRAL_CLAMP: begin&#xa;                        if (pi_integral_sum > PI_INTEGRAL_LIMIT)&#xa;                            pi_work_integral &lt;= PI_INTEGRAL_LIMIT;&#xa;                        else if (pi_integral_sum &lt; -PI_INTEGRAL_LIMIT)&#xa;                            pi_work_integral &lt;= -PI_INTEGRAL_LIMIT;&#xa;                        else&#xa;                            pi_work_integral &lt;= pi_integral_sum;&#xa;                        pi_gain_sum &lt;= 0;&#xa;                        pi_gain_count &lt;= abs_integer(pi_work_error);&#xa;                        pi_state &lt;= PI_KP_ADD;&#xa;                    end&#xa;&#xa;                    PI_KP_ADD: begin&#xa;                        if (pi_gain_count > 0) begin&#xa;                            if (pi_work_error &lt; 0)&#xa;                                pi_gain_sum &lt;= pi_gain_sum - PI_KP_NUM;&#xa;                            else&#xa;                                pi_gain_sum &lt;= pi_gain_sum + PI_KP_NUM;&#xa;                            pi_gain_count &lt;= pi_gain_count - 1;&#xa;                        end else begin&#xa;                            pi_gain_count &lt;= abs_integer(pi_work_integral);&#xa;                            pi_state &lt;= PI_KI_ADD;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_KI_ADD: begin&#xa;                        if (pi_gain_count > 0) begin&#xa;                            if (pi_work_integral &lt; 0)&#xa;                                pi_gain_sum &lt;= pi_gain_sum - PI_KI_NUM;&#xa;                            else&#xa;                                pi_gain_sum &lt;= pi_gain_sum + PI_KI_NUM;&#xa;                            pi_gain_count &lt;= pi_gain_count - 1;&#xa;                        end else begin&#xa;                            pi_gain_quotient &lt;= 0;&#xa;                            pi_state &lt;= PI_GAIN_DIVIDE;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_GAIN_DIVIDE: begin&#xa;                        if (pi_gain_sum &lt; 0)&#xa;                            pi_state &lt;= PI_GAIN_DIV_NEG;&#xa;                        else&#xa;                            pi_state &lt;= PI_GAIN_DIV_POS;&#xa;                    end&#xa;&#xa;                    PI_GAIN_DIV_POS: begin&#xa;                        if (pi_gain_sum >= PI_GAIN_DIV) begin&#xa;                            pi_gain_sum      &lt;= pi_gain_sum - PI_GAIN_DIV;&#xa;                            pi_gain_quotient &lt;= pi_gain_quotient + 1;&#xa;                        end else begin&#xa;                            pi_state &lt;= PI_OUTPUT;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_GAIN_DIV_NEG: begin&#xa;                        if (pi_gain_sum &lt;= -PI_GAIN_DIV) begin&#xa;                            pi_gain_sum      &lt;= pi_gain_sum + PI_GAIN_DIV;&#xa;                            pi_gain_quotient &lt;= pi_gain_quotient - 1;&#xa;                        end else begin&#xa;                            pi_state &lt;= PI_OUTPUT;&#xa;                        end&#xa;                    end&#xa;&#xa;                    PI_OUTPUT: begin&#xa;                        if ((pi_feedforward_quotient + pi_gain_quotient) >&#xa;                            MAX_PWM_PERCENT)&#xa;                            pi_work_output &lt;= MAX_PWM_PERCENT;&#xa;                        else if ((pi_feedforward_quotient + pi_gain_quotient) &lt; 0)&#xa;                            pi_work_output &lt;= 0;&#xa;                        else&#xa;                            pi_work_output &lt;= pi_feedforward_quotient +&#xa;                                              pi_gain_quotient;&#xa;                        pi_state &lt;= PI_STORE;&#xa;                    end&#xa;&#xa;                    PI_STORE: begin&#xa;                        case (pi_motor_index)&#xa;                            2'd0: begin&#xa;                                pi_integral_m1 &lt;= pi_work_integral;&#xa;                                pi_pwm_m1      &lt;= pi_work_output;&#xa;                                if ((pi_work_target >= STALL_MIN_TARGET_PERCENT) &amp;&amp;&#xa;                                    (pi_work_measured &lt;= STALL_MAX_COUNTS)) begin&#xa;                                    stall_samples_m1 &lt;= stall_samples_m1 + 1;&#xa;                                    if (stall_samples_m1 >= (STALL_SAMPLE_LIMIT - 1))&#xa;                                        encoder_fault &lt;= 1'b1;&#xa;                                end else&#xa;                                    stall_samples_m1 &lt;= 0;&#xa;                            end&#xa;                            2'd1: begin&#xa;                                pi_integral_m2 &lt;= pi_work_integral;&#xa;                                pi_pwm_m2      &lt;= pi_work_output;&#xa;                                if ((pi_work_target >= STALL_MIN_TARGET_PERCENT) &amp;&amp;&#xa;                                    (pi_work_measured &lt;= STALL_MAX_COUNTS)) begin&#xa;                                    stall_samples_m2 &lt;= stall_samples_m2 + 1;&#xa;                                    if (stall_samples_m2 >= (STALL_SAMPLE_LIMIT - 1))&#xa;                                        encoder_fault &lt;= 1'b1;&#xa;                                end else&#xa;                                    stall_samples_m2 &lt;= 0;&#xa;                            end&#xa;                            2'd2: begin&#xa;                                pi_integral_m3 &lt;= pi_work_integral;&#xa;                                pi_pwm_m3      &lt;= pi_work_output;&#xa;                                if ((pi_work_target >= STALL_MIN_TARGET_PERCENT) &amp;&amp;&#xa;                                    (pi_work_measured &lt;= STALL_MAX_COUNTS)) begin&#xa;                                    stall_samples_m3 &lt;= stall_samples_m3 + 1;&#xa;                                    if (stall_samples_m3 >= (STALL_SAMPLE_LIMIT - 1))&#xa;                                        encoder_fault &lt;= 1'b1;&#xa;                                end else&#xa;                                    stall_samples_m3 &lt;= 0;&#xa;                            end&#xa;                            default: begin&#xa;                                pi_integral_m4 &lt;= pi_work_integral;&#xa;                                pi_pwm_m4      &lt;= pi_work_output;&#xa;                                if ((pi_work_target >= STALL_MIN_TARGET_PERCENT) &amp;&amp;&#xa;                                    (pi_work_measured &lt;= STALL_MAX_COUNTS)) begin&#xa;                                    stall_samples_m4 &lt;= stall_samples_m4 + 1;&#xa;                                    if (stall_samples_m4 >= (STALL_SAMPLE_LIMIT - 1))&#xa;                                        encoder_fault &lt;= 1'b1;&#xa;                                end else&#xa;                                    stall_samples_m4 &lt;= 0;&#xa;                            end&#xa;                        endcase&#xa;&#xa;                        if (pi_motor_index == 2'd3) begin&#xa;                            telemetry_sequence &lt;= telemetry_sequence + 1'b1;&#xa;                            pi_state &lt;= PI_IDLE;&#xa;                        end else begin&#xa;                            pi_motor_index &lt;= pi_motor_index + 1'b1;&#xa;                            pi_state &lt;= PI_LOAD;&#xa;                        end&#xa;                    end&#xa;&#xa;                    default: pi_state &lt;= PI_IDLE;&#xa;                endcase&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // UART 接收输入两级同步。&#xa;    // -------------------------------------------------------------------------&#xa;    reg uart_rx_meta;&#xa;    reg uart_rx_sync;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_rx_meta &lt;= 1'b1;&#xa;            uart_rx_sync &lt;= 1'b1;&#xa;        end else begin&#xa;            uart_rx_meta &lt;= H2_2_UART_RX;&#xa;            uart_rx_sync &lt;= uart_rx_meta;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 分数累加器产生 16 倍波特率采样使能。&#xa;    // 默认参数下平均采样频率严格为 1,843,200 Hz，不依赖 434 的粗略整除。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] uart_phase_accumulator;&#xa;    reg        uart_x16_tick;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_phase_accumulator &lt;= 32'd0;&#xa;            uart_x16_tick          &lt;= 1'b0;&#xa;        end else begin&#xa;            if (uart_phase_accumulator >= (CLK_FREQ - UART_X16_FREQ)) begin&#xa;                uart_phase_accumulator &lt;= uart_phase_accumulator&#xa;                                          + UART_X16_FREQ - CLK_FREQ;&#xa;                uart_x16_tick          &lt;= 1'b1;&#xa;            end else begin&#xa;                uart_phase_accumulator &lt;= uart_phase_accumulator + UART_X16_FREQ;&#xa;                uart_x16_tick          &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // UART 115200 8N1 接收状态机：起始位中点确认、数据位中心采样、停止位检查。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [2:0]  uart_state;&#xa;    reg [4:0]  uart_subtick_count;&#xa;    reg [2:0]  uart_bit_index;&#xa;    reg [7:0]  uart_shift_register;&#xa;    reg [7:0]  uart_byte;&#xa;    reg        uart_byte_valid;&#xa;    reg [31:0] uart_framing_error_count;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            uart_state               &lt;= UART_IDLE;&#xa;            uart_subtick_count       &lt;= 5'd0;&#xa;            uart_bit_index           &lt;= 3'd0;&#xa;            uart_shift_register      &lt;= 8'd0;&#xa;            uart_byte                &lt;= 8'd0;&#xa;            uart_byte_valid          &lt;= 1'b0;&#xa;            uart_framing_error_count &lt;= 32'd0;&#xa;        end else begin&#xa;            uart_byte_valid &lt;= 1'b0;&#xa;&#xa;            case (uart_state)&#xa;                UART_IDLE: begin&#xa;                    uart_subtick_count &lt;= 5'd0;&#xa;                    uart_bit_index     &lt;= 3'd0;&#xa;                    if (uart_rx_sync == 1'b0)&#xa;                        uart_state &lt;= UART_START;&#xa;                end&#xa;&#xa;                UART_START: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd7) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            if (uart_rx_sync == 1'b0) begin&#xa;                                uart_state     &lt;= UART_DATA;&#xa;                                uart_bit_index &lt;= 3'd0;&#xa;                            end else begin&#xa;                                uart_state &lt;= UART_IDLE;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_DATA: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_shift_register[uart_bit_index] &lt;= uart_rx_sync;&#xa;                            if (uart_bit_index == 3'd7) begin&#xa;                                uart_bit_index &lt;= 3'd0;&#xa;                                uart_state     &lt;= UART_STOP;&#xa;                            end else begin&#xa;                                uart_bit_index &lt;= uart_bit_index + 1'b1;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_STOP: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_state         &lt;= UART_IDLE;&#xa;                            if (uart_rx_sync == 1'b1) begin&#xa;                                uart_byte       &lt;= uart_shift_register;&#xa;                                uart_byte_valid &lt;= 1'b1;&#xa;                            end else begin&#xa;                                uart_framing_error_count &lt;= uart_framing_error_count + 1'b1;&#xa;                                // 错误停止位后不能立刻把持续低电平当作新起始位。&#xa;                                // 先等待一整个 bit 的空闲高电平，再恢复到 IDLE。&#xa;                                uart_state &lt;= UART_RECOVER;&#xa;                            end&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                UART_RECOVER: begin&#xa;                    if (uart_x16_tick) begin&#xa;                        if (uart_rx_sync == 1'b0) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                        end else if (uart_subtick_count == 5'd15) begin&#xa;                            uart_subtick_count &lt;= 5'd0;&#xa;                            uart_state         &lt;= UART_IDLE;&#xa;                        end else begin&#xa;                            uart_subtick_count &lt;= uart_subtick_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                default: begin&#xa;                    uart_state         &lt;= UART_IDLE;&#xa;                    uart_subtick_count &lt;= 5'd0;&#xa;                    uart_bit_index     &lt;= 3'd0;&#xa;                end&#xa;            endcase&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 6 字节二进制控制帧解析。&#xa;    // AA, X+100, Y+100, R+100, FLAGS, CHECKSUM。&#xa;    // 赛车模式中X保留但忽略；FLAGS bit0=急停，bit1=急弯，bit2=清编码器故障。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [2:0]  frame_state;&#xa;    reg [7:0]  frame_x_byte;&#xa;    reg [7:0]  frame_y_byte;&#xa;    reg [7:0]  frame_r_byte;&#xa;    reg [7:0]  frame_flags_byte;&#xa;    reg [7:0]  frame_checksum;&#xa;    reg [7:0]  received_x_byte;&#xa;    reg [7:0]  received_y_byte;&#xa;    reg [7:0]  received_r_byte;&#xa;    reg [7:0]  received_flags_byte;&#xa;    reg        frame_valid;&#xa;    reg [31:0] valid_frame_count;&#xa;    reg [31:0] invalid_frame_count;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            frame_state         &lt;= FRAME_SEARCH;&#xa;            frame_x_byte        &lt;= 8'd0;&#xa;            frame_y_byte        &lt;= 8'd0;&#xa;            frame_r_byte        &lt;= 8'd0;&#xa;            frame_flags_byte    &lt;= 8'd0;&#xa;            frame_checksum      &lt;= 8'd0;&#xa;            received_x_byte     &lt;= 8'd100;&#xa;            received_y_byte     &lt;= 8'd100;&#xa;            received_r_byte     &lt;= 8'd100;&#xa;            received_flags_byte &lt;= 8'd0;&#xa;            frame_valid         &lt;= 1'b0;&#xa;            valid_frame_count   &lt;= 32'd0;&#xa;            invalid_frame_count &lt;= 32'd0;&#xa;        end else begin&#xa;            frame_valid &lt;= 1'b0;&#xa;&#xa;            if (uart_byte_valid) begin&#xa;                case (frame_state)&#xa;                    FRAME_SEARCH: begin&#xa;                        if (uart_byte == 8'hAA) begin&#xa;                            frame_checksum &lt;= 8'hAA;&#xa;                            frame_state    &lt;= FRAME_X;&#xa;                        end&#xa;                    end&#xa;&#xa;                    FRAME_X: begin&#xa;                        frame_x_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_Y;&#xa;                    end&#xa;&#xa;                    FRAME_Y: begin&#xa;                        frame_y_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_R;&#xa;                    end&#xa;&#xa;                    FRAME_R: begin&#xa;                        frame_r_byte   &lt;= uart_byte;&#xa;                        frame_checksum &lt;= frame_checksum + uart_byte;&#xa;                        frame_state    &lt;= FRAME_FLAGS;&#xa;                    end&#xa;&#xa;                    FRAME_FLAGS: begin&#xa;                        frame_flags_byte &lt;= uart_byte;&#xa;                        frame_checksum   &lt;= frame_checksum + uart_byte;&#xa;                        frame_state      &lt;= FRAME_CHECK;&#xa;                    end&#xa;&#xa;                    FRAME_CHECK: begin&#xa;                        frame_state &lt;= FRAME_SEARCH;&#xa;                        if ((frame_x_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (frame_y_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (frame_r_byte &lt;= 8'd200) &amp;&amp;&#xa;                            (uart_byte == frame_checksum)) begin&#xa;                            received_x_byte     &lt;= frame_x_byte;&#xa;                            received_y_byte     &lt;= frame_y_byte;&#xa;                            received_r_byte     &lt;= frame_r_byte;&#xa;                            received_flags_byte &lt;= frame_flags_byte;&#xa;                            frame_valid         &lt;= 1'b1;&#xa;                            valid_frame_count   &lt;= valid_frame_count + 1'b1;&#xa;                        end else begin&#xa;                            invalid_frame_count &lt;= invalid_frame_count + 1'b1;&#xa;                        end&#xa;                    end&#xa;&#xa;                    default: begin&#xa;                        frame_state &lt;= FRAME_SEARCH;&#xa;                    end&#xa;                endcase&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 合法帧命令寄存与 200 ms watchdog。&#xa;    // 只有 frame_valid 才喂狗；急停帧把三轴立即清零并保留急停标志。&#xa;    // -------------------------------------------------------------------------&#xa;    integer joystick_x;&#xa;    integer joystick_y;&#xa;    integer joystick_r;&#xa;    reg [31:0] watchdog_counter;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            joystick_x      &lt;= 0;&#xa;            joystick_y      &lt;= 0;&#xa;            joystick_r      &lt;= 0;&#xa;            control_flags   &lt;= 8'd0;&#xa;            watchdog_counter&lt;= 32'd0;&#xa;            watchdog_alive  &lt;= 1'b0;&#xa;        end else if (frame_valid) begin&#xa;            watchdog_counter &lt;= 32'd0;&#xa;            watchdog_alive   &lt;= 1'b1;&#xa;            control_flags    &lt;= received_flags_byte;&#xa;            if (received_flags_byte[0]) begin&#xa;                joystick_x &lt;= 0;&#xa;                joystick_y &lt;= 0;&#xa;                joystick_r &lt;= 0;&#xa;            end else begin&#xa;                // 赛车模式明确禁止二维横移，兼容接收X字节但强制忽略。&#xa;                joystick_x &lt;= 0;&#xa;                joystick_y &lt;= received_y_byte - 100;&#xa;                joystick_r &lt;= received_r_byte - 100;&#xa;            end&#xa;        end else if (watchdog_alive) begin&#xa;            if (watchdog_counter >= (WATCHDOG_CYCLES - 1)) begin&#xa;                watchdog_counter &lt;= watchdog_counter;&#xa;                watchdog_alive   &lt;= 1'b0;&#xa;                joystick_x       &lt;= 0;&#xa;                joystick_y       &lt;= 0;&#xa;                joystick_r       &lt;= 0;&#xa;                control_flags    &lt;= 8'd0;&#xa;            end else begin&#xa;                watchdog_counter &lt;= watchdog_counter + 1'b1;&#xa;            end&#xa;        end else begin&#xa;            watchdog_counter &lt;= 32'd0;&#xa;            watchdog_alive   &lt;= 1'b0;&#xa;            joystick_x       &lt;= 0;&#xa;            joystick_y       &lt;= 0;&#xa;            joystick_r       &lt;= 0;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 1 kHz 控制使能和 20 kHz、100级百分比 PWM 载波。&#xa;    // 分数累加器产生 PWM_FREQ*100 的百分比步进，不再在输出路径中做乘除法。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] control_counter;&#xa;    reg        control_tick;&#xa;    reg [31:0] pwm_phase_accumulator;&#xa;    reg [6:0]  pwm_percent_counter;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            control_counter &lt;= 32'd0;&#xa;            control_tick    &lt;= 1'b0;&#xa;        end else begin&#xa;            if (control_counter >= (CONTROL_DIV - 1)) begin&#xa;                control_counter &lt;= 32'd0;&#xa;                control_tick    &lt;= 1'b1;&#xa;            end else begin&#xa;                control_counter &lt;= control_counter + 1'b1;&#xa;                control_tick    &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            pwm_phase_accumulator &lt;= 32'd0;&#xa;            pwm_percent_counter   &lt;= 7'd0;&#xa;        end else begin&#xa;            if (pwm_phase_accumulator >=&#xa;                (CLK_FREQ - PWM_PERCENT_TICK_FREQ)) begin&#xa;                pwm_phase_accumulator &lt;= pwm_phase_accumulator +&#xa;                                         PWM_PERCENT_TICK_FREQ - CLK_FREQ;&#xa;                if (pwm_percent_counter == 7'd99)&#xa;                    pwm_percent_counter &lt;= 7'd0;&#xa;                else&#xa;                    pwm_percent_counter &lt;= pwm_percent_counter + 1'b1;&#xa;            end else begin&#xa;                pwm_phase_accumulator &lt;= pwm_phase_accumulator +&#xa;                                         PWM_PERCENT_TICK_FREQ;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 四路AB相输入各自两级同步，随后用Gray状态转移表进行x4解码。&#xa;    // 自由运行总计数只在本块驱动；测速块通过相邻快照相减，不产生多驱动。&#xa;    // -------------------------------------------------------------------------&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            m1_a_meta &lt;= 1'b0; m1_a_sync &lt;= 1'b0;&#xa;            m1_b_meta &lt;= 1'b0; m1_b_sync &lt;= 1'b0;&#xa;            m2_a_meta &lt;= 1'b0; m2_a_sync &lt;= 1'b0;&#xa;            m2_b_meta &lt;= 1'b0; m2_b_sync &lt;= 1'b0;&#xa;            m3_a_meta &lt;= 1'b0; m3_a_sync &lt;= 1'b0;&#xa;            m3_b_meta &lt;= 1'b0; m3_b_sync &lt;= 1'b0;&#xa;            m4_a_meta &lt;= 1'b0; m4_a_sync &lt;= 1'b0;&#xa;            m4_b_meta &lt;= 1'b0; m4_b_sync &lt;= 1'b0;&#xa;        end else begin&#xa;            m1_a_meta &lt;= M1_A; m1_a_sync &lt;= m1_a_meta;&#xa;            m1_b_meta &lt;= M1_B; m1_b_sync &lt;= m1_b_meta;&#xa;            m2_a_meta &lt;= M2_A; m2_a_sync &lt;= m2_a_meta;&#xa;            m2_b_meta &lt;= M2_B; m2_b_sync &lt;= m2_b_meta;&#xa;            m3_a_meta &lt;= M3_A; m3_a_sync &lt;= m3_a_meta;&#xa;            m3_b_meta &lt;= M3_B; m3_b_sync &lt;= m3_b_meta;&#xa;            m4_a_meta &lt;= M4_A; m4_a_sync &lt;= m4_a_meta;&#xa;            m4_b_meta &lt;= M4_B; m4_b_sync &lt;= m4_b_meta;&#xa;        end&#xa;    end&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            encoder_prev_m1    &lt;= 2'b00;&#xa;            encoder_prev_m2    &lt;= 2'b00;&#xa;            encoder_prev_m3    &lt;= 2'b00;&#xa;            encoder_prev_m4    &lt;= 2'b00;&#xa;            encoder_total_m1   &lt;= 0;&#xa;            encoder_total_m2   &lt;= 0;&#xa;            encoder_total_m3   &lt;= 0;&#xa;            encoder_total_m4   &lt;= 0;&#xa;            encoder_invalid_m1 &lt;= 0;&#xa;            encoder_invalid_m2 &lt;= 0;&#xa;            encoder_invalid_m3 &lt;= 0;&#xa;            encoder_invalid_m4 &lt;= 0;&#xa;        end else begin&#xa;            encoder_total_m1 &lt;= encoder_total_m1 +&#xa;                quadrature_step(encoder_prev_m1, {m1_a_sync, m1_b_sync});&#xa;            encoder_total_m2 &lt;= encoder_total_m2 +&#xa;                quadrature_step(encoder_prev_m2, {m2_a_sync, m2_b_sync});&#xa;            encoder_total_m3 &lt;= encoder_total_m3 +&#xa;                quadrature_step(encoder_prev_m3, {m3_a_sync, m3_b_sync});&#xa;            encoder_total_m4 &lt;= encoder_total_m4 +&#xa;                quadrature_step(encoder_prev_m4, {m4_a_sync, m4_b_sync});&#xa;&#xa;            if ((encoder_prev_m1 != {m1_a_sync, m1_b_sync}) &amp;&amp;&#xa;                (quadrature_step(encoder_prev_m1, {m1_a_sync, m1_b_sync}) == 0))&#xa;                encoder_invalid_m1 &lt;= encoder_invalid_m1 + 1;&#xa;            if ((encoder_prev_m2 != {m2_a_sync, m2_b_sync}) &amp;&amp;&#xa;                (quadrature_step(encoder_prev_m2, {m2_a_sync, m2_b_sync}) == 0))&#xa;                encoder_invalid_m2 &lt;= encoder_invalid_m2 + 1;&#xa;            if ((encoder_prev_m3 != {m3_a_sync, m3_b_sync}) &amp;&amp;&#xa;                (quadrature_step(encoder_prev_m3, {m3_a_sync, m3_b_sync}) == 0))&#xa;                encoder_invalid_m3 &lt;= encoder_invalid_m3 + 1;&#xa;            if ((encoder_prev_m4 != {m4_a_sync, m4_b_sync}) &amp;&amp;&#xa;                (quadrature_step(encoder_prev_m4, {m4_a_sync, m4_b_sync}) == 0))&#xa;                encoder_invalid_m4 &lt;= encoder_invalid_m4 + 1;&#xa;&#xa;            encoder_prev_m1 &lt;= {m1_a_sync, m1_b_sync};&#xa;            encoder_prev_m2 &lt;= {m2_a_sync, m2_b_sync};&#xa;            encoder_prev_m3 &lt;= {m3_a_sync, m3_b_sync};&#xa;            encoder_prev_m4 &lt;= {m4_a_sync, m4_b_sync};&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 赛车式轮速混合：每个 1 kHz control_tick 捕获一次新命令。&#xa;    // 急转百分比缩放、混合、最大值和归一化均分拍执行，避免单拍内重复展开&#xa;    // 多个函数和乘除法。最坏执行时间仍远小于 1 ms 控制周期。&#xa;    // -------------------------------------------------------------------------&#xa;    localparam [3:0] NORM_IDLE       = 4'd0;&#xa;    localparam [3:0] NORM_QUICK_ADD  = 4'd1;&#xa;    localparam [3:0] NORM_QUICK_DIV  = 4'd2;&#xa;    localparam [3:0] NORM_MIX        = 4'd3;&#xa;    localparam [3:0] NORM_MAX        = 4'd4;&#xa;    localparam [3:0] NORM_DIVIDE     = 4'd5;&#xa;    localparam [3:0] NORM_MAP        = 4'd6;&#xa;    localparam [3:0] NORM_MAX_DECIDE = 4'd7;&#xa;&#xa;    integer raw_fl;&#xa;    integer raw_fr;&#xa;    integer raw_rl;&#xa;    integer raw_rr;&#xa;    integer max_abs_value;&#xa;    integer wheel_fl;&#xa;    integer wheel_fr;&#xa;    integer wheel_rl;&#xa;    integer wheel_rr;&#xa;    integer target_m1;&#xa;    integer target_m2;&#xa;    integer target_m3;&#xa;    integer target_m4;&#xa;    integer dead_m1;&#xa;    integer dead_m2;&#xa;    integer dead_m3;&#xa;    integer dead_m4;&#xa;    reg [3:0] norm_state;&#xa;    integer mix_throttle;&#xa;    integer mix_steer;&#xa;    integer quick_count_y;&#xa;    integer quick_count_r;&#xa;    integer quick_remainder_y;&#xa;    integer quick_remainder_r;&#xa;    integer quick_quotient_y;&#xa;    integer quick_quotient_r;&#xa;    reg quick_negative_y;&#xa;    reg quick_negative_r;&#xa;    // 归一化中间量始终非负且上限为20000，使用窄位宽降低比较器深度。&#xa;    reg [15:0] norm_divisor;&#xa;    reg [15:0] norm_remainder_fl;&#xa;    reg [15:0] norm_remainder_fr;&#xa;    reg [15:0] norm_remainder_rl;&#xa;    reg [15:0] norm_remainder_rr;&#xa;    reg [15:0] norm_quotient_fl;&#xa;    reg [15:0] norm_quotient_fr;&#xa;    reg [15:0] norm_quotient_rl;&#xa;    reg [15:0] norm_quotient_rr;&#xa;    reg [1:0] norm_divide_index;&#xa;    reg       norm_round_active;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            mix_throttle      &lt;= 0;&#xa;            mix_steer         &lt;= 0;&#xa;            quick_count_y     &lt;= 0;&#xa;            quick_count_r     &lt;= 0;&#xa;            quick_remainder_y &lt;= 0;&#xa;            quick_remainder_r &lt;= 0;&#xa;            quick_quotient_y  &lt;= 0;&#xa;            quick_quotient_r  &lt;= 0;&#xa;            quick_negative_y  &lt;= 1'b0;&#xa;            quick_negative_r  &lt;= 1'b0;&#xa;            norm_divide_index &lt;= 2'd0;&#xa;            norm_round_active &lt;= 1'b0;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            mix_throttle      &lt;= 0;&#xa;            mix_steer         &lt;= 0;&#xa;            quick_count_y     &lt;= 0;&#xa;            quick_count_r     &lt;= 0;&#xa;            quick_remainder_y &lt;= 0;&#xa;            quick_remainder_r &lt;= 0;&#xa;            quick_quotient_y  &lt;= 0;&#xa;            quick_quotient_r  &lt;= 0;&#xa;            quick_negative_y  &lt;= 1'b0;&#xa;            quick_negative_r  &lt;= 1'b0;&#xa;            norm_divide_index &lt;= 2'd0;&#xa;            norm_round_active &lt;= 1'b0;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else if ((!watchdog_alive) || control_flags[0] || encoder_fault ||&#xa;                     (MAPPING_CONFIGURED == 0)) begin&#xa;            raw_fl            &lt;= 0;&#xa;            raw_fr            &lt;= 0;&#xa;            raw_rl            &lt;= 0;&#xa;            raw_rr            &lt;= 0;&#xa;            max_abs_value     &lt;= 0;&#xa;            wheel_fl          &lt;= 0;&#xa;            wheel_fr          &lt;= 0;&#xa;            wheel_rl          &lt;= 0;&#xa;            wheel_rr          &lt;= 0;&#xa;            target_m1         &lt;= 0;&#xa;            target_m2         &lt;= 0;&#xa;            target_m3         &lt;= 0;&#xa;            target_m4         &lt;= 0;&#xa;            norm_state        &lt;= NORM_IDLE;&#xa;            mix_throttle      &lt;= 0;&#xa;            mix_steer         &lt;= 0;&#xa;            quick_count_y     &lt;= 0;&#xa;            quick_count_r     &lt;= 0;&#xa;            quick_remainder_y &lt;= 0;&#xa;            quick_remainder_r &lt;= 0;&#xa;            quick_quotient_y  &lt;= 0;&#xa;            quick_quotient_r  &lt;= 0;&#xa;            quick_negative_y  &lt;= 1'b0;&#xa;            quick_negative_r  &lt;= 1'b0;&#xa;            norm_divide_index &lt;= 2'd0;&#xa;            norm_round_active &lt;= 1'b0;&#xa;            norm_divisor      &lt;= 0;&#xa;            norm_remainder_fl &lt;= 0;&#xa;            norm_remainder_fr &lt;= 0;&#xa;            norm_remainder_rl &lt;= 0;&#xa;            norm_remainder_rr &lt;= 0;&#xa;            norm_quotient_fl  &lt;= 0;&#xa;            norm_quotient_fr  &lt;= 0;&#xa;            norm_quotient_rl  &lt;= 0;&#xa;            norm_quotient_rr  &lt;= 0;&#xa;        end else begin&#xa;            // 原始矢量、统一归一化和轮位映射状态机。&#xa;            case (norm_state)&#xa;                NORM_IDLE: begin&#xa;                    if (control_tick) begin&#xa;                        // X被明确忽略。急弯缩放改为逐拍累加和除100。&#xa;                        if (control_flags[1]) begin&#xa;                            quick_count_y &lt;= abs_integer(joystick_y);&#xa;                            quick_count_r &lt;= abs_integer(joystick_r);&#xa;                            quick_remainder_y &lt;= 0;&#xa;                            quick_remainder_r &lt;= 0;&#xa;                            quick_quotient_y &lt;= 0;&#xa;                            quick_quotient_r &lt;= 0;&#xa;                            quick_negative_y &lt;= (joystick_y &lt; 0);&#xa;                            quick_negative_r &lt;= (joystick_r &lt; 0);&#xa;                            norm_state &lt;= NORM_QUICK_ADD;&#xa;                        end else begin&#xa;                            mix_throttle &lt;= joystick_y;&#xa;                            mix_steer &lt;= joystick_r;&#xa;                            norm_state &lt;= NORM_MIX;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_QUICK_ADD: begin&#xa;                    if ((quick_count_y == 0) &amp;&amp; (quick_count_r == 0)) begin&#xa;                        norm_state &lt;= NORM_QUICK_DIV;&#xa;                    end else begin&#xa;                        if (quick_count_y > 0) begin&#xa;                            quick_remainder_y &lt;= quick_remainder_y +&#xa;                                                 QUICK_TURN_THROTTLE_PERCENT;&#xa;                            quick_count_y &lt;= quick_count_y - 1;&#xa;                        end&#xa;                        if (quick_count_r > 0) begin&#xa;                            quick_remainder_r &lt;= quick_remainder_r +&#xa;                                                 QUICK_TURN_STEER_PERCENT;&#xa;                            quick_count_r &lt;= quick_count_r - 1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_QUICK_DIV: begin&#xa;                    if ((quick_remainder_y &lt; 100) &amp;&amp;&#xa;                        (quick_remainder_r &lt; 100)) begin&#xa;                        if (quick_negative_y)&#xa;                            mix_throttle &lt;= -quick_quotient_y;&#xa;                        else&#xa;                            mix_throttle &lt;= quick_quotient_y;&#xa;&#xa;                        if (quick_quotient_r > 100) begin&#xa;                            if (quick_negative_r)&#xa;                                mix_steer &lt;= -100;&#xa;                            else&#xa;                                mix_steer &lt;= 100;&#xa;                        end else if (quick_negative_r) begin&#xa;                            mix_steer &lt;= -quick_quotient_r;&#xa;                        end else begin&#xa;                            mix_steer &lt;= quick_quotient_r;&#xa;                        end&#xa;                        norm_state &lt;= NORM_MIX;&#xa;                    end else begin&#xa;                        if (quick_remainder_y >= 100) begin&#xa;                            quick_remainder_y &lt;= quick_remainder_y - 100;&#xa;                            quick_quotient_y &lt;= quick_quotient_y + 1;&#xa;                        end&#xa;                        if (quick_remainder_r >= 100) begin&#xa;                            quick_remainder_r &lt;= quick_remainder_r - 100;&#xa;                            quick_quotient_r &lt;= quick_quotient_r + 1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_MIX: begin&#xa;                    raw_fl &lt;= mix_throttle + mix_steer;&#xa;                    raw_fr &lt;= mix_throttle - mix_steer;&#xa;                    raw_rl &lt;= mix_throttle + mix_steer;&#xa;                    raw_rr &lt;= mix_throttle - mix_steer;&#xa;                    norm_state &lt;= NORM_MAX;&#xa;                end&#xa;&#xa;                NORM_MAX: begin&#xa;                    max_abs_value &lt;= max4_abs(raw_fl, raw_fr, raw_rl, raw_rr);&#xa;                    norm_state &lt;= NORM_MAX_DECIDE;&#xa;                end&#xa;&#xa;                NORM_MAX_DECIDE: begin&#xa;                    if (max_abs_value > 100) begin&#xa;                        norm_divisor &lt;= max_abs_value;&#xa;                        norm_remainder_fl &lt;= (abs_integer(raw_fl) &lt;&lt; 6) +&#xa;                                             (abs_integer(raw_fl) &lt;&lt; 5) +&#xa;                                             (abs_integer(raw_fl) &lt;&lt; 2);&#xa;                        norm_remainder_fr &lt;= (abs_integer(raw_fr) &lt;&lt; 6) +&#xa;                                             (abs_integer(raw_fr) &lt;&lt; 5) +&#xa;                                             (abs_integer(raw_fr) &lt;&lt; 2);&#xa;                        norm_remainder_rl &lt;= (abs_integer(raw_rl) &lt;&lt; 6) +&#xa;                                             (abs_integer(raw_rl) &lt;&lt; 5) +&#xa;                                             (abs_integer(raw_rl) &lt;&lt; 2);&#xa;                        norm_remainder_rr &lt;= (abs_integer(raw_rr) &lt;&lt; 6) +&#xa;                                             (abs_integer(raw_rr) &lt;&lt; 5) +&#xa;                                             (abs_integer(raw_rr) &lt;&lt; 2);&#xa;                        norm_quotient_fl &lt;= 0;&#xa;                        norm_quotient_fr &lt;= 0;&#xa;                        norm_quotient_rl &lt;= 0;&#xa;                        norm_quotient_rr &lt;= 0;&#xa;                        norm_divide_index &lt;= 2'd0;&#xa;                        norm_round_active &lt;= 1'b0;&#xa;                        norm_state &lt;= NORM_DIVIDE;&#xa;                    end else begin&#xa;                        wheel_fl &lt;= raw_fl;&#xa;                        wheel_fr &lt;= raw_fr;&#xa;                        wheel_rl &lt;= raw_rl;&#xa;                        wheel_rr &lt;= raw_rr;&#xa;                        norm_divisor &lt;= 0;&#xa;                        norm_remainder_fl &lt;= 0;&#xa;                        norm_remainder_fr &lt;= 0;&#xa;                        norm_remainder_rl &lt;= 0;&#xa;                        norm_remainder_rr &lt;= 0;&#xa;                        norm_quotient_fl &lt;= 0;&#xa;                        norm_quotient_fr &lt;= 0;&#xa;                        norm_quotient_rl &lt;= 0;&#xa;                        norm_quotient_rr &lt;= 0;&#xa;                        norm_state &lt;= NORM_MAP;&#xa;                    end&#xa;                end&#xa;&#xa;                NORM_DIVIDE: begin&#xa;                    case (norm_divide_index)&#xa;                        2'd0: begin&#xa;                            if (norm_remainder_fl >= norm_divisor) begin&#xa;                                norm_remainder_fl &lt;= norm_remainder_fl - norm_divisor;&#xa;                                norm_quotient_fl  &lt;= norm_quotient_fl + 1;&#xa;                                norm_round_active &lt;= 1'b1;&#xa;                            end&#xa;                            norm_divide_index &lt;= 2'd1;&#xa;                        end&#xa;                        2'd1: begin&#xa;                            if (norm_remainder_fr >= norm_divisor) begin&#xa;                                norm_remainder_fr &lt;= norm_remainder_fr - norm_divisor;&#xa;                                norm_quotient_fr  &lt;= norm_quotient_fr + 1;&#xa;                                norm_round_active &lt;= 1'b1;&#xa;                            end&#xa;                            norm_divide_index &lt;= 2'd2;&#xa;                        end&#xa;                        2'd2: begin&#xa;                            if (norm_remainder_rl >= norm_divisor) begin&#xa;                                norm_remainder_rl &lt;= norm_remainder_rl - norm_divisor;&#xa;                                norm_quotient_rl  &lt;= norm_quotient_rl + 1;&#xa;                                norm_round_active &lt;= 1'b1;&#xa;                            end&#xa;                            norm_divide_index &lt;= 2'd3;&#xa;                        end&#xa;                        default: begin&#xa;                            if (norm_remainder_rr >= norm_divisor) begin&#xa;                                norm_remainder_rr &lt;= norm_remainder_rr - norm_divisor;&#xa;                                norm_quotient_rr  &lt;= norm_quotient_rr + 1;&#xa;                            end&#xa;&#xa;                            if (norm_round_active ||&#xa;                                (norm_remainder_rr >= norm_divisor)) begin&#xa;                                norm_divide_index &lt;= 2'd0;&#xa;                                norm_round_active &lt;= 1'b0;&#xa;                            end else begin&#xa;                                if (raw_fl &lt; 0)&#xa;                                    wheel_fl &lt;= -norm_quotient_fl;&#xa;                                else&#xa;                                    wheel_fl &lt;= norm_quotient_fl;&#xa;                                if (raw_fr &lt; 0)&#xa;                                    wheel_fr &lt;= -norm_quotient_fr;&#xa;                                else&#xa;                                    wheel_fr &lt;= norm_quotient_fr;&#xa;                                if (raw_rl &lt; 0)&#xa;                                    wheel_rl &lt;= -norm_quotient_rl;&#xa;                                else&#xa;                                    wheel_rl &lt;= norm_quotient_rl;&#xa;                                if (raw_rr &lt; 0)&#xa;                                    wheel_rr &lt;= -norm_quotient_rr;&#xa;                                else&#xa;                                    wheel_rr &lt;= norm_quotient_rr;&#xa;                                norm_state &lt;= NORM_MAP;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;&#xa;                NORM_MAP: begin&#xa;                    if (M1_INVERT != 0)&#xa;                        target_m1 &lt;= -select_wheel(M1_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m1 &lt;=  select_wheel(M1_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M2_INVERT != 0)&#xa;                        target_m2 &lt;= -select_wheel(M2_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m2 &lt;=  select_wheel(M2_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M3_INVERT != 0)&#xa;                        target_m3 &lt;= -select_wheel(M3_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m3 &lt;=  select_wheel(M3_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    if (M4_INVERT != 0)&#xa;                        target_m4 &lt;= -select_wheel(M4_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    else&#xa;                        target_m4 &lt;=  select_wheel(M4_WHEEL, wheel_fl, wheel_fr, wheel_rl, wheel_rr);&#xa;                    norm_state &lt;= NORM_IDLE;&#xa;                end&#xa;&#xa;                default: begin&#xa;                    norm_state &lt;= NORM_IDLE;&#xa;                end&#xa;            endcase&#xa;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 四路斜坡和换向保护状态机。&#xa;    // 每个 1 ms tick 后依次处理四个电机，每拍只做一种判断或一次加减。&#xa;    // -------------------------------------------------------------------------&#xa;    localparam [2:0] SLEW_IDLE   = 3'd0;&#xa;    localparam [2:0] SLEW_LOAD   = 3'd1;&#xa;    localparam [2:0] SLEW_DECIDE = 3'd2;&#xa;    localparam [2:0] SLEW_APPLY  = 3'd3;&#xa;    localparam [2:0] SLEW_STORE  = 3'd4;&#xa;&#xa;    reg [2:0] slew_state;&#xa;    reg [1:0] slew_motor_index;&#xa;    reg       slew_add_direction;&#xa;    integer slew_work_current;&#xa;    integer slew_work_target;&#xa;    integer slew_work_dead;&#xa;    integer slew_work_step;&#xa;    integer slew_result_current;&#xa;    integer slew_result_dead;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            current_m1 &lt;= 0;&#xa;            current_m2 &lt;= 0;&#xa;            current_m3 &lt;= 0;&#xa;            current_m4 &lt;= 0;&#xa;            dead_m1 &lt;= 0;&#xa;            dead_m2 &lt;= 0;&#xa;            dead_m3 &lt;= 0;&#xa;            dead_m4 &lt;= 0;&#xa;            slew_state &lt;= SLEW_IDLE;&#xa;            slew_motor_index &lt;= 2'd0;&#xa;            slew_add_direction &lt;= 1'b0;&#xa;            slew_work_current &lt;= 0;&#xa;            slew_work_target &lt;= 0;&#xa;            slew_work_dead &lt;= 0;&#xa;            slew_work_step &lt;= 0;&#xa;            slew_result_current &lt;= 0;&#xa;            slew_result_dead &lt;= 0;&#xa;        end else if ((MOTOR_TEST_MODE != 0) || (!watchdog_alive) ||&#xa;                     control_flags[0] || encoder_fault ||&#xa;                     (MAPPING_CONFIGURED == 0)) begin&#xa;            current_m1 &lt;= 0;&#xa;            current_m2 &lt;= 0;&#xa;            current_m3 &lt;= 0;&#xa;            current_m4 &lt;= 0;&#xa;            dead_m1 &lt;= 0;&#xa;            dead_m2 &lt;= 0;&#xa;            dead_m3 &lt;= 0;&#xa;            dead_m4 &lt;= 0;&#xa;            slew_state &lt;= SLEW_IDLE;&#xa;            slew_motor_index &lt;= 2'd0;&#xa;        end else begin&#xa;            case (slew_state)&#xa;                SLEW_IDLE: begin&#xa;                    if (control_tick) begin&#xa;                        slew_motor_index &lt;= 2'd0;&#xa;                        slew_state &lt;= SLEW_LOAD;&#xa;                    end&#xa;                end&#xa;&#xa;                SLEW_LOAD: begin&#xa;                    case (slew_motor_index)&#xa;                        2'd0: begin&#xa;                            slew_work_current &lt;= current_m1;&#xa;                            slew_work_target  &lt;= target_m1;&#xa;                            slew_work_dead    &lt;= dead_m1;&#xa;                        end&#xa;                        2'd1: begin&#xa;                            slew_work_current &lt;= current_m2;&#xa;                            slew_work_target  &lt;= target_m2;&#xa;                            slew_work_dead    &lt;= dead_m2;&#xa;                        end&#xa;                        2'd2: begin&#xa;                            slew_work_current &lt;= current_m3;&#xa;                            slew_work_target  &lt;= target_m3;&#xa;                            slew_work_dead    &lt;= dead_m3;&#xa;                        end&#xa;                        default: begin&#xa;                            slew_work_current &lt;= current_m4;&#xa;                            slew_work_target  &lt;= target_m4;&#xa;                            slew_work_dead    &lt;= dead_m4;&#xa;                        end&#xa;                    endcase&#xa;                    slew_state &lt;= SLEW_DECIDE;&#xa;                end&#xa;&#xa;                SLEW_DECIDE: begin&#xa;                    if (slew_work_dead > 0) begin&#xa;                        slew_result_current &lt;= 0;&#xa;                        slew_result_dead &lt;= slew_work_dead - 1;&#xa;                        slew_state &lt;= SLEW_STORE;&#xa;                    end else if (((slew_work_current > 0) &amp;&amp;&#xa;                                  (slew_work_target &lt; 0)) ||&#xa;                                 ((slew_work_current &lt; 0) &amp;&amp;&#xa;                                  (slew_work_target > 0))) begin&#xa;                        if ((slew_work_current &lt;= DEC_STEP) &amp;&amp;&#xa;                            (slew_work_current >= -DEC_STEP)) begin&#xa;                            slew_result_current &lt;= 0;&#xa;                            slew_result_dead &lt;= DEAD_TIME_MS;&#xa;                        end else if (slew_work_current > 0) begin&#xa;                            slew_result_current &lt;= slew_work_current - DEC_STEP;&#xa;                            slew_result_dead &lt;= 0;&#xa;                        end else begin&#xa;                            slew_result_current &lt;= slew_work_current + DEC_STEP;&#xa;                            slew_result_dead &lt;= 0;&#xa;                        end&#xa;                        slew_state &lt;= SLEW_STORE;&#xa;                    end else if (slew_work_target == slew_work_current) begin&#xa;                        slew_result_current &lt;= slew_work_current;&#xa;                        slew_result_dead &lt;= 0;&#xa;                        slew_state &lt;= SLEW_STORE;&#xa;                    end else begin&#xa;                        if (slew_work_target > slew_work_current) begin&#xa;                            slew_add_direction &lt;= 1'b1;&#xa;                            if ((slew_work_current >= 0) &amp;&amp;&#xa;                                (slew_work_target >= 0))&#xa;                                slew_work_step &lt;= ACC_STEP;&#xa;                            else&#xa;                                slew_work_step &lt;= DEC_STEP;&#xa;                        end else begin&#xa;                            slew_add_direction &lt;= 1'b0;&#xa;                            if ((slew_work_current &lt;= 0) &amp;&amp;&#xa;                                (slew_work_target &lt;= 0))&#xa;                                slew_work_step &lt;= ACC_STEP;&#xa;                            else&#xa;                                slew_work_step &lt;= DEC_STEP;&#xa;                        end&#xa;                        slew_state &lt;= SLEW_APPLY;&#xa;                    end&#xa;                end&#xa;&#xa;                SLEW_APPLY: begin&#xa;                    slew_result_dead &lt;= 0;&#xa;                    if (slew_add_direction) begin&#xa;                        if ((slew_work_current + slew_work_step) > slew_work_target)&#xa;                            slew_result_current &lt;= slew_work_target;&#xa;                        else&#xa;                            slew_result_current &lt;= slew_work_current + slew_work_step;&#xa;                    end else begin&#xa;                        if ((slew_work_current - slew_work_step) &lt; slew_work_target)&#xa;                            slew_result_current &lt;= slew_work_target;&#xa;                        else&#xa;                            slew_result_current &lt;= slew_work_current - slew_work_step;&#xa;                    end&#xa;                    slew_state &lt;= SLEW_STORE;&#xa;                end&#xa;&#xa;                SLEW_STORE: begin&#xa;                    case (slew_motor_index)&#xa;                        2'd0: begin&#xa;                            current_m1 &lt;= slew_result_current;&#xa;                            dead_m1 &lt;= slew_result_dead;&#xa;                        end&#xa;                        2'd1: begin&#xa;                            current_m2 &lt;= slew_result_current;&#xa;                            dead_m2 &lt;= slew_result_dead;&#xa;                        end&#xa;                        2'd2: begin&#xa;                            current_m3 &lt;= slew_result_current;&#xa;                            dead_m3 &lt;= slew_result_dead;&#xa;                        end&#xa;                        default: begin&#xa;                            current_m4 &lt;= slew_result_current;&#xa;                            dead_m4 &lt;= slew_result_dead;&#xa;                        end&#xa;                    endcase&#xa;                    if (slew_motor_index == 2'd3) begin&#xa;                        slew_state &lt;= SLEW_IDLE;&#xa;                    end else begin&#xa;                        slew_motor_index &lt;= slew_motor_index + 1'b1;&#xa;                        slew_state &lt;= SLEW_LOAD;&#xa;                    end&#xa;                end&#xa;&#xa;                default: slew_state &lt;= SLEW_IDLE;&#xa;            endcase&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 电机测试模式：M1运行1秒/停1秒/M2运行1秒/停1秒/.../循环。&#xa;    // -------------------------------------------------------------------------&#xa;    reg [31:0] test_phase_counter;&#xa;    reg [2:0]  test_phase;&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            test_phase_counter &lt;= 32'd0;&#xa;            test_phase         &lt;= 3'd0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            if (test_phase_counter >= (TEST_PHASE_CYCLES - 1)) begin&#xa;                test_phase_counter &lt;= 32'd0;&#xa;                if (test_phase == 3'd7)&#xa;                    test_phase &lt;= 3'd0;&#xa;                else&#xa;                    test_phase &lt;= test_phase + 1'b1;&#xa;            end else begin&#xa;                test_phase_counter &lt;= test_phase_counter + 1'b1;&#xa;            end&#xa;        end else begin&#xa;            test_phase_counter &lt;= 32'd0;&#xa;            test_phase         &lt;= 3'd0;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // FPGA->手机遥测帧，100Hz：&#xa;    // 55 CC C1 C2 C3 C4 PWM1 PWM2 PWM3 PWM4 STATUS CHECKSUM&#xa;    // Cx为该10ms窗口的x4计数幅值；STATUS bit0=链路有效、bit1=急停、&#xa;    // bit2=编码器故障、bit3=急弯。CHECKSUM为前11字节累加低8位。&#xa;    // -------------------------------------------------------------------------&#xa;    always @* begin&#xa;        case (tx_frame_index)&#xa;            4'd0:  tx_selected_byte = tx_b0;&#xa;            4'd1:  tx_selected_byte = tx_b1;&#xa;            4'd2:  tx_selected_byte = tx_b2;&#xa;            4'd3:  tx_selected_byte = tx_b3;&#xa;            4'd4:  tx_selected_byte = tx_b4;&#xa;            4'd5:  tx_selected_byte = tx_b5;&#xa;            4'd6:  tx_selected_byte = tx_b6;&#xa;            4'd7:  tx_selected_byte = tx_b7;&#xa;            4'd8:  tx_selected_byte = tx_b8;&#xa;            4'd9:  tx_selected_byte = tx_b9;&#xa;            4'd10: tx_selected_byte = tx_b10;&#xa;            default: tx_selected_byte = tx_b11;&#xa;        endcase&#xa;    end&#xa;&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            H2_1_UART_TX       &lt;= 1'b1;&#xa;            tx_seen_sequence   &lt;= 8'd0;&#xa;            tx_frame_index     &lt;= 4'd0;&#xa;            tx_frame_active    &lt;= 1'b0;&#xa;            tx_prepare_active  &lt;= 1'b0;&#xa;            tx_checksum_index  &lt;= 4'd0;&#xa;            tx_checksum_accumulator &lt;= 8'd0;&#xa;            tx_byte_busy       &lt;= 1'b0;&#xa;            tx_bit_index       &lt;= 4'd0;&#xa;            tx_shift_register  &lt;= 10'h3FF;&#xa;            tx_phase_accumulator &lt;= 32'd0;&#xa;            tx_b0 &lt;= 8'h55; tx_b1 &lt;= 8'hCC;&#xa;            tx_b2 &lt;= 8'd0;  tx_b3 &lt;= 8'd0;&#xa;            tx_b4 &lt;= 8'd0;  tx_b5 &lt;= 8'd0;&#xa;            tx_b6 &lt;= 8'd0;  tx_b7 &lt;= 8'd0;&#xa;            tx_b8 &lt;= 8'd0;  tx_b9 &lt;= 8'd0;&#xa;            tx_b10 &lt;= 8'd0; tx_b11 &lt;= 8'd0;&#xa;        end else if (tx_byte_busy) begin&#xa;            if (tx_phase_accumulator >= (CLK_FREQ - UART_BAUD)) begin&#xa;                tx_phase_accumulator &lt;= tx_phase_accumulator + UART_BAUD - CLK_FREQ;&#xa;                if (tx_bit_index == 4'd9) begin&#xa;                    tx_byte_busy &lt;= 1'b0;&#xa;                    tx_bit_index &lt;= 4'd0;&#xa;                    H2_1_UART_TX &lt;= 1'b1;&#xa;                end else begin&#xa;                    tx_shift_register &lt;= {1'b1, tx_shift_register[9:1]};&#xa;                    H2_1_UART_TX      &lt;= tx_shift_register[1];&#xa;                    tx_bit_index      &lt;= tx_bit_index + 1'b1;&#xa;                end&#xa;            end else begin&#xa;                tx_phase_accumulator &lt;= tx_phase_accumulator + UART_BAUD;&#xa;            end&#xa;        end else if (tx_prepare_active) begin&#xa;            // 每拍只累加一个字节，避免11级加法器串联成为关键路径。&#xa;            case (tx_checksum_index)&#xa;                4'd0:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b0;&#xa;                4'd1:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b1;&#xa;                4'd2:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b2;&#xa;                4'd3:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b3;&#xa;                4'd4:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b4;&#xa;                4'd5:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b5;&#xa;                4'd6:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b6;&#xa;                4'd7:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b7;&#xa;                4'd8:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b8;&#xa;                4'd9:  tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b9;&#xa;                default: tx_checksum_accumulator &lt;= tx_checksum_accumulator + tx_b10;&#xa;            endcase&#xa;            if (tx_checksum_index == 4'd10) begin&#xa;                tx_b11 &lt;= tx_checksum_accumulator + tx_b10;&#xa;                tx_checksum_index &lt;= 4'd0;&#xa;                tx_prepare_active &lt;= 1'b0;&#xa;                tx_frame_index &lt;= 4'd0;&#xa;                tx_frame_active &lt;= 1'b1;&#xa;            end else begin&#xa;                tx_checksum_index &lt;= tx_checksum_index + 1'b1;&#xa;            end&#xa;        end else if (tx_frame_active) begin&#xa;            tx_shift_register   &lt;= {1'b1, tx_selected_byte, 1'b0};&#xa;            H2_1_UART_TX        &lt;= 1'b0;&#xa;            tx_byte_busy        &lt;= 1'b1;&#xa;            tx_bit_index        &lt;= 4'd0;&#xa;            tx_phase_accumulator&lt;= 32'd0;&#xa;            if (tx_frame_index == 4'd11) begin&#xa;                tx_frame_active &lt;= 1'b0;&#xa;                tx_frame_index  &lt;= 4'd0;&#xa;            end else begin&#xa;                tx_frame_index &lt;= tx_frame_index + 1'b1;&#xa;            end&#xa;        end else if (tx_seen_sequence != telemetry_sequence) begin&#xa;            tx_seen_sequence &lt;= telemetry_sequence;&#xa;            tx_b0  &lt;= 8'h55;&#xa;            tx_b1  &lt;= 8'hCC;&#xa;            tx_b2  &lt;= telemetry_count_byte(measured_counts_m1);&#xa;            tx_b3  &lt;= telemetry_count_byte(measured_counts_m2);&#xa;            tx_b4  &lt;= telemetry_count_byte(measured_counts_m3);&#xa;            tx_b5  &lt;= telemetry_count_byte(measured_counts_m4);&#xa;            tx_b6  &lt;= pi_pwm_m1;&#xa;            tx_b7  &lt;= pi_pwm_m2;&#xa;            tx_b8  &lt;= pi_pwm_m3;&#xa;            tx_b9  &lt;= pi_pwm_m4;&#xa;            tx_b10 &lt;= {4'b0000, control_flags[1], encoder_fault,&#xa;                       control_flags[0], watchdog_alive};&#xa;            tx_b11 &lt;= 8'd0;&#xa;            tx_checksum_accumulator &lt;= 8'd0;&#xa;            tx_checksum_index &lt;= 4'd0;&#xa;            tx_prepare_active &lt;= 1'b1;&#xa;            tx_frame_index  &lt;= 4'd0;&#xa;            H2_1_UART_TX     &lt;= 1'b1;&#xa;        end else begin&#xa;            H2_1_UART_TX &lt;= 1'b1;&#xa;        end&#xa;    end&#xa;&#xa;    // -------------------------------------------------------------------------&#xa;    // 最终电机输出。每一路均使用 if/else 互斥产生 FI/BI，禁止同时有效。&#xa;    // 急停和 watchdog 失效直接覆盖斜坡状态，在下一个 50 MHz 边沿关闭输出。&#xa;    // -------------------------------------------------------------------------&#xa;    always @(posedge CLK_50M) begin&#xa;        if (por_reset) begin&#xa;            M1_FI &lt;= 1'b0;&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= 1'b0;&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= 1'b0;&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= 1'b0;&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else if (MOTOR_TEST_MODE != 0) begin&#xa;            M1_FI &lt;= ((test_phase == 3'd0) &amp;&amp;&#xa;                      (pwm_percent_counter &lt; TEST_PWM_PERCENT));&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= ((test_phase == 3'd2) &amp;&amp;&#xa;                      (pwm_percent_counter &lt; TEST_PWM_PERCENT));&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= ((test_phase == 3'd4) &amp;&amp;&#xa;                      (pwm_percent_counter &lt; TEST_PWM_PERCENT));&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= ((test_phase == 3'd6) &amp;&amp;&#xa;                      (pwm_percent_counter &lt; TEST_PWM_PERCENT));&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else if ((!watchdog_alive) || control_flags[0] || encoder_fault ||&#xa;                     (MAPPING_CONFIGURED == 0)) begin&#xa;            M1_FI &lt;= 1'b0;&#xa;            M1_BI &lt;= 1'b0;&#xa;            M2_FI &lt;= 1'b0;&#xa;            M2_BI &lt;= 1'b0;&#xa;            M3_FI &lt;= 1'b0;&#xa;            M3_BI &lt;= 1'b0;&#xa;            M4_FI &lt;= 1'b0;&#xa;            M4_BI &lt;= 1'b0;&#xa;        end else begin&#xa;            if (current_m1 > 0) begin&#xa;                M1_FI &lt;= (pwm_percent_counter &lt; pi_pwm_m1);&#xa;                M1_BI &lt;= 1'b0;&#xa;            end else if (current_m1 &lt; 0) begin&#xa;                M1_FI &lt;= 1'b0;&#xa;                M1_BI &lt;= (pwm_percent_counter &lt; pi_pwm_m1);&#xa;            end else begin&#xa;                M1_FI &lt;= 1'b0;&#xa;                M1_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m2 > 0) begin&#xa;                M2_FI &lt;= (pwm_percent_counter &lt; pi_pwm_m2);&#xa;                M2_BI &lt;= 1'b0;&#xa;            end else if (current_m2 &lt; 0) begin&#xa;                M2_FI &lt;= 1'b0;&#xa;                M2_BI &lt;= (pwm_percent_counter &lt; pi_pwm_m2);&#xa;            end else begin&#xa;                M2_FI &lt;= 1'b0;&#xa;                M2_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m3 > 0) begin&#xa;                M3_FI &lt;= (pwm_percent_counter &lt; pi_pwm_m3);&#xa;                M3_BI &lt;= 1'b0;&#xa;            end else if (current_m3 &lt; 0) begin&#xa;                M3_FI &lt;= 1'b0;&#xa;                M3_BI &lt;= (pwm_percent_counter &lt; pi_pwm_m3);&#xa;            end else begin&#xa;                M3_FI &lt;= 1'b0;&#xa;                M3_BI &lt;= 1'b0;&#xa;            end&#xa;&#xa;            if (current_m4 > 0) begin&#xa;                M4_FI &lt;= (pwm_percent_counter &lt; pi_pwm_m4);&#xa;                M4_BI &lt;= 1'b0;&#xa;            end else if (current_m4 &lt; 0) begin&#xa;                M4_FI &lt;= 1'b0;&#xa;                M4_BI &lt;= (pwm_percent_counter &lt; pi_pwm_m4);&#xa;            end else begin&#xa;                M4_FI &lt;= 1'b0;&#xa;                M4_BI &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end&#xa;" Color="antiquewhite" Comment="" Height="455" Name="MECANUM_BT_TOP1" Parameters="" Parent="MECANUM_BT_TOP" Type="model" Width="825" X="417.5" Y="210">
