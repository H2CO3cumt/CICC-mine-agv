<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#xa;    localparam IDLE=3'b000;//重力传感器处于空闲状态&#xa;    localparam WAIT=3'b001;//要从WAIT进入SHIFT得先等待50个时钟周期，也就是1us&#xa;    localparam SHIFT=3'b010;//从传感器接受24个数据&#xa;    localparam GAIN=3'b011;&#xa;    localparam DONE=3'b100;&#xa;    localparam DONE_TIME_MAX=24'd5_000_000;//防止因断线而锁死在DONE&#xa;    localparam HEAVY_ON=95;&#xa;    localparam HEAVY_OFF=80;&#xa;    localparam OVERLOAD_ON=150;&#xa;    localparam OVERLOAD_OFF=130;&#xa;    reg [23:0]done_time;&#xa;wire tare_zero=(key_cmd==9'b111_100_000);&#xa;reg tare_zero1;&#xa;reg tare_zero2;&#xa;reg tare_pending;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    tare_zero1&lt;=0;&#xa;    tare_zero2&lt;=0;&#xa;    tare_pending&lt;=0;&#xa;    end&#xa;    else begin&#xa;    tare_zero1&lt;=tare_zero;&#xa;    tare_zero2&lt;=tare_zero1;// 只允许停车状态下提出去皮请求&#xa;            if(tare_zero_pulse &amp;&amp; car_idle &amp;&amp; (~settle_timeout_fault))&#xa;            tare_pending&lt;=1;&#xa;        else if(tare_execute)//已经执行去皮&#xa;            tare_pending &lt;=0;&#xa;    end&#xa;end&#xa;wire tare_zero_pulse= tare_zero1 &amp;&amp; ~tare_zero2;&#xa;// 只有以下条件同时成立，才真正执行去皮：&#xa;// 1. 已完成开机零点校准&#xa;// 2. 当前有一组新的滤波结果可以使用&#xa;// 3. 小车处于静止状态&#xa;// 4. 当前没有锁存的载荷安全故障&#xa;wire tare_execute;&#xa;assign tare_execute =&#xa;       tare_pending&#xa;    &amp;&amp; zero_done&#xa;    &amp;&amp; filter_step&#xa;    &amp;&amp; (~raw_vld)&#xa;    &amp;&amp; car_idle&#xa;    &amp;&amp; (~settle_timeout_fault);&#xa;  wire clear_load_fault=key_cmd==9'b111_111_100;&#xa;reg clear_load_fault1;&#xa;reg clear_load_fault2;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    clear_load_fault1&lt;=0;&#xa;    clear_load_fault2&lt;=0;&#xa;    end&#xa;    else begin&#xa;        clear_load_fault1&lt;=clear_load_fault;&#xa;    clear_load_fault2&lt;=clear_load_fault1;&#xa;    end&#xa;end&#xa;wire clear_load_pulse=clear_load_fault1 &amp;&amp; ~clear_load_fault2;&#xa;wire car_idle;&#xa;reg car_idle_d;//保存上一拍的idle状态，用于触发脉冲&#xa;wire move_start;//车辆起步脉冲，只在静止切换到行驶时保持一个时钟周期&#xa;reg [23:0] moving_ref_weight;//车辆起步的时候冻结的载重基准，当作运动的时候基准&#xa;reg [23:0] moving_prev_weight;//上一组行驶重量，用于判断冲击前后的瞬时重量变化&#xa;reg moving_ref_valid;//行驶载重基准有效标志，防止基准尚未建立时误判&#xa;reg [15:0] moving_loss_cnt;//行驶过程中持续重量下降的连续确认计数器&#xa;reg moving_fault_reported;//单次行驶期间故障只上报一次，避免load_event_toggle反复翻转&#xa;reg impact_pending;//锁存MPU强冲击，直到下一组有效重量数据到达后再处理&#xa;reg impact_candidate;//强冲击并且重量突变后，进入货物移位候选状态&#xa;reg [15:0] impact_confirm_cnt;//冲击后重量偏差持续存在的确认计数器&#xa;wire [23:0] moving_loss_delta;//当前重量相对起步重量的累计下降量，只统计重量减少&#xa;wire [23:0] moving_ref_delta;//前重量相对起步重量的绝对偏差，用于判断货物移位&#xa;wire [23:0] moving_step_delta;//当前重量与上一组行驶重量的绝对差值，用于判断冲击瞬变&#xa;wire [23:0] moving_loss_threshold;//根据原参数和路面粗糙度计算行驶漏货阈值&#xa;wire [23:0] moving_loss_release;//行驶漏货计数解除阈值，形成迟滞以避免阈值附近抖动&#xa;wire moving_impact_effective;//当前冲击或已锁存冲击任一有效时，认为本组重量伴随冲击&#xa;assign car_idle=car_state==4'b0000;&#xa;assign move_start=car_idle_d &amp;&amp; !car_idle;//上一拍是静止，这一拍不是&#xa;assign moving_loss_delta=(moving_ref_weight>data)?moving_ref_weight-data:0;//只计算相对于起步基准的下降量，防止无符号减法溢出&#xa;assign moving_ref_delta=(moving_ref_weight>data)?moving_ref_weight-data:data-moving_ref_weight;//当前货舱内的质量和起步基准的绝对差值&#xa;assign moving_step_delta=(data>moving_prev_weight)?data-moving_prev_weight:moving_prev_weight-data;//相邻两组的差值&#xa;assign moving_loss_threshold=LOAD_EVENT_MIN+SETTLE_DELTA_MAX+{18'd0,road_roughness,2'b00};//粗糙度每增加1级，行驶阈值增加4&#xa;assign moving_loss_release=moving_loss_threshold>>1;//重量偏差回落到一半阈值以下时才清零漏货计数&#xa;assign moving_impact_effective=impact_pending||impact_flag;//当前周期信号和前面已经锁存的冲击信号&#xa;      localparam [23:0] LOAD_EVENT_MIN =3; // 最小有效载荷变化量，当前按3g设置&#xa;      localparam  EVENT_CONFIRM_NUM =20;// 连续这些组有效重量超过阈值后确认事件&#xa;      localparam  EVENT_CONFIRM_LAST = EVENT_CONFIRM_NUM-1; // 根据连续确认次数自动计算末次计数值&#xa;      localparam  SETTLE_DELTA_MAX =2;// 相邻两组重量变化不超过2g时认为趋于稳定&#xa;      localparam  SETTLE_CONFIRM_NUM=30;  // 连续30组稳定数据后重新设置基准值&#xa;      localparam  SETTLE_CONFIRM_LAST = SETTLE_CONFIRM_NUM -1; //根据稳定确认次数自动计算末次计数值&#xa;      localparam EVENT_ARMED =0; //等待新的装料或卸料事件状态&#xa;      localparam EVENT_SETTLE =1;// 事件已触发并等待重量稳定状态&#xa;      reg event_ctrl_state; // 载荷事件识别状态寄存器&#xa;      reg [23:0] load_ref_weight;//上一轮确认完成后的基准重量&#xa;      reg [23:0] load_prev_weight; // 上一组有效重量，用于判断当前重量是否稳定和是否产生新的基准重量&#xa;      reg load_ref_valid;//基准重量是否已经建立&#xa;      reg event_candidate_dir;// 重量变化的方向，1表示增加，0表示减少&#xa;      reg [9:0] event_confirm_cnt;//事件连续确认计数器&#xa;      reg [9:0] settle_confirm_cnt; // 重量稳定连续确认计数器&#xa;      wire [23:0] load_ref_delta;//当前重量与基准重量之间的绝对差值&#xa;      wire [23:0] load_step_delta;// 当前重量与上一组重量之间的绝对差值&#xa;      wire load_current_dir;  // 当前重量变化方向，1表示增加，0表示减少&#xa;    reg [23:0]data_r;//临时存储数据&#xa;    reg [7:0]delay_cnt;//由WAIT进入SHIFIT,延迟1us&#xa;    reg [7:0]shift_cnt;//SHIFT持续的时间，接受24个数据&#xa;    reg [2:0]cstate;&#xa;    reg [2:0]nstate;&#xa;    reg [8:0] tick_r;&#xa;    reg tick_10us;&#xa;    reg [23:0] raw_data;&#xa;    reg raw_vld;&#xa;    reg [23:0]d1,d2,d3;//3次前后挨着的原始值，用来干中值滤波&#xa;    reg [23:0]avg_buf[0:7];&#xa;    reg [23:0]zero_offset;//原始的带皮质量，需要拿raw_data-zero_offset才能得到去皮质量data&#xa;    reg [31:0]zero_sum;//开机前16个有效数据的总和&#xa;    reg [7:0]zero_cnt;&#xa;    reg zero_done;&#xa;    reg dout_r1,dout_r2,dout_r3;&#xa;    wire [23:0]med_val;&#xa;    wire [27:0]sum_all;//8次中值滤波后的值相加&#xa;    wire [23:0]avg_val;&#xa;    assign load_ref_delta=(data>load_ref_weight)?(data-load_ref_weight):(load_ref_weight-data);//当前重量与基准重量的变化量&#xa;    assign load_step_delta=(data>load_prev_weight)?(data-load_prev_weight):(load_prev_weight-data);//当前重量与上一组重量的变化量&#xa;&#xa;    assign load_current_dir=(data>=load_ref_weight)?1:0;//当前的重量大于等于基准重量的时候就判定为1，也就是增加方向&#xa;    assign sum_all={4'd0,avg_buf[0]}+{4'd0,avg_buf[1]}+{4'd0,avg_buf[2]}+{4'd0,avg_buf[3]}+{4'd0,avg_buf[4]}+{4'd0,avg_buf[5]}+{4'd0,avg_buf[6]}+{4'd0,avg_buf[7]};&#xa;    assign avg_val=sum_all[26:3];&#xa;    assign med_val=(d3>d2)?&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;((d2>d1)?d2:(d3>d1)?d1:d3):&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;((d3>d1)?d3:(d2>d1)?d1:d2);  &#xa;    always @ (  posedge clk_50m or posedge rst)&#xa;    begin &#xa;    &#x9;&#x9;if(rst)&#xa;            &#x9;&#x9;{dout_r3,dout_r2,dout_r1}&lt;=3'b111;&#xa;                    else                          &#x9;&#x9;{dout_r3,dout_r2,dout_r1}&lt;={dout_r2,dout_r1,dout};&#xa;                    end&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst) begin&#xa;        tick_10us&lt;=0;&#xa;        tick_r&lt;=0;&#xa;        end&#xa;        else begin&#xa;        if(cstate==SHIFT||cstate==GAIN) begin&#xa;        &#x9;if(tick_r&lt;499)begin&#xa;            tick_r&lt;=tick_r+1;&#xa;            tick_10us&lt;=0;&#xa;            end&#xa;            else if(tick_r==499) begin&#xa;            &#x9;&#x9;tick_10us&lt;=1;&#xa;                    tick_r&lt;=0;&#xa;            end&#xa;            end&#xa;            else begin&#xa;                   &#x9;&#x9;tick_10us&lt;=0;&#xa;                    tick_r&lt;=0;   &#xa;            end&#xa;        &#xa;            end&#xa;        end&#xa;        &#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        cstate&lt;=IDLE;&#xa;        else cstate&lt;=nstate;&#xa;    end&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        sck&lt;=0;&#xa;        else if(cstate==SHIFT|| cstate==GAIN)begin&#xa;        &#x9;&#x9;&#x9;if(tick_10us)&#xa;        &#x9;&#x9;&#x9;sck&lt;=~sck;&#xa;                    end&#xa;                    else sck&lt;=0;&#xa;    end&#xa;    always @ ( * )&#xa;    begin&#xa;    case( cstate )&#xa;    IDLE:if(~dout_r3) nstate=WAIT;&#xa;    &#x9;else nstate=IDLE;&#xa;    WAIT:if(delay_cnt==49) nstate=SHIFT;&#xa;    &#x9;else nstate=WAIT;&#xa;    SHIFT:if(shift_cnt==23 &amp;&amp; tick_10us &amp;&amp; sck) nstate=GAIN;&#xa;    &#x9;else nstate=SHIFT;&#xa;    GAIN:if(tick_10us &amp;&amp; sck)   nstate=DONE;&#xa;    &#x9;&#x9;else nstate=GAIN;&#xa;    DONE :if(dout_r3==1) begin nstate = IDLE;&#xa;    end&#xa;    else begin&#xa;    &#x9;if(done_time>=DONE_TIME_MAX-1) begin&#xa;        &#x9;&#x9;nstate=IDLE;&#xa;                end&#xa;         else  begin nstate=DONE;&#xa;        end &#xa;                &#xa;    end&#xa;    &#xa;        default: nstate=IDLE;&#xa;    endcase&#xa;    end&#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst) begin&#xa;        &#x9;&#x9;delay_cnt&lt;=0;&#xa;                done_time&lt;=0;&#xa;                end&#xa;         else begin  if(cstate==WAIT) begin&#xa;        &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(delay_cnt&lt;49) &#xa;                    delay_cnt&lt;=delay_cnt+1;&#xa;                    &#x9;&#x9;&#x9;else  delay_cnt&lt;=0;&#xa;                                end&#xa;                else delay_cnt&lt;=0;//非WAIT状态，归0&#xa;               if(cstate==DONE &amp;&amp; dout_r3==0) done_time&lt;=done_time+1;&#xa;            else done_time&lt;=0;&#xa;                end                &#xa;    end&#xa;    always@(posedge clk_50m or posedge rst)begin&#xa;    &#x9;if(rst)begin&#xa;        shift_cnt&lt;=0;&#xa;        data_r&lt;=0;&#xa;        raw_vld&lt;=0;&#xa;        end&#xa;        else begin&#xa;        raw_vld&lt;=0;&#xa;        case( cstate)&#xa;        IDLE:begin&#xa;        shift_cnt&lt;=0;&#xa;        data_r&lt;=0;&#xa;        end&#xa;        WAIT:begin&#xa;        shift_cnt&lt;=0;&#xa;        end&#xa;        SHIFT:begin&#xa;        if(tick_10us)&#xa;        &#x9;&#x9;if(sck) begin&#xa;        &#x9;&#x9;&#x9;if(shift_cnt&lt;23) begin&#xa;        &#x9;&#x9;data_r[23-shift_cnt]&lt;=dout_r3;&#xa;            shift_cnt&lt;=shift_cnt+1;&#xa;        end&#xa;        else begin&#xa;        &#x9;&#x9;if(shift_cnt==23) begin&#xa;                raw_data&lt;=  {data_r[23:1], dout_r3} ^ 24'h800000;&#xa;                          // raw_data&lt;=  {data[23],data_r[22:1], dout_r3};&#xa;                shift_cnt&lt;=24;&#xa;                raw_vld&lt;=1;&#xa;                end&#xa;        end&#xa;        end&#xa;        end &#xa;            default:  begin &#xa;                             shift_cnt&lt;=0;&#xa;        &#x9;&#x9;&#x9;&#x9;&#x9;end&#xa;        endcase&#xa;        end&#xa;    end&#xa;    reg filter_step;&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin //1&#xa;    &#x9;if(rst)begin&#xa;        d3&lt;=0;d2&lt;=0;d1&lt;=0;zero_offset&lt;=0;zero_cnt&lt;=0;avg_buf[0]&lt;=0;avg_buf[1]&lt;=0;avg_buf[2]&lt;=0;avg_buf[3]&lt;=0;avg_buf[4]&lt;=0;avg_buf[5]&lt;=0;avg_buf[6]&lt;=0;avg_buf[7]&lt;=0;heavy_load_state&lt;=0;&#xa;        overload_state&lt;=0;&#xa;        data&lt;=0;&#xa;        zero_done&lt;=0;zero_sum&lt;=0;&#xa;        filter_step&lt;=0;&#xa;        data_vld&lt;=0;&#xa;        end&#xa;        else begin&#xa;        data_vld&lt;=0;&#xa;        if(raw_vld)begin//3&#xa;  &#xa;  &#xa;        &#x9;&#x9;d3&lt;=d2;d2&lt;=d1;d1&lt;=raw_data;//第一级流水线&#xa;            filter_step&lt;=1;&#xa;            end &#xa;            else if(filter_step)begin//第二级流水线&#xa;            filter_step &lt;= 1'b0;&#xa;                    avg_buf[7] &lt;= avg_buf[6]; avg_buf[6] &lt;= avg_buf[5];&#xa;                    avg_buf[5] &lt;= avg_buf[4]; avg_buf[4] &lt;= avg_buf[3];&#xa;                    avg_buf[3] &lt;= avg_buf[2]; avg_buf[2] &lt;= avg_buf[1];&#xa;                    avg_buf[1] &lt;= avg_buf[0]; avg_buf[0] &lt;= med_val;&#xa;            if(~zero_done)begin&#xa;            &#x9;&#x9;if(zero_cnt&lt;26)begin&#xa;                    data_vld&lt;=0;&#xa;                    zero_cnt&lt;=zero_cnt+1;&#xa;                    if(zero_cnt>=10)//先让前面的10个值生成一个avg_val&#xa;                    &#x9;&#x9;zero_sum&lt;=zero_sum+avg_val;&#xa;                            end&#xa;                            else  begin zero_done&lt;=1;//完成&#xa;                            zero_offset&lt;=zero_sum[27:4];&#xa;                            end&#xa;            end//零点校验还没完成&#xa;            else //零点校验完成之后&#xa;            begin data_vld&lt;=1;&#xa;            if(tare_execute) begin&#xa;        zero_offset&lt;=avg_val;&#xa;        data&lt;=0;&#xa;        // 当前重量已经重新定义为0，因此清除载重状态&#xa;        heavy_load_state&lt;=0;&#xa;        overload_state&lt;=0;&#xa;    end&#xa;           else begin &#x9;&#x9;if(avg_val>zero_offset)&#xa;                    &#x9;data&lt;=(avg_val-zero_offset)/413;//avg_val-zero_offset;&#xa;                  else data&lt;=(zero_offset-avg_val)/413;//zero_offset-avg_val;&#xa;                if(heavy_load_state==0) begin//迟滞比较，也就是判断从非重载到重载，从重载到非重载的阈值不是同一个数&#xa;                &#x9;&#x9;if(data>HEAVY_ON)&#xa;                        &#x9;heavy_load_state&lt;=1;&#xa;                end&#xa;                else begin&#xa;                &#x9;&#x9;if(data&lt;HEAVY_OFF)&#xa;                        heavy_load_state&lt;=0;&#xa; &#xa;                end&#xa;                         if(overload_state==0) begin&#xa;                        &#x9;&#x9;if(data>OVERLOAD_ON)&#xa;                        &#x9;&#x9;overload_state&lt;=1;&#xa;                                end&#xa;                        else if(data&lt;OVERLOAD_OFF)&#xa;                        &#x9;&#x9;&#x9;overload_state&lt;=0;&#xa;                end&#xa;                end&#xa;            end&#xa;        end//2&#xa;        end//1&#xa;  reg [7:0] stop_cnt;//比如说货舱漏了，一直漏矿物，我就得上报并且紧急停车&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;              event_ctrl_state&lt;=EVENT_ARMED; &#xa;              load_ref_weight&lt;=0; &#xa;              load_prev_weight&lt;=0;&#xa;              load_ref_valid&lt;=0; &#xa;              event_candidate_dir&lt;=0; &#xa;              event_confirm_cnt&lt;=0; &#xa;              settle_confirm_cnt&lt;=0;&#xa;              load_event_state&lt;=0; &#xa;              load_event_toggle&lt;=0; &#xa;              load_change_amount&lt;=0; &#xa;            stop_cnt&lt;=0;&#xa;            settle_timeout_fault&lt;=0;&#xa;            car_idle_d&lt;=1;&#xa;            moving_ref_weight&lt;=0;&#xa;            moving_prev_weight&lt;=0;&#xa;            moving_ref_valid&lt;=0;&#xa;            moving_loss_cnt&lt;=0;&#xa;            moving_fault_reported&lt;=0;&#xa;            impact_pending&lt;=0;&#xa;            impact_candidate&lt;=0;//清空货物移位候选状态&#xa;            impact_confirm_cnt&lt;=0;//清空冲击后重量偏差确认次数&#xa;    end&#xa;    else begin&#xa;       if(tare_execute) begin&#xa;        // 去皮后显示重量为0，因此装卸基准也设置为0&#xa;        load_ref_weight&lt;=0;&#xa;        load_prev_weight&lt;=0;&#xa;        load_ref_valid&lt;=1;&#xa;        event_ctrl_state&lt;=EVENT_ARMED;&#xa;        event_candidate_dir&lt;=0;&#xa;        event_confirm_cnt&lt;=0;&#xa;        settle_confirm_cnt&lt;=0;&#xa;        stop_cnt&lt;=0;&#xa;        load_event_state&lt;=2'b00;&#xa;        load_change_amount&lt;=0;&#xa;        // 清除行驶载荷检测使用的旧重量基准&#xa;        moving_ref_weight&lt;=0;&#xa;        moving_prev_weight&lt;=0;&#xa;        moving_ref_valid&lt;=0;&#xa;        moving_loss_cnt&lt;=0;&#xa;        moving_fault_reported&lt;=0;&#xa;        impact_pending&lt;=0;&#xa;        impact_candidate&lt;= 0;&#xa;        impact_confirm_cnt&lt;=0;&#xa;        car_idle_d&lt;=1;&#xa;    end&#xa;&#xa;     else   if(clear_load_pulse &amp;&amp; car_idle) begin&#xa;    settle_timeout_fault &lt;= 1'b0;&#xa;    load_event_state     &lt;= 2'b00;&#xa;    // 以故障处理后的当前重量建立新基准,这样就能修改掉之前出现的行驶过程中漏货正常显示问题，但是一停车之后就会显示故障和timeout_fault锁存的问题&#xa;    load_ref_weight&lt;= data;&#xa;    load_prev_weight&lt;= data;&#xa;    load_ref_valid &lt;=1;&#xa;    event_ctrl_state&lt;= EVENT_ARMED;&#xa;    event_confirm_cnt&lt;=0;&#xa;    settle_confirm_cnt&lt;=0;&#xa;    stop_cnt&lt;=0;&#xa;    moving_loss_cnt&lt;=0;&#xa;    moving_fault_reported&lt;=0;&#xa;    impact_candidate&lt;=0;&#xa;    impact_confirm_cnt&lt;= 0;&#xa;end&#xa;else begin&#xa;    car_idle_d&lt;=car_idle;&#xa;    &#x9;&#x9;if(impact_flag &amp;&amp; ~car_idle)&#xa;            &#x9;impact_pending&lt;=1;&#xa;                if(car_idle) begin//静止的时候清零&#xa;                moving_loss_cnt&lt;=0;&#xa;                impact_pending&lt;=0;&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                end&#xa;                if(move_start) begin&#xa;                moving_ref_weight&lt;=load_ref_weight;&#xa;                moving_prev_weight&lt;=data;&#xa;                moving_ref_valid&lt;=load_ref_valid;//只有原静止载重基准有效时才允许形式漏货判断&#xa;                moving_loss_cnt&lt;=0;//每次起步都清0&#xa;                moving_fault_reported&lt;=0;//每次起步允许本段行驶过程中上报一次载荷故障&#xa;                impact_pending&lt;=0;&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                settle_confirm_cnt&lt;=0;&#xa;                stop_cnt&lt;=0;&#xa;                &#xa;                &#xa;                end&#xa;    &#x9;&#x9;&#x9;if(data_vld)begin// 行驶载荷故障已经发生时，&#xa;    // 禁止静止装卸状态机把2'b11覆盖成普通卸货2'b10&#xa;    if(settle_timeout_fault) begin&#xa;        load_event_state &lt;= 11;&#xa;        event_ctrl_state&lt;=EVENT_ARMED;&#xa;        event_confirm_cnt&lt;=0;&#xa;        settle_confirm_cnt&lt;=0;&#xa;        stop_cnt&lt;=0;&#xa;        // 保存当前重量，避免恢复后相邻数据差值异常&#xa;        load_prev_weight    &lt;= data;&#xa;    end&#xa;                if(load_ref_valid==0) begin//还没建立基准&#xa;                &#x9;&#x9;load_ref_weight&lt;=data;//默认的基准值是刚开始的data也就是0&#xa;                     load_prev_weight&lt;=data;//上一组值，也就是0&#xa;                    load_ref_valid&lt;=1;&#xa;                    event_ctrl_state&lt;=EVENT_ARMED;//进入等待事件状态&#xa;                    event_candidate_dir&lt;=0;//清除候选变化方向&#xa;                    event_confirm_cnt&lt;=0;//清零事件确认计数器&#xa;                    settle_confirm_cnt&lt;=0;//清零稳定确认计数器&#xa;                    stop_cnt&lt;=0;&#xa;                    moving_prev_weight&lt;=data;//初始载重基准建立时同步保存重量，避免首次起步的顺时差值无效&#xa;                end//建立初始基准结束&#xa;                else if(car_idle) begin//只有车辆静止时才执行原有装料，卸料和稳定检测状态机&#xa;                &#x9;&#x9;&#x9;case(event_ctrl_state)&#xa;                        EVENT_ARMED:begin&#xa;                        stop_cnt&lt;=0;&#xa;                        load_prev_weight&lt;=data;&#xa;                        settle_confirm_cnt&lt;=0;//等待事件的时候清零稳定确认计数器&#xa;                        if(load_ref_delta>=LOAD_EVENT_MIN)//相对基准值的变化量达到了阈值&#xa;                        begin&#xa;                        &#x9;&#x9;if(event_confirm_cnt==0)begin&#xa;                                event_candidate_dir&lt;=load_current_dir;&#xa;                                event_confirm_cnt&lt;=1;&#xa;                                end&#xa;                             else begin&#xa;                            &#x9;&#x9;&#x9;if(event_candidate_dir==load_current_dir) begin//如果上一回的变化方向和这一回的相等&#xa;                                        &#x9;&#x9;if(event_confirm_cnt>=EVENT_CONFIRM_LAST) begin//次数够了&#xa;                                                event_ctrl_state&lt;=EVENT_SETTLE;&#xa;                                                settle_confirm_cnt&lt;=0;&#xa;                                                event_confirm_cnt&lt;=0;&#xa;                                                load_change_amount&lt;=load_ref_delta;//变化量就是当前重量和基准量的差值&#xa;                                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                                &#x9;&#x9;if(load_current_dir==1) begin&#xa;                                                        load_event_state&lt;=2'b01;//锁存装料状态&#xa;                                                        end&#xa;                                                        else begin load_event_state&lt;=2'b10;end&#xa;                                                end&#xa;                                                else event_confirm_cnt&lt;=event_confirm_cnt+1;&#xa;                                        end&#xa;                                        else begin&#xa;                                        event_candidate_dir&lt;=load_current_dir;//开启新一轮&#xa;                                        event_confirm_cnt&lt;=1;&#xa;                                        end&#xa;                            end&#xa;                        end&#xa;                             else event_confirm_cnt&lt;=0;//没到阈值&#xa;                        end&#xa;                        EVENT_SETTLE: begin&#xa;                        load_change_amount&lt;=load_ref_delta;&#xa;                        load_prev_weight&lt;=data;//供下一组判断稳定性&#xa;                        event_confirm_cnt&lt;=0;&#xa;              if(load_step_delta&lt;=SETTLE_DELTA_MAX&amp;&amp;settle_confirm_cnt>=SETTLE_CONFIRM_LAST) begin//稳定&#xa;                                        load_ref_weight&lt;=data;&#xa;                                        event_ctrl_state&lt;=EVENT_ARMED;&#xa;                                        settle_confirm_cnt&lt;=0;&#xa;                                        stop_cnt&lt;=0;&#xa;                                        end&#xa;                                        else  begin if(stop_cnt>=99) begin//没稳定&#xa;                                        &#x9;&#x9;&#x9;&#x9;&#x9;settle_timeout_fault&lt;=1;//超时了还没稳定我就强行停车，疑似漏货&#xa;                                                            stop_cnt&lt;=stop_cnt;end&#xa;                                                        else stop_cnt&lt;=stop_cnt+1; &#xa;                                        &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(load_step_delta&lt;=SETTLE_DELTA_MAX)&#xa;                                                &#x9;&#x9;&#x9;settle_confirm_cnt&lt;=settle_confirm_cnt+1;&#xa;                                                    else settle_confirm_cnt&lt;=0;&#xa;                                                    end&#xa;                        end&#xa;                        default:begin&#xa;                        event_ctrl_state&lt;=EVENT_ARMED;&#xa;                        event_candidate_dir&lt;=0;&#xa;                        settle_confirm_cnt&lt;=0;&#xa;                        event_confirm_cnt&lt;=0;&#xa;                        stop_cnt&lt;=0;&#xa;                        end&#xa;                        endcase&#xa;                        end&#xa;                        else begin//行驶过程中&#xa;                        load_prev_weight&lt;=data;//行驶时只更新相邻重量参考&#xa;                        moving_prev_weight&lt;=data;//保存本组行驶重量，供下一组计算瞬时重量变化&#xa;                        if(moving_ref_valid)begin//起步载重基准有效时&#xa;                        &#x9;&#x9;if(moving_loss_delta>=moving_loss_threshold)//当前重量相对起步重量的变化量达到了设定的阈值&#xa;                                 begin&#xa;                                &#x9;if(moving_loss_cnt&lt;EVENT_CONFIRM_LAST)&#xa;                                    moving_loss_cnt&lt;=moving_loss_cnt+1;&#xa;                                    else moving_loss_cnt&lt;=moving_loss_cnt;//达到上限就锁存    &#xa;                                    end                    &#xa;                        else if(moving_loss_delta&lt;=moving_loss_release)&#xa;                        &#x9;&#x9;&#x9;moving_loss_cnt&lt;=0;&#xa;                          if(moving_impact_effective &amp;&amp; moving_step_delta>=moving_loss_threshold) begin&#xa;                        impact_candidate&lt;=1;//进入冲击后重量持续偏差确认阶段&#xa;                        impact_confirm_cnt&lt;=0;&#xa;                        impact_pending&lt;=0;&#xa;                        end&#xa;                        else if(impact_candidate)begin&#xa;                        if(moving_ref_delta>=moving_loss_threshold) begin//冲击后重量相对基准仍然存在明显偏差&#xa;                        &#x9;&#x9;if(impact_confirm_cnt&lt;=SETTLE_CONFIRM_LAST)&#xa;                                impact_confirm_cnt&lt;=impact_confirm_cnt+1;&#xa;                             else impact_confirm_cnt&lt;=impact_confirm_cnt;&#xa;                       end&#xa;                        else if(moving_ref_delta&lt;=moving_loss_release)begin//小于释放值&#xa;                        impact_candidate&lt;=0;//取消货物位移候选状态&#xa;                        impact_confirm_cnt&lt;=0;&#xa;                        end&#xa;                           else//在中间&#xa;    begin&#xa;        impact_candidate &lt;= impact_candidate;//保持候选状态&#xa;        impact_confirm_cnt &lt;= impact_confirm_cnt;//保持当前确认次数&#xa;    end&#xa;    end&#xa;                        if(~moving_fault_reported)begin//本段行驶还没有上报过载荷安全故障时才允许触发&#xa;                        &#x9;&#x9;if(impact_candidate &amp;&amp; moving_ref_delta>=moving_loss_threshold &amp;&amp; impact_confirm_cnt>=SETTLE_CONFIRM_LAST)begin//冲击后重量偏差持续达到确认次数，判定位货物移位或者说是掉落&#xa;                                settle_timeout_fault&lt;=1;&#xa;                                load_event_state&lt;=2'b11;&#xa;                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                load_change_amount&lt;=moving_ref_delta;//记录当前重量和起步基准的绝对变化量&#xa;                                moving_fault_reported&lt;=1;&#xa;                                impact_candidate&lt;=0;//故障确认后推出冲击候选判断&#xa;                                end&#xa;                                else if(moving_loss_delta>=moving_loss_threshold&amp;&amp; moving_loss_cnt>=EVENT_CONFIRM_LAST)begin//重量相对起步基准持续下降达到指定的阈值次数，判定为行驶漏货&#xa;                                settle_timeout_fault&lt;=1;&#xa;                                load_event_state&lt;=2'b11;&#xa;                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                load_change_amount&lt;=moving_loss_delta;&#xa;                                moving_fault_reported&lt;=1;&#xa;                                end&#xa;                        end&#xa;                end&#xa;                else begin&#xa;                moving_loss_cnt&lt;=0;//基准无效时都取消&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                impact_pending&lt;=0;&#xa;                end&#xa;                end&#xa;                end&#xa;    end&#xa;end&#xa;end &#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="WEIGHT_SENSOR" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.610185"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.735185"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="dout" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.860185"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sck" Parent="WEIGHT_SENSOR" Side="right" Width="30" X="0.98125" Y="0.652778"/>
 <Port Color="#ffe4c4" Connect="" Datasize="24" Datatype="reg" Description="" Height="30" Inout="output" Name="data" Parent="WEIGHT_SENSOR" Side="right" Width="30" X="0.98125" Y="0.818519"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="heavy_load_state" Parent="WEIGHT_SENSOR" Side="right" Width="30" X="0.98125" Y="0.485185"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="data_vld" Parent="WEIGHT_SENSOR" Side="right" Width="30" X="0.98125" Y="0.152778"/>
 <Port Color="#ffebcd" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="load_event_state" Parent="WEIGHT_SENSOR" Side="bottom" Width="30" X="0.190625" Y="0.972222"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="load_event_toggle" Parent="WEIGHT_SENSOR" Side="bottom" Width="30" X="0.390625" Y="0.972222"/>
 <Port Color="#8a2be2" Connect="" Datasize="24" Datatype="reg" Description="" Height="30" Inout="output" Name="load_change_amount" Parent="WEIGHT_SENSOR" Side="bottom" Width="30" X="0.59" Y="0.972222"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="settle_timeout_fault" Parent="WEIGHT_SENSOR" Side="bottom" Width="30" X="0.790625" Y="0.972222"/>
 <Port Color="#deb887" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.485185"/>
 <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="overload_state" Parent="WEIGHT_SENSOR" Side="right" Width="30" X="0.98125" Y="0.318519"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="impact_flag" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.360185"/>
 <Port Color="#d2691e" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="road_roughness" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.235185"/>
 <Port Color="#ff7f50" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="WEIGHT_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.110185"/>
</Module>
