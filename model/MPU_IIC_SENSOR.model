<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="// MPU6050 IIC通信&#xa;localparam DEVICE_READ       = 8'hD1;&#xa;localparam DEVICE_WRITE      = 8'hD0;&#xa;localparam GYRO_ZH           = 8'h47;&#xa;localparam ACCEL_ZH=8'h3F;//加速度计Z轴高字节地址&#xa;localparam PWR_MGMT_1        = 8'h6B;&#xa;localparam PWR_MGMT_1_VAL    = 8'h00;&#xa;localparam SMPLRT_DIV        = 8'h19;&#xa;localparam SMPLRT_DIV_VAL    = 8'h07;&#xa;localparam CONFIG1           = 8'h1A;&#xa;localparam CONFIG1_VAL       = 8'h06;&#xa;localparam GYRO_CONFIG       = 8'h1B;&#xa;localparam GYRO_CONFIG_VAL   = 8'h18;&#xa;localparam ACC_CONFIG        = 8'h1C;&#xa;localparam ACC_CONFIG_VAL    = 8'h00;//地址&#xa;localparam ST_RECOVER      = 4'd0;&#xa;localparam ST_RECOVER_STOP = 4'd1;&#xa;localparam ST_IDLE         = 4'd2;&#xa;localparam ST_START        = 4'd3;&#xa;localparam ST_SEND         = 4'd4;&#xa;localparam ST_ACK          = 4'd5;&#xa;localparam ST_RESTART      = 4'd6;&#xa;localparam ST_READ         = 4'd7;&#xa;localparam ST_MASTER_ACK   = 4'd8;&#xa;localparam ST_STOP         = 4'd9;&#xa;localparam ST_WAIT         = 4'd12;//状态&#xa;//每个SLC分成四个&#xa;reg [6:0] iic_tick_cnt;&#xa;wire tick_iic;&#xa;assign tick_iic = (iic_tick_cnt==124);//SCL是100KHZ,也就是一个SLC周期得计数50M/100K=500,再分成四份，也就是500/4=125&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;iic_tick_cnt&lt;=0;&#xa;            else begin&#xa;            &#x9;&#x9;if(tick_iic)&#xa;                    iic_tick_cnt&lt;=0;&#xa;                    else iic_tick_cnt&lt;=iic_tick_cnt+1;&#xa;            end   &#xa;end&#xa;reg sda_r1;&#xa;reg sda_r2;&#xa;always@(posedge clk_50m or posedge rst)begin//打拍,防止亚稳态&#xa;&#x9;&#x9;if(rst)begin&#xa;        &#x9;&#x9;sda_r1&lt;=1;&#xa;                sda_r2&lt;=1;&#xa;                end&#xa;                else begin&#xa;                sda_r1&lt;=sda;&#xa;                sda_r2&lt;=sda_r1;&#xa;                end&#xa;        end&#xa;reg sda_drive_low;&#xa;reg scl_r;&#xa;assign sda = sda_drive_low ? 1'b0 : 1'bz;&#xa;assign scl = scl_r;&#xa;reg [3:0] cstate;&#xa;reg [1:0] phase;//0:低电平中心，1：上升沿，2：高电平中心，3：下降沿，把一个SLC周期平分为4个脉冲信号&#xa;reg [3:0] recover_count;//统计恢复脉冲，0-8，共9个&#xa;reg [11:0] wait_count;//统计10ms等待时间&#xa;reg [2:0] bit_count;&#xa;reg [7:0] byte_tx;//发送移位缓冲，就是发送第几个bit&#xa;reg [7:0] byte_rx;//接收移位缓冲，这俩本质上就是形成一个8选1多路选择器&#xa;reg [4:0] flow_step;//表示一次大循环里内部进行到了第几个环节&#xa;reg [4:0] times;//表示进行到第几个大循环，0-4是初始化5个寄存器，5是读取MPU6050传来的高低位数据&#xa;reg master_ack_low;//1的话就是主机拉低SDA,发送ACK,0的话就是主机释放了SDA，发送NACK&#xa;reg transaction_ok;//记录当前循环是否成功&#xa;reg [7:0] mpu_zl_read;&#xa;reg [7:0] mpu_zh_read;&#xa;reg [15:0] raw_data_r;&#xa;reg raw_data_vld_r;&#xa;reg [7:0] raw_data_vld_count;&#xa;reg [15:0] pending_raw_data;//读取完高低字节后，不会立刻输出，而是先存入pending_raw_data，只有完成NACK,STOP,确认总线&#xa;//恢复正常后，才把数据发到raw_data_r，不会出现刚开始那种高位是新的，低位是旧的情况&#xa;reg pending_sample;&#xa;reg i2c_init_done;&#xa;reg [7:0] cfg_reg_addr;&#xa;reg [7:0] cfg_reg_data;&#xa;reg [2:0]gyro_read_count;//用来区分当前读取的是陀螺仪还是加速度计&#xa;reg read_accel_z;&#xa;reg [15:0]accel_z_raw_r;&#xa;reg accel_z_vld_r;&#xa;always @(*)//根据不同循环阶段选择不同的地址&#xa;begin&#xa;    cfg_reg_addr = PWR_MGMT_1;//防止锁存器&#xa;    cfg_reg_data = PWR_MGMT_1_VAL;&#xa;    case(times)&#xa;        5'd0: begin&#xa;            cfg_reg_addr = PWR_MGMT_1;&#xa;            cfg_reg_data = PWR_MGMT_1_VAL;&#xa;        end&#xa;        5'd1: begin&#xa;            cfg_reg_addr = SMPLRT_DIV;&#xa;            cfg_reg_data = SMPLRT_DIV_VAL;&#xa;        end&#xa;        5'd2: begin&#xa;            cfg_reg_addr = CONFIG1;&#xa;            cfg_reg_data = CONFIG1_VAL;&#xa;        end&#xa;        5'd3: begin&#xa;            cfg_reg_addr = GYRO_CONFIG;&#xa;            cfg_reg_data = GYRO_CONFIG_VAL;&#xa;        end&#xa;&#xa;        5'd4: begin&#xa;            cfg_reg_addr = ACC_CONFIG;&#xa;            cfg_reg_data = ACC_CONFIG_VAL;&#xa;        end&#xa;&#xa;        default: begin&#xa;            cfg_reg_addr = GYRO_ZH;&#xa;            cfg_reg_data = 8'h00;&#xa;        end&#xa;    endcase&#xa;end&#xa;always @(posedge clk_50m or posedge rst)&#xa;begin&#xa;    if(rst) begin&#xa;        cstate &lt;= ST_RECOVER;//默认恢复&#xa;        phase&lt;=0;&#xa;        recover_count&lt;=0;&#xa;        wait_count&lt;=0;&#xa;        bit_count&lt;=7;&#xa;        byte_tx&lt;=0;&#xa;        byte_rx&lt;=0;&#xa;        flow_step&lt;=0;&#xa;        times&lt;=0;&#xa;        master_ack_low&lt;=0;&#xa;        transaction_ok&lt;=1;&#xa;        scl_r&lt;=1;&#xa;        sda_drive_low&lt;=0;&#xa;        mpu_zh_read&lt;=0;&#xa;        mpu_zl_read&lt;=0;&#xa;        raw_data_r&lt;=0;&#xa;        raw_data_vld_r&lt;=0;&#xa;        raw_data_vld_count&lt;=0;&#xa;        pending_raw_data&lt;=0;&#xa;        pending_sample&lt;=0;&#xa;        i2c_init_done&lt;=0;&#xa;        ack_err_code&lt;=0;&#xa;        gyro_read_count&lt;=0;&#xa;read_accel_z&lt;=0;&#xa;accel_z_raw_r&lt;=0;&#xa;accel_z_vld_r&lt;=0;&#xa;    end&#xa;    else begin&#xa;        // raw_data_vld只保持一个50MHz时钟周期&#xa;        raw_data_vld_r&lt;=0;&#xa;        accel_z_vld_r&lt;=0;&#xa;        if(tick_iic) begin&#xa;            case(cstate)&#xa;                ST_RECOVER: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//SCL拉低，SDA释放&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;//拉高，形成恢复上升沿&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                   2:begin&#xa;                            scl_r&lt;=1;//保持高电平&#xa;                            sda_drive_low &lt;= 1'b0;&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;&#xa;                        3: begin&#xa;                            scl_r&lt;=0;//拉低，形成下降沿&#xa;                            sda_drive_low&lt;=0;&#xa;                            if(recover_count==8) begin&#xa;                                recover_count&lt;=0;&#xa;                                phase&lt;=0;&#xa;                                cstate&lt;=ST_RECOVER_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                recover_count &lt;= recover_count +1;&#xa;                                phase&lt;=0;//意思是得经历9个这样的SCL周期信号才能从RECOVER进入RECOVER_STOP;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_RECOVER_STOP:begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;//SCL低的时候拉低SDA&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SCL高的时候读取&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SCL高的时候释放SDA,让他由低变高，正好是STOP的标准条件&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_IDLE;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_IDLE: begin&#xa;                    scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;//SCL和SDA都是高&#xa;                    phase&lt;=0;&#xa;                    bit_count&lt;=7;&#xa;                    byte_rx&lt;=0;&#xa;                    transaction_ok&lt;=1;&#xa;                    // 如果空闲时SDA仍为低，再进行一次总线恢复&#xa;                    if(sda_r2==0) begin&#xa;                        recover_count&lt;=0;&#xa;                        cstate&lt;=ST_RECOVER;&#xa;                    end&#xa;                    else begin&#xa;                        byte_tx &lt;= DEVICE_WRITE;&#xa;                        // 0-4为初始化，5为读取&#xa;                        if(times&lt;5)&#xa;                            flow_step&lt;=0;&#xa;                        else&#xa;                            flow_step&lt;=10;&#xa;                        cstate &lt;= ST_START;&#xa;                          if(times>=5)begin&#xa;                              if(gyro_read_count>=4)&#xa;                                  read_accel_z&lt;=1;&#xa;                              else&#xa;                                  read_accel_z&lt;=0;&#xa;                          end&#xa;                    end&#xa;                end&#xa;                ST_START: begin//SCL高电平的时候SDA得从高变低&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//两个都是高&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SCL高的时候SDA变低，这是START的开始信号&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2:begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;//开始信号产生后再把SCL拉低，准备改变SDA&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        2'd3: begin&#xa;                            scl_r&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            bit_count&lt;=7;&#xa;                            cstate&lt;=ST_SEND;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_SEND: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            if(byte_tx[bit_count] ==0)&#xa;                                sda_drive_low &lt;=1;&#xa;                            else&#xa;                                sda_drive_low&lt;=0;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;//从机在SCL高电平的时候读取SDA&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;&#xa;                            if(bit_count==0) begin&#xa;                                phase&lt;=0;&#xa;                                cstate&lt;=ST_ACK;//为下一阶段做好准备&#xa;                            end&#xa;                            else begin&#xa;                                bit_count&lt;=bit_count-1;//还没发完&#xa;                                phase&lt;=0;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_ACK: begin//ACK是0，NACK是1&#xa;                    case(phase)&#xa;                        0:begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//主机释放SDA控制权&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            // 没收到ACK&#xa;                            if(sda_r2 ==1) begin&#xa;                                transaction_ok&lt;=0;&#xa;                                pending_sample&lt;=0;&#xa;                                // 保留第一次错误&#xa;                                if(ack_err_code == 0) begin&#xa;                                    case(flow_step)&#xa;                                        0, 10:&#xa;                                            ack_err_code&lt;=1;&#xa;                                        1,11:&#xa;                                            ack_err_code&lt;=2;&#xa;                                        2:&#xa;                                            ack_err_code&lt;=3;&#xa;                                        13:&#xa;                                            ack_err_code&lt;=4;&#xa;                                        default:&#xa;                                            ack_err_code&lt;=15;&#xa;                                    endcase&#xa;                                end&#xa;                                cstate &lt;= ST_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                case(flow_step)&#xa;                                    // 初始化：发送设备写地址成功&#xa;                                    5'd0: begin&#xa;                                        byte_tx&lt;=cfg_reg_addr;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=1;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;&#xa;                                    // 初始化：发送寄存器地址成功&#xa;                                    1: begin&#xa;                                        byte_tx&lt;=cfg_reg_data;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=2;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;                                    // 初始化：发送配置数据成功&#xa;                                    2: begin&#xa;                                        cstate&lt;=ST_STOP;&#xa;                                    end&#xa;                                    // 读取：发送设备写地址成功&#xa;                                    10: begin&#xa;                                        byte_tx&lt;=GYRO_ZH;&#xa;                                        if(read_accel_z)&#xa;                                              byte_tx&lt;=ACCEL_ZH;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=11;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;&#xa;                                    // 读取：发送0x47成功，产生重复START&#xa;                                    11: begin&#xa;                                        flow_step&lt;=12;&#xa;                                        cstate&lt;=ST_RESTART;&#xa;                                    end&#xa;                                    // 读取：发送设备读地址成功&#xa;                                    13: begin&#xa;                                        byte_rx&lt;=0;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=14;&#xa;                                        cstate&lt;=ST_READ;&#xa;                                    end&#xa;&#xa;                                    default: begin&#xa;                                        transaction_ok&lt;=0;&#xa;                                        cstate &lt;=ST_STOP;&#xa;                                    end&#xa;                                endcase&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_RESTART: begin//和普通START的区别是不产生STOP&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//SCL低的时候释放SDA&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SCL拉高的时候SDA继续保持释放也就是高电平&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SDA由高变低，产生START&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;//SCL变低，准备下一阶段&#xa;                            sda_drive_low&lt;=1;&#xa;                            byte_tx &lt;= DEVICE_READ;//读MPU6050传来的&#xa;                            bit_count&lt;=7;&#xa;                            flow_step&lt;=13;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_SEND;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_READ: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;2: begin&#xa;                            scl_r&lt;=1;&#xa;                            byte_rx[bit_count]&lt;=sda_r2;//SCL高电平的时候采样数据&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            if(bit_count==0) begin&#xa;                                // 高字节接收完成&#xa;                                if(flow_step==14) begin&#xa;                                    mpu_zh_read&lt;=byte_rx;&#xa;                                    // 高字节后主机发送ACK&#xa;                                    master_ack_low&lt;=1;&#xa;                                    flow_step&lt;=15;&#xa;                                    cstate&lt;=ST_MASTER_ACK;&#xa;                                end&#xa;                                // 低字节接收完成&#xa;                                else if(flow_step==16) begin&#xa;                                    mpu_zl_read&lt;=byte_rx;&#xa;                                    // 暂存完整16位数据&#xa;                                    pending_raw_data &lt;= {&#xa;                                        mpu_zh_read,&#xa;                                        byte_rx//不能是mpu_zl_read，因为是非阻塞赋值&#xa;                                    };//分两次采集数据，两次采完才合成新数据&#xa;                                    pending_sample&lt;=1;&#xa;                                    //最后一个字节后主机发送NACK&#xa;                                    master_ack_low&lt;=0;&#xa;                                    flow_step&lt;=17;&#xa;                                    cstate&lt;=ST_MASTER_ACK;&#xa;                                end&#xa;                                else begin&#xa;                                    transaction_ok&lt;=0;&#xa;                                    pending_sample&lt;=0;&#xa;                                    cstate&lt;=ST_STOP;&#xa;                                end&#xa;                            end&#xa;                            else begin&#xa;                                bit_count&lt;= bit_count-1;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_MASTER_ACK: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            // 高字节ACK后继续读取低字节&#xa;                            if(flow_step==15) begin&#xa;                                byte_rx&lt;=0;&#xa;                                bit_count&lt;=7;&#xa;                                flow_step&lt;=16;&#xa;                                cstate &lt;= ST_READ;&#xa;                            end&#xa;                            // 低字节NACK后产生STOP&#xa;                            else if(flow_step==17) begin&#xa;                                flow_step&lt;=18;&#xa;                                cstate&lt;=ST_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                transaction_ok&lt;=0;&#xa;                                pending_sample&lt;=0;&#xa;                                cstate&lt;=ST_STOP;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_STOP: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;&#xa;                        2'd2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SDA由低变高,STOP的标志&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;                        2'd3: begin&#xa;                            scl_r&lt;= 1;&#xa;                            sda_drive_low &lt;= 1'b0;&#xa;                            wait_count&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_WAIT;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_WAIT: begin//得在WAIT等10MS才能重新开始&#xa;                   scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;&#xa;                    if(wait_count == 12'd3999) begin&#xa;                        wait_count &lt;= 12'd0;&#xa;                        // 只有事务成功并且SDA已经恢复高电平，&#xa;                        // 才认为本次事务真正成功&#xa;                        if(transaction_ok &amp;&amp; sda_r2) begin&#xa;                            // 完成一个初始化寄存器&#xa;                            if(times&lt;4)&#xa;                                times &lt;= times+1;&#xa;                            // 五个初始化寄存器全部完成&#xa;                            else if(times==4) begin&#xa;                                times&lt;=5;&#xa;                                i2c_init_done &lt;= 1'b1;&#xa;                            end&#xa;                            // 完成一组Z轴高低字节读取&#xa;                            else begin&#xa;                                times&lt;=5;&#xa;                                if(pending_sample) begin&#xa;                                    raw_data_r &lt;= pending_raw_data;&#xa;                                    raw_data_vld_r&lt;=1;&#xa;                                    raw_data_vld_count&#xa;                                        &lt;= raw_data_vld_count + 1'b1;&#xa;                                        if(read_accel_z)begin&#xa;                                          accel_z_raw_r&lt;=pending_raw_data;&#xa;                                          accel_z_vld_r&lt;=1;&#xa;                                          raw_data_r&lt;=raw_data_r;&#xa;                                          raw_data_vld_r&lt;=0;&#xa;                                          gyro_read_count&lt;=0;&#xa;                                      end&#xa;                                    else begin&#xa;                                          gyro_read_count&lt;=gyro_read_count+1;&#xa;                                      end&#xa;                                end&#xa;                            end&#xa;                        end&#xa;                        pending_sample&lt;=0;&#xa;                        // SDA仍为低，重新执行9个恢复时钟&#xa;                        if(sda_r2==0) begin&#xa;                            recover_count&lt;=0;&#xa;                            cstate &lt;= ST_RECOVER;&#xa;                        end&#xa;                        else begin&#xa;                            cstate &lt;= ST_IDLE;&#xa;                        end&#xa;                    end&#xa;                    else begin&#xa;                        wait_count &lt;= wait_count + 1'b1;&#xa;                    end&#xa;                end&#xa;                default: begin&#xa;                    scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;&#xa;                    phase&lt;=0;&#xa;                    recover_count&lt;=0;&#xa;                    pending_sample&lt;=0;&#xa;                    cstate &lt;= ST_RECOVER;&#xa;                end&#xa;&#xa;            endcase&#xa;        end&#xa;    end&#xa;end&#xa;// 原始Z轴数据输出&#xa;//大致就是&#xa;//获取ACCEL_Z&#xa;//→建立动态重力基准&#xa;//→计算当前值偏离基准的绝对值&#xa;//→得到瞬时振动幅值&#xa;//→连续统计8次&#xa;//→计算8次平均值和最大峰值&#xa;//→扣除正常振动底噪&#xa;//→映射为0～15级粗糙度&#xa;assign raw_data = raw_data_r;&#xa; assign accel_z_raw=accel_z_raw_r;&#xa;  reg [15:0]accel_z_base;//ACCEL_Z动态重力基准&#xa;  reg accel_z_base_valid;//动态基准已经建立&#xa;  reg [15:0]vibration_data_r;//当前垂直振动幅值&#xa;  reg [18:0]vibration_sum;//8次振动幅值累加&#xa;  reg [2:0]vibration_count;//8次窗口计数&#xa;  reg [15:0]vibration_peak;//窗口内最大冲击&#xa;  parameter BASE_FILTER_SHIFT=4;//动态基准每次修正差值的1/16&#xa;  parameter IMPACT_THRESHOLD=3500;//强冲击标志阈值，我根据实车测试调整&#xa;  parameter PEAK_LEVEL_THRESHOLD=4000;//窗口峰值达到该值时粗糙度直接显示15&#xa;parameter FLAT_VIB_BASE=900;&#xa;parameter FLAT_VIB_MARGIN=300;&#xa;wire [15:0]roughness_effective=&#xa;(vibration_avg_next>FLAT_VIB_BASE+FLAT_VIB_MARGIN)?&#xa;(vibration_avg_next-FLAT_VIB_BASE-FLAT_VIB_MARGIN):&#xa;0;//这里的BASE是我根据实车悬空制定的，又加了冗余量，可以认为effective是我真实有用的值&#xa;  wire road_detect_enable=(car_state==1||car_state==2||car_state==4||car_state==8);//运动的时候检测&#xa;  wire [15:0]accel_up_diff=accel_z_raw_r-accel_z_base;&#xa;  wire [15:0]accel_down_diff=accel_z_base-accel_z_raw_r;&#xa;  wire [15:0]vibration_now=(accel_z_raw_r>=accel_z_base)?accel_up_diff:accel_down_diff;//当前加速度值和动态基准之间绝对差值&#xa;  wire [18:0]vibration_sum_next=vibration_sum+vibration_now;&#xa;  wire [15:0]vibration_avg_next=vibration_sum_next>>3;&#xa;  wire [15:0]vibration_peak_next=(vibration_now>vibration_peak)?vibration_now:vibration_peak;&#xa;  assign vibration_data=vibration_data_r;&#xa;  always@(posedge clk_50m or posedge rst)begin&#xa;      if(rst)begin&#xa;          accel_z_base&lt;=0;&#xa;          accel_z_base_valid&lt;=0;&#xa;          vibration_data_r&lt;=0;&#xa;          vibration_sum&lt;=0;&#xa;          vibration_count&lt;=0;&#xa;          vibration_peak&lt;=0;&#xa;          vibration_vld&lt;=0;&#xa;          mpu_dir_z&lt;=0;&#xa;          error_mpu_z&lt;=0;&#xa;      end&#xa;      else begin&#xa;          vibration_vld&lt;=0;&#xa;          if(accel_z_vld_r)begin&#xa;              if(!accel_z_base_valid)begin//刚开始第一次&#xa;                  accel_z_base&lt;=accel_z_raw_r;&#xa;                  accel_z_base_valid&lt;=1;&#xa;                  vibration_data_r&lt;=0;&#xa;                  vibration_sum&lt;=0;&#xa;                  vibration_count&lt;=0;&#xa;                  vibration_peak&lt;=0;&#xa;                  mpu_dir_z&lt;=0;&#xa;                  error_mpu_z&lt;=0;&#xa;              end&#xa;              else begin&#xa;                  if(accel_z_raw_r>=accel_z_base)&#xa;                      accel_z_base&lt;=accel_z_base+(accel_up_diff>>BASE_FILTER_SHIFT);&#xa;                  else&#xa;                      accel_z_base&lt;=accel_z_base-(accel_down_diff>>BASE_FILTER_SHIFT);//逐渐变化,故意不跟随新的值快速移动，不然路面的震动就没法检测了&#xa;                  if(road_detect_enable)begin//允许检测&#xa;                      vibration_data_r&lt;=vibration_now;&#xa;                      vibration_vld&lt;=1;&#xa;                      if(vibration_now>=IMPACT_THRESHOLD)//达到强冲击阈值&#xa;                          mpu_dir_z&lt;=1;&#xa;                      else&#xa;                          mpu_dir_z&lt;=0;&#xa;                      if(vibration_now>vibration_peak)&#xa;                          vibration_peak&lt;=vibration_now;&#xa;                      if(vibration_count>=7)begin//到了八次了&#xa;                          vibration_count&lt;=0;&#xa;                          vibration_sum&lt;=0;&#xa;                          vibration_peak&lt;=0;//窗口峰值也清0&#xa;                          if(vibration_peak_next>=PEAK_LEVEL_THRESHOLD)&#xa;                              error_mpu_z&lt;=15;&#xa;                          else if(roughness_effective>=1920)&#xa;                              error_mpu_z&lt;=15;&#xa;                          else&#xa;                              error_mpu_z&lt;=roughness_effective>>7;&#xa;                      end&#xa;                      else begin//没到八次&#xa;                          vibration_count&lt;=vibration_count+1;&#xa;                          vibration_sum&lt;=vibration_sum_next;&#xa;                      end&#xa;                  end&#xa;                  else begin&#xa;                      vibration_data_r&lt;=0;&#xa;                      vibration_sum&lt;=0;&#xa;                      vibration_count&lt;=0;&#xa;                      vibration_peak&lt;=0;&#xa;                      mpu_dir_z&lt;=0;&#xa;                      error_mpu_z&lt;=0;&#xa;                  end&#xa;              end&#xa;          end&#xa;      end&#xa;  end&#xa;  //姿态解算部分&#xa;  wire straight_enable=(car_state==4'b0001|| car_state==4'b0010);&#xa;  parameter YAW_KI_SHIFT  = 4;    // 积分衰减（右移4位，相当于除以16）&#xa;  parameter GYRO_KP_SHIFT = 2;   // 比例衰减（右移2位，相当于除以4）&#xa;  parameter ERROR_SPEED   = 5;  // 比例放大系数（修正力度）&#xa;  parameter GYRO_DEADBAND = 2;   // 剔除零漂后，用于过滤底盘震动的极小死区&#xa;  reg [6:0]calib_cnt;//计算有没有到达64次，到了之后就求零点的平均值&#xa;  reg [21:0]calib_sum;//计算初始64位数据的总和，本来一个数据是16位，也就是[15:0],加了64次也就是乘了2的6次方，左移6位&#xa;  reg calib_done;//初始零点计算有没有结束&#xa;  reg [15:0]zero_offset;//零点的平均值&#xa;  wire [21:0]gyro_ext={{6{raw_data[15]}},raw_data};//扩展到22位，方便累加&#xa;  reg [15:0]data_r;&#xa;  reg [31:0]yaw_integral;&#xa;  wire [15:0]true_gyro=raw_data-zero_offset;//真实值=原始值-零漂误差值&#xa;  wire true_gyro_sign=true_gyro[15];&#xa;  wire [15:0]true_gyro_abs=true_gyro_sign?(~true_gyro+1):true_gyro;&#xa;  wire yaw_sign=yaw_integral[31];&#xa;  wire [31:0]yaw_abs=yaw_sign?(~yaw_integral+1):yaw_integral;//求补码，如果是负数的话就是取反再加1&#xa;  wire gyro_r_sign=data_r[15];&#xa;  wire [15:0]gyro_r_abs=gyro_r_sign?(~data_r+1):data_r;&#xa;  wire [31:0]yaw_scaled=yaw_abs>>YAW_KI_SHIFT;&#xa;  wire [15:0]gyro_scaled=gyro_r_abs>>GYRO_KP_SHIFT;//补码右移&#xa;  wire [31:0]yaw_term=yaw_sign?(~yaw_scaled+1):yaw_scaled;&#xa;  wire [31:0]gyro_term=gyro_r_sign?({~{16'd0,gyro_scaled}+32'd1}):{16'd0,gyro_scaled};&#xa;  wire [31:0]ctrl_out=yaw_term+gyro_term;&#xa;  wire ctrl_sign=ctrl_out[31];&#xa;  wire [31:0]ctrl_abs=ctrl_sign?(~ctrl_out+1):ctrl_out;&#xa;wire [31:0]ctrl_effective=(ctrl_abs>3)?(ctrl_abs-3):0;&#xa;  wire [34:0]calc_error_full={3'd0,ctrl_effective}*ERROR_SPEED;;&#xa;wire [31:0]gyro_ext_32={{16{data_r[15]}},data_r};&#xa;wire [31:0]yaw_sum=yaw_integral+gyro_ext_32;&#xa;&#xa;wire yaw_overflow_pos=(~yaw_integral[31]) &amp;&amp; (~gyro_ext_32[31]) &amp;&amp; yaw_sum[31];//正数溢出，两个正数相加最后符号位变成了负数&#xa;wire yaw_overflow_neg=(yaw_integral[31]) &amp;&amp; (gyro_ext_32[31]) &amp;&amp; ~yaw_sum[31];//负数溢出，两个负数相加最后符号位变成了正数&#xa;localparam [31:0] CTRL_DEADBAND=128;&#xa;parameter RESTART_MAX=30_000_000;&#xa;reg [27:0]restart_cnt;//静止0.6s重新开始计算零漂值&#xa;reg restart_flag;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    &#x9;&#x9;restart_cnt&lt;=0;&#xa;            restart_flag&lt;=0;&#xa;            end&#xa;            else if(car_state==4'b0000) begin&#xa;            if(restart_cnt>=RESTART_MAX-1) begin&#xa;            &#x9;&#x9;&#x9;restart_cnt&lt;=RESTART_MAX-1;&#xa;                        restart_flag&lt;=1;&#xa;                        end&#xa;                  else restart_cnt&lt;=restart_cnt+1;&#xa;                end&#xa;                else begin&#xa;                restart_flag&lt;=0;&#xa;                restart_cnt&lt;=0;&#xa;                end&#xa;&#xa;end&#xa;reg restart_r;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#x9;if(rst)&#xa;&#x9;&#x9;restart_r&lt;=0;&#xa;        else restart_r&lt;=restart_flag;&#xa;&#xa;end&#xa;wire restart_pulse=restart_flag&amp;&amp; ~restart_r;&#xa;&#xa;wire [31:0] ctrl_level;&#xa;assign ctrl_level = ctrl_abs >> 7;&#xa;  always @ ( posedge clk_50m or posedge rst )&#xa;  begin //1&#xa;  &#x9;if(rst)begin//2&#xa;      &#x9;calib_cnt&lt;=0;&#xa;          calib_done&lt;=0;&#xa;          calib_sum&lt;=0;&#xa;          error_mpu&lt;=0;&#xa;          data_r&lt;=0;&#xa;          yaw_integral&lt;=0;&#xa;          zero_offset&lt;=0;&#xa;          mpu_dir&lt;=0;&#xa;   &#xa;      end//2&#xa;      else begin //3&#xa;    &#x9;&#x9;&#x9;if(restart_pulse &amp;&amp; i2c_init_done)begin&#xa;            calib_cnt&lt;= 0;&#xa;            calib_sum&lt;= 0;&#xa;            calib_done&lt;= 0;&#xa;&#xa;            // 清除上一次直线控制产生的累计误差&#xa;            data_r &lt;= 0;&#xa;            yaw_integral&lt;= 0;&#xa;            error_mpu&lt;= 0;&#xa;            mpu_dir&lt;= 0;&#xa;                end&#xa;      &#x9;else &#x9;begin//4&#xa;              if(~calib_done &amp;&amp; i2c_init_done &amp;&amp; raw_data_vld_r &amp;&amp; restart_flag)begin&#xa;   &#x9;&#x9;&#x9;&#x9;if(calib_cnt&lt;64) begin//5&#xa;                  calib_cnt&lt;=calib_cnt+1;&#xa;                  calib_done&lt;=0;&#xa;                  calib_sum&lt;=calib_sum+gyro_ext;//没到64次就一直累加&#xa;                  end//5&#xa;                  else begin//6&#xa;                  zero_offset&lt;=calib_sum[21:6];&#xa;                  calib_done&lt;=1;&#xa;                  calib_sum&lt;=0;&#xa;                  calib_cnt&lt;=0;&#xa;                  end//6&#xa;                 end&#xa;    else begin      // 不处于直行/后退状态时，&#xa;    // 清除本次直线控制的航向累计值&#xa;    if(calib_done &amp;&amp; !straight_enable) begin&#xa;        data_r       &lt;= 16'd0;&#xa;        yaw_integral &lt;= 32'd0;&#xa;        error_mpu    &lt;= 4'd0;&#xa;        mpu_dir      &lt;= 1'b0;&#xa;    end&#xa;   else  if(calib_done &amp;&amp; raw_data_vld_r)//自检完成&#xa;      begin//7&#xa;      &#x9;&#x9;&#x9;begin if(true_gyro_abs>GYRO_DEADBAND)&#xa;                  &#x9;data_r&lt;=true_gyro;&#xa;                   else data_r&lt;=0;&#xa;                  end&#xa;                  begin &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;if(yaw_overflow_pos)&#xa;    yaw_integral &lt;= 32'h7FFF_FFFF;  // 最大正数&#xa;else begin if(yaw_overflow_neg)&#xa;    yaw_integral &lt;= 32'h8000_0000;  // 最小负数&#xa;else&#xa;    yaw_integral &lt;= yaw_sum;&#xa;    end&#xa;    end&#xa;                     if(ctrl_abs &lt; CTRL_DEADBAND) begin&#xa;    error_mpu &lt;= 4'd0;&#xa;&#xa;    // error_mpu=0时方向没有控制意义&#xa;    mpu_dir &lt;= 1'b0;&#xa;end&#xa;else begin&#xa;    mpu_dir &lt;= ctrl_sign;&#xa;&#xa;    if(ctrl_level > 32'd15)&#xa;        error_mpu &lt;= 4'd15;&#xa;    else&#xa;        error_mpu &lt;= ctrl_level[3:0];&#xa;end&#xa;                                  end&#xa;                                  end&#xa;                                  end&#xa;            end  //4  &#xa;      end//3&#xa;  //1" Color="#d3d3d3" Comment="" Height="1080" Name="MPU_IIC_SENSOR" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="MPU_IIC_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="MPU_IIC_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="inout" Name="sda" Parent="MPU_IIC_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.819444"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="scl" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.111111"/>
 <Port Color="#f5f5dc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="raw_data" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.236111"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="mpu_dir" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.361111"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_100" Parent="MPU_IIC_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.152778"/>
 <Port Color="#ffebcd" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="error_mpu" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.486111"/>
 <Port Color="#0000ff" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="ack_err_code" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.861111"/>
 <Port Color="#8a2be2" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="MPU_IIC_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.319444"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="mpu_dir_z" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.611111"/>
 <Port Color="#deb887" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="error_mpu_z" Parent="MPU_IIC_SENSOR" Side="right" Width="30" X="0.98125" Y="0.736111"/>
 <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="vibration_data" Parent="MPU_IIC_SENSOR" Side="bottom" Width="30" X="0.240625" Y="0.972222"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="vibration_vld" Parent="MPU_IIC_SENSOR" Side="bottom" Width="30" X="0.490625" Y="0.972222"/>
 <Port Color="#d2691e" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="accel_z_raw" Parent="MPU_IIC_SENSOR" Side="bottom" Width="30" X="0.740625" Y="0.972222"/>
</Module>
