<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="//defparam SENSOR_TOP0.GAS_SENSOR0." Color="#d3d3d3" Comment="" Height="1080" Name="SENSOR_TOP" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="WEIGHT_SENSOR" Code="&#xa;    localparam IDLE=3'b000;//重力传感器处于空闲状态&#xa;    localparam WAIT=3'b001;//要从WAIT进入SHIFT得先等待50个时钟周期，也就是1us&#xa;    localparam SHIFT=3'b010;//从传感器接受24个数据&#xa;    localparam GAIN=3'b011;&#xa;    localparam DONE=3'b100;&#xa;    localparam DONE_TIME_MAX=24'd5_000_000;//防止因断线而锁死在DONE&#xa;    localparam HEAVY_ON=250;&#xa;    localparam HEAVY_OFF=200;&#xa;    localparam OVERLOAD_ON=550;&#xa;    localparam OVERLOAD_OFF=500;&#xa;    reg [23:0]done_time;&#xa;wire tare_zero=(key_cmd==9'b111_100_000);&#xa;reg tare_zero1;&#xa;reg tare_zero2;&#xa;reg tare_pending;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    tare_zero1&lt;=0;&#xa;    tare_zero2&lt;=0;&#xa;    tare_pending&lt;=0;&#xa;    end&#xa;    else begin&#xa;    tare_zero1&lt;=tare_zero;&#xa;    tare_zero2&lt;=tare_zero1;// 只允许停车状态下提出去皮请求&#xa;            if(tare_zero_pulse &amp;&amp; car_idle &amp;&amp; (~settle_timeout_fault))&#xa;            tare_pending&lt;=1;&#xa;        else if(tare_execute)//已经执行去皮&#xa;            tare_pending &lt;=0;&#xa;    end&#xa;end&#xa;wire tare_zero_pulse= tare_zero1 &amp;&amp; ~tare_zero2;&#xa;// 只有以下条件同时成立，才真正执行去皮：&#xa;// 1. 已完成开机零点校准&#xa;// 2. 当前有一组新的滤波结果可以使用&#xa;// 3. 小车处于静止状态&#xa;// 4. 当前没有锁存的载荷安全故障&#xa;wire tare_execute;&#xa;assign tare_execute =&#xa;       tare_pending&#xa;    &amp;&amp; zero_done&#xa;    &amp;&amp; filter_step&#xa;    &amp;&amp; (~raw_vld)&#xa;    &amp;&amp; car_idle&#xa;    &amp;&amp; (~settle_timeout_fault);&#xa;  wire clear_load_fault=key_cmd==9'b111_111_100;&#xa;reg clear_load_fault1;&#xa;reg clear_load_fault2;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    clear_load_fault1&lt;=0;&#xa;    clear_load_fault2&lt;=0;&#xa;    end&#xa;    else begin&#xa;        clear_load_fault1&lt;=clear_load_fault;&#xa;    clear_load_fault2&lt;=clear_load_fault1;&#xa;    end&#xa;end&#xa;wire clear_load_pulse=clear_load_fault1 &amp;&amp; ~clear_load_fault2;&#xa;wire car_idle;&#xa;reg car_idle_d;//保存上一拍的idle状态，用于触发脉冲&#xa;wire move_start;//车辆起步脉冲，只在静止切换到行驶时保持一个时钟周期&#xa;reg [23:0] moving_ref_weight;//车辆起步的时候冻结的载重基准，当作运动的时候基准&#xa;reg [23:0] moving_prev_weight;//上一组行驶重量，用于判断冲击前后的瞬时重量变化&#xa;reg moving_ref_valid;//行驶载重基准有效标志，防止基准尚未建立时误判&#xa;reg [15:0] moving_loss_cnt;//行驶过程中持续重量下降的连续确认计数器&#xa;reg moving_fault_reported;//单次行驶期间故障只上报一次，避免load_event_toggle反复翻转&#xa;reg impact_pending;//锁存MPU强冲击，直到下一组有效重量数据到达后再处理&#xa;reg impact_candidate;//强冲击并且重量突变后，进入货物移位候选状态&#xa;reg [15:0] impact_confirm_cnt;//冲击后重量偏差持续存在的确认计数器&#xa;wire [23:0] moving_loss_delta;//当前重量相对起步重量的累计下降量，只统计重量减少&#xa;wire [23:0] moving_ref_delta;//前重量相对起步重量的绝对偏差，用于判断货物移位&#xa;wire [23:0] moving_step_delta;//当前重量与上一组行驶重量的绝对差值，用于判断冲击瞬变&#xa;wire [23:0] moving_loss_threshold;//根据原参数和路面粗糙度计算行驶漏货阈值&#xa;wire [23:0] moving_loss_release;//行驶漏货计数解除阈值，形成迟滞以避免阈值附近抖动&#xa;wire moving_impact_effective;//当前冲击或已锁存冲击任一有效时，认为本组重量伴随冲击&#xa;assign car_idle=car_state==4'b0000;&#xa;assign move_start=car_idle_d &amp;&amp; !car_idle;//上一拍是静止，这一拍不是&#xa;assign moving_loss_delta=(moving_ref_weight>data)?moving_ref_weight-data:0;//只计算相对于起步基准的下降量，防止无符号减法溢出&#xa;assign moving_ref_delta=(moving_ref_weight>data)?moving_ref_weight-data:data-moving_ref_weight;//当前货舱内的质量和起步基准的绝对差值&#xa;assign moving_step_delta=(data>moving_prev_weight)?data-moving_prev_weight:moving_prev_weight-data;//相邻两组的差值&#xa;assign moving_loss_threshold=LOAD_EVENT_MIN+SETTLE_DELTA_MAX+{18'd0,road_roughness,2'b00};//粗糙度每增加1级，行驶阈值增加4&#xa;assign moving_loss_release=moving_loss_threshold>>1;//重量偏差回落到一半阈值以下时才清零漏货计数&#xa;assign moving_impact_effective=impact_pending||impact_flag;//当前周期信号和前面已经锁存的冲击信号&#xa;      localparam [23:0] LOAD_EVENT_MIN =3; // 最小有效载荷变化量，当前按3g设置&#xa;      localparam  EVENT_CONFIRM_NUM =20;// 连续这些组有效重量超过阈值后确认事件&#xa;      localparam  EVENT_CONFIRM_LAST = EVENT_CONFIRM_NUM-1; // 根据连续确认次数自动计算末次计数值&#xa;      localparam  SETTLE_DELTA_MAX =2;// 相邻两组重量变化不超过2g时认为趋于稳定&#xa;      localparam  SETTLE_CONFIRM_NUM=30;  // 连续30组稳定数据后重新设置基准值&#xa;      localparam  SETTLE_CONFIRM_LAST = SETTLE_CONFIRM_NUM -1; //根据稳定确认次数自动计算末次计数值&#xa;      localparam EVENT_ARMED =0; //等待新的装料或卸料事件状态&#xa;      localparam EVENT_SETTLE =1;// 事件已触发并等待重量稳定状态&#xa;      reg event_ctrl_state; // 载荷事件识别状态寄存器&#xa;      reg [23:0] load_ref_weight;//上一轮确认完成后的基准重量&#xa;      reg [23:0] load_prev_weight; // 上一组有效重量，用于判断当前重量是否稳定和是否产生新的基准重量&#xa;      reg load_ref_valid;//基准重量是否已经建立&#xa;      reg event_candidate_dir;// 重量变化的方向，1表示增加，0表示减少&#xa;      reg [9:0] event_confirm_cnt;//事件连续确认计数器&#xa;      reg [9:0] settle_confirm_cnt; // 重量稳定连续确认计数器&#xa;      wire [23:0] load_ref_delta;//当前重量与基准重量之间的绝对差值&#xa;      wire [23:0] load_step_delta;// 当前重量与上一组重量之间的绝对差值&#xa;      wire load_current_dir;  // 当前重量变化方向，1表示增加，0表示减少&#xa;    reg [23:0]data_r;//临时存储数据&#xa;    reg [7:0]delay_cnt;//由WAIT进入SHIFIT,延迟1us&#xa;    reg [7:0]shift_cnt;//SHIFT持续的时间，接受24个数据&#xa;    reg [2:0]cstate;&#xa;    reg [2:0]nstate;&#xa;    reg [8:0] tick_r;&#xa;    reg tick_10us;&#xa;    reg [23:0] raw_data;&#xa;    reg raw_vld;&#xa;    reg [23:0]d1,d2,d3;//3次前后挨着的原始值，用来干中值滤波&#xa;    reg [23:0]avg_buf[0:7];&#xa;    reg [23:0]zero_offset;//原始的带皮质量，需要拿raw_data-zero_offset才能得到去皮质量data&#xa;    reg [31:0]zero_sum;//开机前16个有效数据的总和&#xa;    reg [7:0]zero_cnt;&#xa;    reg zero_done;&#xa;    reg dout_r1,dout_r2,dout_r3;&#xa;    wire [23:0]med_val;&#xa;    wire [27:0]sum_all;//8次中值滤波后的值相加&#xa;    wire [23:0]avg_val;&#xa;    assign load_ref_delta=(data>load_ref_weight)?(data-load_ref_weight):(load_ref_weight-data);//当前重量与基准重量的变化量&#xa;    assign load_step_delta=(data>load_prev_weight)?(data-load_prev_weight):(load_prev_weight-data);//当前重量与上一组重量的变化量&#xa;&#xa;    assign load_current_dir=(data>=load_ref_weight)?1:0;//当前的重量大于等于基准重量的时候就判定为1，也就是增加方向&#xa;    assign sum_all={4'd0,avg_buf[0]}+{4'd0,avg_buf[1]}+{4'd0,avg_buf[2]}+{4'd0,avg_buf[3]}+{4'd0,avg_buf[4]}+{4'd0,avg_buf[5]}+{4'd0,avg_buf[6]}+{4'd0,avg_buf[7]};&#xa;    assign avg_val=sum_all[26:3];&#xa;    assign med_val=(d3>d2)?&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;((d2>d1)?d2:(d3>d1)?d1:d3):&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;((d3>d1)?d3:(d2>d1)?d1:d2);  &#xa;    always @ (  posedge clk_50m or posedge rst)&#xa;    begin &#xa;    &#x9;&#x9;if(rst)&#xa;            &#x9;&#x9;{dout_r3,dout_r2,dout_r1}&lt;=3'b111;&#xa;                    else                          &#x9;&#x9;{dout_r3,dout_r2,dout_r1}&lt;={dout_r2,dout_r1,dout};&#xa;                    end&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst) begin&#xa;        tick_10us&lt;=0;&#xa;        tick_r&lt;=0;&#xa;        end&#xa;        else begin&#xa;        if(cstate==SHIFT||cstate==GAIN) begin&#xa;        &#x9;if(tick_r&lt;499)begin&#xa;            tick_r&lt;=tick_r+1;&#xa;            tick_10us&lt;=0;&#xa;            end&#xa;            else if(tick_r==499) begin&#xa;            &#x9;&#x9;tick_10us&lt;=1;&#xa;                    tick_r&lt;=0;&#xa;            end&#xa;            end&#xa;            else begin&#xa;                   &#x9;&#x9;tick_10us&lt;=0;&#xa;                    tick_r&lt;=0;   &#xa;            end&#xa;        &#xa;            end&#xa;        end&#xa;        &#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        cstate&lt;=IDLE;&#xa;        else cstate&lt;=nstate;&#xa;    end&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        sck&lt;=0;&#xa;        else if(cstate==SHIFT|| cstate==GAIN)begin&#xa;        &#x9;&#x9;&#x9;if(tick_10us)&#xa;        &#x9;&#x9;&#x9;sck&lt;=~sck;&#xa;                    end&#xa;                    else sck&lt;=0;&#xa;    end&#xa;    always @ ( * )&#xa;    begin&#xa;    case( cstate )&#xa;    IDLE:if(~dout_r3) nstate=WAIT;&#xa;    &#x9;else nstate=IDLE;&#xa;    WAIT:if(delay_cnt==49) nstate=SHIFT;&#xa;    &#x9;else nstate=WAIT;&#xa;    SHIFT:if(shift_cnt==23 &amp;&amp; tick_10us &amp;&amp; sck) nstate=GAIN;&#xa;    &#x9;else nstate=SHIFT;&#xa;    GAIN:if(tick_10us &amp;&amp; sck)   nstate=DONE;&#xa;    &#x9;&#x9;else nstate=GAIN;&#xa;    DONE :if(dout_r3==1) begin nstate = IDLE;&#xa;    end&#xa;    else begin&#xa;    &#x9;if(done_time>=DONE_TIME_MAX-1) begin&#xa;        &#x9;&#x9;nstate=IDLE;&#xa;                end&#xa;         else  begin nstate=DONE;&#xa;        end &#xa;                &#xa;    end&#xa;    &#xa;        default: nstate=IDLE;&#xa;    endcase&#xa;    end&#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst) begin&#xa;        &#x9;&#x9;delay_cnt&lt;=0;&#xa;                done_time&lt;=0;&#xa;                end&#xa;         else begin  if(cstate==WAIT) begin&#xa;        &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(delay_cnt&lt;49) &#xa;                    delay_cnt&lt;=delay_cnt+1;&#xa;                    &#x9;&#x9;&#x9;else  delay_cnt&lt;=0;&#xa;                                end&#xa;                else delay_cnt&lt;=0;//非WAIT状态，归0&#xa;               if(cstate==DONE &amp;&amp; dout_r3==0) done_time&lt;=done_time+1;&#xa;            else done_time&lt;=0;&#xa;                end                &#xa;    end&#xa;    always@(posedge clk_50m or posedge rst)begin&#xa;    &#x9;if(rst)begin&#xa;        shift_cnt&lt;=0;&#xa;        data_r&lt;=0;&#xa;        raw_vld&lt;=0;&#xa;        end&#xa;        else begin&#xa;        raw_vld&lt;=0;&#xa;        case( cstate)&#xa;        IDLE:begin&#xa;        shift_cnt&lt;=0;&#xa;        data_r&lt;=0;&#xa;        end&#xa;        WAIT:begin&#xa;        shift_cnt&lt;=0;&#xa;        end&#xa;        SHIFT:begin&#xa;        if(tick_10us)&#xa;        &#x9;&#x9;if(sck) begin&#xa;        &#x9;&#x9;&#x9;if(shift_cnt&lt;23) begin&#xa;        &#x9;&#x9;data_r[23-shift_cnt]&lt;=dout_r3;&#xa;            shift_cnt&lt;=shift_cnt+1;&#xa;        end&#xa;        else begin&#xa;        &#x9;&#x9;if(shift_cnt==23) begin&#xa;                raw_data&lt;=  {data_r[23:1], dout_r3} ^ 24'h800000;&#xa;                          // raw_data&lt;=  {data[23],data_r[22:1], dout_r3};&#xa;                shift_cnt&lt;=24;&#xa;                raw_vld&lt;=1;&#xa;                end&#xa;        end&#xa;        end&#xa;        end &#xa;            default:  begin &#xa;                             shift_cnt&lt;=0;&#xa;        &#x9;&#x9;&#x9;&#x9;&#x9;end&#xa;        endcase&#xa;        end&#xa;    end&#xa;    reg filter_step;&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin //1&#xa;    &#x9;if(rst)begin&#xa;        d3&lt;=0;d2&lt;=0;d1&lt;=0;zero_offset&lt;=0;zero_cnt&lt;=0;avg_buf[0]&lt;=0;avg_buf[1]&lt;=0;avg_buf[2]&lt;=0;avg_buf[3]&lt;=0;avg_buf[4]&lt;=0;avg_buf[5]&lt;=0;avg_buf[6]&lt;=0;avg_buf[7]&lt;=0;heavy_load_state&lt;=0;&#xa;        overload_state&lt;=0;&#xa;        data&lt;=0;&#xa;        zero_done&lt;=0;zero_sum&lt;=0;&#xa;        filter_step&lt;=0;&#xa;        data_vld&lt;=0;&#xa;        end&#xa;        else begin&#xa;        data_vld&lt;=0;&#xa;        if(raw_vld)begin//3&#xa;  &#xa;  &#xa;        &#x9;&#x9;d3&lt;=d2;d2&lt;=d1;d1&lt;=raw_data;//第一级流水线&#xa;            filter_step&lt;=1;&#xa;            end &#xa;            else if(filter_step)begin//第二级流水线&#xa;            filter_step &lt;= 1'b0;&#xa;                    avg_buf[7] &lt;= avg_buf[6]; avg_buf[6] &lt;= avg_buf[5];&#xa;                    avg_buf[5] &lt;= avg_buf[4]; avg_buf[4] &lt;= avg_buf[3];&#xa;                    avg_buf[3] &lt;= avg_buf[2]; avg_buf[2] &lt;= avg_buf[1];&#xa;                    avg_buf[1] &lt;= avg_buf[0]; avg_buf[0] &lt;= med_val;&#xa;            if(~zero_done)begin&#xa;            &#x9;&#x9;if(zero_cnt&lt;26)begin&#xa;                    data_vld&lt;=0;&#xa;                    zero_cnt&lt;=zero_cnt+1;&#xa;                    if(zero_cnt>=10)//先让前面的10个值生成一个avg_val&#xa;                    &#x9;&#x9;zero_sum&lt;=zero_sum+avg_val;&#xa;                            end&#xa;                            else  begin zero_done&lt;=1;//完成&#xa;                            zero_offset&lt;=zero_sum[27:4];&#xa;                            end&#xa;            end//零点校验还没完成&#xa;            else //零点校验完成之后&#xa;            begin data_vld&lt;=1;&#xa;            if(tare_execute) begin&#xa;        zero_offset&lt;=avg_val;&#xa;        data&lt;=0;&#xa;        // 当前重量已经重新定义为0，因此清除载重状态&#xa;        heavy_load_state&lt;=0;&#xa;        overload_state&lt;=0;&#xa;    end&#xa;           else begin &#x9;&#x9;if(avg_val>zero_offset)&#xa;                    &#x9;data&lt;=(avg_val-zero_offset)/413;//avg_val-zero_offset;&#xa;                  else data&lt;=(zero_offset-avg_val)/413;//zero_offset-avg_val;&#xa;                if(heavy_load_state==0) begin//迟滞比较，也就是判断从非重载到重载，从重载到非重载的阈值不是同一个数&#xa;                &#x9;&#x9;if(data>HEAVY_ON)&#xa;                        &#x9;heavy_load_state&lt;=1;&#xa;                end&#xa;                else begin&#xa;                &#x9;&#x9;if(data&lt;HEAVY_OFF)&#xa;                        heavy_load_state&lt;=0;&#xa; &#xa;                end&#xa;                         if(overload_state==0) begin&#xa;                        &#x9;&#x9;if(data>OVERLOAD_ON)&#xa;                        &#x9;&#x9;overload_state&lt;=1;&#xa;                                end&#xa;                        else if(data&lt;OVERLOAD_OFF)&#xa;                        &#x9;&#x9;&#x9;overload_state&lt;=0;&#xa;                end&#xa;                end&#xa;            end&#xa;        end//2&#xa;        end//1&#xa;  reg [7:0] stop_cnt;//比如说货舱漏了，一直漏矿物，我就得上报并且紧急停车&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;              event_ctrl_state&lt;=EVENT_ARMED; &#xa;              load_ref_weight&lt;=0; &#xa;              load_prev_weight&lt;=0;&#xa;              load_ref_valid&lt;=0; &#xa;              event_candidate_dir&lt;=0; &#xa;              event_confirm_cnt&lt;=0; &#xa;              settle_confirm_cnt&lt;=0;&#xa;              load_event_state&lt;=0; &#xa;              load_event_toggle&lt;=0; &#xa;              load_change_amount&lt;=0; &#xa;            stop_cnt&lt;=0;&#xa;            settle_timeout_fault&lt;=0;&#xa;            car_idle_d&lt;=1;&#xa;            moving_ref_weight&lt;=0;&#xa;            moving_prev_weight&lt;=0;&#xa;            moving_ref_valid&lt;=0;&#xa;            moving_loss_cnt&lt;=0;&#xa;            moving_fault_reported&lt;=0;&#xa;            impact_pending&lt;=0;&#xa;            impact_candidate&lt;=0;//清空货物移位候选状态&#xa;            impact_confirm_cnt&lt;=0;//清空冲击后重量偏差确认次数&#xa;    end&#xa;    else begin&#xa;       if(tare_execute) begin&#xa;        // 去皮后显示重量为0，因此装卸基准也设置为0&#xa;        load_ref_weight&lt;=0;&#xa;        load_prev_weight&lt;=0;&#xa;        load_ref_valid&lt;=1;&#xa;        event_ctrl_state&lt;=EVENT_ARMED;&#xa;        event_candidate_dir&lt;=0;&#xa;        event_confirm_cnt&lt;=0;&#xa;        settle_confirm_cnt&lt;=0;&#xa;        stop_cnt&lt;=0;&#xa;        load_event_state&lt;=2'b00;&#xa;        load_change_amount&lt;=0;&#xa;        // 清除行驶载荷检测使用的旧重量基准&#xa;        moving_ref_weight&lt;=0;&#xa;        moving_prev_weight&lt;=0;&#xa;        moving_ref_valid&lt;=0;&#xa;        moving_loss_cnt&lt;=0;&#xa;        moving_fault_reported&lt;=0;&#xa;        impact_pending&lt;=0;&#xa;        impact_candidate&lt;= 0;&#xa;        impact_confirm_cnt&lt;=0;&#xa;        car_idle_d&lt;=1;&#xa;    end&#xa;&#xa;     else   if(clear_load_pulse &amp;&amp; car_idle) begin&#xa;    settle_timeout_fault &lt;= 1'b0;&#xa;    load_event_state     &lt;= 2'b00;&#xa;    // 以故障处理后的当前重量建立新基准,这样就能修改掉之前出现的行驶过程中漏货正常显示问题，但是一停车之后就会显示故障和timeout_fault锁存的问题&#xa;    load_ref_weight&lt;= data;&#xa;    load_prev_weight&lt;= data;&#xa;    load_ref_valid &lt;=1;&#xa;    event_ctrl_state&lt;= EVENT_ARMED;&#xa;    event_confirm_cnt&lt;=0;&#xa;    settle_confirm_cnt&lt;=0;&#xa;    stop_cnt&lt;=0;&#xa;    moving_loss_cnt&lt;=0;&#xa;    moving_fault_reported&lt;=0;&#xa;    impact_candidate&lt;=0;&#xa;    impact_confirm_cnt&lt;= 0;&#xa;end&#xa;else begin&#xa;    car_idle_d&lt;=car_idle;&#xa;    &#x9;&#x9;if(impact_flag &amp;&amp; ~car_idle)&#xa;            &#x9;impact_pending&lt;=1;&#xa;                if(car_idle) begin//静止的时候清零&#xa;                moving_loss_cnt&lt;=0;&#xa;                impact_pending&lt;=0;&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                end&#xa;                if(move_start) begin&#xa;                moving_ref_weight&lt;=load_ref_weight;&#xa;                moving_prev_weight&lt;=data;&#xa;                moving_ref_valid&lt;=load_ref_valid;//只有原静止载重基准有效时才允许形式漏货判断&#xa;                moving_loss_cnt&lt;=0;//每次起步都清0&#xa;                moving_fault_reported&lt;=0;//每次起步允许本段行驶过程中上报一次载荷故障&#xa;                impact_pending&lt;=0;&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                settle_confirm_cnt&lt;=0;&#xa;                stop_cnt&lt;=0;&#xa;                &#xa;                &#xa;                end&#xa;    &#x9;&#x9;&#x9;if(data_vld)begin// 行驶载荷故障已经发生时，&#xa;    // 禁止静止装卸状态机把2'b11覆盖成普通卸货2'b10&#xa;    if(settle_timeout_fault) begin&#xa;        load_event_state &lt;= 11;&#xa;        event_ctrl_state&lt;=EVENT_ARMED;&#xa;        event_confirm_cnt&lt;=0;&#xa;        settle_confirm_cnt&lt;=0;&#xa;        stop_cnt&lt;=0;&#xa;        // 保存当前重量，避免恢复后相邻数据差值异常&#xa;        load_prev_weight    &lt;= data;&#xa;    end&#xa;                if(load_ref_valid==0) begin//还没建立基准&#xa;                &#x9;&#x9;load_ref_weight&lt;=data;//默认的基准值是刚开始的data也就是0&#xa;                     load_prev_weight&lt;=data;//上一组值，也就是0&#xa;                    load_ref_valid&lt;=1;&#xa;                    event_ctrl_state&lt;=EVENT_ARMED;//进入等待事件状态&#xa;                    event_candidate_dir&lt;=0;//清除候选变化方向&#xa;                    event_confirm_cnt&lt;=0;//清零事件确认计数器&#xa;                    settle_confirm_cnt&lt;=0;//清零稳定确认计数器&#xa;                    stop_cnt&lt;=0;&#xa;                    moving_prev_weight&lt;=data;//初始载重基准建立时同步保存重量，避免首次起步的顺时差值无效&#xa;                end//建立初始基准结束&#xa;                else if(car_idle) begin//只有车辆静止时才执行原有装料，卸料和稳定检测状态机&#xa;                &#x9;&#x9;&#x9;case(event_ctrl_state)&#xa;                        EVENT_ARMED:begin&#xa;                        stop_cnt&lt;=0;&#xa;                        load_prev_weight&lt;=data;&#xa;                        settle_confirm_cnt&lt;=0;//等待事件的时候清零稳定确认计数器&#xa;                        if(load_ref_delta>=LOAD_EVENT_MIN)//相对基准值的变化量达到了阈值&#xa;                        begin&#xa;                        &#x9;&#x9;if(event_confirm_cnt==0)begin&#xa;                                event_candidate_dir&lt;=load_current_dir;&#xa;                                event_confirm_cnt&lt;=1;&#xa;                                end&#xa;                             else begin&#xa;                            &#x9;&#x9;&#x9;if(event_candidate_dir==load_current_dir) begin//如果上一回的变化方向和这一回的相等&#xa;                                        &#x9;&#x9;if(event_confirm_cnt>=EVENT_CONFIRM_LAST) begin//次数够了&#xa;                                                event_ctrl_state&lt;=EVENT_SETTLE;&#xa;                                                settle_confirm_cnt&lt;=0;&#xa;                                                event_confirm_cnt&lt;=0;&#xa;                                                load_change_amount&lt;=load_ref_delta;//变化量就是当前重量和基准量的差值&#xa;                                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                                &#x9;&#x9;if(load_current_dir==1) begin&#xa;                                                        load_event_state&lt;=2'b01;//锁存装料状态&#xa;                                                        end&#xa;                                                        else begin load_event_state&lt;=2'b10;end&#xa;                                                end&#xa;                                                else event_confirm_cnt&lt;=event_confirm_cnt+1;&#xa;                                        end&#xa;                                        else begin&#xa;                                        event_candidate_dir&lt;=load_current_dir;//开启新一轮&#xa;                                        event_confirm_cnt&lt;=1;&#xa;                                        end&#xa;                            end&#xa;                        end&#xa;                             else event_confirm_cnt&lt;=0;//没到阈值&#xa;                        end&#xa;                        EVENT_SETTLE: begin&#xa;                        load_change_amount&lt;=load_ref_delta;&#xa;                        load_prev_weight&lt;=data;//供下一组判断稳定性&#xa;                        event_confirm_cnt&lt;=0;&#xa;              if(load_step_delta&lt;=SETTLE_DELTA_MAX&amp;&amp;settle_confirm_cnt>=SETTLE_CONFIRM_LAST) begin//稳定&#xa;                                        load_ref_weight&lt;=data;&#xa;                                        event_ctrl_state&lt;=EVENT_ARMED;&#xa;                                        settle_confirm_cnt&lt;=0;&#xa;                                        stop_cnt&lt;=0;&#xa;                                        end&#xa;                                        else  begin if(stop_cnt>=99) begin//没稳定&#xa;                                        &#x9;&#x9;&#x9;&#x9;&#x9;settle_timeout_fault&lt;=1;//超时了还没稳定我就强行停车，疑似漏货&#xa;                                                            stop_cnt&lt;=stop_cnt;end&#xa;                                                        else stop_cnt&lt;=stop_cnt+1; &#xa;                                        &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(load_step_delta&lt;=SETTLE_DELTA_MAX)&#xa;                                                &#x9;&#x9;&#x9;settle_confirm_cnt&lt;=settle_confirm_cnt+1;&#xa;                                                    else settle_confirm_cnt&lt;=0;&#xa;                                                    end&#xa;                        end&#xa;                        default:begin&#xa;                        event_ctrl_state&lt;=EVENT_ARMED;&#xa;                        event_candidate_dir&lt;=0;&#xa;                        settle_confirm_cnt&lt;=0;&#xa;                        event_confirm_cnt&lt;=0;&#xa;                        stop_cnt&lt;=0;&#xa;                        end&#xa;                        endcase&#xa;                        end&#xa;                        else begin//行驶过程中&#xa;                        load_prev_weight&lt;=data;//行驶时只更新相邻重量参考&#xa;                        moving_prev_weight&lt;=data;//保存本组行驶重量，供下一组计算瞬时重量变化&#xa;                        if(moving_ref_valid)begin//起步载重基准有效时&#xa;                        &#x9;&#x9;if(moving_loss_delta>=moving_loss_threshold)//当前重量相对起步重量的变化量达到了设定的阈值&#xa;                                 begin&#xa;                                &#x9;if(moving_loss_cnt&lt;EVENT_CONFIRM_LAST)&#xa;                                    moving_loss_cnt&lt;=moving_loss_cnt+1;&#xa;                                    else moving_loss_cnt&lt;=moving_loss_cnt;//达到上限就锁存    &#xa;                                    end                    &#xa;                        else if(moving_loss_delta&lt;=moving_loss_release)&#xa;                        &#x9;&#x9;&#x9;moving_loss_cnt&lt;=0;&#xa;                          if(moving_impact_effective &amp;&amp; moving_step_delta>=moving_loss_threshold) begin&#xa;                        impact_candidate&lt;=1;//进入冲击后重量持续偏差确认阶段&#xa;                        impact_confirm_cnt&lt;=0;&#xa;                        impact_pending&lt;=0;&#xa;                        end&#xa;                        else if(impact_candidate)begin&#xa;                        if(moving_ref_delta>=moving_loss_threshold) begin//冲击后重量相对基准仍然存在明显偏差&#xa;                        &#x9;&#x9;if(impact_confirm_cnt&lt;=SETTLE_CONFIRM_LAST)&#xa;                                impact_confirm_cnt&lt;=impact_confirm_cnt+1;&#xa;                             else impact_confirm_cnt&lt;=impact_confirm_cnt;&#xa;                       end&#xa;                        else if(moving_ref_delta&lt;=moving_loss_release)begin//小于释放值&#xa;                        impact_candidate&lt;=0;//取消货物位移候选状态&#xa;                        impact_confirm_cnt&lt;=0;&#xa;                        end&#xa;                           else//在中间&#xa;    begin&#xa;        impact_candidate &lt;= impact_candidate;//保持候选状态&#xa;        impact_confirm_cnt &lt;= impact_confirm_cnt;//保持当前确认次数&#xa;    end&#xa;    end&#xa;                        if(~moving_fault_reported)begin//本段行驶还没有上报过载荷安全故障时才允许触发&#xa;                        &#x9;&#x9;if(impact_candidate &amp;&amp; moving_ref_delta>=moving_loss_threshold &amp;&amp; impact_confirm_cnt>=SETTLE_CONFIRM_LAST)begin//冲击后重量偏差持续达到确认次数，判定位货物移位或者说是掉落&#xa;                                settle_timeout_fault&lt;=1;&#xa;                                load_event_state&lt;=2'b11;&#xa;                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                load_change_amount&lt;=moving_ref_delta;//记录当前重量和起步基准的绝对变化量&#xa;                                moving_fault_reported&lt;=1;&#xa;                                impact_candidate&lt;=0;//故障确认后推出冲击候选判断&#xa;                                end&#xa;                                else if(moving_loss_delta>=moving_loss_threshold&amp;&amp; moving_loss_cnt>=EVENT_CONFIRM_LAST)begin//重量相对起步基准持续下降达到指定的阈值次数，判定为行驶漏货&#xa;                                settle_timeout_fault&lt;=1;&#xa;                                load_event_state&lt;=2'b11;&#xa;                                load_event_toggle&lt;=~load_event_toggle;&#xa;                                load_change_amount&lt;=moving_loss_delta;&#xa;                                moving_fault_reported&lt;=1;&#xa;                                end&#xa;                        end&#xa;                end&#xa;                else begin&#xa;                moving_loss_cnt&lt;=0;//基准无效时都取消&#xa;                impact_candidate&lt;=0;&#xa;                impact_confirm_cnt&lt;=0;&#xa;                impact_pending&lt;=0;&#xa;                end&#xa;                end&#xa;                end&#xa;    end&#xa;end&#xa;end &#xa;" Color="aqua" Comment="" Height="439" Name="WEIGHT_SENSOR2" Parameters="" Parent="SENSOR_TOP" Type="model" Width="402" X="106.5" Y="126">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="WEIGHT_SENSOR2" Side="left" Width="30" X="-0.0746269" Y="0.628702"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="WEIGHT_SENSOR2" Side="left" Width="30" X="-0.0746269" Y="0.797267"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="dout" Parent="WEIGHT_SENSOR2" Side="bottom" Width="30" X="0.462687" Y="0.931663"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sck" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.671982"/>
  <Port Color="#ffe4c4" Connect="" Datasize="24" Datatype="reg" Description="" Height="30" Inout="output" Name="data" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.813212"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="data_vld" Parent="WEIGHT_SENSOR2" Side="top" Width="30" X="0.161692" Y="-0.0683371"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="heavy_load_state" Parent="WEIGHT_SENSOR2" Side="top" Width="30" X="0.360697" Y="-0.0683371"/>
  <Port Color="#ffebcd" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="load_event_state" Parent="WEIGHT_SENSOR2" Side="left" Width="30" X="-0.0746269" Y="0.129841"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="load_event_toggle" Parent="WEIGHT_SENSOR2" Side="left" Width="30" X="-0.0746269" Y="0.296128"/>
  <Port Color="#8a2be2" Connect="" Datasize="24" Datatype="reg" Description="" Height="30" Inout="output" Name="load_change_amount" Parent="WEIGHT_SENSOR2" Side="left" Width="30" X="-0.0746269" Y="0.462415"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="settle_timeout_fault" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.248292"/>
  <Port Color="#deb887" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.389522"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="overload_state" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.530752"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="impact_flag" Parent="WEIGHT_SENSOR2" Side="top" Width="30" X="0.557214" Y="-0.0683371"/>
  <Port Color="#d2691e" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="road_roughness" Parent="WEIGHT_SENSOR2" Side="right" Width="30" X="0.925373" Y="0.107062"/>
  <Port Color="#ff7f50" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="WEIGHT_SENSOR2" Side="top" Width="30" X="0.756219" Y="-0.0683371"/>
 </Module>
 <Module Category="Current" Class="TRACKING_SENSOR" Code="    // 1：传感器检测到轨迹时输出高电平&#xa;    // 0：传感器检测到轨迹时输出低电平&#xa;    parameter SENSOR_ACTIVE_HIGH=1;&#xa;    // en_10k为10 kHz时：&#xa;    // 2000次  = 200 ms&#xa;    // 10000次 = 1000 ms&#xa;    // 20000次 = 2000 ms&#xa; parameter  LOST_PREDICT_COUNT = 10000;//1s&#xa; parameter  LOST_SEARCH_COUNT= 20000;//2s&#xa; parameter  LOST_STOP_COUNT= 30000;//3s&#xa;localparam [1:0]MODE_NORMAL=2'b00;//正常循迹模式&#xa;localparam [1:0]MODE_DEGRADED=2'b01;//降级循迹，PWM适当减速&#xa;localparam [1:0]MODE_RECOVERY=2'b10;//断轨预测恢复，PWM应当低速&#xa;localparam [1:0]MODE_STOP=2'b11;//脱轨，应当安全停车&#xa;//第一层，先三级打拍同步防止亚稳态&#xa;reg [7:0]sync_1; &#xa;reg [7:0]sync_2;&#xa;reg [7:0]sync_3;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;&#x9;if(rst) begin&#xa;        sync_1&lt;=8'b0000_0000;&#xa; sync_2&lt;=8'b0000_0000;&#xa; sync_3&lt;=8'b0000_0000;&#xa;        end else begin&#xa;        sync_1&lt;=direction_in;&#xa;        sync_2&lt;=sync_1;&#xa;        sync_3&lt;=sync_2;&#xa;        end&#xa;end&#xa;wire [7:0]sensor_active=SENSOR_ACTIVE_HIGH?sync_3:~sync_3;//方便换灰度传感器的时候改&#xa;//第二层，时域下五点多数滤波，之前的三次一致有点太苛刻了&#xa;//每一路传感器都比较最近五次的结果，大于等于3次是1就认为是1&#xa;reg [7:0]sample_0;&#xa;reg [7:0]sample_1;&#xa;reg [7:0]sample_2;&#xa;reg [7:0]sample_3;&#xa;reg [7:0]sample_4;&#xa;reg [2:0]sample_fill_count;&#xa;wire samples_ready=(sample_fill_count==5);&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;    sample_0&lt;=8'b0000_0000;&#xa;            sample_1&lt;=8'b0000_0000;&#xa;            sample_2&lt;=8'b0000_0000;&#xa;            sample_3&lt;=8'b0000_0000;&#xa;            sample_4&lt;=8'b0000_0000;&#xa;            sample_fill_count&lt;=0;&#xa;    end&#xa;    else if(en_10k) begin&#xa;    sample_0&lt;=sensor_active;&#xa;    sample_1&lt;=sample_0;&#xa;    sample_2&lt;=sample_1;&#xa;    sample_3&lt;=sample_2;&#xa;    sample_4&lt;=sample_3;&#xa;    &#x9;&#x9;&#x9;if(sample_fill_count&lt;5)&#xa;                &#x9;sample_fill_count&lt;=sample_fill_count+1;&#xa;    end&#xa;end&#xa;integer i_major;&#xa;integer majority_sum;&#xa;reg [7:0]direction_majority;&#xa;always @ ( * )&#xa;begin &#xa;&#x9;&#x9;direction_majority=8'b0000_0000;&#xa;        majority_sum=0;&#xa;        for(i_major=0;i_major&lt;8;i_major++)begin&#xa;        majority_sum=sample_0[i_major]+sample_1[i_major]+sample_2[i_major]+sample_3[i_major]+sample_4[i_major];&#xa;        if(majority_sum>=3)&#xa;        &#x9;&#x9;direction_majority[i_major]=1;&#xa;         else direction_majority[i_major]=0;&#xa;        end&#xa;  end&#xa; //第三层，统计八路传感器的有效数量&#xa;function [3:0]count_ones8;&#xa;&#x9;&#x9;input [7:0]value;&#xa;        integer k_count;&#xa;        begin&#xa;        count_ones8=0;&#xa;        for(k_count=0;k_count&lt;8;k_count++)begin&#xa;        count_ones8=count_ones8+value[k_count];&#xa;        end&#xa;        end&#xa;            endfunction&#xa;  wire  [3:0]raw_active_count=count_ones8(direction_majority);&#xa;//第四层，健康度诊断，每一路传感器具有四位健康值&#xa;//12-15，健康；8-11轻度退化，4-7严重退化，0-3故障&#xa;//诊断依据有两种，第一种是时间依据，固定窗口内频繁反转，可能是矿场内强电磁干扰，粉尘，接触不良&#xa;//第二种是空间依据，内部传感器长期与相邻传感器矛盾&#xa;//健康度不会因为一次异常直接变成故障，而是逐渐下降，反之亦然，也是正常后也是逐渐恢复&#xa;reg [3:0]sensor_health[0:7];&#xa;reg [7:0]toggle_count[0:7];&#xa;reg [7:0]contradiction_count[0:7];&#xa;reg [7:0]direction_last;&#xa;reg [7:0]diag_window_count;&#xa;integer i_diag;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    direction_last&lt;=8'b0000_0000;&#xa;    diag_window_count&lt;=0;&#xa;    &#x9;&#x9;for(i_diag=0;i_diag&lt;8;i_diag++) begin&#xa;            sensor_health[i_diag]&lt;=15;&#xa;            toggle_count[i_diag]&lt;=0;&#xa;            contradiction_count[i_diag]&lt;=0;&#xa;            end&#xa;    end &#xa;    else if(en_10k) begin&#x9;if(~samples_ready) begin//还没填充好就先不更新&#xa;    &#x9;&#x9;&#x9;direction_last&lt;=direction_majority;&#xa;             diag_window_count&lt;=0;&#xa;            &#x9;&#x9;for(i_diag=0;i_diag&lt;8;i_diag++)begin&#xa;                    &#x9;&#x9;toggle_count[i_diag]&lt;=0;&#xa;                          contradiction_count[i_diag]&lt;=0;&#xa;                    end&#xa;    end&#xa;    else begin&#xa;    direction_last&lt;=direction_majority;&#xa;    &#x9;&#x9;if(diag_window_count==8'hFF) begin//大约25.6ms更新一次健康度&#xa;            diag_window_count&lt;=0;&#xa;            &#x9;&#x9;for(i_diag=0;i_diag&lt;8;i_diag++) begin&#xa;                    if(toggle_count[i_diag]>=80 || contradiction_count[i_diag]>=64) begin&#xa;                    &#x9;&#x9;&#x9;if(sensor_health[i_diag]>2) &#xa;                                sensor_health[i_diag]&lt;=sensor_health[i_diag]-2;&#xa;                             else sensor_health[i_diag]&lt;=0;&#xa;                    end&#xa;                    else if(toggle_count[i_diag]>=12|| contradiction_count[i_diag]>=24) begin&#xa;                    &#x9;&#x9;&#x9;if(sensor_health[i_diag]>1)&#xa;                                &#x9;sensor_health[i_diag]&lt;=sensor_health[i_diag]-1;&#xa;                             else sensor_health[i_diag]&lt;=0;&#xa;                    end&#x9;//本窗口内表现正常，健康度恢复&#xa;                    &#x9;&#x9;else  begin if(sensor_health[i_diag]&lt;15)&#xa;                            &#x9;&#x9;sensor_health[i_diag]&lt;=sensor_health[i_diag]+1;&#xa;                                 else sensor_health[i_diag]&lt;=15;&#xa;                                end&#xa;                                toggle_count[i_diag]&lt;=0;&#xa;                                contradiction_count[i_diag]&lt;=0;//对应的清零&#xa;                    end//一次循环结束&#xa;            end&#xa;            else begin&#xa;            &#x9;&#x9;&#x9;diag_window_count&lt;=diag_window_count+1;&#xa;                      for(i_diag=0;i_diag&lt;8;i_diag++) begin&#xa;                    &#x9;&#x9;&#x9;if(direction_majority[i_diag]!=direction_last[i_diag]  &amp;&amp; toggle_count[i_diag]!=8'hFF)//当前滤波值与上一周期不同，记录一次反转&#xa;                                &#x9;&#x9;toggle_count[i_diag]&lt;=toggle_count[i_diag]+1;&#xa;                                   //检测孤立电平，只检测内部的那六个，边缘的2个不检测&#xa;                                if(i_diag>0 &amp;&amp; i_diag&lt;7) begin&#xa;                                &#x9;&#x9;//孤立高电平，中间是1，两边是0，并且整个阵列还有其它的有效点&#xa;                                        if(direction_majority[i_diag]==1 &amp;&amp; direction_majority[i_diag-1]==0 &amp;&amp; direction_majority[i_diag+1]==0 &amp;&amp; raw_active_count>=2 &amp;&amp; contradiction_count[i_diag]!=8'hFF)&#xa;                                       &#x9;contradiction_count[i_diag]&lt;=contradiction_count[i_diag]+1;&#xa;                                            //孤立的低电平&#xa;                                            if(direction_majority[i_diag]==0 &amp;&amp; direction_majority[i_diag-1]==1 &amp;&amp; direction_majority[i_diag+1] ==1 &amp;&amp; raw_active_count>=2 &amp;&amp; contradiction_count[i_diag]!=8'hFF)&#xa;                                       &#x9;contradiction_count[i_diag]&lt;=contradiction_count[i_diag]+1;&#xa;                                end&#xa;                    end&#xa;            end&#xa;    end&#xa;    &#xa;    end&#xa;end&#xa;//第五层，故障通道同构，把坏掉的变成好的&#xa;//左右邻道同时为1时将中间通道变为1，左右邻道不同时为1时，中间的通道为0&#xa;//对于边缘故障通道，不外推，直接置为0，避免虚构出不存在的轨迹&#xa;reg [7:0]direction_reconstructed;&#xa;integer i_recon;&#xa;always @ ( * )&#xa;begin &#xa;&#x9;&#x9;direction_reconstructed=direction_majority;&#xa;        sensor_fault=8'b0000_0000;&#xa;        for(i_recon=0;i_recon&lt;8;i_recon++) begin&#xa;        &#x9;&#x9;if(sensor_health[i_recon]&lt;4) begin//故障了&#xa;                sensor_fault[i_recon]=1;&#xa;              if(i_recon>0 &amp;&amp; i_recon&lt;7)&#xa;            &#x9;&#x9;&#x9;direction_reconstructed[i_recon]= direction_majority[i_recon-1] &amp;&amp; direction_majority[i_recon+1];&#xa;                  else direction_reconstructed[i_recon]=0;&#xa;                        end&#xa;               &#xa;        end&#xa;end&#xa;//第六层，健康度加权质心&#xa;//左4 左3 左2 左1  右1 右2 右3 右4&#xa;//-7  -5  -3  -1   +1  +3  +5  +7&#xa;//对于我们的健康权重，有:&#xa;//health>=12 权重为3，>=8，权重为2，>=4,权重为1，>=0，权重就是0&#xa;//加权质心:position=Σ(传感器位置 × 健康权重 × 状态)/Σ(健康权重 × 状态)&#xa;//故障通道经过相邻重构后，只赋最低权重1&#xa;  integer weighted_sum_comb;&#xa;  integer valid_weight_sum_comb;&#xa;  integer track_position_comb;&#xa;  integer active_count_comb;&#xa;    integer segment_count_comb;&#xa;  integer fault_count_comb;&#xa;    integer suspect_count_comb;&#xa;  integer position_weight_comb;&#xa;    integer health_weight_comb;&#xa; integer i_center;&#xa; reg position_valid_comb;&#xa;always @ ( * )&#xa;begin &#xa;        weighted_sum_comb     = 0;&#xa;        valid_weight_sum_comb = 0;&#xa;        track_position_comb   = 0;&#xa;        active_count_comb     = 0;&#xa;        segment_count_comb    = 0;&#xa;        fault_count_comb      = 0;&#xa;        suspect_count_comb    = 0;&#xa;        position_weight_comb  = 0;&#xa;        health_weight_comb    = 0;&#xa;        position_valid_comb   = 1'b0;&#xa;        //统计轨迹连续区域数量&#xa;        //0001_1000是1个连续区域，0101_0111是3个&#xa;        if(direction_reconstructed[7])//边缘是1的话必须得先算1个，不然就少了&#xa;        segment_count_comb=segment_count_comb+1;&#xa;        for(i_center=0;i_center&lt;7;i_center++)begin&#xa;        &#x9;&#x9;if(~direction_reconstructed[7-i_center] &amp;&amp; direction_reconstructed[6-i_center])&#xa;                &#x9;&#x9;segment_count_comb=segment_count_comb+1;&#xa;&#x9;        end&#xa;           for(i_center=0;i_center&lt;8;i_center++)begin//根据传感器型号选权值&#xa;        case( i_center)&#xa;        0: position_weight_comb = 7;&#xa;        1: position_weight_comb = 5;&#xa;        2: position_weight_comb = 3;&#xa;         3:position_weight_comb = 1;&#xa;        4: position_weight_comb = -1;&#xa;        5: position_weight_comb = -3;&#xa;        6: position_weight_comb = -5;&#xa;        7: position_weight_comb = -7;//从0到7依次是从右往左&#xa;            default:   position_weight_comb = 0  ;&#xa;        endcase&#xa;        //根据通道的健康值选动态权重&#xa;        if(sensor_health[i_center]>=12) health_weight_comb=3; &#xa;        else begin if(sensor_health[i_center]>=8) health_weight_comb=2;&#xa;              else  if(sensor_health[i_center]>=4) health_weight_comb=1;&#xa;            &#x9;&#x9;&#x9;else health_weight_comb=0;&#xa;                        end&#xa;        //统计故障通道数和严重退化的通道数&#xa;        &#x9;&#x9;if(sensor_health[i_center]&lt;4) fault_count_comb=fault_count_comb+1; &#xa;                else begin if(sensor_health[i_center]&lt;8) suspect_count_comb=suspect_count_comb+1;end&#xa;                        //正常通道数&#xa;        &#x9;&#x9;if(direction_reconstructed[i_center])begin  active_count_comb=active_count_comb+1;&#xa;                &#x9;&#x9;if(health_weight_comb==0 &amp;&amp; i_center>0 &amp;&amp; i_center &lt;7) begin//故障通道的健康可信度是0&#xa;                        weighted_sum_comb=weighted_sum_comb+position_weight_comb;&#xa;                        valid_weight_sum_comb=valid_weight_sum_comb+1;&#xa;                        end&#xa;                        else if(health_weight_comb!=0) begin//正常或者退化的通道使用健康权重&#xa;                        &#x9;&#x9;weighted_sum_comb=weighted_sum_comb+position_weight_comb*health_weight_comb;&#xa;                                valid_weight_sum_comb=valid_weight_sum_comb+health_weight_comb;&#xa;                        end&#xa;&#xa;                end&#xa;                                        if(valid_weight_sum_comb!=0) begin//Q1定点加权质心，本来实际位置范围是-7到+7&#xa;                                        //error_mag是4位，上了Q2或者更高的就截断了&#xa;                                        //track_position_comb的实际值==track_position_comb÷2&#xa;                       //本来让weight_sum_com直接整除valid_weight_sum_comb会丢失小数位&#xa;                        track_position_comb=(weighted_sum_comb*2)/valid_weight_sum_comb;&#xa;                        position_valid_comb=1;&#xa;                        end&#xa;        end&#x9;&#x9;&#xa;end&#xa;//第七层，时空轨迹置信度计算&#xa;//置信度范围0-15，初试分数是15，根据以下情况扣分&#xa;//  轨迹存在多个分离区域&#xa;//  同时有效的传感器过多&#xa;// 存在故障通道&#xa;// 存在严重退化通道&#xa;//  本次位置相对上次位置发生异常跳变&#xa;//置信度位于12-15，8-11，4-7，0-3分别对应高 中 低  不可信&#xa;integer confidence_comb;&#xa;integer jump_abs_comb;&#xa;integer fault_penalty_comb;&#xa;integer suspect_penalty_comb;&#xa;integer last_position;&#xa;integer last_delta;&#xa;reg history_valid;//已经保存过至少一次中高置信度轨迹&#xa;always @ ( * )&#xa;begin &#xa;&#x9;confidence_comb=0;&#xa;    jump_abs_comb=0;&#xa;    fault_penalty_comb=0;&#xa;    suspect_penalty_comb=0;&#xa;    &#x9;&#x9;if(samples_ready &amp;&amp; position_valid_comb) begin&#xa;            &#x9;confidence_comb=15;//初始就是15分&#xa;          //开始扣分了&#xa;        if(segment_count_comb==2) confidence_comb=confidence_comb-2;//两个连续区域扣两分&#xa;        else if(segment_count_comb>=3) confidence_comb=confidence_comb-6;//超过两个就扣六分&#xa;        if(active_count_comb>=7) confidence_comb=confidence_comb-3;//有效传感器太多了，可能是路口，宽线&#xa;        else if(active_count_comb>=5) confidence_comb=confidence_comb-1;&#xa;        fault_penalty_comb=fault_count_comb*2;&#xa;        if(fault_penalty_comb>=6) fault_penalty_comb=6;//传感器故障一个扣2分，最多扣6分&#xa;        confidence_comb=confidence_comb-fault_penalty_comb;&#xa;        suspect_penalty_comb=suspect_count_comb;&#xa;        &#x9;if(suspect_penalty_comb>=3) suspect_penalty_comb=3;//传感器退化一个扣1分，最多3分&#xa;                    confidence_comb=confidence_comb-suspect_penalty_comb;&#xa;                   if(history_valid) begin&#xa;          jump_abs_comb=track_position_comb-last_position;&#xa;        &#x9;if(jump_abs_comb&lt;0) jump_abs_comb=-jump_abs_comb;&#xa;            //根据位置突变量扣分，偏差的越大扣的越多&#xa;            if(jump_abs_comb>=12) confidence_comb=confidence_comb-5;&#xa;            else if(jump_abs_comb>=10) confidence_comb=confidence_comb-4;&#xa;            &#x9;&#x9;else if(jump_abs_comb>=8) confidence_comb=confidence_comb-3;&#xa;                    else if(jump_abs_comb>=6) confidence_comb=confidence_comb-2;&#xa;                    &#x9;&#x9;else if(jump_abs_comb>=4) confidence_comb=confidence_comb-1;&#xa;                            end&#xa;                            else jump_abs_comb=0;//第一次有效轨迹没有历史参考，就不扣分&#xa;                if(confidence_comb>15) confidence_comb=15;&#xa;                else if(confidence_comb&lt;0)confidence_comb=0;&#xa;                end&#xa;end&#xa;//第八层，二阶轨迹趋势预测&#xa;//位置变化量delta=当前轨迹位置-上一轨迹位置&#xa;//位置变化加速度accel=当前delta-上一delta&#xa;//预测位置=当前位置+delta+accel/2&#xa;//这个模型用于矿井环境内传感器短时被粉尘遮挡或者断线的时候继续估计当前怎么运动&#xa;//delta限制在-8到+8&#xa;//accel限制在-4到+4&#xa;integer delta_comb;&#xa;integer accel_comb;&#xa;integer predicted_position_comb;&#xa;integer selected_position_comb;&#xa;always @ (*  )&#xa;begin &#xa;delta_comb=0;&#xa;accel_comb=0;&#xa;predicted_position_comb=track_position_comb;&#xa;selected_position_comb=track_position_comb;&#xa; if(history_valid) begin&#xa;&#x9;if(confidence_comb>=8) begin //置信度>=8，才使用当前测量，否则用预测输出&#xa;&#x9;&#x9; delta_comb=track_position_comb-last_position;&#xa;&#x9;if(delta_comb>8) delta_comb=8;&#xa;    else if(delta_comb&lt;-8) delta_comb=-8;&#xa;accel_comb=delta_comb-last_delta;&#xa;&#x9;if(accel_comb>4) accel_comb=4;&#xa;    else if(accel_comb&lt;-4) accel_comb=-4;&#xa;predicted_position_comb=track_position_comb+delta_comb+accel_comb/2;&#xa;&#x9;if(predicted_position_comb>14) predicted_position_comb=14;&#xa;    else if(predicted_position_comb&lt;-14) predicted_position_comb=-14;&#xa;    selected_position_comb=track_position_comb;&#xa;    end&#xa;  else begin  predicted_position_comb=last_position+last_delta;&#xa;if(predicted_position_comb>14) predicted_position_comb=14;&#xa;    else if(predicted_position_comb&lt;-14) predicted_position_comb=-14;&#xa;    selected_position_comb=predicted_position_comb;&#xa;    end&#xa;    end else begin//还没建立可靠历史，不能用二阶预测&#xa;    delta_comb=0;&#xa;    accel_comb=0;&#xa;predicted_position_comb=track_position_comb;&#xa;selected_position_comb=track_position_comb;&#xa;    end&#xa;end&#xa;function [3:0]position_to_error;&#xa;&#x9;&#x9;input integer position_value;&#xa;        integer abs_value;&#xa;        begin&#xa;        if(position_value>0) abs_value=position_value;&#xa;        else abs_value=-position_value;&#xa;                if(abs_value>15) abs_value=15;&#xa;         position_to_error=abs_value[3:0];&#xa;        end&#xa;        endfunction&#xa;  //第九层，分级脱轨恢复和安全状态机&#xa;//脱轨&#xa;//先使用最近一次二阶预测位置继续纠偏，还没回到轨道上的话就按最后有效方向逐渐增加搜索误差，之后保持低速搜索&#xa;//最后还没找到的话就sensor_lost置位为1，control_mode进入MODE_STOP&#xa;reg [23:0]lost_count;&#xa;reg last_turn_dir;&#xa;reg [3:0]last_error_mag;&#xa;integer predicted_position_hold;&#xa;integer search_error_comb;&#xa;always @ ( * )&#xa;begin &#xa;&#x9;if(lost_count>LOST_PREDICT_COUNT) begin&#xa;    &#x9;&#x9;&#x9;search_error_comb=last_error_mag+(lost_count-LOST_PREDICT_COUNT)/100;&#xa;                end&#xa;&#x9;&#x9;else search_error_comb=last_error_mag;&#xa;      if(search_error_comb>14) search_error_comb=14;//限幅&#xa;    else if(search_error_comb&lt;0) search_error_comb=0;&#xa;end&#xa;//轨迹可用条件:已经完成五点采样&amp;&amp; 加权质心计算有效&amp;&amp;轨迹置信度不低于4&#xa;wire usable_track=samples_ready &amp;&amp; position_valid_comb &amp;&amp; (confidence_comb>=4);&#xa; always @(posedge clk_50m or posedge rst) begin&#xa;        if (rst) begin&#xa; error_mag &lt;= 0;&#xa; sensor_lost &lt;= 1;&#xa;turn_dir&lt;=0;&#xa;   track_confidence &lt;=0;&#xa;   control_mode &lt;= MODE_STOP;&#xa; lost_count&lt;= 0;&#xa; last_turn_dir &lt;=0;&#xa;   last_error_mag  &lt;=0;&#xa;    last_position&lt;=0;&#xa;  last_delta &lt;=0;&#xa; history_valid&lt;=0;&#xa;predicted_position_hold &lt;= 0;end&#xa;else if(en_10k)begin&#xa;&#x9;if(~samples_ready) begin//五组滤波还没好&#xa;    error_mag&lt;=0;&#xa;    sensor_lost&lt;=1;&#xa;   track_confidence&lt;=0;&#xa;&#x9;control_mode&lt;=MODE_STOP;&#xa;    lost_count&lt;=0;&#xa;    end&#xa;    else if(usable_track) begin//当前存在可用轨迹&#xa;    &#x9;&#x9;&#x9;lost_count&lt;=0;&#xa;            sensor_lost&lt;=0;&#xa;            track_confidence&lt;=confidence_comb;&#xa;            //寄存轨迹状态&#xa;            if(confidence_comb>=8) begin//只有中高置信度才更新预测轨迹，置信度为4-7时允许参与临时控制，但不能污染可靠历史&#xa;           last_position&lt;= track_position_comb;&#xa;        &#x9;&#x9;last_delta&lt;=delta_comb;&#xa;              predicted_position_hold&lt;=predicted_position_comb;&#xa;            history_valid&lt;=1;&#xa;            end&#xa;            if(selected_position_comb&lt;0) begin&#xa;            &#x9;&#x9;turn_dir&lt;=1;//轨迹位于系统的左侧&#xa;                  error_mag&lt;=position_to_error(selected_position_comb);&#xa;                last_turn_dir&lt;=1;//轨迹位于系统的左侧&#xa;                 last_error_mag&lt;=position_to_error(selected_position_comb);&#xa;            end &#xa;            else if(selected_position_comb>0)begin&#x9;&#xa;                        &#x9;&#x9;turn_dir&lt;=0;//轨迹位于系统的右侧&#xa;                  error_mag&lt;=position_to_error(selected_position_comb);&#xa;                                last_turn_dir&lt;=0;&#xa;                 last_error_mag&lt;=position_to_error(selected_position_comb);&#xa;            end&#xa;            else begin&#xa;            &#x9;&#x9;turn_dir&lt;=last_turn_dir;&#xa;                error_mag&lt;=0;//中心时不覆盖最后搜索方向，防止刚到中心就丢线导致小车不知道往哪搜&#xa;            end &#xa;          if(confidence_comb>=12 &amp;&amp; suspect_count_comb==0 &amp;&amp; fault_count_comb==0) &#xa;        &#x9;&#x9;control_mode&lt;=MODE_NORMAL;&#xa;            else if(confidence_comb>=8) control_mode&lt;=MODE_DEGRADED;&#xa;            &#x9;&#x9; else control_mode&lt;=MODE_RECOVERY;&#xa;    end&#xa;    else begin//当前没有可用轨迹，置信度低于4&#xa;    &#x9;&#x9;if(lost_count&lt;LOST_STOP_COUNT)&#xa;            &#x9;lost_count&lt;=lost_count+1;&#xa;           //第一级恢复&#xa;       &#x9;&#x9;if(lost_count&lt; LOST_PREDICT_COUNT) begin&#xa;            sensor_lost&lt;=0;&#xa;            control_mode&lt;=MODE_RECOVERY;&#xa;            track_confidence&lt;=6;&#xa;            &#x9;&#x9;if(predicted_position_hold&lt;0) begin&#xa;                   turn_dir&lt;=1;//左转&#xa;                //turn_dir&lt;=last_turn_dir;&#xa;                    error_mag&lt;=position_to_error(predicted_position_hold);&#xa;                    end&#xa;                    else      if(predicted_position_hold>0) begin&#xa;                    turn_dir&lt;=0;//右转&#xa;                    //turn_dir&lt;=last_turn_dir;&#xa;                    error_mag&lt;=position_to_error(predicted_position_hold);&#xa;                    end&#xa;                    else  begin turn_dir&lt;=last_turn_dir;&#xa;                    error_mag&lt;=last_error_mag;&#xa;                    end&#xa;            end&#xa;            //第二级恢复，沿最后一次搜索方向逐渐增大搜索误差，不能直接增大到最大值，防止甩尾&#xa;            else if(lost_count&lt;LOST_SEARCH_COUNT) begin&#xa;            sensor_lost&lt;=0;&#xa;            control_mode&lt;=MODE_RECOVERY;&#xa;            track_confidence&lt;=3;&#xa;            turn_dir&lt;=last_turn_dir;&#xa;            error_mag&lt;=search_error_comb;&#xa;            end&#xa;            else//第三级恢复保持低速强制定向搜索&#xa;             if(lost_count&lt;LOST_STOP_COUNT) begin&#xa;            control_mode&lt;=MODE_RECOVERY;&#xa;            &#x9;&#x9;sensor_lost&lt;=0;&#xa;            &#x9;&#x9;&#x9;turn_dir&lt;=last_turn_dir;&#xa;                        error_mag&lt;=14;&#xa;                        track_confidence&lt;=1;&#xa;            end&#xa;            //第四级，这里我认为是轨迹暂时无法自主恢复，需要安全停车上报&#xa;            else begin&#xa;            sensor_lost&lt;=1;&#xa;            control_mode&lt;=MODE_STOP;&#xa;            track_confidence&lt;=0;&#xa;            turn_dir&lt;=last_turn_dir;&#xa;            error_mag&lt;=0;&#xa;            end&#xa;    end&#xa;end&#xa;   end" Color="aquamarine" Comment="" Height="334" Name="TRACKING_SENSOR3" Parameters="" Parent="SENSOR_TOP" Type="model" Width="545" X="440.5" Y="328">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="TRACKING_SENSOR3" Side="left" Width="30" X="-0.0550459" Y="0.54491"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="TRACKING_SENSOR3" Side="left" Width="30" X="-0.0550459" Y="0.745509"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="direction_in" Parent="TRACKING_SENSOR3" Side="bottom" Width="30" X="0.47156" Y="0.91018"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_10k" Parent="TRACKING_SENSOR3" Side="left" Width="30" X="-0.0550459" Y="0.347305"/>
  <Port Color="#ffe4c4" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="error_mag" Parent="TRACKING_SENSOR3" Side="top" Width="30" X="0.302752" Y="-0.0898204"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sensor_lost" Parent="TRACKING_SENSOR3" Side="top" Width="30" X="0.634862" Y="-0.0898204"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="turn_dir" Parent="TRACKING_SENSOR3" Side="right" Width="30" X="0.944954" Y="0.700599"/>
  <Port Color="#ffebcd" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="track_confidence" Parent="TRACKING_SENSOR3" Side="right" Width="30" X="0.944954" Y="0.203593"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="sensor_fault" Parent="TRACKING_SENSOR3" Side="right" Width="30" X="0.944954" Y="0.452096"/>
  <Port Color="#8a2be2" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="control_mode" Parent="TRACKING_SENSOR3" Side="left" Width="30" X="-0.0550459" Y="0.152695"/>
 </Module>
 <Module Category="Current" Class="GAS_SENSOR" Code="//因为cnt_warmup是从0开始计算的，我的设想是cnt_warmup==WARMUP_TIME-1时就达到了最大值，下一步应该在时序逻辑里cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;,也就是说我第一次cnt_warmup==WARMUP_TIME-1的时候，啥都没发生，因为cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;是非阻塞赋值，我下一时钟到达的时候我cnt_warmup第二次等于WARMUP_TIME-1，也就是相当于上一个周期结束了，这是第二个周期的第1秒（从1开始算），此时warmup_done为1，比较合理&#xa;parameter WARMUP_TIME=250_000_000;//预热时间为5s，先让MQ4内部化学反应充分&#xa;parameter FILTER_TIME=500_000;//数字滤波时间为10ms,尽量减少毛刺的影响，防止出现小车抽搐等现象的发生&#xa;reg [27:0]cnt_warmup;//计算有没有过预热时间&#xa;reg warmup_done;//1表示过了预热时间&#xa;reg [19:0]cnt_filter;//计算有没有过数字滤波时间&#xa;reg filter_done;//1表示过了数字滤波时间&#xa;reg do1;&#xa;reg do2;&#xa;wire gas_clear=(key_cmd==9'b111_111_000);//中控台已经确定瓦斯风险消除&#xa;reg gas_clear1;&#xa;reg gas_clear2;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    gas_clear1&lt;=0;&#xa;    gas_clear2&lt;=0;&#xa;    end&#xa;    else begin gas_clear1&lt;=gas_clear;&#xa;    &#x9;&#x9;gas_clear2&lt;=gas_clear1;end &#xa;end&#xa;wire clear_pulse=gas_clear1 &amp;&amp; ~gas_clear2;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    do1&lt;=1;&#xa;    do2&lt;=1;&#xa;    end &#xa;    else begin&#xa;    &#x9;do2&lt;=do1;&#xa;    do1&lt;=do;&#xa;    end&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_warmup&lt;=0;&#xa;    warmup_done&lt;=0;&#xa;    end&#xa;    else if(~warmup_done) begin&#xa;    &#x9;&#x9;if(cnt_warmup&lt;WARMUP_TIME-1) &#xa;    &#x9;&#x9;&#x9;cnt_warmup&lt;=cnt_warmup+1;&#xa;          else begin&#xa;        &#x9;&#x9;cnt_warmup&lt;=WARMUP_TIME-1;&#xa;             warmup_done&lt;=1;&#xa;            end&#xa;        end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_filter&lt;=0;&#xa;    filter_done&lt;=0;&#xa;    end&#xa;    else if(warmup_done) begin&#xa;    &#x9;&#x9;&#x9;if(~do2) begin&#xa;    &#x9;&#x9;&#x9;&#x9;if(cnt_filter&lt;FILTER_TIME-1) begin&#xa;                    cnt_filter&lt;=cnt_filter+1;&#xa;                    filter_done&lt;=filter_done;&#xa;//上面filter_done&lt;=filter_done的意思是还没完成数字滤波的时候filter_done保持原值，比如在系统刚开始的时候&#xa;//瓦斯浓度达标，但是还没完成数字滤波，filter_done为复位时的0&#xa;//瓦斯浓度超标，并且迟迟未退散，那我filter_done保持第一次数字滤波后的值，也就是1，防止发生脉冲信号，导致小车一抽一抽的&#xa;                    end&#xa;                 else begin&#xa;                &#x9;&#x9;cnt_filter&lt;=0;&#xa;                     filter_done&lt;=1;&#xa;                end&#xa;    &#x9;&#x9;end&#xa;            else begin&#xa;            &#x9;&#x9;filter_done&lt;=0;&#xa;                 cnt_filter&lt;=0;&#xa;            end  &#xa;            end          &#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;gas_alarm&lt;=0;&#xa;        force_stop&lt;=0;&#xa;    end&#xa;    else if(filter_done)begin&#xa;    &#x9;&#x9;gas_alarm&lt;=1;&#xa;        force_stop&lt;=1;    &#xa;    end&#xa;    &#x9;&#x9;else begin&#xa;            if(clear_pulse)&#xa;    &#x9;&#x9;gas_alarm&lt;=0;&#xa;        force_stop&lt;=0;    &#xa;    end  &#xa;end" Color="azure" Comment="" Height="222" Name="GAS_SENSOR4" Parameters="" Parent="SENSOR_TOP" Type="model" Width="219" X="903.5" Y="44">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="GAS_SENSOR4" Side="left" Width="30" X="-0.136986" Y="0.175676"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="GAS_SENSOR4" Side="left" Width="30" X="-0.136986" Y="0.427928"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="do" Parent="GAS_SENSOR4" Side="left" Width="30" X="-0.136986" Y="0.675676"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="gas_alarm" Parent="GAS_SENSOR4" Side="right" Width="30" X="0.863014" Y="0.265766"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="force_stop" Parent="GAS_SENSOR4" Side="right" Width="30" X="0.863014" Y="0.594595"/>
  <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="GAS_SENSOR4" Side="top" Width="30" X="0.429224" Y="-0.135135"/>
 </Module>
 <Module Category="Current" Class="ULTRASONIC_SENSOR_cg" Code="&#xa;  //----Code starts here: integrated by Robei-----&#xa;  parameter OVER_TIME=2_500_000;&#xa;  parameter WAIT_TIME=3_000_000;&#xa;  parameter TRIG_TIME=750;&#xa;  parameter IDLE=4'b0000;&#xa;  parameter SEND_TRIG=4'b0001;&#xa;  parameter WAIT_ECHO=4'b0010;&#xa;  parameter MEASURE=4'b0100;&#xa;  parameter CALC=4'b1000;&#xa;  parameter MAX_MEASURE_CNT=1_500_000;&#xa; // parameter OBSTACLE_ON=400;&#xa;  //parameter OBSTACLE_OFF=450;//基础双阈&#xa;parameter OBSTACLE_MARGIN=50;&#xa;parameter basic_mm=400;&#xa;//wire [15:0]OBSTACLE_ON=(heavy_load_state)?((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?550:500):((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?500:450);&#xa;wire [15:0]OBSTACLE_ON=(heavy_load_state)?((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?basic_mm+2*OBSTACLE_MARGIN:basic_mm+OBSTACLE_MARGIN):((car_state==4'b0010||car_state==4'b0100||car_state==4'b1000)?basic_mm+OBSTACLE_MARGIN:basic_mm);&#xa;wire [15:0]OBSTACLE_OFF=OBSTACLE_ON+OBSTACLE_MARGIN;//危险程度得和测量值的程度相反&#xa;  wire flag_go=(car_state==4'b0001||car_state==4'b0100||car_state==4'b1000);&#xa;  wire flag_back=(car_state==4'b0010);&#xa;  wire flag_idle=(car_state==4'b0000);&#xa;  reg [15:0]distance_mm1;&#xa;  reg [15:0]distance_mm2;&#xa;  reg echo1_1;&#xa;  reg echo1_2;&#xa;  reg [23:0]cnt1;&#xa;  reg [3:0]cstate1;&#xa;  reg [3:0]nstate1;&#xa;  //reg [15:0]distance_mm1;&#xa;  reg echo2_1;&#xa;  reg echo2_2;&#xa;  reg [23:0]cnt2;&#xa;  reg [3:0]cstate2;&#xa;  reg [3:0]nstate2;&#xa;  //reg [15:0]distance_mm2;&#xa;  reg [1:0]step;&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;          cstate1&lt;=IDLE;&#xa;          cstate2&lt;=IDLE;&#xa;          end&#xa;      else begin&#xa;      &#x9;&#x9;if(group_pulse)begin&#xa;                  cstate1&lt;=IDLE;&#xa;      cstate2&lt;=IDLE;&#xa;              end&#xa;      else begin    cstate1&lt;=nstate1;&#xa;          cstate2&lt;=nstate2;&#xa;          end&#xa;          end&#xa;  end&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;          &#x9;&#x9;&#x9;echo1_1&lt;=0;&#xa;          echo1_2&lt;=0;&#xa;                  echo2_1&lt;=0;&#xa;          echo2_2&lt;=0;&#xa;      end&#xa;      else begin&#xa;          &#x9;&#x9;&#x9;echo1_2&lt;=echo1_1;&#xa;          echo1_1&lt;=echo_1;&#xa;                  echo2_2&lt;=echo2_1;&#xa;          echo2_1&lt;=echo_2;&#xa;      end&#xa;  end&#xa;  always @ ( * )&#xa;  begin&#xa;  &#x9;nstate1=cstate1;&#xa;      &#x9;nstate2=cstate2;&#xa;      if(step==1&amp;&amp;(flag_go||flag_idle))&#xa;      case( cstate1)&#xa;          IDLE:if(cnt1==WAIT_TIME-1) nstate1=SEND_TRIG;&#xa;          else nstate1=IDLE;&#xa;          SEND_TRIG:if(cnt1==TRIG_TIME-1)nstate1=WAIT_ECHO;&#xa;          else nstate1=SEND_TRIG;&#xa;          WAIT_ECHO:if(echo1_2==1) nstate1=MEASURE;&#xa;          else begin&#xa;              if(cnt1&lt;OVER_TIME-1) nstate1=WAIT_ECHO;&#xa;              else nstate1=IDLE;&#xa;          end&#xa;          MEASURE:if(echo1_2==1&amp;&amp; cnt1&lt;MAX_MEASURE_CNT-1) nstate1=MEASURE;&#xa;          else nstate1=CALC;&#xa;          CALC: begin nstate1=IDLE;&#xa;          end&#xa;          default:  begin nstate1=IDLE;&#xa;          end&#xa;      endcase&#xa;                  if(step==2&amp;&amp;(flag_back||flag_idle))&#xa;      case( cstate2)&#xa;          IDLE:if(cnt2==WAIT_TIME-1) nstate2=SEND_TRIG;&#xa;          else nstate2=IDLE;&#xa;          SEND_TRIG:if(cnt2==TRIG_TIME-1)nstate2=WAIT_ECHO;&#xa;          else nstate2=SEND_TRIG;&#xa;          WAIT_ECHO:if(echo2_2==1) nstate2=MEASURE;&#xa;          else begin&#xa;              if(cnt2&lt;OVER_TIME-1) nstate2=WAIT_ECHO;&#xa;              else nstate2=IDLE;&#xa;          end&#xa;          MEASURE:if(echo2_2==1&amp;&amp; cnt2&lt;MAX_MEASURE_CNT-1) nstate2=MEASURE;&#xa;          else nstate2=CALC;&#xa;          CALC: begin nstate2=IDLE;&#xa;          end&#xa;          default:  begin nstate2=IDLE;&#xa;          end&#xa;      endcase&#xa;                  &#xa;  end&#xa;  reg [2:0]group_now;&#xa;  reg [2:0]group_last;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst)begin&#xa;      group_now&lt;=0;&#xa;      group_last&lt;=0;&#xa;      end&#xa;      else begin&#xa;      group_now&lt;={flag_idle,flag_back,flag_go};&#xa;      group_last&lt;=group_now;&#xa;      end&#xa;  end&#xa;  reg [15:0]distance_mm1_1;&#xa;  reg [15:0]distance_mm1_2;&#xa;  reg [15:0]distance_mm1_3;&#xa;  reg [15:0]distance_mm2_1;&#xa;  reg [15:0]distance_mm2_2;&#xa;  reg [15:0]distance_mm2_3;&#xa;  wire group_pulse=group_now[2]^group_last[2]||group_now[1]^group_last[1]||group_now[0]^group_last[0];&#xa;  always @ (posedge clk_50m or posedge rst )&#xa;  begin&#xa;      if(rst) begin&#xa;      step&lt;=1;&#xa;          trig_1&lt;=0;&#xa;          cnt1&lt;=0;&#xa;          distance_mm1&lt;=0;&#xa;                  trig_2&lt;=0;&#xa;          cnt2&lt;=0;&#xa;          distance_mm2&lt;=0;&#xa;          distance_mm1_1&lt;=0;&#xa;  distance_mm1_2&lt;=0;&#xa;  distance_mm1_3&lt;=0;&#xa;  distance_mm2_1&lt;=0;&#xa;  distance_mm2_2&lt;=0;&#xa;  distance_mm2_3&lt;=0;&#xa;  go_flag1&lt;=1;&#xa;  go_flag2&lt;=1;&#xa;  go_flag3&lt;=1;&#xa;  back_flag1&lt;=1;&#xa;  back_flag2&lt;=1;&#xa;  back_flag3&lt;=1;&#xa;      end&#xa;      else &#x9;if(flag_idle) &#xa;      begin &#xa;         if(group_pulse)begin&#xa;      step&lt;=1;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;     else   if(step==1) begin//1&#x9;&#xa;      case(cstate1)&#xa;          IDLE:if(cnt1&lt;WAIT_TIME-1) cnt1&lt;=cnt1+1;&#xa;          else cnt1&lt;=0;&#xa;          SEND_TRIG:if(cnt1&lt;TRIG_TIME-1) begin cnt1&lt;=cnt1+1;&#xa;              trig_1&lt;=1;&#xa;          end&#xa;          else begin cnt1&lt;=0;&#xa;              trig_1&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo1_2==1) cnt1&lt;=0;&#xa;          else begin if(cnt1&lt;OVER_TIME-1)cnt1&lt;=cnt1+1;&#xa;              else begin cnt1&lt;=0;&#xa;                  distance_mm1&lt;=0;&#xa;                  step&lt;=2;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt1&lt;=cnt1+1;&#xa;          CALC: begin distance_mm1&lt;=((cnt1+1)*223)>>16;&#xa;                          distance_mm1_1&lt;=distance_mm1;&#xa;                  distance_mm1_2&lt;=distance_mm1_1;&#xa;                  distance_mm1_3&lt;=distance_mm1_2;&#xa;              cnt1&lt;=0; &#xa;              step&lt;=2; if(distance_vld_go) begin&#xa;                      go_flag1&lt;=(distance_1>OBSTACLE_OFF &amp;&amp; mid_value1[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag2&lt;=go_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag3&lt;=go_flag2;&#xa;                          end &#xa;                          else begin&#xa;                          go_flag1&lt;=0;&#xa;                          go_flag2&lt;=0;&#xa;                          go_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt1&lt;=0;&#xa;              distance_mm1&lt;=0;&#xa;                              distance_mm1_1&lt;=0;&#xa;                  distance_mm1_2&lt;=0;&#xa;                  distance_mm1_3&lt;=0;&#xa;              step&lt;=1;&#xa;              go_flag1&lt;=0;&#xa;              go_flag2&lt;=0;&#xa;              go_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//1&#xa;     else  if(step==2) begin//2&#xa;      &#x9;case(cstate2)&#xa;          IDLE:if(cnt2&lt;WAIT_TIME-1) cnt2&lt;=cnt2+1;&#xa;          else cnt2&lt;=0;&#xa;          SEND_TRIG:if(cnt2&lt;TRIG_TIME-1) begin cnt2&lt;=cnt2+1;&#xa;              trig_2&lt;=1;&#xa;          end&#xa;          else begin cnt2&lt;=0;&#xa;              trig_2&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo2_2==1) cnt2&lt;=0;&#xa;          else begin if(cnt2&lt;OVER_TIME-1)cnt2&lt;=cnt2+1;&#xa;              else begin cnt2&lt;=0;&#xa;                  distance_mm2&lt;=0;&#xa;                  step&lt;=1;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt2&lt;=cnt2+1;&#xa;          CALC: begin distance_mm2&lt;=((cnt2+1)*223)>>16;&#xa;                          distance_mm2_1&lt;=distance_mm2;&#xa;                  distance_mm2_2&lt;=distance_mm2_1;&#xa;                  distance_mm2_3&lt;=distance_mm2_2;&#xa;              cnt2&lt;=0;&#xa;              step&lt;=1; if(distance_vld_back) begin&#xa;                      back_flag1&lt;=(distance_2>OBSTACLE_OFF &amp;&amp; mid_value2[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag2&lt;=back_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag3&lt;=back_flag2;end&#xa;                          else begin&#xa;                          back_flag1&lt;=0;&#xa;                          back_flag2&lt;=0;&#xa;                          back_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt2&lt;=0;&#xa;              distance_mm2&lt;=0;&#xa;                  distance_mm2_1&lt;=0;&#xa;                  distance_mm2_2&lt;=0;&#xa;                  distance_mm2_3&lt;=0;&#xa;              step&lt;=1;&#xa;              back_flag1&lt;=0;&#xa;              back_flag2&lt;=0;&#xa;              back_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//2&#xa;      end&#xa;      else&#xa;       begin  if(flag_go) begin &#xa;      if(group_pulse)begin&#xa;      step&lt;=1;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;     else  if(step>=2)&#xa;      &#x9;&#x9;step&lt;=1;&#xa;     else   if(step==1) begin//1&#x9;&#xa;      case(cstate1)&#xa;          IDLE:if(cnt1&lt;WAIT_TIME-1) cnt1&lt;=cnt1+1;&#xa;          else cnt1&lt;=0;&#xa;          SEND_TRIG:if(cnt1&lt;TRIG_TIME-1) begin cnt1&lt;=cnt1+1;&#xa;              trig_1&lt;=1;&#xa;          end&#xa;          else begin cnt1&lt;=0;&#xa;              trig_1&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo1_2==1) cnt1&lt;=0;&#xa;          else begin if(cnt1&lt;OVER_TIME-1)cnt1&lt;=cnt1+1;&#xa;              else begin cnt1&lt;=0;&#xa;                  distance_mm1&lt;=0;&#xa;                  step&lt;=1;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt1&lt;=cnt1+1;&#xa;          CALC: begin distance_mm1&lt;=((cnt1+1)*223)>>16;&#xa;                                  distance_mm1_1&lt;=distance_mm1;&#xa;                  distance_mm1_2&lt;=distance_mm1_1;&#xa;                  distance_mm1_3&lt;=distance_mm1_2;&#xa;              cnt1&lt;=0;&#xa;              step&lt;=1;&#x9;&#x9;if(distance_vld_go) begin&#xa;                        go_flag1&lt;=(distance_1>OBSTACLE_OFF &amp;&amp; mid_value1[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag2&lt;=go_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;go_flag3&lt;=go_flag2;end&#xa;                          else begin&#xa;                          &#x9;&#x9;go_flag1&lt;=0;&#xa;                                  go_flag2&lt;=0;&#xa;                                  go_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt1&lt;=0;&#xa;              distance_mm1&lt;=0;&#xa;                              distance_mm1_1&lt;=0;&#xa;                  distance_mm1_2&lt;=0;&#xa;                  distance_mm1_3&lt;=0;&#xa;              step&lt;=1;&#xa;              go_flag1&lt;=0;&#xa;              go_flag2&lt;=0;&#xa;              go_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//1&#xa;   end&#xa;      else if(flag_back) begin &#xa;          if(group_pulse)begin&#xa;      step&lt;=2;&#xa;      cnt1&lt;=0;&#xa;      cnt2&lt;=0;&#xa;      trig_1&lt;=0;&#xa;      trig_2&lt;=0;&#xa;      end&#xa;   else    if(step!=2)&#xa;      &#x9;&#x9;step&lt;=2;&#xa;    else    if(step==2) begin//4&#xa;      &#x9;case(cstate2)&#xa;          IDLE:if(cnt2&lt;WAIT_TIME-1) cnt2&lt;=cnt2+1;&#xa;          else cnt2&lt;=0;&#xa;          SEND_TRIG:if(cnt2&lt;TRIG_TIME-1) begin cnt2&lt;=cnt2+1;&#xa;              trig_2&lt;=1;&#xa;          end&#xa;          else begin cnt2&lt;=0;&#xa;              trig_2&lt;=0;&#xa;          end&#xa;          WAIT_ECHO:if(echo2_2==1) cnt2&lt;=0;&#xa;          else begin if(cnt2&lt;OVER_TIME-1)cnt2&lt;=cnt2+1;&#xa;              else begin cnt2&lt;=0;&#xa;                  distance_mm2&lt;=0;&#xa;                  step&lt;=2;&#xa;              end&#xa;          end&#xa;          MEASURE:cnt2&lt;=cnt2+1;&#xa;          CALC: begin distance_mm2&lt;=((cnt2+1)*223)>>16;&#xa;                          distance_mm2_1&lt;=distance_mm2;&#xa;                  distance_mm2_2&lt;=distance_mm2_1;&#xa;                  distance_mm2_3&lt;=distance_mm2_2;&#xa;              cnt2&lt;=0;&#xa;              step&lt;=2;&#x9;&#x9;if(distance_vld_back) begin&#xa;                      back_flag1&lt;=(distance_2>OBSTACLE_OFF &amp;&amp; mid_value2[0]>OBSTACLE_OFF ) ;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag2&lt;=back_flag1;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;back_flag3&lt;=back_flag2;end &#xa;                          else begin&#xa;                          back_flag1&lt;=0;&#xa;                          back_flag2&lt;=0;&#xa;                          back_flag3&lt;=0;&#xa;                          end&#xa;          end&#xa;          default:begin&#xa;              cnt2&lt;=0;&#xa;              distance_mm2&lt;=0;&#xa;                                              distance_mm2_1&lt;=0;&#xa;                  distance_mm2_2&lt;=0;&#xa;                  distance_mm2_3&lt;=0;&#xa;              step&lt;=2;&#xa;              back_flag1&lt;=0;&#xa;              back_flag2&lt;=0;&#xa;              back_flag3&lt;=0;&#xa;          end&#xa;      endcase&#xa;      end//4&#xa;    end&#xa;  end &#xa;  end&#xa;  wire [15:0]distance_1_max=(distance_mm1_1>distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_1>distance_mm1_3?distance_mm1_1:distance_mm1_3)://1>2的情况下1还>3，那就是1最大&#xa;                          (distance_mm1_2&lt;distance_mm1_3?distance_mm1_3:distance_mm1_2);//1&lt;2的情况下2＜3，2＞3&#xa;  wire [15:0]distance_2_max=(distance_mm2_1>distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_1>distance_mm2_3?distance_mm2_1:distance_mm2_3)://1>2的情况下1还>3，那就是1最大&#xa;                          (distance_mm2_2&lt;distance_mm2_3?distance_mm2_3:distance_mm2_2);//1&lt;2的情况下2＜3，2＞3&#xa;  wire [15:0]distance_1_min=(distance_mm1_1&lt;distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_2&lt;distance_mm1_3?                        //1小于2的情况下2小于3，最小的就是1&#xa;                          distance_mm1_1:(distance_mm1_1>distance_mm1_3)&#x9;&#x9;//1小于2的情况下2大于3，那就比较1和3&#xa;                          ?distance_mm1_3:distance_mm1_1):&#xa;                          (distance_mm1_2>distance_mm1_3?distance_mm1_3:distance_mm1_2);//1大于2的情况下2大于3，最小的就是3，否则最小的就是2&#xa;  wire [15:0]distance_2_min=(distance_mm2_1&lt;distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_2&lt;distance_mm2_3?                        //1小于2的情况下2小于3，最小的就是1&#xa;                          distance_mm2_1:(distance_mm2_1>distance_mm2_3)&#x9;&#x9;//1小于2的情况下2大于3，那就比较1和3&#xa;                          ?distance_mm2_3:distance_mm2_1):&#xa;                          (distance_mm2_2>distance_mm2_3?distance_mm2_3:distance_mm2_2);//1大于2的情况下2大于3，最小的就是3，否则最小的就是2&#xa;  wire [15:0]distance_1_mid=(distance_mm1_1>distance_mm1_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm1_2>distance_mm1_3?distance_mm1_2:&#xa;                          &#x9;distance_mm1_1>distance_mm1_3?distance_mm1_3:distance_mm1_1):&#xa;                             (distance_mm1_2&lt;distance_mm1_3?distance_mm1_2:&#xa;                          distance_mm1_1&lt;distance_mm1_3?distance_mm1_3:distance_mm1_1);&#xa;   wire [15:0]distance_2_mid=(distance_mm2_1>distance_mm2_2)?&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(distance_mm2_2>distance_mm2_3?distance_mm2_2:&#xa;                          &#x9;distance_mm2_1>distance_mm2_3?distance_mm2_3:distance_mm2_1):&#xa;                           (distance_mm2_2&lt;distance_mm2_3?distance_mm2_2:&#xa;                          distance_mm2_1&lt;distance_mm2_3?distance_mm2_3:distance_mm2_1);&#x9;&#xa;  wire [18:0]sum_all1={3'd0,mid_value1[0]}&#xa;  &#x9;&#x9;&#x9;    +{3'd0,mid_value1[1]}&#xa;                  +{3'd0,mid_value1[2]}&#xa;                  +{3'd0,mid_value1[3]}&#xa;                  +{3'd0,mid_value1[4]}&#xa;                  +{3'd0,mid_value1[5]}&#xa;                  +{3'd0,mid_value1[6]}                &#xa;                  +{3'd0,mid_value1[7]};//用于均值的和&#xa;  reg [15:0]mid_value1[7:0];//&#xa;  wire [18:0]sum_all2={3'd0,mid_value2[0]}&#xa;  &#x9;&#x9;&#x9;    +{3'd0,mid_value2[1]}&#xa;                  +{3'd0,mid_value2[2]}&#xa;                  +{3'd0,mid_value2[3]}&#xa;                  +{3'd0,mid_value2[4]}&#xa;                  +{3'd0,mid_value2[5]}&#xa;                  +{3'd0,mid_value2[6]}                &#xa;                  +{3'd0,mid_value2[7]};//用于均值的和&#xa;  reg [15:0]mid_value2[7:0];//&#xa;  assign distance_1=sum_all1>>3;&#xa;  assign distance_2=sum_all2>>3;&#xa;  always @ ( posedge clk_50m or posedge rst )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      mid_value1[7]&lt;=0;&#xa;      mid_value1[6]&lt;=0;&#xa;      mid_value1[5]&lt;=0;&#xa;      mid_value1[4]&lt;=0;                                   &#xa;      mid_value1[3]&lt;=0;&#xa;      mid_value1[2]&lt;=0;&#xa;      mid_value1[1]&lt;=0;&#xa;      mid_value1[0]&lt;=0;&#xa;      mid_value2[7]&lt;=0;&#xa;      mid_value2[6]&lt;=0;&#xa;      mid_value2[5]&lt;=0;&#xa;      mid_value2[4]&lt;=0;                                   &#xa;      mid_value2[3]&lt;=0;&#xa;      mid_value2[2]&lt;=0;&#xa;      mid_value2[1]&lt;=0;&#xa;      mid_value2[0]&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(cstate1==CALC) begin&#xa;      mid_value1[7]&lt;=mid_value1[6];&#xa;      mid_value1[6]&lt;=mid_value1[5];&#xa;      mid_value1[5]&lt;=mid_value1[4];&#xa;      mid_value1[4]&lt;=mid_value1[3];&#xa;      mid_value1[3]&lt;=mid_value1[2];&#xa;      mid_value1[2]&lt;=mid_value1[1];&#xa;      mid_value1[1]&lt;=mid_value1[0];&#xa;      mid_value1[0]&lt;=distance_1_mid;&#xa;      end&#xa;      else&#xa;      &#x9;&#x9;if(cstate2==CALC) begin&#xa;      mid_value2[7]&lt;=mid_value2[6];&#xa;      mid_value2[6]&lt;=mid_value2[5];&#xa;      mid_value2[5]&lt;=mid_value2[4];&#xa;      mid_value2[4]&lt;=mid_value2[3];&#xa;      mid_value2[3]&lt;=mid_value2[2];&#xa;      mid_value2[2]&lt;=mid_value2[1];&#xa;      mid_value2[1]&lt;=mid_value2[0];&#xa;      mid_value2[0]&lt;=distance_2_mid; &#xa;      end&#xa;      end&#xa;  end&#xa;  //之前三次一致有点重复了，我就删除了&#xa;  reg go_flag1;&#xa;  reg go_flag2;&#xa;  reg go_flag3;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      distance_vld_go&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(flag_idle||flag_go) begin&#xa;              if(distance_vld_go==1) begin&#xa;              &#x9;&#x9;if(distance_1>OBSTACLE_OFF ) begin//慢速解除&#xa;                      distance_vld_go&lt;=~(go_flag1 &amp;&amp; go_flag2 &amp;&amp; go_flag3); end&#xa;                          end&#xa;               else if(distance_1_mid&lt;OBSTACLE_ON) begin//快速报警&#xa;              &#x9;&#x9;&#x9;distance_vld_go&lt;=1;&#xa;                          end&#xa;              end&#xa;      end&#xa;  end&#xa;  &#xa;  reg back_flag1;&#xa;  reg back_flag2;&#xa;  reg back_flag3;&#xa;  always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;  &#x9;if(rst) begin&#xa;      distance_vld_back&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(flag_idle||flag_back) begin&#xa;              if(distance_vld_back==1) begin&#xa;              &#x9;&#x9;if(distance_2>OBSTACLE_OFF ) begin&#xa;                      distance_vld_back&lt;=~(back_flag1 &amp;&amp; back_flag2 &amp;&amp; back_flag3);&#xa;                          end&#xa;                          end&#xa;               else if(distance_2_mid&lt;OBSTACLE_ON) begin&#xa;              &#x9;&#x9;&#x9;distance_vld_back&lt;=1;&#xa;                          end&#xa;              end&#xa;      end&#xa;  end&#xa;  &#xa;&#xa;  &#xa;  &#xa;&#xa;" Color="azure" Comment="" Height="369" Name="ULTRASONIC_SENSOR_cg4" Parameters="" Parent="SENSOR_TOP" Type="model" Width="505" X="35" Y="566">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.0930693" Y="0.918699"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.219802" Y="0.918699"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="echo_1" Parent="ULTRASONIC_SENSOR_cg4" Side="right" Width="30" X="0.940594" Y="0.157182"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_vld_go" Parent="ULTRASONIC_SENSOR_cg4" Side="right" Width="30" X="0.940594" Y="0.355014"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="trig_1" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.342574" Y="0.918699"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="echo_2" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.469307" Y="0.918699"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="trig_2" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.592079" Y="0.918699"/>
  <Port Color="#ff7f50" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.718812" Y="0.918699"/>
  <Port Color="#6495ed" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_vld_back" Parent="ULTRASONIC_SENSOR_cg4" Side="right" Width="30" X="0.940594" Y="0.750678"/>
  <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="distance_1" Parent="ULTRASONIC_SENSOR_cg4" Side="right" Width="30" X="0.940594" Y="0.552846"/>
  <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="distance_2" Parent="ULTRASONIC_SENSOR_cg4" Side="bottom" Width="30" X="0.841584" Y="0.918699"/>
  <Port Color="#deb887" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="heavy_load_state" Parent="ULTRASONIC_SENSOR_cg4" Side="left" Width="30" X="-0.0594059" Y="0.457995"/>
 </Module>
 <Module Category="Current" Class="MPU_IIC_SENSOR" Code="// MPU6050 IIC通信&#xa;localparam DEVICE_READ       = 8'hD1;&#xa;localparam DEVICE_WRITE      = 8'hD0;&#xa;localparam GYRO_ZH           = 8'h47;&#xa;localparam ACCEL_ZH=8'h3F;//加速度计Z轴高字节地址&#xa;localparam PWR_MGMT_1        = 8'h6B;&#xa;localparam PWR_MGMT_1_VAL    = 8'h00;&#xa;localparam SMPLRT_DIV        = 8'h19;&#xa;localparam SMPLRT_DIV_VAL    = 8'h07;&#xa;localparam CONFIG1           = 8'h1A;&#xa;localparam CONFIG1_VAL       = 8'h06;&#xa;localparam GYRO_CONFIG       = 8'h1B;&#xa;localparam GYRO_CONFIG_VAL   = 8'h18;&#xa;localparam ACC_CONFIG        = 8'h1C;&#xa;localparam ACC_CONFIG_VAL    = 8'h00;//地址&#xa;localparam ST_RECOVER      = 4'd0;&#xa;localparam ST_RECOVER_STOP = 4'd1;&#xa;localparam ST_IDLE         = 4'd2;&#xa;localparam ST_START        = 4'd3;&#xa;localparam ST_SEND         = 4'd4;&#xa;localparam ST_ACK          = 4'd5;&#xa;localparam ST_RESTART      = 4'd6;&#xa;localparam ST_READ         = 4'd7;&#xa;localparam ST_MASTER_ACK   = 4'd8;&#xa;localparam ST_STOP         = 4'd9;&#xa;localparam ST_WAIT         = 4'd12;//状态&#xa;//每个SLC分成四个&#xa;reg [6:0] iic_tick_cnt;&#xa;wire tick_iic;&#xa;assign tick_iic = (iic_tick_cnt==124);//SCL是100KHZ,也就是一个SLC周期得计数50M/100K=500,再分成四份，也就是500/4=125&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;iic_tick_cnt&lt;=0;&#xa;            else begin&#xa;            &#x9;&#x9;if(tick_iic)&#xa;                    iic_tick_cnt&lt;=0;&#xa;                    else iic_tick_cnt&lt;=iic_tick_cnt+1;&#xa;            end   &#xa;end&#xa;reg sda_r1;&#xa;reg sda_r2;&#xa;always@(posedge clk_50m or posedge rst)begin//打拍,防止亚稳态&#xa;&#x9;&#x9;if(rst)begin&#xa;        &#x9;&#x9;sda_r1&lt;=1;&#xa;                sda_r2&lt;=1;&#xa;                end&#xa;                else begin&#xa;                sda_r1&lt;=sda;&#xa;                sda_r2&lt;=sda_r1;&#xa;                end&#xa;        end&#xa;reg sda_drive_low;&#xa;reg scl_r;&#xa;assign sda = sda_drive_low ? 1'b0 : 1'bz;&#xa;assign scl = scl_r;&#xa;reg [3:0] cstate;&#xa;reg [1:0] phase;//0:低电平中心，1：上升沿，2：高电平中心，3：下降沿，把一个SLC周期平分为4个脉冲信号&#xa;reg [3:0] recover_count;//统计恢复脉冲，0-8，共9个&#xa;reg [11:0] wait_count;//统计10ms等待时间&#xa;reg [2:0] bit_count;&#xa;reg [7:0] byte_tx;//发送移位缓冲，就是发送第几个bit&#xa;reg [7:0] byte_rx;//接收移位缓冲，这俩本质上就是形成一个8选1多路选择器&#xa;reg [4:0] flow_step;//表示一次大循环里内部进行到了第几个环节&#xa;reg [4:0] times;//表示进行到第几个大循环，0-4是初始化5个寄存器，5是读取MPU6050传来的高低位数据&#xa;reg master_ack_low;//1的话就是主机拉低SDA,发送ACK,0的话就是主机释放了SDA，发送NACK&#xa;reg transaction_ok;//记录当前循环是否成功&#xa;reg [7:0] mpu_zl_read;&#xa;reg [7:0] mpu_zh_read;&#xa;reg [15:0] raw_data_r;&#xa;reg raw_data_vld_r;&#xa;reg [7:0] raw_data_vld_count;&#xa;reg [15:0] pending_raw_data;//读取完高低字节后，不会立刻输出，而是先存入pending_raw_data，只有完成NACK,STOP,确认总线&#xa;//恢复正常后，才把数据发到raw_data_r，不会出现刚开始那种高位是新的，低位是旧的情况&#xa;reg pending_sample;&#xa;reg i2c_init_done;&#xa;reg [7:0] cfg_reg_addr;&#xa;reg [7:0] cfg_reg_data;&#xa;reg [2:0]gyro_read_count;//用来区分当前读取的是陀螺仪还是加速度计&#xa;reg read_accel_z;&#xa;reg [15:0]accel_z_raw_r;&#xa;reg accel_z_vld_r;&#xa;always @(*)//根据不同循环阶段选择不同的地址&#xa;begin&#xa;    cfg_reg_addr = PWR_MGMT_1;//防止锁存器&#xa;    cfg_reg_data = PWR_MGMT_1_VAL;&#xa;    case(times)&#xa;        5'd0: begin&#xa;            cfg_reg_addr = PWR_MGMT_1;&#xa;            cfg_reg_data = PWR_MGMT_1_VAL;&#xa;        end&#xa;        5'd1: begin&#xa;            cfg_reg_addr = SMPLRT_DIV;&#xa;            cfg_reg_data = SMPLRT_DIV_VAL;&#xa;        end&#xa;        5'd2: begin&#xa;            cfg_reg_addr = CONFIG1;&#xa;            cfg_reg_data = CONFIG1_VAL;&#xa;        end&#xa;        5'd3: begin&#xa;            cfg_reg_addr = GYRO_CONFIG;&#xa;            cfg_reg_data = GYRO_CONFIG_VAL;&#xa;        end&#xa;&#xa;        5'd4: begin&#xa;            cfg_reg_addr = ACC_CONFIG;&#xa;            cfg_reg_data = ACC_CONFIG_VAL;&#xa;        end&#xa;&#xa;        default: begin&#xa;            cfg_reg_addr = GYRO_ZH;&#xa;            cfg_reg_data = 8'h00;&#xa;        end&#xa;    endcase&#xa;end&#xa;always @(posedge clk_50m or posedge rst)&#xa;begin&#xa;    if(rst) begin&#xa;        cstate &lt;= ST_RECOVER;//默认恢复&#xa;        phase&lt;=0;&#xa;        recover_count&lt;=0;&#xa;        wait_count&lt;=0;&#xa;        bit_count&lt;=7;&#xa;        byte_tx&lt;=0;&#xa;        byte_rx&lt;=0;&#xa;        flow_step&lt;=0;&#xa;        times&lt;=0;&#xa;        master_ack_low&lt;=0;&#xa;        transaction_ok&lt;=1;&#xa;        scl_r&lt;=1;&#xa;        sda_drive_low&lt;=0;&#xa;        mpu_zh_read&lt;=0;&#xa;        mpu_zl_read&lt;=0;&#xa;        raw_data_r&lt;=0;&#xa;        raw_data_vld_r&lt;=0;&#xa;        raw_data_vld_count&lt;=0;&#xa;        pending_raw_data&lt;=0;&#xa;        pending_sample&lt;=0;&#xa;        i2c_init_done&lt;=0;&#xa;        ack_err_code&lt;=0;&#xa;        gyro_read_count&lt;=0;&#xa;read_accel_z&lt;=0;&#xa;accel_z_raw_r&lt;=0;&#xa;accel_z_vld_r&lt;=0;&#xa;    end&#xa;    else begin&#xa;        // raw_data_vld只保持一个50MHz时钟周期&#xa;        raw_data_vld_r&lt;=0;&#xa;        accel_z_vld_r&lt;=0;&#xa;        if(tick_iic) begin&#xa;            case(cstate)&#xa;                ST_RECOVER: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//SCL拉低，SDA释放&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;//拉高，形成恢复上升沿&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                   2:begin&#xa;                            scl_r&lt;=1;//保持高电平&#xa;                            sda_drive_low &lt;= 1'b0;&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;&#xa;                        3: begin&#xa;                            scl_r&lt;=0;//拉低，形成下降沿&#xa;                            sda_drive_low&lt;=0;&#xa;                            if(recover_count==8) begin&#xa;                                recover_count&lt;=0;&#xa;                                phase&lt;=0;&#xa;                                cstate&lt;=ST_RECOVER_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                recover_count &lt;= recover_count +1;&#xa;                                phase&lt;=0;//意思是得经历9个这样的SCL周期信号才能从RECOVER进入RECOVER_STOP;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_RECOVER_STOP:begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;//SCL低的时候拉低SDA&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SCL高的时候读取&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SCL高的时候释放SDA,让他由低变高，正好是STOP的标准条件&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_IDLE;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_IDLE: begin&#xa;                    scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;//SCL和SDA都是高&#xa;                    phase&lt;=0;&#xa;                    bit_count&lt;=7;&#xa;                    byte_rx&lt;=0;&#xa;                    transaction_ok&lt;=1;&#xa;                    // 如果空闲时SDA仍为低，再进行一次总线恢复&#xa;                    if(sda_r2==0) begin&#xa;                        recover_count&lt;=0;&#xa;                        cstate&lt;=ST_RECOVER;&#xa;                    end&#xa;                    else begin&#xa;                        byte_tx &lt;= DEVICE_WRITE;&#xa;                        // 0-4为初始化，5为读取&#xa;                        if(times&lt;5)&#xa;                            flow_step&lt;=0;&#xa;                        else&#xa;                            flow_step&lt;=10;&#xa;                        cstate &lt;= ST_START;&#xa;                          if(times>=5)begin&#xa;                              if(gyro_read_count>=4)&#xa;                                  read_accel_z&lt;=1;&#xa;                              else&#xa;                                  read_accel_z&lt;=0;&#xa;                          end&#xa;                    end&#xa;                end&#xa;                ST_START: begin//SCL高电平的时候SDA得从高变低&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//两个都是高&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1:begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SCL高的时候SDA变低，这是START的开始信号&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2:begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;//开始信号产生后再把SCL拉低，准备改变SDA&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        2'd3: begin&#xa;                            scl_r&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            bit_count&lt;=7;&#xa;                            cstate&lt;=ST_SEND;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_SEND: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            if(byte_tx[bit_count] ==0)&#xa;                                sda_drive_low &lt;=1;&#xa;                            else&#xa;                                sda_drive_low&lt;=0;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;//从机在SCL高电平的时候读取SDA&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;&#xa;                            if(bit_count==0) begin&#xa;                                phase&lt;=0;&#xa;                                cstate&lt;=ST_ACK;//为下一阶段做好准备&#xa;                            end&#xa;                            else begin&#xa;                                bit_count&lt;=bit_count-1;//还没发完&#xa;                                phase&lt;=0;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_ACK: begin//ACK是0，NACK是1&#xa;                    case(phase)&#xa;                        0:begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//主机释放SDA控制权&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            // 没收到ACK&#xa;                            if(sda_r2 ==1) begin&#xa;                                transaction_ok&lt;=0;&#xa;                                pending_sample&lt;=0;&#xa;                                // 保留第一次错误&#xa;                                if(ack_err_code == 0) begin&#xa;                                    case(flow_step)&#xa;                                        0, 10:&#xa;                                            ack_err_code&lt;=1;&#xa;                                        1,11:&#xa;                                            ack_err_code&lt;=2;&#xa;                                        2:&#xa;                                            ack_err_code&lt;=3;&#xa;                                        13:&#xa;                                            ack_err_code&lt;=4;&#xa;                                        default:&#xa;                                            ack_err_code&lt;=15;&#xa;                                    endcase&#xa;                                end&#xa;                                cstate &lt;= ST_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                case(flow_step)&#xa;                                    // 初始化：发送设备写地址成功&#xa;                                    5'd0: begin&#xa;                                        byte_tx&lt;=cfg_reg_addr;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=1;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;&#xa;                                    // 初始化：发送寄存器地址成功&#xa;                                    1: begin&#xa;                                        byte_tx&lt;=cfg_reg_data;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=2;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;                                    // 初始化：发送配置数据成功&#xa;                                    2: begin&#xa;                                        cstate&lt;=ST_STOP;&#xa;                                    end&#xa;                                    // 读取：发送设备写地址成功&#xa;                                    10: begin&#xa;                                        byte_tx&lt;=GYRO_ZH;&#xa;                                        if(read_accel_z)&#xa;                                              byte_tx&lt;=ACCEL_ZH;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=11;&#xa;                                        cstate&lt;=ST_SEND;&#xa;                                    end&#xa;&#xa;                                    // 读取：发送0x47成功，产生重复START&#xa;                                    11: begin&#xa;                                        flow_step&lt;=12;&#xa;                                        cstate&lt;=ST_RESTART;&#xa;                                    end&#xa;                                    // 读取：发送设备读地址成功&#xa;                                    13: begin&#xa;                                        byte_rx&lt;=0;&#xa;                                        bit_count&lt;=7;&#xa;                                        flow_step&lt;=14;&#xa;                                        cstate&lt;=ST_READ;&#xa;                                    end&#xa;&#xa;                                    default: begin&#xa;                                        transaction_ok&lt;=0;&#xa;                                        cstate &lt;=ST_STOP;&#xa;                                    end&#xa;                                endcase&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_RESTART: begin//和普通START的区别是不产生STOP&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;//SCL低的时候释放SDA&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SCL拉高的时候SDA继续保持释放也就是高电平&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;//SDA由高变低，产生START&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;//SCL变低，准备下一阶段&#xa;                            sda_drive_low&lt;=1;&#xa;                            byte_tx &lt;= DEVICE_READ;//读MPU6050传来的&#xa;                            bit_count&lt;=7;&#xa;                            flow_step&lt;=13;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_SEND;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_READ: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;2: begin&#xa;                            scl_r&lt;=1;&#xa;                            byte_rx[bit_count]&lt;=sda_r2;//SCL高电平的时候采样数据&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            if(bit_count==0) begin&#xa;                                // 高字节接收完成&#xa;                                if(flow_step==14) begin&#xa;                                    mpu_zh_read&lt;=byte_rx;&#xa;                                    // 高字节后主机发送ACK&#xa;                                    master_ack_low&lt;=1;&#xa;                                    flow_step&lt;=15;&#xa;                                    cstate&lt;=ST_MASTER_ACK;&#xa;                                end&#xa;                                // 低字节接收完成&#xa;                                else if(flow_step==16) begin&#xa;                                    mpu_zl_read&lt;=byte_rx;&#xa;                                    // 暂存完整16位数据&#xa;                                    pending_raw_data &lt;= {&#xa;                                        mpu_zh_read,&#xa;                                        byte_rx//不能是mpu_zl_read，因为是非阻塞赋值&#xa;                                    };//分两次采集数据，两次采完才合成新数据&#xa;                                    pending_sample&lt;=1;&#xa;                                    //最后一个字节后主机发送NACK&#xa;                                    master_ack_low&lt;=0;&#xa;                                    flow_step&lt;=17;&#xa;                                    cstate&lt;=ST_MASTER_ACK;&#xa;                                end&#xa;                                else begin&#xa;                                    transaction_ok&lt;=0;&#xa;                                    pending_sample&lt;=0;&#xa;                                    cstate&lt;=ST_STOP;&#xa;                                end&#xa;                            end&#xa;                            else begin&#xa;                                bit_count&lt;= bit_count-1;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_MASTER_ACK: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;                        2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=master_ack_low;&#xa;                            phase&lt;=3;&#xa;                        end&#xa;                        3: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            // 高字节ACK后继续读取低字节&#xa;                            if(flow_step==15) begin&#xa;                                byte_rx&lt;=0;&#xa;                                bit_count&lt;=7;&#xa;                                flow_step&lt;=16;&#xa;                                cstate &lt;= ST_READ;&#xa;                            end&#xa;                            // 低字节NACK后产生STOP&#xa;                            else if(flow_step==17) begin&#xa;                                flow_step&lt;=18;&#xa;                                cstate&lt;=ST_STOP;&#xa;                            end&#xa;                            else begin&#xa;                                transaction_ok&lt;=0;&#xa;                                pending_sample&lt;=0;&#xa;                                cstate&lt;=ST_STOP;&#xa;                            end&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_STOP: begin&#xa;                    case(phase)&#xa;                        0: begin&#xa;                            scl_r&lt;=0;&#xa;                            sda_drive_low&lt;=1;&#xa;                            phase&lt;=1;&#xa;                        end&#xa;                        1: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=1;&#xa;                            phase&lt;=2;&#xa;                        end&#xa;&#xa;                        2'd2: begin&#xa;                            scl_r&lt;=1;&#xa;                            sda_drive_low&lt;=0;//SDA由低变高,STOP的标志&#xa;                            phase &lt;= 2'd3;&#xa;                        end&#xa;                        2'd3: begin&#xa;                            scl_r&lt;= 1;&#xa;                            sda_drive_low &lt;= 1'b0;&#xa;                            wait_count&lt;=0;&#xa;                            phase&lt;=0;&#xa;                            cstate&lt;=ST_WAIT;&#xa;                        end&#xa;                    endcase&#xa;                end&#xa;                ST_WAIT: begin//得在WAIT等10MS才能重新开始&#xa;                   scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;&#xa;                    if(wait_count == 12'd3999) begin&#xa;                        wait_count &lt;= 12'd0;&#xa;                        // 只有事务成功并且SDA已经恢复高电平，&#xa;                        // 才认为本次事务真正成功&#xa;                        if(transaction_ok &amp;&amp; sda_r2) begin&#xa;                            // 完成一个初始化寄存器&#xa;                            if(times&lt;4)&#xa;                                times &lt;= times+1;&#xa;                            // 五个初始化寄存器全部完成&#xa;                            else if(times==4) begin&#xa;                                times&lt;=5;&#xa;                                i2c_init_done &lt;= 1'b1;&#xa;                            end&#xa;                            // 完成一组Z轴高低字节读取&#xa;                            else begin&#xa;                                times&lt;=5;&#xa;                                if(pending_sample) begin&#xa;                                    raw_data_r &lt;= pending_raw_data;&#xa;                                    raw_data_vld_r&lt;=1;&#xa;                                    raw_data_vld_count&#xa;                                        &lt;= raw_data_vld_count + 1'b1;&#xa;                                        if(read_accel_z)begin&#xa;                                          accel_z_raw_r&lt;=pending_raw_data;&#xa;                                          accel_z_vld_r&lt;=1;&#xa;                                          raw_data_r&lt;=raw_data_r;&#xa;                                          raw_data_vld_r&lt;=0;&#xa;                                          gyro_read_count&lt;=0;&#xa;                                      end&#xa;                                    else begin&#xa;                                          gyro_read_count&lt;=gyro_read_count+1;&#xa;                                      end&#xa;                                end&#xa;                            end&#xa;                        end&#xa;                        pending_sample&lt;=0;&#xa;                        // SDA仍为低，重新执行9个恢复时钟&#xa;                        if(sda_r2==0) begin&#xa;                            recover_count&lt;=0;&#xa;                            cstate &lt;= ST_RECOVER;&#xa;                        end&#xa;                        else begin&#xa;                            cstate &lt;= ST_IDLE;&#xa;                        end&#xa;                    end&#xa;                    else begin&#xa;                        wait_count &lt;= wait_count + 1'b1;&#xa;                    end&#xa;                end&#xa;                default: begin&#xa;                    scl_r&lt;=1;&#xa;                    sda_drive_low&lt;=0;&#xa;                    phase&lt;=0;&#xa;                    recover_count&lt;=0;&#xa;                    pending_sample&lt;=0;&#xa;                    cstate &lt;= ST_RECOVER;&#xa;                end&#xa;&#xa;            endcase&#xa;        end&#xa;    end&#xa;end&#xa;// 原始Z轴数据输出&#xa;//大致就是&#xa;//获取ACCEL_Z&#xa;//→建立动态重力基准&#xa;//→计算当前值偏离基准的绝对值&#xa;//→得到瞬时振动幅值&#xa;//→连续统计8次&#xa;//→计算8次平均值和最大峰值&#xa;//→扣除正常振动底噪&#xa;//→映射为0～15级粗糙度&#xa;assign raw_data = raw_data_r;&#xa; assign accel_z_raw=accel_z_raw_r;&#xa;  reg [15:0]accel_z_base;//ACCEL_Z动态重力基准&#xa;  reg accel_z_base_valid;//动态基准已经建立&#xa;  reg [15:0]vibration_data_r;//当前垂直振动幅值&#xa;  reg [18:0]vibration_sum;//8次振动幅值累加&#xa;  reg [2:0]vibration_count;//8次窗口计数&#xa;  reg [15:0]vibration_peak;//窗口内最大冲击&#xa;  parameter BASE_FILTER_SHIFT=4;//动态基准每次修正差值的1/16&#xa;  parameter IMPACT_THRESHOLD=3500;//强冲击标志阈值，我根据实车测试调整&#xa;  parameter PEAK_LEVEL_THRESHOLD=4000;//窗口峰值达到该值时粗糙度直接显示15&#xa;parameter FLAT_VIB_BASE=900;&#xa;parameter FLAT_VIB_MARGIN=300;&#xa;wire [15:0]roughness_effective=&#xa;(vibration_avg_next>FLAT_VIB_BASE+FLAT_VIB_MARGIN)?&#xa;(vibration_avg_next-FLAT_VIB_BASE-FLAT_VIB_MARGIN):&#xa;0;//这里的BASE是我根据实车悬空制定的，又加了冗余量，可以认为effective是我真实有用的值&#xa;  wire road_detect_enable=(car_state==1||car_state==2||car_state==4||car_state==8);//运动的时候检测&#xa;  wire [15:0]accel_up_diff=accel_z_raw_r-accel_z_base;&#xa;  wire [15:0]accel_down_diff=accel_z_base-accel_z_raw_r;&#xa;  wire [15:0]vibration_now=(accel_z_raw_r>=accel_z_base)?accel_up_diff:accel_down_diff;//当前加速度值和动态基准之间绝对差值&#xa;  wire [18:0]vibration_sum_next=vibration_sum+vibration_now;&#xa;  wire [15:0]vibration_avg_next=vibration_sum_next>>3;&#xa;  wire [15:0]vibration_peak_next=(vibration_now>vibration_peak)?vibration_now:vibration_peak;&#xa;  assign vibration_data=vibration_data_r;&#xa;  always@(posedge clk_50m or posedge rst)begin&#xa;      if(rst)begin&#xa;          accel_z_base&lt;=0;&#xa;          accel_z_base_valid&lt;=0;&#xa;          vibration_data_r&lt;=0;&#xa;          vibration_sum&lt;=0;&#xa;          vibration_count&lt;=0;&#xa;          vibration_peak&lt;=0;&#xa;          vibration_vld&lt;=0;&#xa;          mpu_dir_z&lt;=0;&#xa;          error_mpu_z&lt;=0;&#xa;      end&#xa;      else begin&#xa;          vibration_vld&lt;=0;&#xa;          if(accel_z_vld_r)begin&#xa;              if(!accel_z_base_valid)begin//刚开始第一次&#xa;                  accel_z_base&lt;=accel_z_raw_r;&#xa;                  accel_z_base_valid&lt;=1;&#xa;                  vibration_data_r&lt;=0;&#xa;                  vibration_sum&lt;=0;&#xa;                  vibration_count&lt;=0;&#xa;                  vibration_peak&lt;=0;&#xa;                  mpu_dir_z&lt;=0;&#xa;                  error_mpu_z&lt;=0;&#xa;              end&#xa;              else begin&#xa;                  if(accel_z_raw_r>=accel_z_base)&#xa;                      accel_z_base&lt;=accel_z_base+(accel_up_diff>>BASE_FILTER_SHIFT);&#xa;                  else&#xa;                      accel_z_base&lt;=accel_z_base-(accel_down_diff>>BASE_FILTER_SHIFT);//逐渐变化,故意不跟随新的值快速移动，不然路面的震动就没法检测了&#xa;                  if(road_detect_enable)begin//允许检测&#xa;                      vibration_data_r&lt;=vibration_now;&#xa;                      vibration_vld&lt;=1;&#xa;                      if(vibration_now>=IMPACT_THRESHOLD)//达到强冲击阈值&#xa;                          mpu_dir_z&lt;=1;&#xa;                      else&#xa;                          mpu_dir_z&lt;=0;&#xa;                      if(vibration_now>vibration_peak)&#xa;                          vibration_peak&lt;=vibration_now;&#xa;                      if(vibration_count>=7)begin//到了八次了&#xa;                          vibration_count&lt;=0;&#xa;                          vibration_sum&lt;=0;&#xa;                          vibration_peak&lt;=0;//窗口峰值也清0&#xa;                          if(vibration_peak_next>=PEAK_LEVEL_THRESHOLD)&#xa;                              error_mpu_z&lt;=15;&#xa;                          else if(roughness_effective>=1920)&#xa;                              error_mpu_z&lt;=15;&#xa;                          else&#xa;                              error_mpu_z&lt;=roughness_effective>>7;&#xa;                      end&#xa;                      else begin//没到八次&#xa;                          vibration_count&lt;=vibration_count+1;&#xa;                          vibration_sum&lt;=vibration_sum_next;&#xa;                      end&#xa;                  end&#xa;                  else begin&#xa;                      vibration_data_r&lt;=0;&#xa;                      vibration_sum&lt;=0;&#xa;                      vibration_count&lt;=0;&#xa;                      vibration_peak&lt;=0;&#xa;                      mpu_dir_z&lt;=0;&#xa;                      error_mpu_z&lt;=0;&#xa;                  end&#xa;              end&#xa;          end&#xa;      end&#xa;  end&#xa;  //姿态解算部分&#xa;  wire straight_enable=(car_state==4'b0001|| car_state==4'b0010);&#xa;  parameter YAW_KI_SHIFT  = 4;    // 积分衰减（右移4位，相当于除以16）&#xa;  parameter GYRO_KP_SHIFT = 2;   // 比例衰减（右移2位，相当于除以4）&#xa;  parameter ERROR_SPEED   = 5;  // 比例放大系数（修正力度）&#xa;  parameter GYRO_DEADBAND = 2;   // 剔除零漂后，用于过滤底盘震动的极小死区&#xa;  reg [6:0]calib_cnt;//计算有没有到达64次，到了之后就求零点的平均值&#xa;  reg [21:0]calib_sum;//计算初始64位数据的总和，本来一个数据是16位，也就是[15:0],加了64次也就是乘了2的6次方，左移6位&#xa;  reg calib_done;//初始零点计算有没有结束&#xa;  reg [15:0]zero_offset;//零点的平均值&#xa;  wire [21:0]gyro_ext={{6{raw_data[15]}},raw_data};//扩展到22位，方便累加&#xa;  reg [15:0]data_r;&#xa;  reg [31:0]yaw_integral;&#xa;  wire [15:0]true_gyro=raw_data-zero_offset;//真实值=原始值-零漂误差值&#xa;  wire true_gyro_sign=true_gyro[15];&#xa;  wire [15:0]true_gyro_abs=true_gyro_sign?(~true_gyro+1):true_gyro;&#xa;  wire yaw_sign=yaw_integral[31];&#xa;  wire [31:0]yaw_abs=yaw_sign?(~yaw_integral+1):yaw_integral;//求补码，如果是负数的话就是取反再加1&#xa;  wire gyro_r_sign=data_r[15];&#xa;  wire [15:0]gyro_r_abs=gyro_r_sign?(~data_r+1):data_r;&#xa;  wire [31:0]yaw_scaled=yaw_abs>>YAW_KI_SHIFT;&#xa;  wire [15:0]gyro_scaled=gyro_r_abs>>GYRO_KP_SHIFT;//补码右移&#xa;  wire [31:0]yaw_term=yaw_sign?(~yaw_scaled+1):yaw_scaled;&#xa;  wire [31:0]gyro_term=gyro_r_sign?({~{16'd0,gyro_scaled}+32'd1}):{16'd0,gyro_scaled};&#xa;  wire [31:0]ctrl_out=yaw_term+gyro_term;&#xa;  wire ctrl_sign=ctrl_out[31];&#xa;  wire [31:0]ctrl_abs=ctrl_sign?(~ctrl_out+1):ctrl_out;&#xa;wire [31:0]ctrl_effective=(ctrl_abs>3)?(ctrl_abs-3):0;&#xa;  wire [34:0]calc_error_full={3'd0,ctrl_effective}*ERROR_SPEED;;&#xa;wire [31:0]gyro_ext_32={{16{data_r[15]}},data_r};&#xa;wire [31:0]yaw_sum=yaw_integral+gyro_ext_32;&#xa;&#xa;wire yaw_overflow_pos=(~yaw_integral[31]) &amp;&amp; (~gyro_ext_32[31]) &amp;&amp; yaw_sum[31];//正数溢出，两个正数相加最后符号位变成了负数&#xa;wire yaw_overflow_neg=(yaw_integral[31]) &amp;&amp; (gyro_ext_32[31]) &amp;&amp; ~yaw_sum[31];//负数溢出，两个负数相加最后符号位变成了正数&#xa;localparam [31:0] CTRL_DEADBAND=128;&#xa;parameter RESTART_MAX=30_000_000;&#xa;reg [27:0]restart_cnt;//静止0.6s重新开始计算零漂值&#xa;reg restart_flag;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    &#x9;&#x9;restart_cnt&lt;=0;&#xa;            restart_flag&lt;=0;&#xa;            end&#xa;            else if(car_state==4'b0000) begin&#xa;            if(restart_cnt>=RESTART_MAX-1) begin&#xa;            &#x9;&#x9;&#x9;restart_cnt&lt;=RESTART_MAX-1;&#xa;                        restart_flag&lt;=1;&#xa;                        end&#xa;                  else restart_cnt&lt;=restart_cnt+1;&#xa;                end&#xa;                else begin&#xa;                restart_flag&lt;=0;&#xa;                restart_cnt&lt;=0;&#xa;                end&#xa;&#xa;end&#xa;reg restart_r;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#x9;if(rst)&#xa;&#x9;&#x9;restart_r&lt;=0;&#xa;        else restart_r&lt;=restart_flag;&#xa;&#xa;end&#xa;wire restart_pulse=restart_flag&amp;&amp; ~restart_r;&#xa;&#xa;wire [31:0] ctrl_level;&#xa;assign ctrl_level = ctrl_abs >> 7;&#xa;  always @ ( posedge clk_50m or posedge rst )&#xa;  begin //1&#xa;  &#x9;if(rst)begin//2&#xa;      &#x9;calib_cnt&lt;=0;&#xa;          calib_done&lt;=0;&#xa;          calib_sum&lt;=0;&#xa;          error_mpu&lt;=0;&#xa;          data_r&lt;=0;&#xa;          yaw_integral&lt;=0;&#xa;          zero_offset&lt;=0;&#xa;          mpu_dir&lt;=0;&#xa;   &#xa;      end//2&#xa;      else begin //3&#xa;    &#x9;&#x9;&#x9;if(restart_pulse &amp;&amp; i2c_init_done)begin&#xa;            calib_cnt&lt;= 0;&#xa;            calib_sum&lt;= 0;&#xa;            calib_done&lt;= 0;&#xa;&#xa;            // 清除上一次直线控制产生的累计误差&#xa;            data_r &lt;= 0;&#xa;            yaw_integral&lt;= 0;&#xa;            error_mpu&lt;= 0;&#xa;            mpu_dir&lt;= 0;&#xa;                end&#xa;      &#x9;else &#x9;begin//4&#xa;              if(~calib_done &amp;&amp; i2c_init_done &amp;&amp; raw_data_vld_r &amp;&amp; restart_flag)begin&#xa;   &#x9;&#x9;&#x9;&#x9;if(calib_cnt&lt;64) begin//5&#xa;                  calib_cnt&lt;=calib_cnt+1;&#xa;                  calib_done&lt;=0;&#xa;                  calib_sum&lt;=calib_sum+gyro_ext;//没到64次就一直累加&#xa;                  end//5&#xa;                  else begin//6&#xa;                  zero_offset&lt;=calib_sum[21:6];&#xa;                  calib_done&lt;=1;&#xa;                  calib_sum&lt;=0;&#xa;                  calib_cnt&lt;=0;&#xa;                  end//6&#xa;                 end&#xa;    else begin      // 不处于直行/后退状态时，&#xa;    // 清除本次直线控制的航向累计值&#xa;    if(calib_done &amp;&amp; !straight_enable) begin&#xa;        data_r       &lt;= 16'd0;&#xa;        yaw_integral &lt;= 32'd0;&#xa;        error_mpu    &lt;= 4'd0;&#xa;        mpu_dir      &lt;= 1'b0;&#xa;    end&#xa;   else  if(calib_done &amp;&amp; raw_data_vld_r)//自检完成&#xa;      begin//7&#xa;      &#x9;&#x9;&#x9;begin if(true_gyro_abs>GYRO_DEADBAND)&#xa;                  &#x9;data_r&lt;=true_gyro;&#xa;                   else data_r&lt;=0;&#xa;                  end&#xa;                  begin &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;if(yaw_overflow_pos)&#xa;    yaw_integral &lt;= 32'h7FFF_FFFF;  // 最大正数&#xa;else begin if(yaw_overflow_neg)&#xa;    yaw_integral &lt;= 32'h8000_0000;  // 最小负数&#xa;else&#xa;    yaw_integral &lt;= yaw_sum;&#xa;    end&#xa;    end&#xa;                     if(ctrl_abs &lt; CTRL_DEADBAND) begin&#xa;    error_mpu &lt;= 4'd0;&#xa;&#xa;    // error_mpu=0时方向没有控制意义&#xa;    mpu_dir &lt;= 1'b0;&#xa;end&#xa;else begin&#xa;    mpu_dir &lt;= ctrl_sign;&#xa;&#xa;    if(ctrl_level > 32'd15)&#xa;        error_mpu &lt;= 4'd15;&#xa;    else&#xa;        error_mpu &lt;= ctrl_level[3:0];&#xa;end&#xa;                                  end&#xa;                                  end&#xa;                                  end&#xa;            end  //4  &#xa;      end//3&#xa;  //1" Color="beige" Comment="" Height="465" Name="MPU_IIC_SENSOR5" Parameters="" Parent="SENSOR_TOP" Type="model" Width="552" X="659" Y="213">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="MPU_IIC_SENSOR5" Side="left" Width="30" X="-0.0543478" Y="0.466667"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="MPU_IIC_SENSOR5" Side="left" Width="30" X="-0.0543478" Y="0.591398"/>
