  <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="vibration_data" Parent="MPU_IIC_SENSOR5" Side="left" Width="30" X="-0.0543478" Y="0.0903226"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="vibration_vld" Parent="MPU_IIC_SENSOR5" Side="left" Width="30" X="-0.0543478" Y="0.215054"/>
