<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#xa;" Color="#d3d3d3" Comment="" Height="1454" Name="UI_CMD_TOP" Parameters="" Parent="0" Type="model" Width="2457" X="0" Y="0">
 <Module Category="Current" Class="KEY_DEBOUNCE" Code="//接入10KHZ的时钟，能有效应对矿物运输过程中的干扰因素&#xa;//key_value的值对应如下：&#xa;//111_111_110->1&#xa;//111_111_101->2&#xa;//111_111_011->3&#xa;//111_110_111->4&#xa;//111_101_111->5&#xa;//111_011_111->6&#xa;//110_111_111->7&#xa;//101_111_111->8&#xa;//011_111_111->9&#xa;reg [8:0] key1;//三次的采样值&#xa;reg [8:0] key2;&#xa;reg [8:0] key3;&#xa;reg [8:0]key_old;&#xa;reg key_trig;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin if(rst) begin&#xa;&#x9;&#x9;key_value&lt;=9'b111_111_111;&#xa;&#x9;&#x9;key1&lt;=9'b111_111_111;&#xa;        key2&lt;=9'b111_111_111;&#xa;        key3&lt;=9'b111_111_111;&#xa;        key_old&lt;=9'b111_111_111;&#xa;        key_trig&lt;=0;&#xa;        end&#xa;        else begin if(en_10k) begin&#xa;        &#x9;&#x9;key3&lt;=key2;&#xa;            key2&lt;=key1;&#xa;            key1&lt;=key_in;&#xa;            end&#xa;            if((key1==key2) &amp;&amp; (key1==key3)) begin //连续三次采样都相等&#xa;            &#x9;&#x9;if(key_old==9'b111_111_111 &amp;&amp; key1!=9'b111_111_111)//旧key值为空也就是9'b111_111_111,并且最新值不为空时进入赋值&#xa;                    //目的是为了按一次键即时不松手，赋值也只触发一次&#xa;                    begin&#xa;                    key_trig&lt;=1;&#xa;                    key_old&lt;=key3;&#xa;                    end&#xa;                    else  begin  key_trig&lt;=0;&#xa;                    &#x9;&#x9;&#x9;&#x9;key_old&lt;=key3;&#xa;                    end&#xa;&#xa;                    if(key_trig)&#xa;            begin&#xa;            &#x9;&#x9;case(key3)//按行分类&#xa;                   9'b111_111_110:key_value&lt;=key3;//用三次采样后的数据，能尽量避免偶发干扰和短时间抖动（机械抖动和运输干扰）&#xa;                &#x9;  9'b111_111_101:key_value&lt;=key3;&#xa;                    9'b111_111_011:key_value&lt;=key3;&#xa;                    9'b111_110_111:key_value&lt;=key3;&#xa;                    9'b111_101_111:key_value&lt;=key3;&#xa;                    9'b111_011_111:key_value&lt;=key3;&#xa;                    9'b110_111_111:key_value&lt;=key3;&#xa;                    9'b101_111_111:key_value&lt;=key3;&#xa;                    9'b011_111_111:key_value&lt;=key3;&#xa;                    default:key_value&lt;=key_value;&#xa;                    endcase&#xa;            end&#xa;            else key_value&lt;=key_value;//采样失败，保持原值            &#xa;        end        &#xa;        else begin&#xa;        key_old&lt;=key_old;&#xa;        key_trig&lt;=key_trig;//消抖不稳定时保持原态     &#xa;        end       &#xa;        end&#xa;end&#xa;" Color="azure" Comment="" Height="220" Name="KEY_DEBOUNCE4" Parameters="" Parent="UI_CMD_TOP" Type="model" Width="200" X="615" Y="877.5">
  <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="reg" Description="" Height="30" Inout="output" Name="key_value" Parent="KEY_DEBOUNCE4" Side="right" Width="30" X="0.85" Y="0.681818"/>
  <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_in" Parent="KEY_DEBOUNCE4" Side="left" Width="30" X="-0.15" Y="0.431818"/>
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="KEY_DEBOUNCE4" Side="top" Width="30" X="0.425" Y="-0.136364"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_10k" Parent="KEY_DEBOUNCE4" Side="right" Width="30" X="0.85" Y="0.181818"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="KEY_DEBOUNCE4" Side="right" Width="30" X="0.85" Y="0.431818"/>
 </Module>
 <Module Category="Current" Class="SEG_LED_BUZZ" Code="//因为模块限额，我只能把原先的SEL_SEG,LED,BUZZ模块融合，请谅解&#xa;//SEL_SEG部分&#xa;  //   // 数字段码&#xa;    parameter  SEG_0    = 8'hC0;  // 数字 0&#xa;    parameter  SEG_1    = 8'hF9;  // 数字 1&#xa;    parameter  SEG_2    = 8'hA4;  // 数字 2&#xa;    parameter  SEG_3    = 8'hB0;  // 数字 3&#xa;    parameter  SEG_4    = 8'h99;  // 数字 4&#xa;    parameter  SEG_5    = 8'h92;  // 数字 5&#xa;    parameter  SEG_6    = 8'h82;  // 数字 6&#xa;    parameter  SEG_7    = 8'hF8;  // 数字 7&#xa;    parameter  SEG_8    = 8'h80;  // 数字 8&#xa;    parameter  SEG_9    = 8'h90;  // 数字 9&#xa;    // 熄灭码 (全灭)&#xa;    parameter  SEG_OFF  = 8'hFF;  // 数码管全灭&#xa;    parameter IDLE=4'b0000;&#xa;    parameter GO=4'b0001;&#xa;    parameter BACK=4'b0010;&#xa;    parameter LEFT=4'b0100;&#xa;    parameter RIGHT=4'b1000;&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        &#x9;&#x9;sel&lt;=6'b111_110;&#xa;         else if(en_500)&#xa;         sel&lt;={sel[4:0],sel[5]};&#xa;    end&#xa;    always @ ( * )&#xa;&#x9; begin&#xa;        &#x9;case( car_state)&#xa;        IDLE:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        &#xa;        GO:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_1;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        BACK:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_1;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        LEFT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_1;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        RIGHT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_1;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end   &#xa;                default:seg=SEG_6;&#xa;            endcase&#xa;&#xa;        end &#xa;//BUZZ部分&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst)&#xa;buzz_out&lt;=0;&#xa;else begin&#x9;if(en_2k) begin&#xa;&#x9;&#x9;&#x9;&#x9;if(car_state==4'b0100||car_state==4'b1000||car_state==4'b0010||gas_alarm||stall_alarm) &#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;buzz_out&lt;=~buzz_out;&#xa;                   else buzz_out&lt;=0;&#xa;                        end&#xa;                end&#xa;&#xa;end&#xa; //LED部分&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;  begin &#xa;   if(rst) begin&#xa;    go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      else begin if(en_1)&#xa;      case( car_state)&#xa;      4'b0000:begin&#xa;   go&lt;=2'b11;&#xa;   back&lt;=2'b11;&#xa;   right&lt;=2'b11;&#xa;      left&lt;=2'b11;&#xa;      end&#xa;      4'b0001:begin &#xa;  go&lt;=~go;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0010:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=~back;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0100:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=~left;&#xa;      end&#xa;      4'b1000:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=~right;&#xa;      left&lt;=2'b00;&#xa;  &#xa;      end&#xa;          default:  begin&#xa;          go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end &#xa;      endcase&#xa;      &#xa;      end    &#xa;  end&#xa;" Color="aqua" Comment="" Height="445" Name="SEG_LED_BUZZ2" Parameters="" Parent="UI_CMD_TOP" Type="model" Width="930" X="915" Y="320.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.107865"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_500" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.249438"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.391011"/>
  <Port Color="#f0ffff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.532584"/>
  <Port Color="#f5f5dc" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="sel" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.674157"/>
  <Port Color="#ffe4c4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="seg" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.81573"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.674157"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_2k" Parent="SEG_LED_BUZZ2" Side="left" Width="30" X="-0.0322581" Y="0.81573"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1" Parent="SEG_LED_BUZZ2" Side="bottom" Width="30" X="0.483871" Y="0.932584"/>
  <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="go" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.391011"/>
  <Port Color="#deb887" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.532584"/>
  <Port Color="#5f9ea0" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.249438"/>
  <Port Color="#7fff00" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="back" Parent="SEG_LED_BUZZ2" Side="right" Width="30" X="0.967742" Y="0.107865"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="buzz_out" Parent="SEG_LED_BUZZ2" Side="top" Width="30" X="0.317204" Y="-0.0674157"/>
  <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="stall_alarm" Parent="SEG_LED_BUZZ2" Side="top" Width="30" X="0.650538" Y="-0.0674157"/>
 </Module>
