<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="" Color="#d3d3d3" Comment="" Height="1235" Name="BT_RECEIVING" Parameters="" Parent="0" Type="model" Width="1850" X="0" Y="0">
 <Module Category="Current" Class="DATA_PACK_SEND" Code="//本来我是把FAULT_LOGGER模块单独写的，但是超过了20个模块的限额，所以只能把FAULT_LOGGER放这里写的&#xa;reg [2:0]fault_0;&#xa;reg [2:0]fault_1;&#xa;reg [2:0]fault_2;&#xa;reg [2:0]fault_3;&#xa;reg [2:0]fault_4;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;  begin &#xa;   if(rst)begin&#xa;      fault_4&lt;=0;&#xa;      fault_3&lt;=0;&#xa;      fault_2&lt;=0;&#xa;      fault_1&lt;=0;&#xa;      fault_0&lt;=0;&#xa;      end&#xa;      else begin&#xa;        if(new_stop_event)begin&#xa;              fault_4&lt;=fault_3;&#xa;              fault_3&lt;=fault_2;&#xa;              fault_2&lt;=fault_1;&#xa;              fault_1&lt;=fault_0;&#xa;              fault_0&lt;=curr_stop;&#xa;              end&#xa;      end&#xa;  end&#xa;reg [7:0]step;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    tx_data&lt;=0;&#xa;    tx_data_vld&lt;=0;&#xa;    step&lt;=0;&#xa;    end&#xa;    else if(en_500)&#xa;    begin&#xa;    step&lt;=(step==43)?0:step+1;&#xa;    tx_data_vld&lt;=1;&#xa;    case(step)&#xa;    0:tx_data&lt;=8'hAA;&#xa;    1:tx_data&lt;={4'd0,car_state};&#xa;    2:tx_data&lt;={5'd0,heavy_load_state,overload_state,gas_alarm};&#xa;    3:tx_data&lt;=weight_data[23:16];&#xa;    4:tx_data&lt;=weight_data[15:8];&#xa;    5:tx_data&lt;=weight_data[7:0];&#xa;    6:tx_data&lt;=fault_0;&#xa;    7:tx_data&lt;=fault_1;&#xa;    8:tx_data&lt;=fault_2;&#xa;    9:tx_data&lt;=fault_3;&#xa;    10:tx_data&lt;=fault_4;&#xa;    11:tx_data&lt;=distance_mm1[7:0];&#xa;     12:tx_data&lt;=distance_mm1[15:8];&#xa;    13:tx_data&lt;=distance_mm2[7:0];&#xa;    14:tx_data&lt;=distance_mm2[15:8];&#xa;    15:tx_data&lt;=actual_speed_left[7:0];&#xa;        16:tx_data&lt;=actual_speed_left[15:8];&#xa;            17:tx_data&lt;=actual_speed_right[7:0];&#xa;                18:tx_data&lt;=actual_speed_right[15:8];&#xa;                    19:tx_data&lt;=target_speed_l[7:0];&#xa;                    20:tx_data&lt;=target_speed_l[15:8];&#xa;                    21:tx_data&lt;=target_speed_r[7:0];&#xa;                    22:tx_data&lt;=target_speed_r[15:8];&#xa;              23:tx_data&lt;={4'd0,error_mpu};&#xa;24:tx_data&lt;={7'd0,mpu_dir}; &#xa;25:tx_data&lt;={7'd0, mpu_dir_z};&#xa;26:tx_data&lt;={4'd0,error_mpu_z} ;&#xa;27:tx_data&lt;={7'd0,sensor_lost};// sensor_lost,&#xa;28:tx_data&lt;={ sensor_fault};//,&#xa;29:tx_data&lt;={4'd0,track_confidence};// track_confidence,&#xa;30:tx_data&lt;={6'd0,control_mode};// [1:0] control_mode,&#xa;31:tx_data&lt;={6'd0,load_event_state};//load_event_state,&#xa;32:tx_data&lt;={7'd0,load_event_toggle};// load_event_toggle,&#xa;33:tx_data&lt;=load_change_amount[7:0];&#xa;34:tx_data&lt;=load_change_amount[15:8];&#xa;35:tx_data&lt;=load_change_amount[23:16];&#xa;36:tx_data&lt;={7'd0,settle_timeout_fault};&#xa;37:tx_data&lt;={7'd0,overload_state};&#xa;38:tx_data&lt;=vibration_data[7:0];&#xa;39:tx_data&lt;=vibration_data[15:8];&#xa;40:tx_data&lt;={7'd0,vibration_vld};&#xa;41:tx_data&lt;={6'd0,stall_state};&#xa;42:tx_data&lt;={7'd0,stall_alarm};&#xa;    43:tx_data&lt;=8'h55;&#xa;    default:begin&#xa;    tx_data&lt;=0;&#xa;    step&lt;=0;&#xa;    tx_data_vld&lt;=0;&#xa;    end&#xa;    endcase&#xa;    end&#xa;    else tx_data_vld&lt;=0;&#xa;end" Color="antiquewhite" Comment="" Height="279" Name="DATA_PACK_SEND1" Parameters="" Parent="BT_RECEIVING" Type="model" Width="414" X="1130.5" Y="298.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.0144928" Y="0.892473"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.0652174" Y="0.892473"/>
  <Port Color="#ffebcd" Connect="" Datasize="24" Datatype="wire" Description="" Height="30" Inout="input" Name="weight_data" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.115942" Y="0.892473"/>
  <Port Color="#0000ff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.166667" Y="0.892473"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.784946"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="tx_data_vld" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.217391" Y="0.892473"/>
  <Port Color="#deb887" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="tx_data" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.268116" Y="0.892473"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_500" Parent="DATA_PACK_SEND1" Side="top" Width="30" X="0.161836" Y="-0.107527"/>
  <Port Color="#7fff00" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="curr_stop" Parent="DATA_PACK_SEND1" Side="top" Width="30" X="0.359903" Y="-0.107527"/>
  <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="new_stop_event" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.318841" Y="0.892473"/>
  <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="actual_speed_left" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.369565" Y="0.892473"/>
  <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="actual_speed_right" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.42029" Y="0.892473"/>
  <Port Color="#d2691e" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="target_speed_l" Parent="DATA_PACK_SEND1" Side="top" Width="30" X="0.557971" Y="-0.107527"/>
  <Port Color="#7fff00" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="target_speed_r" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.471014" Y="0.892473"/>
  <Port Color="#ff7f50" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_mm2" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.521739" Y="0.892473"/>
  <Port Color="#6495ed" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_mm1" Parent="DATA_PACK_SEND1" Side="top" Width="30" X="0.756039" Y="-0.107527"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="heavy_load_state" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.0860215"/>
  <Port Color="#fff8dc" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="error_mpu" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.0860215"/>
  <Port Color="#dc143c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="mpu_dir" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.225806"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="mpu_dir_z" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.365591"/>
  <Port Color="#00008b" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="error_mpu_z" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.505376"/>
  <Port Color="#008b8b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_lost" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.645161"/>
  <Port Color="#b8860b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_fault" Parent="DATA_PACK_SEND1" Side="left" Width="30" X="-0.0724638" Y="0.784946"/>
  <Port Color="#a9a9a9" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="track_confidence" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.572464" Y="0.892473"/>
  <Port Color="#006400" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="control_mode" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.623188" Y="0.892473"/>
  <Port Color="#a9a9a9" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="load_event_state" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.673913" Y="0.892473"/>
  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="load_event_toggle" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.724638" Y="0.892473"/>
  <Port Color="#8b008b" Connect="" Datasize="24" Datatype="wire" Description="" Height="30" Inout="input" Name="load_change_amount" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.775362" Y="0.892473"/>
  <Port Color="#556b2f" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settle_timeout_fault" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.225806"/>
  <Port Color="#ff8c00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.365591"/>
  <Port Color="#9932cc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="vibration_data" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.826087" Y="0.892473"/>
  <Port Color="#8b0000" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="vibration_vld" Parent="DATA_PACK_SEND1" Side="bottom" Width="30" X="0.876812" Y="0.892473"/>
  <Port Color="#e9967a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="stall_alarm" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.505376"/>
  <Port Color="#8fbc8f" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="stall_state" Parent="DATA_PACK_SEND1" Side="right" Width="30" X="0.927536" Y="0.645161"/>
 </Module>
 <Module Category="Current" Class="UART_TX" Code="localparam CLOCK=50_000_000;//系统时钟频率&#xa;localparam BAUD=115200;//波特率&#xa;localparam CHECK_BIT=&quot;None&quot;;&#xa;parameter MAX_1BAUD=CLOCK/BAUD;//发送一波特数据需要多少个系统时钟&#xa;parameter IDLE=5'b00000;&#xa;parameter START=5'b00001;&#xa;parameter DATA=5'b00010;&#xa;parameter CHECK=5'b00100;&#xa;parameter STOP=5'b01000;&#xa;reg [4:0]cstate;&#xa;reg [4:0]nstate;&#xa;reg [15:0]cnt_baud;&#xa;reg [3:0]cnt_bit;&#xa;reg [3:0]max_bit;&#xa;reg [7:0]tx_data_r;//暂时数据寄存器，防止发送数据的过程中，系统输入的tx_data发生变化，导致tx无法正确输出&#xa;wire add_baud;&#xa;wire end_baud;&#xa;wire add_bit;&#xa;wire end_bit;&#xa;wire check_val;&#xa;wire IDLE_START=(cstate==IDLE) &amp;&amp; tx_data_vld;&#xa;wire START_DATA=(cstate==START) &amp;&amp; end_bit;&#xa;wire DATA_CHECK=(cstate==DATA) &amp;&amp; end_bit &amp;&amp; (CHECK_BIT!=&quot;None&quot;);&#xa;wire DATA_STOP=(cstate==DATA) &amp;&amp; end_bit &amp;&amp; (CHECK_BIT==&quot;None&quot;);&#xa;wire CHECK_STOP=(cstate==CHECK) &amp;&amp; end_bit;&#xa;wire STOP_IDLE=(cstate==STOP)&amp;&amp; end_bit;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    cnt_baud&lt;=0;&#xa;    else begin&#xa;    &#x9;&#x9;if(add_baud) begin&#xa;            if(end_baud)&#xa;            &#x9;&#x9;cnt_baud&lt;=0;&#xa;            else cnt_baud&lt;=cnt_baud+1;&#xa;                     end&#xa;         else cnt_baud&lt;=0;&#xa;    end &#xa;end&#xa;assign add_baud=cstate!=IDLE;//只要不在空闲位，就开始计算&#xa;assign end_baud=add_baud &amp;&amp; (cnt_baud==MAX_1BAUD-1);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    cnt_bit&lt;=0;&#xa;    else begin&#xa;    &#x9;&#x9;if(add_bit) begin&#xa;            if(end_bit)&#xa;            &#x9;&#x9;cnt_bit&lt;=0;&#xa;            else cnt_bit&lt;=cnt_bit+1;&#xa;                     end&#xa;    end &#xa;end&#xa;assign add_bit=end_baud;//上一个bit的波特率计算结束，就开始下一bit的计算&#xa;assign end_bit=add_bit &amp;&amp; (cnt_bit==max_bit-1);&#xa;always @ (*  )&#xa;begin case( cstate)&#xa;&#x9;IDLE:max_bit=0;&#xa;    START:max_bit=1;&#xa;    DATA:max_bit=8;&#xa;    CHECK:max_bit=1;&#xa;    STOP:max_bit=1;&#xa;    default: max_bit=0;&#xa;endcase&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;cstate&lt;=IDLE;&#xa;    else cstate&lt;=nstate;&#xa;end&#xa;always @ (*  )&#xa;begin case(cstate )&#xa;&#x9;IDLE:if(IDLE_START)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=START;&#xa;         else nstate&lt;=cstate;&#xa;     START:if(START_DATA)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=DATA;&#xa;          else nstate&lt;=cstate;&#xa;     DATA:if(DATA_CHECK)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=CHECK;&#xa;           else begin if(DATA_STOP)&#xa;        &#x9;&#x9;&#x9;&#x9;nstate&lt;=STOP;&#xa;                 else nstate&lt;=cstate;&#xa;                end&#xa;      CHECK:if(CHECK_STOP)&#xa;    &#x9;&#x9;&#x9;&#x9;nstate&lt;=STOP;&#xa;            else nstate&lt;=cstate;&#xa;       STOP:if(STOP_IDLE)&#xa;    &#x9;&#x9;&#x9;&#x9;nstate&lt;=IDLE;&#xa;             else nstate&lt;=cstate;&#xa;    default:nstate&lt;=IDLE;//防止锁存&#xa;endcase&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin if(rst)&#xa;&#x9;&#x9;tx_data_r&lt;=0;&#xa;        else begin if(tx_data_vld)&#xa;        &#x9;&#x9;tx_data_r&lt;=tx_data;&#xa;                else tx_data_r&lt;=tx_data_r;&#xa;                end&#xa;end&#xa;&#xa;assign check_val=(CHECK_BIT==&quot;None&quot;)?~^tx_data_r:^tx_data_r;&#xa;always @ (  *)&#xa;begin case( cstate)&#xa;&#x9;IDLE:tx=1;&#xa;    START:tx=0;&#xa;    DATA:tx=tx_data_r[cnt_bit];&#xa;    CHECK:tx=check_val;&#xa;    STOP:tx=1;&#xa;    default:  tx=0;&#xa;endcase&#xa;end&#xa;assign ready=(cstate==IDLE);" Color="aquamarine" Comment="" Height="50" Name="UART_TX3" Parameters="" Parent="BT_RECEIVING" Type="model" Width="187" X="1439.5" Y="89.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="UART_TX3" Side="bottom" Width="30" X="0.0588235" Y="0.4"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="tx_data_vld" Parent="UART_TX3" Side="bottom" Width="30" X="0.197861" Y="0.4"/>
  <Port Color="#f0ffff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="tx_data" Parent="UART_TX3" Side="bottom" Width="30" X="0.336898" Y="0.4"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="ready" Parent="UART_TX3" Side="bottom" Width="30" X="0.475936" Y="0.4"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="tx" Parent="UART_TX3" Side="bottom" Width="30" X="0.614973" Y="0.4"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="UART_TX3" Side="bottom" Width="30" X="0.754011" Y="0.4"/>
 </Module>
 <Module Category="Current" Class="STOP_DETECTING" Code="parameter STOP_NONE=8'd0;&#xa;parameter STOP_GAS=8'd1;&#xa;parameter STOP_OBSTACLE_GO=8'd2;&#xa;parameter STOP_OBSTACLE_BACK=8'd3;&#xa;parameter STOP_KEY=8'd4;&#xa;parameter STOP_SETTLETIME_FAULT=8'd5;&#xa;parameter STOP_OVERLOAD=8'D6;&#xa;parameter IDLE=4'B0000;&#xa;parameter GO=4'B0001;&#xa;parameter BACK=4'B0010;&#xa;parameter LEFT=4'B0100;&#xa;parameter RIGHT=4'B1000;&#xa;parameter DIGIT1=9'b111_111_110;&#xa;parameter DIGIT2=9'b111_111_101;&#xa;parameter DIGIT3=9'b111_111_011;&#xa;parameter DIGIT4=9'b111_110_111;&#xa;parameter DIGIT5=9'b111_101_111;&#xa;parameter DIGIT6=9'b111_011_111;&#xa;parameter DIGIT7=9'b110_111_111;&#xa;parameter DIGIT8=9'b101_111_111;&#xa;parameter DIGIT9=9'b011_111_111;&#xa;reg [7:0]last_curr_stop;&#xa;reg prev_stop;&#xa;wire [8:0] selected_key;&#xa;assign selected_key =&#xa;       bt_lock     ? key_cmd :&#xa;       sensor_lock ? DIGIT2 :&#xa;                     key_value;&#xa;wire car_moving;&#xa;assign car_moving =&#xa;       (car_state == GO)&#xa;    || (car_state == BACK)&#xa;    || (car_state == LEFT)&#xa;    || (car_state == RIGHT);&#xa;reg       stop_request_now;&#xa;reg [7:0] stop_reason_now;&#xa;&#xa;always @ (*)&#xa;begin&#xa;&#xa;    stop_request_now = 0;&#xa;    stop_reason_now  = STOP_NONE;&#xa;    // 1. 瓦斯超标&#xa;    // 对应 CAR_STATE：&#xa;    // if(force_stop)&#xa;    if(gas_alarm)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_GAS;&#xa;    end&#xa;    // 2. 前方障碍&#xa;    // 必须与 CAR_STATE 一样检查当前命令方向。&#xa;    // 前进、左转、右转使用前方超声波。=&#xa;    else if(&#xa;        distance_vld_go &amp;&amp;&#xa;        (&#xa;            selected_key == DIGIT2 ||&#xa;            selected_key == DIGIT4 ||&#xa;            selected_key == DIGIT6&#xa;        )&#xa;    )&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OBSTACLE_GO;&#xa;    end&#xa;    // 3. 后方障碍&#xa;    // 只有当前要求后退时，&#xa;    // 后方障碍才是真正导致 CAR_STATE 停车的原因。&#xa;    else if(&#xa;        distance_vld_back &amp;&amp;&#xa;        selected_key == DIGIT8&#xa;    )&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OBSTACLE_BACK;&#xa;    end&#xa;    // 4. 称重稳定/行驶载荷异常故障&#xa;    else if(settletime_fault)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_SETTLETIME_FAULT;&#xa;    end&#xa;    // 5. 超载&#xa;    else if(overload_state)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OVERLOAD;&#xa;    end&#xa;    // 6. 人工停止&#xa; // 直接判断 selected_key，&#xa; // 保证与 CAR_STATE 当前真正采用的控制源一致。&#xa;    else if(selected_key == DIGIT5)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_KEY;&#xa;    end&#xa;end&#xa;reg [7:0] pending_stop_reason;&#xa;reg       pending_stop_valid;&#xa;&#xa;reg prev_gas_alarm;&#xa;reg prev_settletime_fault;&#xa;reg prev_overload_state;&#xa;&#xa;&#xa;//============================================================&#xa;// 停车/安全事件记录&#xa;//============================================================&#xa;always @ (posedge clk_50m or posedge rst)&#xa;begin&#xa;    if(rst)&#xa;    begin&#xa;        curr_stop              &lt;= STOP_NONE;&#xa;        new_stop_event         &lt;= 1'b0;&#xa;&#xa;        pending_stop_reason    &lt;= STOP_NONE;&#xa;        pending_stop_valid     &lt;= 1'b0;&#xa;&#xa;        prev_stop              &lt;= 1'b1;&#xa;&#xa;        prev_gas_alarm         &lt;= 1'b0;&#xa;        prev_settletime_fault  &lt;= 1'b0;&#xa;        prev_overload_state    &lt;= 1'b0;&#xa;    end&#xa;    else&#xa;    begin&#xa;&#xa;        // new_stop_event 默认只保持一个 clk_50m 周期&#xa;        new_stop_event &lt;= 1'b0;&#xa;&#xa;        // 保存上一周期状态&#xa;        prev_stop             &lt;= (car_state == IDLE);&#xa;        prev_gas_alarm        &lt;= gas_alarm;&#xa;        prev_settletime_fault &lt;= settletime_fault;&#xa;        prev_overload_state   &lt;= overload_state;&#xa;&#xa;&#xa;        //====================================================&#xa;        // 1. 静止状态下的安全报警&#xa;        //&#xa;        // 这些不是“车辆由运动变停止”，&#xa;        // 但是仍然属于必须记录的重要安全事件。&#xa;        //====================================================&#xa;&#xa;        // 瓦斯报警上升沿&#xa;        if((car_state == IDLE) &amp;&amp;&#xa;           gas_alarm &amp;&amp;&#xa;           (~prev_gas_alarm))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_GAS;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;&#xa;        // 载荷异常上升沿&#xa;        else if((car_state == IDLE) &amp;&amp;&#xa;                settletime_fault &amp;&amp;&#xa;                (~prev_settletime_fault))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_SETTLETIME_FAULT;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;&#xa;        // 超载上升沿&#xa;        else if((car_state == IDLE) &amp;&amp;&#xa;                overload_state &amp;&amp;&#xa;                (~prev_overload_state))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_OVERLOAD;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;&#xa;&#xa;        //====================================================&#xa;        // 2. 车辆运动过程中发生真正停车请求&#xa;        //&#xa;        // 先锁存原因，等待 CAR_STATE 真正进入 IDLE。&#xa;        //====================================================&#xa;        else&#xa;        begin&#xa;&#xa;            if(car_moving &amp;&amp; stop_request_now)&#xa;            begin&#xa;                pending_stop_reason &lt;= stop_reason_now;&#xa;                pending_stop_valid  &lt;= 1'b1;&#xa;            end&#xa;&#xa;&#xa;            //================================================&#xa;            // 上一周期正在运动，本周期进入 IDLE&#xa;            //================================================&#xa;            if((car_state == IDLE) &amp;&amp;&#xa;               (prev_stop == 1'b0))&#xa;            begin&#xa;&#xa;                if(pending_stop_valid)&#xa;                begin&#xa;                    curr_stop      &lt;= pending_stop_reason;&#xa;                    new_stop_event &lt;= 1'b1;&#xa;&#xa;                    pending_stop_valid &lt;= 1'b0;&#xa;                end&#xa;&#xa;                //没有 pending_stop_valid：&#xa;                //例如 GO -> IDLE -> BACK&#xa;                //属于正常换向保护，不产生停车事件&#xa;            end&#xa;&#xa;        end&#xa;&#xa;    end&#xa;end" Color="azure" Comment="" Height="700" Name="STOP_DETECTING4" Parameters="" Parent="BT_RECEIVING" Type="model" Width="829" X="298.5" Y="487.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.478571"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.578571"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.678571"/>
  <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_value" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.778571"/>
  <Port Color="#b8860b" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_sensor" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.878571"/>
  <Port Color="#ffebcd" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="STOP_DETECTING4" Side="bottom" Width="30" X="0.481303" Y="0.957143"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="new_stop_event" Parent="STOP_DETECTING4" Side="right" Width="30" X="0.963812" Y="0.311429"/>
  <Port Color="#8a2be2" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="curr_stop" Parent="STOP_DETECTING4" Side="right" Width="30" X="0.963812" Y="0.644286"/>
  <Port Color="#a52a2a" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.378571"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_lock" Parent="STOP_DETECTING4" Side="top" Width="30" X="0.231604" Y="-0.0428571"/>
  <Port Color="#deb887" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_lock" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.278571"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="STOP_DETECTING4" Side="top" Width="30" X="0.481303" Y="-0.0428571"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_back" Parent="STOP_DETECTING4" Side="top" Width="30" X="0.731001" Y="-0.0428571"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settletime_fault" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.0785714"/>
  <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="STOP_DETECTING4" Side="left" Width="30" X="-0.0361882" Y="0.178571"/>
 </Module>
