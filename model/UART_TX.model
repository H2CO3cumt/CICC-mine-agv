<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam CLOCK=50_000_000;//系统时钟频率&#xa;localparam BAUD=115200;//波特率&#xa;localparam CHECK_BIT=&quot;None&quot;;&#xa;parameter MAX_1BAUD=CLOCK/BAUD;//发送一波特数据需要多少个系统时钟&#xa;parameter IDLE=5'b00000;&#xa;parameter START=5'b00001;&#xa;parameter DATA=5'b00010;&#xa;parameter CHECK=5'b00100;&#xa;parameter STOP=5'b01000;&#xa;reg [4:0]cstate;&#xa;reg [4:0]nstate;&#xa;reg [15:0]cnt_baud;&#xa;reg [3:0]cnt_bit;&#xa;reg [3:0]max_bit;&#xa;reg [7:0]tx_data_r;//暂时数据寄存器，防止发送数据的过程中，系统输入的tx_data发生变化，导致tx无法正确输出&#xa;wire add_baud;&#xa;wire end_baud;&#xa;wire add_bit;&#xa;wire end_bit;&#xa;wire check_val;&#xa;wire IDLE_START=(cstate==IDLE) &amp;&amp; tx_data_vld;&#xa;wire START_DATA=(cstate==START) &amp;&amp; end_bit;&#xa;wire DATA_CHECK=(cstate==DATA) &amp;&amp; end_bit &amp;&amp; (CHECK_BIT!=&quot;None&quot;);&#xa;wire DATA_STOP=(cstate==DATA) &amp;&amp; end_bit &amp;&amp; (CHECK_BIT==&quot;None&quot;);&#xa;wire CHECK_STOP=(cstate==CHECK) &amp;&amp; end_bit;&#xa;wire STOP_IDLE=(cstate==STOP)&amp;&amp; end_bit;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    cnt_baud&lt;=0;&#xa;    else begin&#xa;    &#x9;&#x9;if(add_baud) begin&#xa;            if(end_baud)&#xa;            &#x9;&#x9;cnt_baud&lt;=0;&#xa;            else cnt_baud&lt;=cnt_baud+1;&#xa;                     end&#xa;         else cnt_baud&lt;=0;&#xa;    end &#xa;end&#xa;assign add_baud=cstate!=IDLE;//只要不在空闲位，就开始计算&#xa;assign end_baud=add_baud &amp;&amp; (cnt_baud==MAX_1BAUD-1);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    cnt_bit&lt;=0;&#xa;    else begin&#xa;    &#x9;&#x9;if(add_bit) begin&#xa;            if(end_bit)&#xa;            &#x9;&#x9;cnt_bit&lt;=0;&#xa;            else cnt_bit&lt;=cnt_bit+1;&#xa;                     end&#xa;    end &#xa;end&#xa;assign add_bit=end_baud;//上一个bit的波特率计算结束，就开始下一bit的计算&#xa;assign end_bit=add_bit &amp;&amp; (cnt_bit==max_bit-1);&#xa;always @ (*  )&#xa;begin case( cstate)&#xa;&#x9;IDLE:max_bit=0;&#xa;    START:max_bit=1;&#xa;    DATA:max_bit=8;&#xa;    CHECK:max_bit=1;&#xa;    STOP:max_bit=1;&#xa;    default: max_bit=0;&#xa;endcase&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;cstate&lt;=IDLE;&#xa;    else cstate&lt;=nstate;&#xa;end&#xa;always @ (*  )&#xa;begin case(cstate )&#xa;&#x9;IDLE:if(IDLE_START)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=START;&#xa;         else nstate&lt;=cstate;&#xa;     START:if(START_DATA)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=DATA;&#xa;          else nstate&lt;=cstate;&#xa;     DATA:if(DATA_CHECK)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=CHECK;&#xa;           else begin if(DATA_STOP)&#xa;        &#x9;&#x9;&#x9;&#x9;nstate&lt;=STOP;&#xa;                 else nstate&lt;=cstate;&#xa;                end&#xa;      CHECK:if(CHECK_STOP)&#xa;    &#x9;&#x9;&#x9;&#x9;nstate&lt;=STOP;&#xa;            else nstate&lt;=cstate;&#xa;       STOP:if(STOP_IDLE)&#xa;    &#x9;&#x9;&#x9;&#x9;nstate&lt;=IDLE;&#xa;             else nstate&lt;=cstate;&#xa;    default:nstate&lt;=IDLE;//防止锁存&#xa;endcase&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin if(rst)&#xa;&#x9;&#x9;tx_data_r&lt;=0;&#xa;        else begin if(tx_data_vld)&#xa;        &#x9;&#x9;tx_data_r&lt;=tx_data;&#xa;                else tx_data_r&lt;=tx_data_r;&#xa;                end&#xa;end&#xa;&#xa;assign check_val=(CHECK_BIT==&quot;None&quot;)?~^tx_data_r:^tx_data_r;&#xa;always @ (  *)&#xa;begin case( cstate)&#xa;&#x9;IDLE:tx=1;&#xa;    START:tx=0;&#xa;    DATA:tx=tx_data_r[cnt_bit];&#xa;    CHECK:tx=check_val;&#xa;    STOP:tx=1;&#xa;    default:  tx=0;&#xa;endcase&#xa;end&#xa;assign ready=(cstate==IDLE);" Color="#d3d3d3" Comment="" Height="1080" Name="UART_TX" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="UART_TX" Side="left" Width="30" X="-0.01875" Y="0.184259"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="UART_TX" Side="left" Width="30" X="-0.01875" Y="0.384259"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="tx_data_vld" Parent="UART_TX" Side="left" Width="30" X="-0.01875" Y="0.584259"/>
 <Port Color="#f0ffff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="tx_data" Parent="UART_TX" Side="left" Width="30" X="-0.01875" Y="0.784259"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="ready" Parent="UART_TX" Side="right" Width="30" X="0.98125" Y="0.318519"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="tx" Parent="UART_TX" Side="right" Width="30" X="0.98125" Y="0.652778"/>
</Module>
