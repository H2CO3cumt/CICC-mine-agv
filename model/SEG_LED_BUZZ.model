<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="//因为模块限额，我只能把原先的SEL_SEG,LED,BUZZ模块融合，请谅解&#xa;//SEL_SEG部分&#xa;  //   // 数字段码&#xa;    parameter  SEG_0    = 8'hC0;  // 数字 0&#xa;    parameter  SEG_1    = 8'hF9;  // 数字 1&#xa;    parameter  SEG_2    = 8'hA4;  // 数字 2&#xa;    parameter  SEG_3    = 8'hB0;  // 数字 3&#xa;    parameter  SEG_4    = 8'h99;  // 数字 4&#xa;    parameter  SEG_5    = 8'h92;  // 数字 5&#xa;    parameter  SEG_6    = 8'h82;  // 数字 6&#xa;    parameter  SEG_7    = 8'hF8;  // 数字 7&#xa;    parameter  SEG_8    = 8'h80;  // 数字 8&#xa;    parameter  SEG_9    = 8'h90;  // 数字 9&#xa;    // 熄灭码 (全灭)&#xa;    parameter  SEG_OFF  = 8'hFF;  // 数码管全灭&#xa;    parameter IDLE=4'b0000;&#xa;    parameter GO=4'b0001;&#xa;    parameter BACK=4'b0010;&#xa;    parameter LEFT=4'b0100;&#xa;    parameter RIGHT=4'b1000;&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        &#x9;&#x9;sel&lt;=6'b111_110;&#xa;         else if(en_500)&#xa;         sel&lt;={sel[4:0],sel[5]};&#xa;    end&#xa;    always @ ( * )&#xa;&#x9; begin&#xa;        &#x9;case( car_state)&#xa;        IDLE:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        &#xa;        GO:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_1;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        BACK:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_1;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        LEFT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_0;&#xa;                    6'b111_011:seg=SEG_1;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end&#xa;        RIGHT:begin&#xa;        &#x9;&#x9;&#x9;&#x9;case(sel)&#xa;                    6'b111_110:seg=SEG_OFF;&#xa;                    6'b111_101:seg=SEG_1;&#xa;                    6'b111_011:seg=SEG_0;&#xa;                    6'b110_111:seg=SEG_0;&#xa;                    6'b101_111:seg=SEG_0;&#xa;                    6'b011_111:seg=SEG_OFF;&#xa;            &#x9;&#x9;&#x9;default:seg=SEG_OFF;&#xa;        &#x9;&#x9;&#x9;&#x9;endcase&#xa;        &#x9;&#x9;&#x9;end   &#xa;                default:seg=SEG_6;&#xa;            endcase&#xa;&#xa;        end &#xa;//BUZZ部分&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst)&#xa;buzz_out&lt;=0;&#xa;else begin&#x9;if(en_2k) begin&#xa;&#x9;&#x9;&#x9;&#x9;if(car_state==4'b0100||car_state==4'b1000||car_state==4'b0010||gas_alarm||stall_alarm) &#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;buzz_out&lt;=~buzz_out;&#xa;                   else buzz_out&lt;=0;&#xa;                        end&#xa;                end&#xa;&#xa;end&#xa; //LED部分&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;  begin &#xa;   if(rst) begin&#xa;    go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      else begin if(en_1)&#xa;      case( car_state)&#xa;      4'b0000:begin&#xa;   go&lt;=2'b11;&#xa;   back&lt;=2'b11;&#xa;   right&lt;=2'b11;&#xa;      left&lt;=2'b11;&#xa;      end&#xa;      4'b0001:begin &#xa;  go&lt;=~go;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0010:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=~back;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end&#xa;      4'b0100:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=~left;&#xa;      end&#xa;      4'b1000:begin &#xa;  go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=~right;&#xa;      left&lt;=2'b00;&#xa;  &#xa;      end&#xa;          default:  begin&#xa;          go&lt;=2'b00;&#xa;   back&lt;=2'b00;&#xa;   right&lt;=2'b00;&#xa;      left&lt;=2'b00;&#xa;      end &#xa;      endcase&#xa;      &#xa;      end    &#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="SEG_LED_BUZZ" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.208333"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_500" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.319444"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.430556"/>
 <Port Color="#f0ffff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.541667"/>
 <Port Color="#f5f5dc" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="sel" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.736111"/>
 <Port Color="#ffe4c4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="seg" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.861111"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_2k" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.763889"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.875"/>
 <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="go" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.486111"/>
 <Port Color="#deb887" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.611111"/>
 <Port Color="#5f9ea0" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.361111"/>
 <Port Color="#7fff00" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="back" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.236111"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="buzz_out" Parent="SEG_LED_BUZZ" Side="right" Width="30" X="0.98125" Y="0.111111"/>
 <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="stall_alarm" Parent="SEG_LED_BUZZ" Side="left" Width="30" X="-0.01875" Y="0.0972222"/>
</Module>
