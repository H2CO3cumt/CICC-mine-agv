 <Module Category="Current" Class="CLK_DIV_TOP" Code="parameter MAX_500=1_000_00-1;&#xa;parameter MAX_2k=25_000-1;&#xa;parameter MAX_1=50_000_000-1;&#xa;parameter MAX_1k=50_000-1;&#xa;parameter MAX_10k=5_000-1;&#xa;parameter MAX_1m=50-1;&#xa;parameter MAX_10=5_000_000-1;&#xa;parameter MAX_100=5_000_00-1;&#xa;reg[23:0]cnt_100;&#xa;reg [19:0]cnt_500;&#xa;reg [15:0]cnt_2k;&#xa;reg [27:0]cnt_1;&#xa;reg [15:0]cnt_1k;&#xa;reg [15:0]cnt_10k;&#xa;reg [7:0]cnt_1m;&#xa;reg [23:0] rst_cnt;&#xa;reg [23:0] cnt_10;&#xa;reg rst_r;&#xa;initial begin&#xa;rst_cnt=0;&#xa;rst_r=0;&#xa;end&#xa;&#xa;always @(posedge clk_50m) begin&#xa;    if (rst_cnt != 24'd5_000_000) //保持0.1s的高电平&#xa;    begin&#xa;        rst_cnt &lt;= rst_cnt + 1;&#xa;        rst_r &lt;= 1;          // 复位期间保持高&#xa;    end else begin&#xa;        rst_r &lt;= 0;          // 复位结束后拉低&#xa;    end&#xa;end&#xa;assign rst=(key_value==9'b111_111_110)?1:rst_r;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_500&lt;=0;&#xa;    en_500&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_500==MAX_500) begin&#xa;            cnt_500&lt;=0;&#xa;            en_500&lt;=1;&#xa;            end&#xa;         else begin cnt_500&lt;=cnt_500+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_500&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_100&lt;=0;&#xa;    en_100&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_100==MAX_100) begin&#xa;            cnt_100&lt;=0;&#xa;            en_100&lt;=1;&#xa;            end&#xa;         else begin cnt_100&lt;=cnt_100+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_100&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_2k&lt;=0;&#xa;    en_2k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_2k==MAX_2k) begin&#xa;            cnt_2k&lt;=0;&#xa;            en_2k&lt;=1;&#xa;            end&#xa;         else begin cnt_2k&lt;=cnt_2k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_2k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_1&lt;=0;&#xa;    en_1&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_1==MAX_1) begin&#xa;            cnt_1&lt;=0;&#xa;            en_1&lt;=1;&#xa;            end&#xa;         else begin cnt_1&lt;=cnt_1+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_1&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_1k&lt;=0;&#xa;    en_1k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_1k==MAX_1k) begin&#xa;            cnt_1k&lt;=0;&#xa;            en_1k&lt;=1;&#xa;            end&#xa;         else begin cnt_1k&lt;=cnt_1k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_1k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_10k&lt;=0;&#xa;    en_10k&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_10k==MAX_10k) begin&#xa;            cnt_10k&lt;=0;&#xa;            en_10k&lt;=1;&#xa;            end&#xa;         else begin cnt_10k&lt;=cnt_10k+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_10k&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_1m&lt;=0;&#xa;    en_1m&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_1m==MAX_1m) begin&#xa;            cnt_1m&lt;=0;&#xa;            en_1m&lt;=1;&#xa;            end&#xa;         else begin cnt_1m&lt;=cnt_1m+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_1m&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    cnt_10&lt;=0;&#xa;    en_10&lt;=0;&#xa;    end &#xa;    else begin&#xa;    &#x9;&#x9;if(cnt_10==MAX_10) begin&#xa;            cnt_10&lt;=0;&#xa;            en_10&lt;=1;&#xa;            end&#xa;         else begin cnt_10&lt;=cnt_10+1;&#xa;        &#x9;&#x9;&#x9;&#x9;en_10&lt;=0;&#xa;           &#x9;&#x9;end&#xa;    end&#xa;end" Color="antiquewhite" Comment="" Height="125" Name="CLK_DIV_TOP1" Parameters="" Parent="TOP" Type="model" Width="259" X="84" Y="100">
