<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="//接入10KHZ的时钟，能有效应对矿物运输过程中的干扰因素&#xa;//key_value的值对应如下：&#xa;//111_111_110->1&#xa;//111_111_101->2&#xa;//111_111_011->3&#xa;//111_110_111->4&#xa;//111_101_111->5&#xa;//111_011_111->6&#xa;//110_111_111->7&#xa;//101_111_111->8&#xa;//011_111_111->9&#xa;reg [8:0] key1;//三次的采样值&#xa;reg [8:0] key2;&#xa;reg [8:0] key3;&#xa;reg [8:0]key_old;&#xa;reg key_trig;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin if(rst) begin&#xa;&#x9;&#x9;key_value&lt;=9'b111_111_111;&#xa;&#x9;&#x9;key1&lt;=9'b111_111_111;&#xa;        key2&lt;=9'b111_111_111;&#xa;        key3&lt;=9'b111_111_111;&#xa;        key_old&lt;=9'b111_111_111;&#xa;        key_trig&lt;=0;&#xa;        end&#xa;        else begin if(en_10k) begin&#xa;        &#x9;&#x9;key3&lt;=key2;&#xa;            key2&lt;=key1;&#xa;            key1&lt;=key_in;&#xa;            end&#xa;            if((key1==key2) &amp;&amp; (key1==key3)) begin //连续三次采样都相等&#xa;            &#x9;&#x9;if(key_old==9'b111_111_111 &amp;&amp; key1!=9'b111_111_111)//旧key值为空也就是9'b111_111_111,并且最新值不为空时进入赋值&#xa;                    //目的是为了按一次键即时不松手，赋值也只触发一次&#xa;                    begin&#xa;                    key_trig&lt;=1;&#xa;                    key_old&lt;=key3;&#xa;                    end&#xa;                    else  begin  key_trig&lt;=0;&#xa;                    &#x9;&#x9;&#x9;&#x9;key_old&lt;=key3;&#xa;                    end&#xa;&#xa;                    if(key_trig)&#xa;            begin&#xa;            &#x9;&#x9;case(key3)//按行分类&#xa;                   9'b111_111_110:key_value&lt;=key3;//用三次采样后的数据，能尽量避免偶发干扰和短时间抖动（机械抖动和运输干扰）&#xa;                &#x9;  9'b111_111_101:key_value&lt;=key3;&#xa;                    9'b111_111_011:key_value&lt;=key3;&#xa;                    9'b111_110_111:key_value&lt;=key3;&#xa;                    9'b111_101_111:key_value&lt;=key3;&#xa;                    9'b111_011_111:key_value&lt;=key3;&#xa;                    9'b110_111_111:key_value&lt;=key3;&#xa;                    9'b101_111_111:key_value&lt;=key3;&#xa;                    9'b011_111_111:key_value&lt;=key3;&#xa;                    default:key_value&lt;=key_value;&#xa;                    endcase&#xa;            end&#xa;            else key_value&lt;=key_value;//采样失败，保持原值            &#xa;        end        &#xa;        else begin&#xa;        key_old&lt;=key_old;&#xa;        key_trig&lt;=key_trig;//消抖不稳定时保持原态     &#xa;        end       &#xa;        end&#xa;end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="KEY_DEBOUNCE" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="KEY_DEBOUNCE" Side="left" Width="30" X="-0.01875" Y="0.385185"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="KEY_DEBOUNCE" Side="left" Width="30" X="-0.01875" Y="0.585185"/>
 <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="reg" Description="" Height="30" Inout="output" Name="key_value" Parent="KEY_DEBOUNCE" Side="right" Width="30" X="0.98125" Y="0.485185"/>
 <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_in" Parent="KEY_DEBOUNCE" Side="left" Width="30" X="-0.01875" Y="0.785185"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_10k" Parent="KEY_DEBOUNCE" Side="left" Width="30" X="-0.01875" Y="0.185185"/>
</Module>
