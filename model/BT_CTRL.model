<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam CLOCK=50_000_000;//系统时钟频率&#xa;localparam BAUD=115200;//波特率；&#xa;localparam CHECK_BIT=&quot;None&quot;;//无校验位&#xa;parameter MAX_1BAUD=CLOCK/BAUD;//一个波特率所要经历的时钟周期&#xa;parameter IDLE=5'b00000;&#xa;parameter START=5'b00001;&#xa;parameter DATA=5'b00010;&#xa;parameter CHECK=5'b00100;&#xa;reg [15:0]cnt_baud;//计算baud有没有到达MAX_1BAUD&#xa;reg [3:0]cnt_bit;//计算bit有没有达到max_bit;&#xa;reg [3:0]max_bit;//bit的最大值，根据不同状态所决定&#xa;reg [4:0]cstate;//当前状态&#xa;reg [4:0]nstate;//下一时钟状态&#xa;reg rx_check;//校验位的实际值&#xa;reg [7:0]rx_temp;//类似于仓库，存储要发送的数据&#xa;reg rx_r1;&#xa;reg rx_r2; &#xa;wire rx_nege;//用于rx下降沿检测&#xa;wire add_baud;&#xa;wire end_baud;//波特率开始，结束计算&#xa;wire add_bit;&#xa;wire end_bit;//bit开始，结束运算&#xa;wire IDLE_START=(cstate==IDLE) &amp;&amp; rx_nege;&#xa;wire START_DATA=(cstate==START)&amp;&amp; end_bit;&#xa;wire DATA_CHECK=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT!=&quot;None&quot;);&#xa;wire DATA_IDLE=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT==&quot;None&quot;);&#xa;wire CHECK_IDLE=(cstate==CHECK)&amp;&amp; end_bit;&#xa;//wire check_val;//校验位的正确值;经计算得到&#xa;wire add_bit1;&#xa;wire add_bit2;//检测end_baud的上升沿&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;rx_r1&lt;=1;&#xa;        rx_r2&lt;=1;&#xa;            end&#xa;     else begin&#xa;    &#x9;    rx_r1&lt;=rx;&#xa;        rx_r2&lt;=rx_r1;&#xa;    end&#xa;end&#xa;assign rx_nege=~rx_r1 &amp;&amp; rx_r2;//检测rx刚刚经历了下降沿  &#xa;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_baud&lt;=0;&#xa;     else if(add_baud)begin&#xa;    &#x9;&#x9;&#x9;if(end_baud)&#xa;                cnt_baud&lt;=0; &#xa;            else cnt_baud&lt;=cnt_baud+1;                &#xa;    end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_baud&lt;=0;    &#xa;end&#xa;assign add_baud=cstate!=IDLE;&#xa;assign end_baud=add_baud &amp;&amp; (cnt_baud==MAX_1BAUD-1);&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:max_bit=0;&#xa;    START:max_bit=1;&#xa;    DATA:max_bit=8;&#xa;    CHECK:max_bit=1;&#xa;        default: max_bit=0   ;&#xa;    endcase&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_bit&lt;=0;&#xa;     else if(add_bit)begin&#xa;    &#x9;&#x9;&#x9;if(end_bit)&#xa;                cnt_bit&lt;=0; &#xa;            else cnt_bit&lt;=cnt_bit+1;                &#xa;    &#x9;&#x9;&#x9;end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_bit&lt;=cnt_bit;    &#xa;end&#xa;assign add_bit=end_baud;&#xa;assign end_bit=add_bit &amp;&amp; (cnt_bit==max_bit-1);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;cstate&lt;=IDLE;&#xa;    else cstate&lt;=nstate;&#xa;end&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:if(IDLE_START)&#xa;    &#x9;&#x9;&#x9;nstate=START;&#xa;         else nstate=cstate;&#xa;    START:if( cnt_baud==MAX_1BAUD>>1 &amp;&amp; rx_r2==1)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=IDLE;&#xa;   else begin if(START_DATA)&#xa;    &#x9;&#x9;&#x9;nstate=DATA;&#xa;          else nstate=cstate;&#xa;        end&#xa;    &#x9;DATA:if(DATA_CHECK)&#xa;        &#x9;&#x9;nstate=CHECK;&#xa;          else  begin if(DATA_IDLE)&#xa;        &#x9;&#x9;&#x9;nstate=IDLE;&#xa;                    else nstate=cstate;&#xa;                    end&#xa;    &#x9;CHECK:if(CHECK_IDLE)&#xa;        &#x9;&#x9;nstate=IDLE;&#xa;           else nstate=cstate;&#x9;&#x9;   &#xa;        default: nstate=IDLE;&#xa;    endcase&#xa;end &#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;rx_temp&lt;=0;&#xa;    else  begin if(cstate==DATA &amp;&amp; cnt_baud== MAX_1BAUD>>1)&#xa;    rx_temp[cnt_bit]&lt;=rx_r2;&#xa;    else rx_temp&lt;=rx_temp;&#xa;    end&#xa;end&#xa;assign rx_data=rx_temp;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)&#xa;    rx_check&lt;=0;&#xa;    else if(cstate==CHECK &amp;&amp; cnt_baud==MAX_1BAUD>>1)&#xa;    &#x9;&#x9;rx_check&lt;=rx_r2;&#xa;end&#xa;assign rx_data_vld=DATA_IDLE;&#xa;//原来的CMD_PARSER模块&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin if(rst)&#xa;&#x9;key_cmd&lt;=9'b111_111_111;&#xa;    else  begin if(rx_data_vld) begin&#xa;&#x9;&#x9;case( rx_data)&#xa;        8'h46 : key_cmd &lt;= 9'b111_111_101; // 'F' GO&#xa;        8'h42 : key_cmd &lt;= 9'b101_111_111; // 'B' BACK&#xa;        8'h4C : key_cmd &lt;= 9'b111_110_111; // 'L' LEFT&#xa;        8'h52 : key_cmd &lt;= 9'b111_011_111; // 'R' RIGHT&#xa;        8'h53 : key_cmd &lt;= 9'b111_101_111; // 'S'：停车&#xa;8'h54 : key_cmd &lt;= 9'b011_111_111; // 'T'：进入循迹模式&#xa;8'h4D : key_cmd &lt;= 9'b111_111_011; // 'M'：返回蓝牙手动模式&#xa;8'h43: key_cmd&lt;=9'b111_111_100;//C:清除WEIGHT_SENSOR漏货的故障锁存&#xa;8'h45:key_cmd&lt;=9'b111_111_000;//E:清除瓦斯风险&#xa;8'h47:key_cmd&lt;=9'b111_100_000;//G:重新设置HX711零点&#xa;            default: key_cmd&lt;=key_cmd;&#xa;        endcase&#xa;        end&#xa;        else key_cmd&lt;=key_cmd; &#xa;        end&#xa;end&#xa; /*&#xa;  localparam integer CLOCK     = 50_000_000;&#xa;  localparam integer BAUD      = 115200;&#xa;  localparam integer ONE_BAUD  = CLOCK / BAUD;&#xa;  localparam integer HALF_BAUD = ONE_BAUD / 2;&#xa;&#xa;  localparam UART_IDLE  = 2'd0;&#xa;  localparam UART_START = 2'd1;&#xa;  localparam UART_DATA  = 2'd2;&#xa;  localparam UART_STOP  = 2'd3;&#xa;&#xa;  reg        rx_r1;&#xa;  reg        rx_r2;&#xa;  reg [1:0]  uart_state;&#xa;  reg [15:0] baud_cnt;&#xa;  reg [2:0]  bit_cnt;&#xa;  reg [7:0]  rx_shift;&#xa;  reg [7:0]  rx_data_reg;&#xa;  reg        rx_data_vld_reg;&#xa;&#xa;  assign rx_data     = rx_data_reg;&#xa;  assign rx_data_vld = rx_data_vld_reg;&#xa;&#xa;  // 两级同步，降低异步蓝牙 RX 输入带来的亚稳态风险。&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      rx_r1 &lt;= 1'b1;&#xa;      rx_r2 &lt;= 1'b1;&#xa;    end&#xa;    else begin&#xa;      rx_r1 &lt;= rx;&#xa;      rx_r2 &lt;= rx_r1;&#xa;    end&#xa;  end&#xa;&#xa;  // 固定 115200、8N1 UART 接收器。数据位在各自中心采样，完整停止位正确后才给出 vld。&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      uart_state      &lt;= UART_IDLE;&#xa;      baud_cnt        &lt;= 16'd0;&#xa;      bit_cnt         &lt;= 3'd0;&#xa;      rx_shift        &lt;= 8'd0;&#xa;      rx_data_reg     &lt;= 8'd0;&#xa;      rx_data_vld_reg &lt;= 1'b0;&#xa;    end&#xa;    else begin&#xa;      rx_data_vld_reg &lt;= 1'b0;&#xa;      case (uart_state)&#xa;        UART_IDLE: begin&#xa;          baud_cnt &lt;= 16'd0;&#xa;          bit_cnt  &lt;= 3'd0;&#xa;          if (!rx_r2)&#xa;            uart_state &lt;= UART_START;&#xa;        end&#xa;&#xa;        UART_START: begin&#xa;          if (baud_cnt == HALF_BAUD-1) begin&#xa;            baud_cnt &lt;= 16'd0;&#xa;            if (!rx_r2)&#xa;              uart_state &lt;= UART_DATA;&#xa;            else&#xa;              uart_state &lt;= UART_IDLE;&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        UART_DATA: begin&#xa;          if (baud_cnt == ONE_BAUD-1) begin&#xa;            baud_cnt         &lt;= 16'd0;&#xa;            rx_shift[bit_cnt] &lt;= rx_r2;&#xa;            if (bit_cnt == 3'd7) begin&#xa;              bit_cnt    &lt;= 3'd0;&#xa;              uart_state &lt;= UART_STOP;&#xa;            end&#xa;            else&#xa;              bit_cnt &lt;= bit_cnt + 1'b1;&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        UART_STOP: begin&#xa;          if (baud_cnt == ONE_BAUD-1) begin&#xa;            baud_cnt   &lt;= 16'd0;&#xa;            uart_state &lt;= UART_IDLE;&#xa;            if (rx_r2) begin&#xa;              rx_data_reg     &lt;= rx_shift;&#xa;              rx_data_vld_reg &lt;= 1'b1;&#xa;            end&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        default: uart_state &lt;= UART_IDLE;&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  // --------------------------------------------------------------------------&#xa;  // 命令与实时调参协议&#xa;  //&#xa;  // 原有运动/维护命令仍为单字节 ASCII。&#xa;  // 调参帧固定 5 字节：A5, addr, data_l, data_h, checksum&#xa;  // checksum = A5 ^ addr ^ data_l ^ data_h&#xa;  // TRIM_GO/TRIM_BACK 的 data 为 16 位二补码，其余参数为无符号数。&#xa;  // --------------------------------------------------------------------------&#xa;  localparam CFG_HEAD      = 8'hA5;&#xa;  localparam CFG_WAIT_HEAD = 3'd0;&#xa;  localparam CFG_WAIT_ADDR = 3'd1;&#xa;  localparam CFG_WAIT_LOW  = 3'd2;&#xa;  localparam CFG_WAIT_HIGH = 3'd3;&#xa;  localparam CFG_WAIT_XOR  = 3'd4;&#xa;&#xa;  reg [2:0]  cfg_state;&#xa;  reg [7:0]  cfg_addr_buf;&#xa;  reg [7:0]  cfg_low_buf;&#xa;  reg [7:0]  cfg_high_buf;&#xa;  reg [15:0] cfg_data_reg;&#xa;&#xa;  assign cfg_data = cfg_data_reg;&#xa;&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      key_cmd       &lt;= 9'b111_111_111;&#xa;      cfg_vld       &lt;= 1'b0;&#xa;      cfg_addr      &lt;= 8'd0;&#xa;      cfg_data_reg  &lt;= 16'd0;&#xa;      cfg_state     &lt;= CFG_WAIT_HEAD;&#xa;      cfg_addr_buf  &lt;= 8'd0;&#xa;      cfg_low_buf   &lt;= 8'd0;&#xa;      cfg_high_buf  &lt;= 8'd0;&#xa;    end&#xa;    else begin&#xa;      // cfg_vld 只保持一个系统时钟周期。&#xa;      cfg_vld &lt;= 1'b0;&#xa;      if (rx_data_vld_reg) begin&#xa;        case (cfg_state)&#xa;          CFG_WAIT_HEAD: begin&#xa;            if (rx_data_reg == CFG_HEAD)&#xa;              cfg_state &lt;= CFG_WAIT_ADDR;&#xa;            else begin&#xa;              // 仅在调参帧之外解释单字节命令，参数载荷不会误触发运动。&#xa;              case (rx_data_reg)&#xa;                8'h46: key_cmd &lt;= 9'b111_111_101; // F: GO&#xa;                8'h42: key_cmd &lt;= 9'b101_111_111; // B: BACK&#xa;                8'h4C: key_cmd &lt;= 9'b111_110_111; // L: LEFT&#xa;                8'h52: key_cmd &lt;= 9'b111_011_111; // R: RIGHT&#xa;                8'h53: key_cmd &lt;= 9'b111_101_111; // S: STOP&#xa;                8'h54: key_cmd &lt;= 9'b011_111_111; // T: TRACKING&#xa;                8'h4D: key_cmd &lt;= 9'b111_111_011; // M: BLUETOOTH MANUAL&#xa;                8'h43: key_cmd &lt;= 9'b111_111_100; // C: CLEAR LOAD FAULT&#xa;                8'h45: key_cmd &lt;= 9'b111_111_000; // E: CLEAR GAS RISK&#xa;                8'h47: key_cmd &lt;= 9'b111_100_000; // G: HX711 TARE&#xa;                default: key_cmd &lt;= key_cmd;&#xa;              endcase&#xa;            end&#xa;          end&#xa;&#xa;          CFG_WAIT_ADDR: begin&#xa;            cfg_addr_buf &lt;= rx_data_reg;&#xa;            cfg_state    &lt;= CFG_WAIT_LOW;&#xa;          end&#xa;&#xa;          CFG_WAIT_LOW: begin&#xa;            cfg_low_buf &lt;= rx_data_reg;&#xa;            cfg_state   &lt;= CFG_WAIT_HIGH;&#xa;          end&#xa;&#xa;          CFG_WAIT_HIGH: begin&#xa;            cfg_high_buf &lt;= rx_data_reg;&#xa;            cfg_state    &lt;= CFG_WAIT_XOR;&#xa;          end&#xa;&#xa;          CFG_WAIT_XOR: begin&#xa;            cfg_state &lt;= CFG_WAIT_HEAD;&#xa;            if (rx_data_reg == (CFG_HEAD ^ cfg_addr_buf ^ cfg_low_buf ^ cfg_high_buf)) begin&#xa;              cfg_addr     &lt;= cfg_addr_buf;&#xa;              cfg_data_reg &lt;= {cfg_high_buf, cfg_low_buf};&#xa;              cfg_vld      &lt;= 1'b1;&#xa;            end&#xa;          end&#xa;&#xa;          default: cfg_state &lt;= CFG_WAIT_HEAD;&#xa;        endcase&#xa;      end&#xa;    end&#xa;  end*/" Color="#d3d3d3" Comment="" Height="1300" Name="BT_CTRL" Parameters="" Parent="0" Type="model" Width="1675" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="BT_CTRL" Side="left" Width="30" X="-0.0179104" Y="0.488462"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="BT_CTRL" Side="left" Width="30" X="-0.0179104" Y="0.238462"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rx" Parent="BT_CTRL" Side="left" Width="30" X="-0.0179104" Y="0.738462"/>
 <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="reg" Description="" Height="30" Inout="output" Name="key_cmd" Parent="BT_CTRL" Side="right" Width="30" X="0.98209" Y="0.486154"/>
 <Port Color="#f5f5dc" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data" Parent="BT_CTRL" Side="right" Width="30" X="0.98209" Y="0.32"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data_vld" Parent="BT_CTRL" Side="right" Width="30" X="0.98209" Y="0.153846"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="cfg_vld" Parent="BT_CTRL" Side="right" Width="30" X="0.98209" Y="0.653077"/>
 <Port Color="#ffebcd" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="cfg_addr" Parent="BT_CTRL" Side="right" Width="30" X="0.98209" Y="0.819231"/>
 <Port Color="#0000ff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="cfg_data" Parent="BT_CTRL" Side="bottom" Width="30" X="0.490149" Y="0.976923"/>
</Module>
