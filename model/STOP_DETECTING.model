<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="parameter STOP_NONE=8'd0;&#xa;parameter STOP_GAS=8'd1;&#xa;parameter STOP_OBSTACLE_GO=8'd2;&#xa;parameter STOP_OBSTACLE_BACK=8'd3;&#xa;parameter STOP_KEY=8'd4;&#xa;parameter STOP_SETTLETIME_FAULT=8'd5;&#xa;parameter STOP_OVERLOAD=8'D6;&#xa;parameter IDLE=4'B0000;&#xa;parameter GO=4'B0001;&#xa;parameter BACK=4'B0010;&#xa;parameter LEFT=4'B0100;&#xa;parameter RIGHT=4'B1000;&#xa;parameter DIGIT1=9'b111_111_110;&#xa;parameter DIGIT2=9'b111_111_101;&#xa;parameter DIGIT3=9'b111_111_011;&#xa;parameter DIGIT4=9'b111_110_111;&#xa;parameter DIGIT5=9'b111_101_111;&#xa;parameter DIGIT6=9'b111_011_111;&#xa;parameter DIGIT7=9'b110_111_111;&#xa;parameter DIGIT8=9'b101_111_111;&#xa;parameter DIGIT9=9'b011_111_111;&#xa;reg [7:0]last_curr_stop;&#xa;reg prev_stop;&#xa;wire [8:0] selected_key;&#xa;assign selected_key =&#xa;       bt_lock     ? key_cmd :&#xa;       sensor_lock ? DIGIT2 :&#xa;                     key_value;&#xa;wire car_moving;&#xa;assign car_moving =&#xa;       (car_state == GO)&#xa;    || (car_state == BACK)&#xa;    || (car_state == LEFT)&#xa;    || (car_state == RIGHT);&#xa;reg       stop_request_now;&#xa;reg [7:0] stop_reason_now;&#xa;&#xa;always @ (*)&#xa;begin&#xa;    stop_request_now = 0;&#xa;    stop_reason_now  = STOP_NONE;&#xa;    // 1. 瓦斯超标&#xa;    // 对应 CAR_STATE：&#xa;    // if(force_stop)&#xa;    if(gas_alarm)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_GAS;&#xa;    end&#xa;    // 2. 前方障碍&#xa;    // 必须与 CAR_STATE 一样检查当前命令方向。&#xa;    // 前进、左转、右转使用前方超声波。=&#xa;    else if(&#xa;        distance_vld_go &amp;&amp;&#xa;        (&#xa;            selected_key == DIGIT2 ||&#xa;            selected_key == DIGIT4 ||&#xa;            selected_key == DIGIT6&#xa;        )&#xa;    )&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OBSTACLE_GO;&#xa;    end&#xa;    // 3. 后方障碍&#xa;    // 只有当前要求后退时，&#xa;    // 后方障碍才是真正导致 CAR_STATE 停车的原因。&#xa;    else if(&#xa;        distance_vld_back &amp;&amp;&#xa;        selected_key == DIGIT8&#xa;    )&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OBSTACLE_BACK;&#xa;    end&#xa;    // 4. 称重稳定/行驶载荷异常故障&#xa;    else if(settletime_fault)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_SETTLETIME_FAULT;&#xa;    end&#xa;    // 5. 超载&#xa;    else if(overload_state)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_OVERLOAD;&#xa;    end&#xa;    // 6. 人工停止&#xa; // 直接判断 selected_key，&#xa; // 保证与 CAR_STATE 当前真正采用的控制源一致。&#xa;    else if(selected_key == DIGIT5)&#xa;    begin&#xa;        stop_request_now = 1'b1;&#xa;        stop_reason_now  = STOP_KEY;&#xa;    end&#xa;end&#xa;reg [7:0] pending_stop_reason;&#xa;reg       pending_stop_valid;&#xa;&#xa;reg prev_gas_alarm;&#xa;reg prev_settletime_fault;&#xa;reg prev_overload_state;&#xa;// 停车/安全事件记录&#xa;always @ (posedge clk_50m or posedge rst)&#xa;begin&#xa;    if(rst)&#xa;    begin&#xa;        curr_stop              &lt;= STOP_NONE;&#xa;        new_stop_event         &lt;= 1'b0;&#xa;&#xa;        pending_stop_reason    &lt;= STOP_NONE;&#xa;        pending_stop_valid     &lt;= 1'b0;&#xa;&#xa;        prev_stop              &lt;= 1'b1;&#xa;&#xa;        prev_gas_alarm         &lt;= 1'b0;&#xa;        prev_settletime_fault  &lt;= 1'b0;&#xa;        prev_overload_state    &lt;= 1'b0;&#xa;    end&#xa;    else&#xa;    begin&#xa;&#xa;        // new_stop_event 默认只保持一个 clk_50m 周期&#xa;        new_stop_event &lt;= 1'b0;&#xa;&#xa;        // 保存上一周期状态&#xa;        prev_stop             &lt;= (car_state == IDLE);&#xa;        prev_gas_alarm        &lt;= gas_alarm;&#xa;        prev_settletime_fault &lt;= settletime_fault;&#xa;        prev_overload_state   &lt;= overload_state;&#xa;        if((car_state == IDLE) &amp;&amp;//本来就停止&#xa;           gas_alarm &amp;&amp;&#xa;           (~prev_gas_alarm))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_GAS;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;&#xa;        // 载荷异常上升沿&#xa;        else if((car_state == IDLE) &amp;&amp;&#xa;                settletime_fault &amp;&amp;&#xa;                (~prev_settletime_fault))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_SETTLETIME_FAULT;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;&#xa;        // 超载上升沿&#xa;        else if((car_state == IDLE) &amp;&amp;&#xa;                overload_state &amp;&amp;&#xa;                (~prev_overload_state))&#xa;        begin&#xa;            curr_stop      &lt;= STOP_OVERLOAD;&#xa;            new_stop_event &lt;= 1'b1;&#xa;        end&#xa;       else&#xa;        begin&#xa;            if(car_moving &amp;&amp; stop_request_now)//由运动到停止&#xa;            begin&#xa;                pending_stop_reason &lt;= stop_reason_now;&#xa;                pending_stop_valid  &lt;= 1'b1;&#xa;            end&#xa;            if((car_state == IDLE) &amp;&amp;&#xa;               (prev_stop == 1'b0))&#xa;            begin &#xa;                if(pending_stop_valid)&#xa;                begin&#xa;                    curr_stop      &lt;= pending_stop_reason;&#xa;                    new_stop_event &lt;= 1;&#xa;                    pending_stop_valid &lt;=0;&#xa;                end&#xa;            end&#xa;        end&#xa;    end&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="STOP_DETECTING" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.258333"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.349074"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.439815"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gas_alarm" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.621296"/>
 <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_value" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.712037"/>
 <Port Color="#b8860b" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_sensor" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.802778"/>
 <Port Color="#ffebcd" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.893519"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="new_stop_event" Parent="STOP_DETECTING" Side="right" Width="30" X="0.98125" Y="0.319444"/>
 <Port Color="#8a2be2" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="curr_stop" Parent="STOP_DETECTING" Side="right" Width="30" X="0.98125" Y="0.652778"/>
 <Port Color="#a52a2a" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.167593"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_lock" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.0768519"/>
 <Port Color="#deb887" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_lock" Parent="STOP_DETECTING" Side="top" Width="30" X="0.240625" Y="-0.0277778"/>
 <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_back" Parent="STOP_DETECTING" Side="left" Width="30" X="-0.01875" Y="0.530556"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settletime_fault" Parent="STOP_DETECTING" Side="top" Width="30" X="0.490625" Y="-0.0277778"/>
 <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="STOP_DETECTING" Side="top" Width="30" X="0.740625" Y="-0.0277778"/>
</Module>
