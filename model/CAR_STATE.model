<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#xa;//car_state;&#xa;parameter IDLE=4'b0000;&#xa;parameter GO=4'b0001;&#xa;parameter BACK=4'b0010;&#xa;parameter LEFT=4'b0100;&#xa;parameter RIGHT=4'b1000;&#xa;//key_value&#xa;parameter DIGIT1=9'b111_111_110;&#xa;parameter DIGIT2=9'b111_111_101;&#xa;parameter DIGIT3=9'b111_111_011;&#xa;parameter DIGIT4=9'b111_110_111;&#xa;parameter DIGIT5=9'b111_101_111;&#xa;parameter DIGIT6=9'b111_011_111;&#xa;parameter DIGIT7=9'b110_111_111;&#xa;parameter DIGIT8=9'b101_111_111;&#xa;parameter DIGIT9=9'b011_111_111;&#xa;parameter GO_BACK_MAX=25_000_000-1;&#xa;parameter GO_IDLE_MAX=25_000_000-1;&#xa;reg [27:0] cnt_go_back;//从任何挡位到BACK得是XX-IDLE-BACK的路径，防止炸管&#xa;reg goback_flag;&#xa;reg [27:0] cnt_go_idle;&#xa;reg goidle_flag;//同上，只不过是从BACK到GO/LEFT/RIGHT需要触发这个逻辑,也就是说从IDLE到正转的任何状态都得经过0.5s&#xa;reg [8:0]final_key;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;cnt_go_back&lt;=0;&#xa;        goback_flag&lt;=1;//车刚插上钥匙，肯定可以直接挂倒挡&#xa;            end&#xa;            else if(cstate==IDLE)begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_back&lt;GO_BACK_MAX)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_back&lt;=cnt_go_back+1;&#xa;                            goback_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_back&lt;=cnt_go_back;&#xa;            &#x9;&#x9;&#x9;&#x9;goback_flag&lt;=1;                        &#xa;                        end                         &#xa;                    end&#xa;            else begin&#xa;            if(cstate==BACK)  begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=1;&#xa;            end&#xa;            else begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=0;            &#xa;            end&#xa;            end&#xa;            &#x9;&#x9;&#x9;&#xa;end&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst) begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;&#xa;    end &#xa;    else if(cstate==IDLE) begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_idle&lt;GO_IDLE_MAX-1)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle+1;&#xa;                            goidle_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle;&#xa;            &#x9;&#x9;&#x9;&#x9;goidle_flag&lt;=1;     &#xa;    end&#xa;    end&#xa;    else if(cstate==BACK)begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=0;    &#x9;&#xa;    end&#xa;    else begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;    &#xa;    end&#xa;end&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    bt_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b111_111_011)&#xa;                bt_lock&lt;=1;&#xa;                else if()&#xa;                end&#xa;end*/&#xa;&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    sensor_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b011_111_111||key_cmd==9'b011_111_111)&#xa;                sensor_lock&lt;=1;&#xa;                else if(key_cmd==9'b111_111_011)&#xa;                &#x9;&#x9;&#x9;sensor_lock&lt;=0;//只能远程取消&#xa;                end&#xa;end*/&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    sensor_lock&lt;=0;&#xa;    bt_lock&lt;=0;&#xa;    end&#xa; else    if(en_1k)begin&#xa;    &#x9;&#x9;if(key_value==9'b111_111_011)begin&#xa;            bt_lock&lt;=1;&#xa;            &#x9;&#x9;if(key_cmd==9'b011_111_111)begin&#xa;                   sensor_lock&lt;=1; &#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                end&#xa;                else if(key_cmd==9'b111_111_011)begin&#xa;                &#x9;&#x9;bt_lock&lt;=1;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;                else if(key_cmd==9'b111_111_110) begin&#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;            end&#xa;       else if(key_value==9'b011_111_111)&#xa;    &#x9;&#x9;&#x9;&#x9;sensor_lock&lt;=1;&#xa;    end&#xa;end&#xa;wire [8:0]selected_key=bt_lock?(key_cmd):(sensor_lock?9'b111_111_101:key_value);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    final_key&lt;=DIGIT5;//默认停止；&#xa;    else begin&#xa;    &#x9;&#x9;if(en_1k)&#xa;             begin &#xa;            if(force_stop)&#xa;            final_key&lt;=DIGIT5;&#xa;            else if(&#xa;            distance_vld_go&amp;&amp;(selected_key==DIGIT2||selected_key==DIGIT4||selected_key==DIGIT6)&#xa;)&#xa;final_key&lt;=DIGIT5;                  &#xa;            &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if(distance_vld_back&amp;&amp;selected_key==DIGIT8)&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                                     else if(settletime_fault) &#xa;                                    &#x9;&#x9;final_key&lt;=DIGIT5;  &#xa;                                       else if(overload_state)&#xa;                                    &#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;else  begin &#xa;                                        final_key&lt;=selected_key;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xa;                    end&#xa;            end&#xa;    end&#xa;reg [3:0]cstate;//当前时钟状态；&#xa;reg [3:0]nstate;//下一时钟状态；&#xa;//wire [8:0]final_key=9'b0;//(key_cmd!=0)?key_cmd:key_value;//蓝牙命令优先于物理逻辑&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin &#xa;&#x9;if(rst)&#xa;    cstate&lt;=IDLE;&#xa;    else begin if(en_1k)&#xa;    cstate&lt;=nstate;&#xa;    else cstate&lt;=cstate;&#xa;    end&#xa;end&#xa;always @ (*)&#xa;begin &#xa;case( final_key) &#xa;    DIGIT2: if(goidle_flag)nstate=GO;//前进&#xa;else nstate=IDLE;&#xa;DIGIT4:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==RIGHT||cstate==LEFT)nstate=LEFT;//左拐&#xa;else nstate=IDLE;&#xa;DIGIT5:nstate=IDLE;//停止&#xa;DIGIT6:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==LEFT||cstate==RIGHT)nstate=RIGHT;//右拐&#xa;else nstate=IDLE;&#xa;DIGIT8: if(goback_flag) nstate=BACK;&#xa;else nstate=IDLE;//后退&#xa;    default:nstate=cstate;&#xa;endcase&#xa;end&#xa;assign car_state1=cstate;&#xa;assign en=(cstate==GO||cstate==BACK||cstate==LEFT||cstate==RIGHT)?1:0;&#xa;&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="CAR_STATE" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1k" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.621296"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.712037"/>
 <Port Color="#7fffd4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_value" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.802778"/>
 <Port Color="#f0ffff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="output" Name="car_state1" Parent="CAR_STATE" Side="right" Width="30" X="0.98125" Y="0.586111"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="en" Parent="CAR_STATE" Side="right" Width="30" X="0.98125" Y="0.786111"/>
 <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.893519"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.530556"/>
 <Port Color="#ffebcd" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_sensor" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.439815"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="force_stop" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.349074"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="bt_lock" Parent="CAR_STATE" Side="right" Width="30" X="0.98125" Y="0.386111"/>
 <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sensor_lock" Parent="CAR_STATE" Side="right" Width="30" X="0.98125" Y="0.186111"/>
 <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.167593"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_back" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.258333"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="CAR_STATE" Side="left" Width="30" X="-0.01875" Y="0.0768519"/>
 <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settletime_fault" Parent="CAR_STATE" Side="top" Width="30" X="0.32375" Y="-0.0277778"/>
 <Port Color="#ff7f50" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="load_ready" Parent="CAR_STATE" Side="top" Width="30" X="0.656875" Y="-0.0277778"/>
</Module>
