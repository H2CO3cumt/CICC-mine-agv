<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="" Color="#d3d3d3" Comment="" Height="1217" Name="CORE_CONTROL_TOP" Parameters="" Parent="0" Type="model" Width="1757" X="0" Y="0">
 <Module Category="Current" Class="CAR_STATE" Code="&#xa;//car_state;&#xa;parameter IDLE=4'b0000;&#xa;parameter GO=4'b0001;&#xa;parameter BACK=4'b0010;&#xa;parameter LEFT=4'b0100;&#xa;parameter RIGHT=4'b1000;&#xa;//key_value&#xa;parameter DIGIT1=9'b111_111_110;&#xa;parameter DIGIT2=9'b111_111_101;&#xa;parameter DIGIT3=9'b111_111_011;&#xa;parameter DIGIT4=9'b111_110_111;&#xa;parameter DIGIT5=9'b111_101_111;&#xa;parameter DIGIT6=9'b111_011_111;&#xa;parameter DIGIT7=9'b110_111_111;&#xa;parameter DIGIT8=9'b101_111_111;&#xa;parameter DIGIT9=9'b011_111_111;&#xa;parameter GO_BACK_MAX=25_000_000-1;&#xa;parameter GO_IDLE_MAX=25_000_000-1;&#xa;reg [27:0] cnt_go_back;//从任何挡位到BACK得是XX-IDLE-BACK的路径，防止炸管&#xa;reg goback_flag;&#xa;reg [27:0] cnt_go_idle;&#xa;reg goidle_flag;//同上，只不过是从BACK到GO/LEFT/RIGHT需要触发这个逻辑,也就是说从IDLE到正转的任何状态都得经过0.5s&#xa;reg [8:0]final_key;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;cnt_go_back&lt;=0;&#xa;        goback_flag&lt;=1;//车刚插上钥匙，肯定可以直接挂倒挡&#xa;            end&#xa;            else if(cstate==IDLE)begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_back&lt;GO_BACK_MAX)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_back&lt;=cnt_go_back+1;&#xa;                            goback_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_back&lt;=cnt_go_back;&#xa;            &#x9;&#x9;&#x9;&#x9;goback_flag&lt;=1;                        &#xa;                        end                         &#xa;                    end&#xa;            else begin&#xa;            if(cstate==BACK)  begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=1;&#xa;            end&#xa;            else begin&#xa;            cnt_go_back&lt;=0;&#xa;            goback_flag&lt;=0;            &#xa;            end&#xa;            end&#xa;            &#x9;&#x9;&#x9;&#xa;end&#xa;always@(posedge clk_50m or posedge rst)begin&#xa;if(rst) begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;&#xa;    end &#xa;    else if(cstate==IDLE) begin&#xa;            &#x9;&#x9;&#x9;&#x9;if(cnt_go_idle&lt;GO_IDLE_MAX-1)//得先等0.5s&#xa;                            begin&#xa;                    &#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle+1;&#xa;                            goidle_flag&lt;=0;&#xa;                            end&#xa;                        else   begin&#xa;            &#x9;&#x9;&#x9;&#x9;cnt_go_idle&lt;=cnt_go_idle;&#xa;            &#x9;&#x9;&#x9;&#x9;goidle_flag&lt;=1;     &#xa;    end&#xa;    end&#xa;    else if(cstate==BACK)begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=0;    &#x9;&#xa;    end&#xa;    else begin&#xa;&#x9;cnt_go_idle&lt;=0;&#xa;    goidle_flag&lt;=1;    &#xa;    end&#xa;end&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    bt_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b111_111_011)&#xa;                bt_lock&lt;=1;&#xa;                else if()&#xa;                end&#xa;end*/&#xa;&#xa;/*always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    sensor_lock&lt;=0;&#xa;    else if(en_1k) begin&#xa;    &#x9;&#x9;&#x9;if(key_value==9'b011_111_111||key_cmd==9'b011_111_111)&#xa;                sensor_lock&lt;=1;&#xa;                else if(key_cmd==9'b111_111_011)&#xa;                &#x9;&#x9;&#x9;sensor_lock&lt;=0;//只能远程取消&#xa;                end&#xa;end*/&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    sensor_lock&lt;=0;&#xa;    bt_lock&lt;=0;&#xa;    end&#xa; else    if(en_1k)begin&#xa;    &#x9;&#x9;if(key_value==9'b111_111_011)begin&#xa;            bt_lock&lt;=1;&#xa;            &#x9;&#x9;if(key_cmd==9'b011_111_111)begin&#xa;                   sensor_lock&lt;=1; &#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                end&#xa;                else if(key_cmd==9'b111_111_011)begin&#xa;                &#x9;&#x9;bt_lock&lt;=1;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;                else if(key_cmd==9'b111_111_110) begin&#xa;                &#x9;&#x9;bt_lock&lt;=0;&#xa;                        sensor_lock&lt;=0;&#xa;                        end&#xa;            end&#xa;       else if(key_value==9'b011_111_111)&#xa;    &#x9;&#x9;&#x9;&#x9;sensor_lock&lt;=1;&#xa;    end&#xa;end&#xa;wire [8:0]selected_key=bt_lock?(key_cmd):(sensor_lock?9'b111_111_101:key_value);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    final_key&lt;=DIGIT5;//默认停止；&#xa;    else begin&#xa;    &#x9;&#x9;if(en_1k)&#xa;             begin &#xa;            if(force_stop)&#xa;            final_key&lt;=DIGIT5;&#xa;            else if(&#xa;            distance_vld_go&amp;&amp;(selected_key==DIGIT2||selected_key==DIGIT4||selected_key==DIGIT6)&#xa;)&#xa;final_key&lt;=DIGIT5;                  &#xa;            &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if(distance_vld_back&amp;&amp;selected_key==DIGIT8)&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                                     else if(settletime_fault) &#xa;                                    &#x9;&#x9;final_key&lt;=DIGIT5;  &#xa;                                       else if(overload_state)&#xa;                                    &#x9;&#x9;&#x9;final_key&lt;=DIGIT5;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;else  begin &#xa;                                        final_key&lt;=selected_key;&#xa;                    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xa;                    end&#xa;            end&#xa;    end&#xa;reg [3:0]cstate;//当前时钟状态；&#xa;reg [3:0]nstate;//下一时钟状态；&#xa;//wire [8:0]final_key=9'b0;//(key_cmd!=0)?key_cmd:key_value;//蓝牙命令优先于物理逻辑&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin &#xa;&#x9;if(rst)&#xa;    cstate&lt;=IDLE;&#xa;    else begin if(en_1k)&#xa;    cstate&lt;=nstate;&#xa;    else cstate&lt;=cstate;&#xa;    end&#xa;end&#xa;always @ (*)&#xa;begin &#xa;case( final_key) &#xa;    DIGIT2: if(goidle_flag)nstate=GO;//前进&#xa;else nstate=IDLE;&#xa;DIGIT4:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==RIGHT||cstate==LEFT)nstate=LEFT;//左拐&#xa;else nstate=IDLE;&#xa;DIGIT5:nstate=IDLE;//停止&#xa;DIGIT6:if((cstate==IDLE&amp;&amp;goidle_flag)||cstate==GO||cstate==LEFT||cstate==RIGHT)nstate=RIGHT;//右拐&#xa;else nstate=IDLE;&#xa;DIGIT8: if(goback_flag) nstate=BACK;&#xa;else nstate=IDLE;//后退&#xa;    default:nstate=cstate;&#xa;endcase&#xa;end&#xa;assign car_state1=cstate;&#xa;assign en=(cstate==GO||cstate==BACK||cstate==LEFT||cstate==RIGHT)?1:0;&#xa;&#xa;" Color="antiquewhite" Comment="" Height="107" Name="CAR_STATE1" Parameters="" Parent="CORE_CONTROL_TOP" Type="model" Width="605" X="1088" Y="349.5">
  <Port Color="#7fffd4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_value" Parent="CAR_STATE1" Side="left" Width="30" X="-0.0495868" Y="0.514019"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="en" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.0644628" Y="0.719626"/>
  <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="CAR_STATE1" Side="top" Width="30" X="0.305785" Y="-0.280374"/>
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1k" Parent="CAR_STATE1" Side="right" Width="30" X="0.950413" Y="0.186916"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.157025" Y="0.719626"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.247934" Y="0.719626"/>
  <Port Color="#ffebcd" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_sensor" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.338843" Y="0.719626"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="force_stop" Parent="CAR_STATE1" Side="right" Width="30" X="0.950413" Y="0.514019"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="bt_lock" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.428099" Y="0.719626"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="sensor_lock" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.519008" Y="0.719626"/>
  <Port Color="#f0ffff" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="output" Name="car_state1" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.609917" Y="0.719626"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.700826" Y="0.719626"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_back" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.791736" Y="0.719626"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="overload_state" Parent="CAR_STATE1" Side="bottom" Width="30" X="0.884298" Y="0.719626"/>
  <Port Color="#d2691e" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="settletime_fault" Parent="CAR_STATE1" Side="top" Width="30" X="0.638017" Y="-0.280374"/>
  <Port Color="#ff7f50" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="load_ready" Parent="CAR_STATE1" Side="left" Width="30" X="-0.0495868" Y="0.186916"/>
 </Module>
 <Module Category="Current" Class="PWM" Code=" /*  //组合逻辑always@(*)不允许用复位&#xa;    parameter MAG_SPEED=10;&#xa;    parameter ERROR_SPEED=20;&#xa;    parameter IDLE=4'b0000;&#xa;    parameter GO=4'b0001;&#xa;    parameter BACK=4'b0010;&#xa;    parameter LEFT=4'b0100;&#xa;    parameter RIGHT=4'b1000;&#xa;    parameter PWM_FREQ=1000;//PWM的频率&#xa;    parameter CLK_FREQ=50_000_000;//输入的系统时钟频率&#xa;    parameter PERIOD=CLK_FREQ/PWM_FREQ;//PWM一个周期所经过的系统时钟周期，50_000;&#xa;    localparam DUTY_IDLE= 8'd0;&#xa;    //这都是50MS内编码器双边沿测量的结果，不是PWM值，别搞混了&#xa;    //localparam DUTY_LOAD_GOBACK= 8'd82;//重载的前进/后退速度&#xa;    //localparam DUTY_GOBACK= 8'd120;// 空载的前进/后退速度&#xa;    //localparam DUTY_TURN_IN= 8'd40; //空载转弯内测速度&#xa;    //localparam DUTY_TURN_OUT= 8'd100;//空载转弯外侧速度&#xa;    //localparam DUTY_LOAD_TURN_IN  = 8'd30;//重载转弯内侧速度&#xa;    //localparam DUTY_LOAD_TURN_OUT = 8'd75;//重载转弯外侧速度&#xa;    localparam DUTY_LOAD_GOBACK= 10'd280;//重载的前进/后退速度&#xa;    localparam DUTY_GOBACK= 10'd320;// 空载的前进/后退速度&#xa;    localparam DUTY_TURN_IN= 10'd140; //空载转弯内测速度&#xa;    localparam DUTY_TURN_OUT= 10'd300;//空载转弯外侧速度&#xa;    localparam DUTY_LOAD_TURN_IN  = 10'd110;//重载转弯内侧速度&#xa;    localparam DUTY_LOAD_TURN_OUT = 10'd250;//重载转弯外侧速度&#xa;  &#xa;  parameter TRIM_GO=15;&#xa;  parameter TRIM_BACK=0;&#xa;  parameter GOBACK_CORR_GAIN=1;&#xa;&#xa;  localparam [1:0] TRACK_NORMAL   = 2'b00;&#xa;  localparam [1:0] TRACK_DEGRADED = 2'b01;&#xa;  localparam [1:0] TRACK_RECOVERY = 2'b10;&#xa;  localparam [1:0] TRACK_STOP     = 2'b11;&#xa;&#xa;  localparam TRACK_BASE_LIGHT_NORMAL   = 290;&#xa;  localparam TRACK_BASE_HEAVY_NORMAL   = 280;&#xa;  localparam TRACK_BASE_LIGHT_DEGRADED = 230;&#xa;  localparam TRACK_BASE_HEAVY_DEGRADED = 220;&#xa;  localparam TRACK_BASE_LIGHT_RECOVERY = 160;&#xa;  localparam TRACK_BASE_HEAVY_RECOVERY = 150;&#xa;  localparam TRACK_SLOW_NORMAL         = 7;&#xa;  localparam TRACK_SLOW_DEGRADED       = 4;&#xa;  localparam TRACK_CORR_MAX            = 220;&#xa;  reg lost_used;&#xa;  reg [27:0]lost_cnt;&#xa;  localparam lost_max=50_000_000;&#xa;  always @ (  posedge clk_50m or posedge rst)&#xa;  begin &#xa;  &#x9;if(rst)begin&#xa;      lost_used&lt;=0;&#xa;      lost_cnt&lt;=0;&#xa;      end&#xa;      else begin&#xa;      &#x9;&#x9;if(~sensor_lost||~en||~sensor_lock)begin&#xa;              lost_used&lt;=0;&#xa;              lost_cnt&lt;=0;&#xa;              end&#xa;              else begin&#x9;if(~lost_used)begin&#xa;              if(lost_cnt>=lost_max-1)begin&#xa;              &#x9;&#x9;&#x9;lost_used&lt;=1;&#xa;                          lost_cnt&lt;=0;&#xa;                          end &#xa;                          else begin&#xa;                          lost_used&lt;=0;&#xa;                          lost_cnt&lt;=lost_cnt+1;&#xa;                          end&#xa;                          end&#xa;              &#x9;else begin&#xa;                  lost_used&lt;=1;&#xa;                  lost_cnt&lt;=lost_cnt;&#xa;                  end&#xa;                  end&#x9;&#x9;&#xa;                  end&#xa;  end&#xa;  reg [3:0]error_used;&#xa;  always @(*)&#xa;  begin&#xa;      if(error_mag > 4'd14)&#xa;          error_used = 4'd14;&#xa;      else&#xa;          error_used = error_mag;&#xa;  end&#xa;   // reg [15:0]target_speed_l;//目标的编码器上升/下降沿数量，不是最终的占空比&#xa;   // reg [15:0]target_speed_r;&#xa;    reg dir_left;//0是正转动，1是反转&#xa;    reg dir_right;&#xa;    reg toggle_flag;//现在没用了，本来我设计的是用它反复在01跳变来取0.5的效果，以实现不用corr_value和MPU6050来走直线，发现实现不了&#xa;    integer base_speed;//integer 默认是32位的有符号位，系统自动截取了前八位&#xa;    integer temp_speed_l;&#xa;    integer track_corr;&#xa;    integer encoder_corr_term;&#xa;    integer mpu_corr_term;&#xa;&#xa;    function [15:0] clamp_target;&#xa;      input integer value;&#xa;      begin&#xa;        if(value &lt; 0)&#xa;          clamp_target = 16'd0;&#xa;        else if(value > 4000)&#xa;          clamp_target = 16'd4000;&#xa;        else&#xa;          clamp_target = value[15:0];&#xa;      end&#xa;    endfunction&#xa;&#xa;    always @(*) begin&#xa;      encoder_corr_term = corr_value * GOBACK_CORR_GAIN;&#xa;      mpu_corr_term = error_mpu * ERROR_SPEED;&#xa;    end&#xa;    integer temp_speed_r;//用于临时存储左右轮转速，防止直接用target存储的时候溢出&#xa;    //目标编码生成区&#xa;    always@(*)begin//sensor_lock也就是循迹模式优先级最高，通过TRACKING_SENSOR传来的error_mag表示偏移量，turn_dir表示应该往哪转&#xa;    //类似于编码器测速，只不过是编码器换成了8路传感器&#xa;    &#x9;target_speed_l=0;&#xa;        target_speed_r=0;&#xa;        dir_left=0;&#xa;        dir_right=0;&#xa;        base_speed=0;&#xa;        temp_speed_l=0;&#xa;        temp_speed_r=0;&#xa;        track_corr=0;&#xa;       if(sensor_lock)begin&#xa;        dir_left=0;&#xa;        dir_right=0;&#xa;        if(force_stop || distance_vld_go || sensor_lost ||&#xa;           (track_control_mode == TRACK_STOP)) begin&#xa;          base_speed=0;&#xa;          temp_speed_l=0;&#xa;          temp_speed_r=0;&#xa;          target_speed_l=0;&#xa;          target_speed_r=0;&#xa;        end&#xa;        else begin&#xa;          case(track_control_mode)&#xa;            TRACK_NORMAL: begin&#xa;              base_speed=(heavy_load_state==1)&#xa;                         ? TRACK_BASE_HEAVY_NORMAL&#xa;                         : TRACK_BASE_LIGHT_NORMAL;&#xa;              base_speed=base_speed-error_used*TRACK_SLOW_NORMAL;&#xa;            end&#xa;            TRACK_DEGRADED: begin&#xa;              base_speed=(heavy_load_state==1)&#xa;                         ? TRACK_BASE_HEAVY_DEGRADED&#xa;                         : TRACK_BASE_LIGHT_DEGRADED;&#xa;              base_speed=base_speed-error_used*TRACK_SLOW_DEGRADED;&#xa;            end&#xa;            TRACK_RECOVERY: begin&#xa;              base_speed=(heavy_load_state==1)&#xa;                         ? TRACK_BASE_HEAVY_RECOVERY&#xa;                         : TRACK_BASE_LIGHT_RECOVERY;&#xa;            end&#xa;            default: base_speed=0;&#xa;          endcase&#xa;&#xa;          track_corr=error_used*MAG_SPEED;&#xa;          if(track_corr>TRACK_CORR_MAX)&#xa;            track_corr=TRACK_CORR_MAX;&#xa;&#xa;          if(error_used==0)begin&#xa;            temp_speed_l=base_speed-TRIM_GO;&#xa;            temp_speed_r=base_speed;&#xa;          end&#xa;          else if(turn_dir==1)begin&#xa;            temp_speed_l=base_speed-track_corr-TRIM_GO;&#xa;            temp_speed_r=base_speed+track_corr;&#xa;          end&#xa;          else begin&#xa;            temp_speed_l=base_speed+track_corr-TRIM_GO;&#xa;            temp_speed_r=base_speed-track_corr;&#xa;          end&#xa;&#xa;          target_speed_l=clamp_target(temp_speed_l);&#xa;          target_speed_r=clamp_target(temp_speed_r);&#xa;        end&#xa;        end&#xa;&#xa;        &#xa;        else begin&#xa;        case(car_state)&#xa;        IDLE:begin&#xa;    &#x9;target_speed_l=0;&#xa;        target_speed_r=0;&#xa;        dir_left=0;&#xa;        dir_right=0;     &#xa;        end&#xa;      &#xa;   &#xa;      GO:begin//这里我不管偏左还是偏右，我都是左轮减去corr_value，右轮加上corr_value，因为corr_value本身就是带符号的数据&#xa;        //它的运算逻辑与error_mpu以及编码器测速是分开的，就表示编码器在一段时间内测量的总脉冲数来代替路程&#xa;        //如果corr_value是正数的话表示左轮走的路程多，那我就得左减右加，负数的话是右轮走的路程多，那我得左加右减，减一个负数&#xa;        //就相当于加一个正数，逻辑没问题&#xa;        //但是error_mpu就不一样了，偏右我就得左轮减速，偏左我就得右轮减速，逻辑不同的关键就在于我有mpu_dir来限制了error_mpu的方向&#xa;        //而corr_value不同，正负都可能存在&#xa;            dir_left=0;&#xa;        dir_right=0; &#xa;        base_speed=(heavy_load_state==1)?DUTY_LOAD_GOBACK:DUTY_GOBACK;&#xa;        if(error_mpu==0)begin&#xa;        temp_speed_l=base_speed-TRIM_GO-encoder_corr_term;&#xa;        temp_speed_r=base_speed+encoder_corr_term;&#xa;        end&#xa;        else begin&#xa;        &#x9;&#x9;&#x9;if(mpu_dir==1)//偏右了&#xa;                    begin&#xa;&#x9;                    &#x9;temp_speed_l=base_speed-TRIM_GO-encoder_corr_term-mpu_corr_term;&#xa;                      //我觉得本质上就是PI算法的变形，corr_value是积分项，考虑的是总的偏差，error_mpu是比例项，考虑的是瞬时的偏差&#xa;&#x9;                    &#x9;temp_speed_r=base_speed+encoder_corr_term;&#xa;                        end&#xa;                        else begin&#xa;&#x9;                    &#x9;temp_speed_l=base_speed-TRIM_GO-encoder_corr_term;&#xa;                      temp_speed_r=base_speed+encoder_corr_term-mpu_corr_term;&#xa;                        end&#xa;                        &#xa;        end&#xa;        target_speed_l=clamp_target(temp_speed_l);&#xa;        target_speed_r=clamp_target(temp_speed_r);&#xa;        end&#xa;        LEFT:begin&#xa;    &#x9;target_speed_r=(heavy_load_state==1)?DUTY_LOAD_TURN_OUT:DUTY_TURN_OUT;&#xa;        target_speed_l=(heavy_load_state==1)?DUTY_LOAD_TURN_IN:DUTY_TURN_IN;&#xa;        dir_left=0;&#xa;        dir_right=0;    &#xa;        end&#xa;        RIGHT:begin&#xa;    &#x9;target_speed_l=(heavy_load_state==1)?DUTY_LOAD_TURN_OUT:DUTY_TURN_OUT;&#xa;        target_speed_r=(heavy_load_state==1)?DUTY_LOAD_TURN_IN:DUTY_TURN_IN;&#xa;        dir_left=0;&#xa;        dir_right=0;&#xa;        end&#xa;        BACK:begin&#xa;            dir_left=1;&#xa;        dir_right=1; &#xa;        base_speed=(heavy_load_state==1)?DUTY_LOAD_GOBACK:DUTY_GOBACK;&#xa;        if(error_mpu==0)begin&#xa;        temp_speed_l=base_speed-encoder_corr_term;&#xa;        temp_speed_r=base_speed+encoder_corr_term-TRIM_BACK;&#xa;        end&#xa;        else begin&#xa;&#x9;        &#x9;&#x9;&#x9;if(mpu_dir==0)//&#xa;                    begin&#xa;&#x9;                    &#x9;temp_speed_l=base_speed-encoder_corr_term-mpu_corr_term;&#xa;&#x9;                    &#x9;temp_speed_r=base_speed+encoder_corr_term-TRIM_BACK;&#xa;                        end&#xa;                        else if(mpu_dir==1)begin//右轮太快了&#xa;                      temp_speed_r=base_speed+encoder_corr_term-TRIM_BACK-mpu_corr_term;&#xa;&#x9;                    &#x9;temp_speed_l=base_speed-encoder_corr_term;&#xa;                        end&#xa;                        &#xa;        end&#xa;        target_speed_l=clamp_target(temp_speed_l);&#xa;        target_speed_r=clamp_target(temp_speed_r);&#xa;        end&#xa;        default:begin&#xa;    &#x9;target_speed_l=0;&#xa;        target_speed_r=0;&#xa;        dir_left=0;&#xa;        dir_right=0;     &#xa;        end&#xa;        endcase&#xa;        end&#xa;    end&#xa;    //编码器读取区&#xa;    //我本来设计的是只读取上升沿跳变，但是后来为了达到更高的精度，就改成了下降沿跳变也读取&#xa;    reg enc_left_r1,enc_left_r2;&#xa;    reg enc_right_r1,enc_right_r2;&#xa;    always @ (posedge clk_50m  )&#xa;    begin &#xa;    &#x9;enc_left_r1&lt;=enc_left_a;&#xa;        enc_left_r2&lt;=enc_left_r1;&#xa;        &#x9;enc_right_r1&lt;=enc_right_a;&#xa;        enc_right_r2&lt;=enc_right_r1;//打拍，统一时钟域&#xa;    end&#xa;    wire pulse_left=enc_left_r2^enc_left_r1;&#xa;    wire pulse_right=enc_right_r2^enc_right_r1;&#xa;    reg [15:0]pulse_cnt_right;//当前周期内编码器的脉冲数&#xa;    reg [15:0]pulse_cnt_left;&#xa;   // reg [15:0]actual_speed_left;&#xa;   // reg [15:0]actual_speed_right;&#xa;    localparam SAMPLE_TIME=2_500_000;//编码器的周期是50ms&#xa;    reg [23:0]sample_timer;//判断有没有到达周期&#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst)begin&#xa;        pulse_cnt_right&lt;=0;&#xa;        pulse_cnt_left&lt;=0;&#xa;        actual_speed_left&lt;=0;&#xa;        actual_speed_right&lt;=0;&#xa;        sample_timer&lt;=0;&#xa;        toggle_flag&lt;=0;&#xa;        end&#xa;        else begin&#xa;        if(sample_timer&lt;SAMPLE_TIME-1)begin&#xa;        if(pulse_left) pulse_cnt_left&lt;=pulse_cnt_left+1;//意思就是一个sample周期内只要检测到pulse信号就对相应的pulse_cnt+1处理&#xa;        if(pulse_right) pulse_cnt_right&lt;=pulse_cnt_right+1;&#xa;        sample_timer&lt;=sample_timer+1;&#xa;        toggle_flag&lt;=toggle_flag;&#xa;        end&#xa;        else if(sample_timer==SAMPLE_TIME-1)begin//sample周期的最后一个时钟进行左移两位也就是乘4处理，是为了后续达到更高的计算精度&#xa;        actual_speed_left&lt;=pulse_cnt_left&lt;&lt;2;&#xa;        actual_speed_right&lt;=pulse_cnt_right&lt;&lt;2;&#xa;        pulse_cnt_left&lt;=0;&#xa;        pulse_cnt_right&lt;=0;&#xa;        sample_timer&lt;=0;//重新开始新的sample周期&#xa;        toggle_flag&lt;=~toggle_flag;&#xa;        end&#xa;        end&#xa;    end&#xa;    localparam GOBACK_ERR_DEBAND=16;//误差死区&#xa;    localparam GOBACK_SHIFT=6;//修正系数，修正量等于误差/64，也就是2的6次方&#xa;    parameter GOBACK_CORR_MAX=40;&#xa;    localparam GOBACK_ERR_MAX=2000;//累计误差的限幅，最大就是2000;&#xa;    integer goback_error;//累计误差值&#xa;    integer corr_value;&#xa;    reg [3:0] lstate;//上一时钟的状态&#xa;  integer goback_sample_error;&#xa;  always @(*)&#xa;  begin&#xa;      // actual_speed使用pulse_cnt左移2位，&#xa;      // 所以这里也乘4，统一到target_speed的数值单位&#xa;      goback_sample_error = pulse_cnt_left;&#xa;      goback_sample_error = goback_sample_error - pulse_cnt_right;&#xa;      goback_sample_error = goback_sample_error * 4;&#xa;      // 左轮目标比右轮少TRIM，&#xa;      // 因此把TRIM加入误差基准&#xa;      goback_sample_error = goback_sample_error - target_speed_l;&#xa;      goback_sample_error = goback_sample_error + target_speed_r;&#xa;  end&#xa;    wire sample_tick=(sample_timer==2_499_999);&#xa;    always @ ( posedge clk_50m or posedge rst )&#xa;    begin//1 &#x9;&#xa;    if(rst)&#x9;begin//2&#xa;    &#x9;&#x9;&#x9;lstate&lt;=IDLE;&#xa;                goback_error&lt;=0;&#xa;                end //2&#xa;                else begin//3&#xa;                &#x9;&#x9;lstate&lt;=car_state;&#xa;                        &#x9;if(~en || GOBACK_CORR_GAIN==0)begin//4&#xa;                            goback_error&lt;=0;&#xa;                            end//4&#xa;                            else&#x9;if(sample_tick) begin//en==1//5&#xa;                            &#x9;&#x9;if(lstate==IDLE&amp;&amp; (car_state==GO||car_state==BACK)) begin//6&#xa;                                    goback_error&lt;=0;&#xa;                                    end//6&#xa;                                    else &#x9;if((lstate==GO&amp;&amp;car_state==GO)|| (car_state==BACK&amp;&amp;lstate==BACK))begin//7&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;goback_error&lt;=goback_error+goback_sample_error;&#xa;                                    &#x9;&#x9;if(goback_error+goback_sample_error>GOBACK_ERR_MAX)&#xa;                                            &#x9;goback_error&lt;=GOBACK_ERR_MAX;&#xa;                                            else if(goback_error+goback_sample_error&lt;-GOBACK_ERR_MAX)&#xa;                                            &#x9;&#x9;&#x9;goback_error&lt;=-GOBACK_ERR_MAX;&#xa;                                    end//7&#xa;                                    else begin&#xa;                                    &#x9;&#x9;goback_error&lt;=0;//左转右转的时候给直线偏移量清0&#xa;                                    end&#xa;                                    &#xa;                            end//5&#xa;                end//3&#xa;    &#xa;    end//1&#xa;    always @ (*  )&#xa;    begin &#xa;        corr_value=0;//GOBAND_ERR_DEBAND是死区，我只有累计误差值超过了死区才进行逻辑运算&#xa;        if(goback_error>GOBACK_ERR_DEBAND)begin//左轮快,后续我就得左轮减速右轮加速&#xa;        &#x9;&#x9;corr_value=(goback_error-GOBACK_ERR_DEBAND)>>GOBACK_SHIFT;&#xa;                &#x9;&#x9;if(corr_value>GOBACK_CORR_MAX)//超过了限幅 我就稳定在MAX&#xa;                        &#x9;corr_value=GOBACK_CORR_MAX;&#xa;                            else corr_value=corr_value;&#xa;                end&#xa;                else begin&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(goback_error&lt;-GOBACK_ERR_DEBAND)&#x9;&#x9;begin&#xa;                            &#x9;corr_value=-((-goback_error-GOBACK_ERR_DEBAND)>>GOBACK_SHIFT);//同上，现在是右轮快&#xa;                                if(corr_value&lt;-GOBACK_CORR_MAX)&#xa;                                &#x9;&#x9;corr_value=-GOBACK_CORR_MAX;&#xa;                                        else corr_value=corr_value;&#xa;                            end&#xa;                            else begin&#xa;                            corr_value=0;&#xa;                            end&#xa;                end&#xa;                &#xa;    end&#xa;    //PI控制器区&#xa;    localparam Kp=12;&#xa;    localparam Ki=2;&#xa;    reg [3:0]last_cstate;&#xa;    reg [15:0]abs_left;//左轮绝对误差&#xa;    reg err_left;//左轮的误差方向,0代表着目标速度大于实际速度,需要加速，1的话就是减速&#xa;    reg [15:0]integral_left;//左轮误差的累计值&#xa;    reg [15:0]p_term_l;//左轮比例计算结果&#xa;    reg [15:0]calc_duty_left;//左轮PI计算出的临时占空比&#xa;    reg [15:0]abs_right;&#xa;    reg err_right;&#xa;    reg [15:0]integral_right;&#xa;    reg [15:0]p_term_r;&#xa;    reg [15:0]calc_duty_right;&#xa;    reg [7:0]final_duty_l;&#xa;    reg [7:0]final_duty_r;//这才是最终的占空比&#xa;    always@(*)begin//误差计算逻辑&#xa;    &#x9;if(actual_speed_left>target_speed_l)begin&#xa;        abs_left=actual_speed_left-target_speed_l;&#xa;        err_left=1;//减速&#xa;        end&#xa;        else begin&#xa;        abs_left=target_speed_l-actual_speed_left;&#xa;        err_left=0;//加速   &#xa;        end&#xa;        &#x9;if(actual_speed_right>target_speed_r)begin&#xa;        abs_right=actual_speed_right-target_speed_r;&#xa;        err_right=1;//减速&#xa;        end&#xa;        else begin&#xa;        abs_right=target_speed_r-actual_speed_right;&#xa;        err_right=0;//加速   &#xa;        end&#xa;    end&#xa;    always@(posedge clk_50m or posedge rst)begin//1&#xa;    &#x9;if(rst)begin//2&#xa;        final_duty_l&lt;=0;&#xa;        final_duty_r&lt;=0;&#xa;        integral_right&lt;=0;&#xa;        integral_left&lt;=0;&#xa;    &#x9;last_cstate&lt;=IDLE;&#xa;      calc_duty_right&lt;=0;&#xa;      calc_duty_left&lt;=0;&#xa;        end//2&#xa;        else begin //3&#xa;        if(sample_timer==SAMPLE_TIME-1) begin //4&#xa;        if (car_state != last_cstate) begin//5&#xa;                      integral_left  &lt;= integral_left >> 2;//本来我设计的是状态转换的时候积分项直接清零，但是不丝滑&#xa;                      integral_right &lt;= integral_right >> 2;&#xa;                      last_cstate &lt;= car_state;&#xa;                  end     //5         &#xa;        &#x9;else begin&#x9;if(target_speed_l==0)//左轮区//6&#xa;                begin//7&#xa;                final_duty_l&lt;=0;&#xa;               &#x9;integral_left&lt;=0;&#xa;                calc_duty_left &lt;= 0;&#xa;                end//7&#xa;            &#x9;else begin&#x9;if(err_left==0)//需要加速了//8&#xa;                    begin&#xa;                    if(integral_left+abs_left&lt;4000)//积分限幅&#xa;                    //比如跑步的时候你前面几圈特别慢，你总不能最后几圈跑的飞快，你肯定得爆缸啊&#xa;                    &#x9;   integral_left&lt;=integral_left+abs_left;&#xa;                        else begin&#xa;                        &#x9;integral_left&lt;=4000;&#xa;                        end&#xa;                        calc_duty_left&lt;=((integral_left*Ki)+abs_left*Kp)>>5;//我本来是>>3,但是因为我actual_speed&lt;&lt;2,相应的abs也&lt;&lt;2，为了保持数值的大小，我就把>>3变成了>>5&#xa;             //这里&lt;&lt;2的目的是在target_speed逻辑里实现更精确的计算，以实现不&lt;&lt;2的时候小数的情况，也就是提高控制参数的分辨性，而非编码器的分辨性&#xa;                        end&#xa;                   else //减速的时候&#xa;                begin&#xa;                &#x9;&#x9;if(integral_left>abs_left)&#xa;                        &#x9;integral_left&lt;=integral_left-abs_left;&#xa;                      else integral_left&lt;=0;&#xa;                    if(integral_left*Ki>abs_left*Kp)&#xa;                    &#x9;&#x9;calc_duty_left&lt;=(integral_left*Ki-abs_left*Kp)>>5;&#xa;                     else calc_duty_left&lt;=0;&#xa;    &#x9;&#x9;&#x9;&#x9;&#x9;end&#xa;                    end&#xa;                                                if(calc_duty_left>255)&#xa;                &#x9;&#x9;final_duty_l&lt;=255;&#xa;                 else final_duty_l&lt;=calc_duty_left[7:0];&#xa;            &#x9;&#x9;&#x9;&#xa;    &#xa;                //&#xa;        &#x9;&#x9;if(target_speed_r==0)//右轮区&#xa;                begin&#xa;                final_duty_r&lt;=0;&#xa;               &#x9;integral_right&lt;=0;&#xa;                calc_duty_right&lt;=0;&#xa;                end&#xa;            else &#x9;if(err_right==0)//需要加速了&#xa;                    begin&#xa;                    if(integral_right+abs_right&lt;4000)&#xa;                    &#x9;   integral_right&lt;=integral_right+abs_right;&#xa;                        else begin&#xa;                        &#x9;integral_right&lt;=4000;&#xa;                        end&#xa;                        calc_duty_right&lt;=((integral_right*Ki)+abs_right*Kp)>>5;&#xa;                        end&#xa;                   else //减速的时候 &#xa;                begin&#xa;                &#x9;&#x9;if(integral_right>abs_right)&#xa;                        &#x9;integral_right&lt;=integral_right-abs_right;&#xa;                      else integral_right&lt;=0;&#xa;                    if(integral_right*Ki>abs_right*Kp)&#xa;                    &#x9;&#x9;calc_duty_right&lt;=(integral_right*Ki-abs_right*Kp)>>5;&#xa;                     else calc_duty_right&lt;=0;&#xa;    &#xa;                    end&#xa;            &#x9;&#x9;&#x9;&#xa;                                                    if(calc_duty_right>255)&#xa;                &#x9;&#x9;final_duty_r&lt;=255;&#xa;                 else final_duty_r&lt;=calc_duty_right[7:0];&#xa;    end&#xa;            end//3&#xa;                end//1&#xa;                &#xa;    end&#xa;    //电机堵转检测逻辑，当en==1，目标占空比不为0，PI实际输出不为0，实际编码器计数多个周期为0&#xa;    //当前编码器测速周期是50ms一从&#xa;    localparam STALL_SAMPLE_MAX=1;//0.05s满足上述条件我就认为是某个轮子被石子卡住了&#xa;    reg [4:0]stall_cnt_left;&#xa;    reg [4:0]stall_cnt_right;&#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;&#x9;if(rst)begin&#xa;            stall_cnt_left&lt;=0;&#xa;            stall_cnt_right&lt;=0;&#xa;            stall_state&lt;=0;&#xa;            end&#xa;            else begin&#xa;            &#x9;&#x9;if(en &amp;&amp; final_duty_l!=0 &amp;&amp; target_speed_l!=0 )begin&#xa;                    &#x9;&#x9;if(sample_tick)&#xa;                            &#x9;&#x9;if(pulse_cnt_left==0) begin&#xa;                                    if(stall_cnt_left>=STALL_SAMPLE_MAX-1) begin&#xa;                                    &#x9;&#x9;stall_cnt_left&lt;=STALL_SAMPLE_MAX-1;&#xa;                                            stall_state[0]&lt;=1;&#xa;                                            end&#xa;                                      else  begin stall_cnt_left&lt;=stall_cnt_left+1;&#xa;                                    &#x9;&#x9;&#x9;stall_state[0]&lt;=0;&#xa;                                    end&#xa;                                    end&#xa;                                    else begin&#xa;                                    stall_cnt_left&lt;=0;&#xa;                                    stall_state[0]&lt;=0;&#xa;                                    end&#xa;                               end &#xa;                      else begin&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; stall_cnt_left&lt;=0;&#xa;                                    stall_state[0]&lt;=0;                   &#xa;                    end     &#xa;                    if(en &amp;&amp; final_duty_r!=0 &amp;&amp; target_speed_r!=0 )begin&#xa;                    &#x9;&#x9;if(sample_tick)&#xa;                            &#x9;&#x9;if(pulse_cnt_right==0) begin&#xa;                                    if(stall_cnt_right>=STALL_SAMPLE_MAX-1) begin&#xa;                                    &#x9;&#x9;stall_cnt_right&lt;=STALL_SAMPLE_MAX-1;&#xa;                                            stall_state[1]&lt;=1;&#xa;                                            end&#xa;                                      else  begin stall_cnt_right&lt;=stall_cnt_right+1;&#xa;                                    &#x9;&#x9;&#x9;stall_state[1]&lt;=0;&#xa;                                    end&#xa;                                    end&#xa;                                    else begin&#xa;                                    stall_cnt_right&lt;=0;&#xa;                                    stall_state[1]&lt;=0;&#xa;                                    end&#xa;                               end &#xa;                      else begin&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; stall_cnt_right&lt;=0;&#xa;                                    stall_state[1]&lt;=0;                   &#xa;                    end     &#xa;                         &#xa;            end&#xa;    end&#xa;    assign  stall_alarm=stall_state[0] || stall_state[1];&#xa;    //PWM底层逻辑&#xa;    reg [15:0]pwm_cnt;&#xa;    wire [15:0]compare_left=(final_duty_l*PERIOD)/256;&#xa;    wire [15:0]compare_right=(final_duty_r*PERIOD)/256;&#xa;    always @ (posedge clk_50m or posedge rst  )&#xa;    begin &#xa;    &#x9;if(rst)&#xa;        pwm_cnt&lt;=0;&#xa;        else begin&#xa;        &#x9;&#x9;if(pwm_cnt==PERIOD-1)&#xa;                pwm_cnt&lt;=0;&#xa;                else pwm_cnt&lt;=pwm_cnt+1;&#xa;        end&#xa;    end&#xa;    always@(posedge clk_50m or posedge rst)&#xa;    begin&#xa;    &#x9;if(rst)begin&#xa;        pwm_left&lt;=0;&#xa;        pwm_right&lt;=0;&#xa;        end&#xa;        else begin&#xa;      &#x9;&#x9;if(lost_used||stall_alarm)begin&#xa;              pwm_left&lt;=0;&#xa;              pwm_right&lt;=0;&#xa;              end&#xa;              else begin&#xa;        pwm_left&lt;=(pwm_cnt&lt;compare_left)?1:0;&#xa;        pwm_right&lt;=(pwm_cnt&lt;compare_right)?1:0;&#xa;      end&#xa;        end&#xa;    end&#xa;    assign IN1=(en==0||final_duty_l==0||stall_alarm)?0:dir_left;&#xa;    assign IN2=(en==0||final_duty_l==0||stall_alarm)?0:~dir_left;&#xa;    &#xa;    assign IN3=(en==0||final_duty_r==0||stall_alarm)?0:~dir_right;&#xa;    assign IN4=(en==0||final_duty_r==0||stall_alarm)?0:dir_right;*/&#xa;&#xa;&#xa;&#xa;      //组合逻辑always@(*)不允许用复位 TRACK_CORR_MAX&#xa;      parameter MAG_SPEED=6;&#xa;      // MPU 修正项保留在目标速度表达式中；默认 0 表示上电后暂不参与控制。&#xa;      parameter ERROR_SPEED=0;&#xa;      parameter IDLE=4'b0000;&#xa;      parameter GO=4'b0001;&#xa;      parameter BACK=4'b0010;&#xa;      parameter LEFT=4'b0100;&#xa;      parameter RIGHT=4'b1000;&#xa;      // TRACKING_SENSOR输出的循迹控制模式。&#xa;      localparam [1:0] TRACK_NORMAL   = 2'b00;&#xa;      localparam [1:0] TRACK_DEGRADED = 2'b01;&#xa;      localparam [1:0] TRACK_RECOVERY = 2'b10;&#xa;      localparam [1:0] TRACK_STOP     = 2'b11;&#xa;&#xa;      // 循迹初始速度参数，单位与target_speed一致。&#xa;      localparam TRACK_BASE_LIGHT_NORMAL   = 290;&#xa;      localparam TRACK_BASE_HEAVY_NORMAL   = 280;&#xa;      localparam TRACK_BASE_LIGHT_DEGRADED = 230;&#xa;      localparam TRACK_BASE_HEAVY_DEGRADED = 220;&#xa;      localparam TRACK_BASE_LIGHT_RECOVERY = 160;&#xa;      localparam TRACK_BASE_HEAVY_RECOVERY = 150;&#xa;      localparam TRACK_SLOW_NORMAL         = 7;&#xa;      localparam TRACK_SLOW_DEGRADED       = 4;&#xa;      localparam TRACK_CORR_MAX            = 220;&#xa;      parameter PWM_FREQ=1000;//PWM的频率&#xa;      parameter CLK_FREQ=50_000_000;//输入的系统时钟频率&#xa;      parameter PERIOD=CLK_FREQ/PWM_FREQ;//PWM一个周期所经过的系统时钟周期，50_000;&#xa;      localparam DUTY_IDLE= 8'd0;&#xa;      //这都是50MS内编码器双边沿测量的结果，不是PWM值，别搞混了&#xa;      //localparam DUTY_LOAD_GOBACK= 8'd82;//重载的前进/后退速度&#xa;      //localparam DUTY_GOBACK= 8'd120;// 空载的前进/后退速度&#xa;      //localparam DUTY_TURN_IN= 8'd40; //空载转弯内测速度&#xa;      //localparam DUTY_TURN_OUT= 8'd100;//空载转弯外侧速度&#xa;      //localparam DUTY_LOAD_TURN_IN  = 8'd30;//重载转弯内侧速度&#xa;      //localparam DUTY_LOAD_TURN_OUT = 8'd75;//重载转弯外侧速度&#xa;      localparam DUTY_LOAD_GOBACK= 10'd280;//重载的前进/后退速度&#xa;      localparam DUTY_GOBACK= 10'd320;// 空载的前进/后退速度&#xa;      localparam DUTY_TURN_IN= 10'd140; //空载转弯内测速度&#xa;      localparam DUTY_TURN_OUT= 10'd300;//空载转弯外侧速度&#xa;      localparam DUTY_LOAD_TURN_IN  = 10'd110;//重载转弯内侧速度&#xa;      localparam DUTY_LOAD_TURN_OUT = 10'd250;//重载转弯外侧速度&#xa;    parameter TRIM_GO=0;&#xa;    // 原代码后退右轮固定减 15；改成可调参数后以 15 作为上电默认值。&#xa;    parameter TRIM_BACK=15;&#xa;  &#xa;    // 蓝牙实时调参地址。cfg_data 对 TRIM 使用 16 位二补码，其余参数为无符号数。&#xa;    localparam CFG_TRIM_GO             = 8'h01;&#xa;    localparam CFG_TRIM_BACK           = 8'h02;&#xa;    localparam CFG_KP                  = 8'h03;&#xa;    localparam CFG_KI                  = 8'h04;&#xa;    localparam CFG_GO_TARGET_LIGHT     = 8'h05;&#xa;    localparam CFG_GO_TARGET_HEAVY     = 8'h06;&#xa;    localparam CFG_BACK_TARGET_LIGHT   = 8'h07;&#xa;    localparam CFG_BACK_TARGET_HEAVY   = 8'h08;&#xa;    localparam CFG_TURN_IN_LIGHT       = 8'h09;&#xa;    localparam CFG_TURN_OUT_LIGHT      = 8'h0A;&#xa;    localparam CFG_TURN_IN_HEAVY       = 8'h0B;&#xa;    localparam CFG_TURN_OUT_HEAVY      = 8'h0C;&#xa;    localparam CFG_TRACK_MAG_SPEED     = 8'h0D;&#xa;    localparam CFG_MPU_ERROR_SPEED     = 8'h0E;&#xa;    localparam CFG_ENCODER_CORR_GAIN   = 8'h0F;&#xa;    localparam CFG_ENCODER_ERR_DEADBAND= 8'h10;&#xa;    localparam CFG_ENCODER_ERR_SHIFT   = 8'h11;&#xa;    localparam CFG_ENCODER_CORR_MAX    = 8'h12;&#xa;    localparam CFG_ENCODER_ERR_MAX     = 8'h13;&#xa;    localparam CFG_TRACK_BASE_LIGHT_NORMAL   = 8'h14;&#xa;    localparam CFG_TRACK_BASE_HEAVY_NORMAL   = 8'h15;&#xa;    localparam CFG_TRACK_BASE_LIGHT_DEGRADED = 8'h16;&#xa;    localparam CFG_TRACK_BASE_HEAVY_DEGRADED = 8'h17;&#xa;    localparam CFG_TRACK_BASE_LIGHT_RECOVERY = 8'h18;&#xa;    localparam CFG_TRACK_BASE_HEAVY_RECOVERY = 8'h19;&#xa;  &#xa;    // 使用 integer 保留乘法位宽，避免较大的 Kp/Ki 在乘法时过早截断。&#xa;    integer trim_go_cfg;&#xa;    integer trim_back_cfg;&#xa;    integer kp_cfg;&#xa;    integer ki_cfg;&#xa;    integer go_target_light_cfg;&#xa;    integer go_target_heavy_cfg;&#xa;    integer back_target_light_cfg;&#xa;    integer back_target_heavy_cfg;&#xa;    integer turn_in_light_cfg;&#xa;    integer turn_out_light_cfg;&#xa;    integer turn_in_heavy_cfg;&#xa;    integer turn_out_heavy_cfg;&#xa;    integer track_mag_speed_cfg;&#xa;    integer mpu_error_speed_cfg;&#xa;    integer encoder_corr_gain_cfg;&#xa;    integer encoder_err_deband_cfg;&#xa;    integer encoder_err_shift_cfg;&#xa;    integer encoder_corr_max_cfg;&#xa;    integer encoder_err_max_cfg;&#xa;    integer track_base_light_normal_cfg;&#xa;    integer track_base_heavy_normal_cfg;&#xa;    integer track_base_light_degraded_cfg;&#xa;    integer track_base_heavy_degraded_cfg;&#xa;    integer track_base_light_recovery_cfg;&#xa;    integer track_base_heavy_recovery_cfg;&#xa;    integer corr_value;&#xa;    integer encoder_corr_term;&#xa;    integer mpu_corr_term;&#xa;  &#xa;    // 所有参数在完整调参帧校验通过后立即生效；硬件端再次限幅，防止异常串口数据。&#xa;    always @(posedge clk_50m or posedge rst)&#xa;    begin&#xa;      if (rst) begin&#xa;        trim_go_cfg           &lt;= TRIM_GO;&#xa;        trim_back_cfg         &lt;= TRIM_BACK;&#xa;        kp_cfg                &lt;= 12;&#xa;        ki_cfg                &lt;= 2;&#xa;        go_target_light_cfg   &lt;= DUTY_GOBACK;&#xa;        go_target_heavy_cfg   &lt;= DUTY_LOAD_GOBACK;&#xa;        back_target_light_cfg &lt;= DUTY_GOBACK;&#xa;        back_target_heavy_cfg &lt;= DUTY_LOAD_GOBACK;&#xa;        turn_in_light_cfg     &lt;= DUTY_TURN_IN;&#xa;        turn_out_light_cfg    &lt;= DUTY_TURN_OUT;&#xa;        turn_in_heavy_cfg     &lt;= DUTY_LOAD_TURN_IN;&#xa;        turn_out_heavy_cfg    &lt;= DUTY_LOAD_TURN_OUT;&#xa;        track_mag_speed_cfg   &lt;= MAG_SPEED;&#xa;        mpu_error_speed_cfg   &lt;= ERROR_SPEED;&#xa;        encoder_corr_gain_cfg &lt;= 0;&#xa;        encoder_err_deband_cfg&lt;= 32;&#xa;        encoder_err_shift_cfg &lt;= 6;&#xa;        encoder_corr_max_cfg  &lt;= 40;&#xa;        encoder_err_max_cfg   &lt;= 2000;&#xa;        track_base_light_normal_cfg   &lt;= TRACK_BASE_LIGHT_NORMAL;&#xa;        track_base_heavy_normal_cfg   &lt;= TRACK_BASE_HEAVY_NORMAL;&#xa;        track_base_light_degraded_cfg &lt;= TRACK_BASE_LIGHT_DEGRADED;&#xa;        track_base_heavy_degraded_cfg &lt;= TRACK_BASE_HEAVY_DEGRADED;&#xa;        track_base_light_recovery_cfg &lt;= TRACK_BASE_LIGHT_RECOVERY;&#xa;        track_base_heavy_recovery_cfg &lt;= TRACK_BASE_HEAVY_RECOVERY;&#xa;      end&#xa;      else if (cfg_vld) begin&#xa;        case (cfg_addr)&#xa;          CFG_TRIM_GO: begin&#xa;            if ($signed(cfg_data) > 1000)&#xa;              trim_go_cfg &lt;= 1000;&#xa;            else if ($signed(cfg_data) &lt; -1000)&#xa;              trim_go_cfg &lt;= -1000;&#xa;            else&#xa;              trim_go_cfg &lt;= $signed(cfg_data);&#xa;          end&#xa;          CFG_TRIM_BACK: begin&#xa;            if ($signed(cfg_data) > 1000)&#xa;              trim_back_cfg &lt;= 1000;&#xa;            else if ($signed(cfg_data) &lt; -1000)&#xa;              trim_back_cfg &lt;= -1000;&#xa;            else&#xa;              trim_back_cfg &lt;= $signed(cfg_data);&#xa;          end&#xa;          CFG_KP:                kp_cfg                &lt;= (cfg_data > 255)  ? 255  : cfg_data;&#xa;          CFG_KI:                ki_cfg                &lt;= (cfg_data > 255)  ? 255  : cfg_data;&#xa;          CFG_GO_TARGET_LIGHT:   go_target_light_cfg   &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_GO_TARGET_HEAVY:   go_target_heavy_cfg   &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_BACK_TARGET_LIGHT: back_target_light_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_BACK_TARGET_HEAVY: back_target_heavy_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TURN_IN_LIGHT:     turn_in_light_cfg     &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TURN_OUT_LIGHT:    turn_out_light_cfg    &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TURN_IN_HEAVY:     turn_in_heavy_cfg     &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TURN_OUT_HEAVY:    turn_out_heavy_cfg    &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_MAG_SPEED:   track_mag_speed_cfg   &lt;= (cfg_data > 255)  ? 255  : cfg_data;&#xa;          CFG_MPU_ERROR_SPEED:   mpu_error_speed_cfg   &lt;= (cfg_data > 255)  ? 255  : cfg_data;&#xa;          // 0=关闭累计编码器修正，1=使用原始 corr_value，2～16 为倍增。&#xa;          CFG_ENCODER_CORR_GAIN: encoder_corr_gain_cfg &lt;= (cfg_data > 16)   ? 16   : cfg_data;&#xa;          CFG_ENCODER_ERR_DEADBAND: encoder_err_deband_cfg &lt;= (cfg_data > 4000)  ? 4000  : cfg_data;&#xa;          CFG_ENCODER_ERR_SHIFT:    encoder_err_shift_cfg  &lt;= (cfg_data > 15)    ? 15    : cfg_data;&#xa;          CFG_ENCODER_CORR_MAX:     encoder_corr_max_cfg   &lt;= (cfg_data > 1000)  ? 1000  : cfg_data;&#xa;          CFG_ENCODER_ERR_MAX:      encoder_err_max_cfg    &lt;= (cfg_data > 30000) ? 30000 : cfg_data;&#xa;          CFG_TRACK_BASE_LIGHT_NORMAL:&#xa;            track_base_light_normal_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_BASE_HEAVY_NORMAL:&#xa;            track_base_heavy_normal_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_BASE_LIGHT_DEGRADED:&#xa;            track_base_light_degraded_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_BASE_HEAVY_DEGRADED:&#xa;            track_base_heavy_degraded_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_BASE_LIGHT_RECOVERY:&#xa;            track_base_light_recovery_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          CFG_TRACK_BASE_HEAVY_RECOVERY:&#xa;            track_base_heavy_recovery_cfg &lt;= (cfg_data > 4000) ? 4000 : cfg_data;&#xa;          default: begin end&#xa;        endcase&#xa;      end&#xa;    end&#xa;  &#xa;    function [15:0] clamp_target;&#xa;      input integer value;&#xa;      begin&#xa;        if (value &lt; 0)&#xa;          clamp_target = 16'd0;&#xa;        else if (value > 4000)&#xa;          clamp_target = 16'd4000;&#xa;        else&#xa;          clamp_target = value[15:0];&#xa;      end&#xa;    endfunction&#xa;  &#xa;    // 两个外环修正项始终存在于 speed 表达式中。&#xa;    // 初始 encoder_corr_gain_cfg=0、mpu_error_speed_cfg=0，因此刚开始测试时两项均为 0。&#xa;    always @(*)&#xa;    begin&#xa;      encoder_corr_term = corr_value * encoder_corr_gain_cfg;&#xa;      mpu_corr_term     = error_mpu * mpu_error_speed_cfg;&#xa;    end&#xa;    reg lost_used;&#xa;    reg [27:0]lost_cnt;&#xa;    localparam lost_max=50_000_000;&#xa;    always @ (  posedge clk_50m or posedge rst)&#xa;    begin &#xa;    &#x9;if(rst)begin&#xa;        lost_used&lt;=0;&#xa;        lost_cnt&lt;=0;&#xa;        end&#xa;        else begin&#xa;        &#x9;&#x9;if(~sensor_lost||~en||~sensor_lock)begin&#xa;                lost_used&lt;=0;&#xa;                lost_cnt&lt;=0;&#xa;                end&#xa;                else begin&#x9;if(~lost_used)begin&#xa;                if(lost_cnt>=lost_max-1)begin&#xa;                &#x9;&#x9;&#x9;lost_used&lt;=1;&#xa;                            lost_cnt&lt;=0;&#xa;                            end &#xa;                            else begin&#xa;                            lost_used&lt;=0;&#xa;                            lost_cnt&lt;=lost_cnt+1;&#xa;                            end&#xa;                            end&#xa;                &#x9;else begin&#xa;                    lost_used&lt;=1;&#xa;                    lost_cnt&lt;=lost_cnt;&#xa;                    end&#xa;                    end&#x9;&#x9;&#xa;                    end&#xa;    end&#xa;    // TRACKING_SENSOR的error_mag已经是0～14的Q1位置误差等级，&#xa;    // 直接使用并限幅，保证偏得越远，循迹修正越强。&#xa;    reg [3:0]error_used;&#xa;    always @(*)&#xa;    begin&#xa;        if(error_mag > 4'd14)&#xa;            error_used = 4'd14;&#xa;        else&#xa;            error_used = error_mag;&#xa;    end&#xa;     // reg [15:0]target_speed_l;//目标的编码器上升/下降沿数量，不是最终的占空比&#xa;     // reg [15:0]target_speed_r;&#xa;      reg dir_left;//0是正转动，1是反转&#xa;      reg dir_right;&#xa;      reg toggle_flag;//现在没用了，本来我设计的是用它反复在01跳变来取0.5的效果，以实现不用corr_value和MPU6050来走直线，发现实现不了&#xa;      integer base_speed;//integer 默认是32位的有符号位，系统自动截取了前八位&#xa;      integer temp_speed_l;&#xa;      integer temp_speed_r;//用于临时存储左右轮转速，防止直接用target存储的时候溢出&#xa;      integer track_corr;&#xa;      //目标编码生成区&#xa;      always@(*)begin//sensor_lock也就是循迹模式优先级最高，通过TRACKING_SENSOR传来的error_mag表示偏移量，turn_dir表示应该往哪转&#xa;      //类似于编码器测速，只不过是编码器换成了8路传感器&#xa;      &#x9;target_speed_l=0;&#xa;          target_speed_r=0;&#xa;          dir_left=0;&#xa;          dir_right=0;&#xa;          base_speed=0;&#xa;          temp_speed_l=0;&#xa;          temp_speed_r=0;&#xa;          track_corr=0;&#xa;         if(sensor_lock)begin&#xa;          dir_left=0;&#xa;          dir_right=0;&#xa;          // TRACKING_SENSOR已经完成分级脱轨恢复；进入STOP或sensor_lost时立即停车，&#xa;          // 不再由PWM额外等待lost_used的一秒延时。&#xa;          if(force_stop || distance_vld_go || sensor_lost ||&#xa;             (track_control_mode == TRACK_STOP)) begin&#xa;              base_speed     = 0;&#xa;              temp_speed_l   = 0;&#xa;              temp_speed_r   = 0;&#xa;              target_speed_l = 0;&#xa;              target_speed_r = 0;&#xa;          end&#xa;          else begin&#xa;              // 正常模式速度最高；置信度降低或进入寻线恢复时主动降速。&#xa;              case(track_control_mode)&#xa;                  TRACK_NORMAL: begin&#xa;                      base_speed = (heavy_load_state == 1)&#xa;                                 ? track_base_heavy_normal_cfg&#xa;                                 : track_base_light_normal_cfg;&#xa;                      base_speed = base_speed&#xa;                                 - error_used * TRACK_SLOW_NORMAL;&#xa;                  end&#xa;&#xa;                  TRACK_DEGRADED: begin&#xa;                      base_speed = (heavy_load_state == 1)&#xa;                                 ? track_base_heavy_degraded_cfg&#xa;                                 : track_base_light_degraded_cfg;&#xa;                      base_speed = base_speed&#xa;                                 - error_used * TRACK_SLOW_DEGRADED;&#xa;                  end&#xa;&#xa;                  TRACK_RECOVERY: begin&#xa;                      base_speed = (heavy_load_state == 1)&#xa;                                 ? track_base_heavy_recovery_cfg&#xa;                                 : track_base_light_recovery_cfg;&#xa;                  end&#xa;&#xa;                  default: begin&#xa;                      base_speed = 0;&#xa;                  end&#xa;              endcase&#xa;&#xa;              // 0x0D控制每级循迹误差对应的差速量，默认值为6。&#xa;              track_corr = error_used * track_mag_speed_cfg;&#xa;              if(track_corr > TRACK_CORR_MAX)&#xa;                  track_corr = TRACK_CORR_MAX;&#xa;&#xa;              if(error_used == 0) begin&#xa;                  temp_speed_l = base_speed - trim_go_cfg;&#xa;                  temp_speed_r = base_speed;&#xa;              end&#xa;              else if(turn_dir == 1) begin&#xa;                  // 轨迹位于左侧：左轮减速、右轮加速，使车辆左转。&#xa;                  temp_speed_l = base_speed - track_corr - trim_go_cfg;&#xa;                  temp_speed_r = base_speed + track_corr;&#xa;              end&#xa;              else begin&#xa;                  // 轨迹位于右侧：左轮加速、右轮减速，使车辆右转。&#xa;                  temp_speed_l = base_speed + track_corr - trim_go_cfg;&#xa;                  temp_speed_r = base_speed - track_corr;&#xa;              end&#xa;&#xa;              target_speed_l = clamp_target(temp_speed_l);&#xa;              target_speed_r = clamp_target(temp_speed_r);&#xa;          end&#xa;    &#xa;          end&#xa;          else begin&#xa;          case(car_state)&#xa;          IDLE:begin&#xa;      &#x9;target_speed_l=0;&#xa;          target_speed_r=0;&#xa;          dir_left=0;&#xa;          dir_right=0;     &#xa;          end&#xa;        &#xa;     &#xa;      GO: begin&#xa;      dir_left  = 0;&#xa;      dir_right = 0;&#xa;  &#xa;      base_speed = (heavy_load_state == 1)&#xa;                 ? go_target_heavy_cfg&#xa;                 : go_target_light_cfg;&#xa;  &#xa;      if(error_mpu == 0) begin&#xa;          // 没有MPU误差，只使用TRIM和累计编码器修正&#xa;          temp_speed_l = base_speed&#xa;                       - trim_go_cfg&#xa;                       - encoder_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term;&#xa;      end&#xa;      else if(mpu_dir == 1) begin&#xa;          // 前进时车头向右偏：&#xa;          // 降低左轮速度，使车头向左修正&#xa;          temp_speed_l = base_speed&#xa;                       - trim_go_cfg&#xa;                       - encoder_corr_term&#xa;                       - mpu_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term;&#xa;      end&#xa;      else begin&#xa;          // 前进时车头向左偏：&#xa;          // 降低右轮速度，使车头向右修正&#xa;          temp_speed_l = base_speed&#xa;                       - trim_go_cfg&#xa;                       - encoder_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term&#xa;                       - mpu_corr_term;&#xa;      end&#xa;  &#xa;      target_speed_l = clamp_target(temp_speed_l);&#xa;      target_speed_r = clamp_target(temp_speed_r);&#xa;  end&#xa;          LEFT:begin&#xa;  &#x9;&#x9;target_speed_r=(heavy_load_state==1)?turn_out_heavy_cfg:turn_out_light_cfg;&#xa;          target_speed_l=(heavy_load_state==1)?turn_in_heavy_cfg:turn_in_light_cfg;&#xa;          dir_left=0;&#xa;          dir_right=0;    &#xa;          end&#xa;          RIGHT:begin&#xa;  &#x9;&#x9;target_speed_l=(heavy_load_state==1)?turn_out_heavy_cfg:turn_out_light_cfg;&#xa;          target_speed_r=(heavy_load_state==1)?turn_in_heavy_cfg:turn_in_light_cfg;&#xa;          dir_left=0;&#xa;          dir_right=0;&#xa;          end&#xa;          BACK: begin&#xa;      dir_left  = 1;&#xa;      dir_right = 1;&#xa;  &#xa;      base_speed = (heavy_load_state == 1)&#xa;                 ? back_target_heavy_cfg&#xa;                 : back_target_light_cfg;&#xa;  &#xa;      if(error_mpu == 0) begin&#xa;          // 没有MPU航向误差，只使用累计编码器修正&#xa;          temp_speed_l = base_speed&#xa;                       - encoder_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term&#xa;                       - trim_back_cfg;&#xa;      end&#xa;      else if(mpu_dir == 1) begin&#xa;          // 后退时车头向右偏：&#xa;          // 右轮后退过快，降低右轮目标&#xa;          temp_speed_l = base_speed&#xa;                       - encoder_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term&#xa;                       - trim_back_cfg&#xa;                       - mpu_corr_term;&#xa;      end&#xa;      else begin&#xa;          // 后退时车头向左偏：&#xa;          // 左轮后退过快，降低左轮目标&#xa;          temp_speed_l = base_speed&#xa;                       - encoder_corr_term&#xa;                       - mpu_corr_term;&#xa;  &#xa;          temp_speed_r = base_speed&#xa;                       + encoder_corr_term&#xa;                       - trim_back_cfg;&#xa;      end&#xa;  &#xa;      target_speed_l = clamp_target(temp_speed_l);&#xa;      target_speed_r = clamp_target(temp_speed_r);&#xa;  end&#xa;          default:begin&#xa;      &#x9;target_speed_l=0;&#xa;          target_speed_r=0;&#xa;          dir_left=0;&#xa;          dir_right=0;     &#xa;          end&#xa;          endcase&#xa;          end&#xa;      end&#xa;      //编码器读取区&#xa;      //我本来设计的是只读取上升沿跳变，但是后来为了达到更高的精度，就改成了下降沿跳变也读取&#xa;      reg enc_left_r1,enc_left_r2;&#xa;      reg enc_right_r1,enc_right_r2;&#xa;      always @ (posedge clk_50m  )&#xa;      begin &#xa;      &#x9;enc_left_r1&lt;=enc_left_a;&#xa;          enc_left_r2&lt;=enc_left_r1;&#xa;          &#x9;enc_right_r1&lt;=enc_right_a;&#xa;          enc_right_r2&lt;=enc_right_r1;//打拍，统一时钟域&#xa;      end&#xa;      wire pulse_left=enc_left_r2^enc_left_r1;&#xa;      wire pulse_right=enc_right_r2^enc_right_r1;&#xa;      reg [15:0]pulse_cnt_right;//当前周期内编码器的脉冲数&#xa;      reg [15:0]pulse_cnt_left;&#xa;     // reg [15:0]actual_speed_left;&#xa;     // reg [15:0]actual_speed_right;&#xa;      localparam SAMPLE_TIME=2_500_000;//编码器的周期是50ms&#xa;      reg [23:0]sample_timer;//判断有没有到达周期&#xa;      always @ (posedge clk_50m or posedge rst  )&#xa;      begin &#xa;      &#x9;if(rst)begin&#xa;          pulse_cnt_right&lt;=0;&#xa;          pulse_cnt_left&lt;=0;&#xa;          actual_speed_left&lt;=0;&#xa;          actual_speed_right&lt;=0;&#xa;          sample_timer&lt;=0;&#xa;          toggle_flag&lt;=0;&#xa;          end&#xa;          else begin&#xa;          if(sample_timer&lt;SAMPLE_TIME-1)begin&#xa;          if(pulse_left) pulse_cnt_left&lt;=pulse_cnt_left+1;//意思就是一个sample周期内只要检测到pulse信号就对相应的pulse_cnt+1处理&#xa;          if(pulse_right) pulse_cnt_right&lt;=pulse_cnt_right+1;&#xa;          sample_timer&lt;=sample_timer+1;&#xa;          toggle_flag&lt;=toggle_flag;&#xa;          end&#xa;          else if(sample_timer==SAMPLE_TIME-1)begin//sample周期的最后一个时钟进行左移两位也就是乘4处理，是为了后续达到更高的计算精度&#xa;          actual_speed_left&lt;=pulse_cnt_left&lt;&lt;2;&#xa;          actual_speed_right&lt;=pulse_cnt_right&lt;&lt;2;&#xa;          pulse_cnt_left&lt;=0;&#xa;          pulse_cnt_right&lt;=0;&#xa;          sample_timer&lt;=0;//重新开始新的sample周期&#xa;          toggle_flag&lt;=~toggle_flag;&#xa;          end&#xa;          end&#xa;      end&#xa;      //直线累计误差,我感觉没啥用，还不如直接让CORR_MAAX=0效果好&#xa;      // 累计编码器算法的死区、右移系数、输出限幅和累计限幅均可由蓝牙实时调整。&#xa;      integer goback_error;//累计误差值&#xa;      reg [3:0] lstate;//上一时钟的状态&#xa;    integer goback_sample_error;&#xa;    always @(*)&#xa;    begin&#xa;        // 先计算当前50ms内左右编码器的实际速度差。&#xa;        // actual_speed使用pulse_cnt左移2位，所以这里同样乘4，&#xa;        // 统一到target_speed的数值单位。&#xa;        goback_sample_error = pulse_cnt_left;&#xa;        goback_sample_error = goback_sample_error - pulse_cnt_right;&#xa;        goback_sample_error = goback_sample_error * 4;&#xa;&#xa;        // 再减去当前左右轮目标速度差：&#xa;        // sample_error = (actual_left-actual_right)&#xa;        //              - (target_left-target_right)&#xa;        // target_speed已经包含TRIM、累计编码器修正和MPU航向修正，&#xa;        // 因而编码器累计环可以持续运行，同时不会把MPU主动产生的&#xa;        // 左右轮目标差误认为新的编码器偏差。&#xa;        goback_sample_error = goback_sample_error - target_speed_l;&#xa;        goback_sample_error = goback_sample_error + target_speed_r;&#xa;    end&#xa;      wire sample_tick=(sample_timer==SAMPLE_TIME-1);&#xa;      always @ ( posedge clk_50m or posedge rst )&#xa;      begin//1 &#x9;&#xa;      if(rst)&#x9;begin//2&#xa;      &#x9;&#x9;&#x9;lstate&lt;=IDLE;&#xa;                  goback_error&lt;=0;&#xa;                  end //2&#xa;                  else begin//3&#xa;                  &#x9;&#x9;lstate&lt;=car_state;&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(~en || encoder_corr_gain_cfg==0 || cfg_vld)begin//4&#xa;                              goback_error&lt;=0;&#xa;                              end//4&#xa;                              // MPU航向纠偏工作时，编码器累计环仍然每50ms更新。&#xa;                              // goback_sample_error已扣除当前目标差，因此不会与MPU修正互相对抗。&#xa;                              else if(sample_tick) begin//en==1//5&#xa;                              &#x9;&#x9;if(lstate==IDLE&amp;&amp; (car_state==GO||car_state==BACK)) begin//6&#xa;                                      goback_error&lt;=0;&#xa;                                      end//6&#xa;                                      else &#x9;if((lstate==GO&amp;&amp;car_state==GO)|| (car_state==BACK&amp;&amp;lstate==BACK))begin//7&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;goback_error&lt;=goback_error+goback_sample_error;&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(goback_error+goback_sample_error>encoder_err_max_cfg)&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;goback_error&lt;=encoder_err_max_cfg;&#xa;                                              else if(goback_error+goback_sample_error&lt;-encoder_err_max_cfg)&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;goback_error&lt;=-encoder_err_max_cfg;&#xa;                                      end//7&#xa;                                      else begin&#xa;                                      &#x9;&#x9;goback_error&lt;=0;//左转右转的时候给直线偏移量清0&#xa;                                      end&#xa;                                      &#xa;                              end//5&#xa;                  end//3&#xa;      &#xa;      end//1&#xa;      always @ (*  )&#xa;      begin &#xa;          corr_value=0;//GOBAND_ERR_DEBAND是死区，我只有累计误差值超过了死区才进行逻辑运算&#xa;          if(goback_error>encoder_err_deband_cfg)begin//左轮快,后续我就得左轮减速右轮加速&#xa;  &#x9;&#x9;&#x9;&#x9;corr_value=(goback_error-encoder_err_deband_cfg)>>encoder_err_shift_cfg;&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(corr_value>encoder_corr_max_cfg)//超过了限幅 我就稳定在MAX&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;corr_value=encoder_corr_max_cfg;&#xa;                              else corr_value=corr_value;&#xa;                  end&#xa;                  else begin&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if(goback_error&lt;-encoder_err_deband_cfg)&#x9;&#x9;begin&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;corr_value=-((-goback_error-encoder_err_deband_cfg)>>encoder_err_shift_cfg);//同上，现在是右轮快&#xa;                                  if(corr_value&lt;-encoder_corr_max_cfg)&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;corr_value=-encoder_corr_max_cfg;&#xa;                                          else corr_value=corr_value;&#xa;                              end&#xa;                              else begin&#xa;                              corr_value=0;&#xa;                              end&#xa;                  end&#xa;                  &#xa;      end&#xa;      //PI控制器区&#xa;      reg [3:0]last_cstate;&#xa;      reg [15:0]abs_left;//左轮绝对误差&#xa;      reg err_left;//左轮的误差方向,0代表着目标速度大于实际速度,需要加速，1的话就是减速&#xa;      reg [15:0]integral_left;//左轮误差的累计值&#xa;      reg [15:0]p_term_l;//左轮比例计算结果&#xa;      reg [15:0]calc_duty_left;//左轮PI计算出的临时占空比&#xa;      reg [15:0]abs_right;&#xa;      reg err_right;&#xa;      reg [15:0]integral_right;&#xa;      reg [15:0]p_term_r;&#xa;      reg [15:0]calc_duty_right;&#xa;      reg [7:0]final_duty_l;&#xa;      reg [7:0]final_duty_r;//这才是最终的占空比&#xa;      always@(*)begin//误差计算逻辑&#xa;      &#x9;if(actual_speed_left>target_speed_l)begin&#xa;          abs_left=actual_speed_left-target_speed_l;&#xa;          err_left=1;//减速&#xa;          end&#xa;          else begin&#xa;          abs_left=target_speed_l-actual_speed_left;&#xa;          err_left=0;//加速   &#xa;          end&#xa;          &#x9;if(actual_speed_right>target_speed_r)begin&#xa;          abs_right=actual_speed_right-target_speed_r;&#xa;          err_right=1;//减速&#xa;          end&#xa;          else begin&#xa;          abs_right=target_speed_r-actual_speed_right;&#xa;          err_right=0;//加速   &#xa;          end&#xa;      end&#xa;      always@(posedge clk_50m or posedge rst)begin//1&#xa;      &#x9;if(rst)begin//2&#xa;          final_duty_l&lt;=0;&#xa;          final_duty_r&lt;=0;&#xa;          integral_right&lt;=0;&#xa;          integral_left&lt;=0;&#xa;      &#x9;last_cstate&lt;=IDLE;&#xa;        calc_duty_right&lt;=0;&#xa;        calc_duty_left&lt;=0;&#xa;          end//2&#xa;          // 调参时清空 PI 的历史累计，避免旧积分与新参数组合造成瞬时突变。&#xa;          // final_duty 保持到下一个 50 ms 采样点，再由新参数平滑接管。&#xa;          else if (cfg_vld) begin&#xa;            integral_left&lt;=0;&#xa;            integral_right&lt;=0;&#xa;            calc_duty_left&lt;=0;&#xa;            calc_duty_right&lt;=0;&#xa;            last_cstate&lt;=car_state;&#xa;          end&#xa;          else begin //3&#xa;          if(sample_timer==SAMPLE_TIME-1) begin //4&#xa;          if (car_state != last_cstate) begin//5&#xa;                        integral_left  &lt;= integral_left >> 2;//本来我设计的是状态转换的时候积分项直接清零，但是不丝滑&#xa;                        integral_right &lt;= integral_right >> 2;&#xa;                        last_cstate &lt;= car_state;&#xa;                    end     //5         &#xa;          &#x9;else begin&#x9;if(target_speed_l==0)//左轮区//6&#xa;                  begin//7&#xa;                  final_duty_l&lt;=0;&#xa;                 &#x9;integral_left&lt;=0;&#xa;                  calc_duty_left &lt;= 0;&#xa;                  end//7&#xa;              &#x9;else begin&#x9;if(err_left==0)//需要加速了//8&#xa;                      begin&#xa;                      if(integral_left+abs_left&lt;4000)//积分限幅&#xa;                      //比如跑步的时候你前面几圈特别慢，你总不能最后几圈跑的飞快，你肯定得爆缸啊&#xa;                      &#x9;   integral_left&lt;=integral_left+abs_left;&#xa;                          else begin&#xa;                          &#x9;integral_left&lt;=4000;&#xa;                          end&#xa;                          calc_duty_left&lt;=((integral_left*ki_cfg)+abs_left*kp_cfg)>>5;//我本来是>>3,但是因为我actual_speed&lt;&lt;2,相应的abs也&lt;&lt;2，为了保持数值的大小，我就把>>3变成了>>5&#xa;               //这里&lt;&lt;2的目的是在target_speed逻辑里实现更精确的计算，以实现不&lt;&lt;2的时候小数的情况，也就是提高控制参数的分辨性，而非编码器的分辨性&#xa;                          end&#xa;                     else //减速的时候&#xa;                  begin&#xa;                  &#x9;&#x9;if(integral_left>abs_left)&#xa;                          &#x9;integral_left&lt;=integral_left-abs_left;&#xa;                        else integral_left&lt;=0;&#xa;                      if(integral_left*ki_cfg>abs_left*kp_cfg)&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;calc_duty_left&lt;=(integral_left*ki_cfg-abs_left*kp_cfg)>>5;&#xa;                       else calc_duty_left&lt;=0;&#xa;      &#x9;&#x9;&#x9;&#x9;&#x9;end&#xa;                      end&#xa;                                                  if(calc_duty_left>255)&#xa;                  &#x9;&#x9;final_duty_l&lt;=255;&#xa;                   else final_duty_l&lt;=calc_duty_left[7:0];&#xa;              &#x9;&#x9;&#x9;&#xa;      &#xa;                  //&#xa;          &#x9;&#x9;if(target_speed_r==0)//右轮区&#xa;                  begin&#xa;                  final_duty_r&lt;=0;&#xa;                 &#x9;integral_right&lt;=0;&#xa;                  calc_duty_right&lt;=0;&#xa;                  end&#xa;              else &#x9;if(err_right==0)//需要加速了&#xa;                      begin&#xa;                      if(integral_right+abs_right&lt;4000)&#xa;                      &#x9;   integral_right&lt;=integral_right+abs_right;&#xa;                          else begin&#xa;                          &#x9;integral_right&lt;=4000;&#xa;                          end&#xa;                          calc_duty_right&lt;=((integral_right*ki_cfg)+abs_right*kp_cfg)>>5;&#xa;                          end&#xa;                     else //减速的时候 &#xa;                  begin&#xa;                  &#x9;&#x9;if(integral_right>abs_right)&#xa;                          &#x9;integral_right&lt;=integral_right-abs_right;&#xa;                        else integral_right&lt;=0;&#xa;                      if(integral_right*ki_cfg>abs_right*kp_cfg)&#xa;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;calc_duty_right&lt;=(integral_right*ki_cfg-abs_right*kp_cfg)>>5;&#xa;                       else calc_duty_right&lt;=0;&#xa;      &#xa;                      end&#xa;              &#x9;&#x9;&#x9;&#xa;                                                      if(calc_duty_right>255)&#xa;                  &#x9;&#x9;final_duty_r&lt;=255;&#xa;                   else final_duty_r&lt;=calc_duty_right[7:0];&#xa;      end&#xa;              end//3&#xa;                  end//1&#xa;                  &#xa;      end&#xa;      &#xa;      //PWM底层逻辑&#xa;      reg [15:0]pwm_cnt;&#xa;      wire [15:0]compare_left=(final_duty_l*PERIOD)/256;&#xa;      wire [15:0]compare_right=(final_duty_r*PERIOD)/256;&#xa;      always @ (posedge clk_50m or posedge rst  )&#xa;      begin &#xa;      &#x9;if(rst)&#xa;          pwm_cnt&lt;=0;&#xa;          else begin&#xa;          &#x9;&#x9;if(pwm_cnt==PERIOD-1)&#xa;                  pwm_cnt&lt;=0;&#xa;                  else pwm_cnt&lt;=pwm_cnt+1;&#xa;          end&#xa;      end&#xa;      always@(posedge clk_50m or posedge rst)&#xa;      begin&#xa;      &#x9;if(rst)begin&#xa;          pwm_left&lt;=0;&#xa;          pwm_right&lt;=0;&#xa;          end&#xa;          else begin&#xa;        &#x9;&#x9;if(lost_used)begin&#xa;                pwm_left&lt;=0;&#xa;                pwm_right&lt;=0;&#xa;                end&#xa;                else begin&#xa;          pwm_left&lt;=(pwm_cnt&lt;compare_left)?1:0;&#xa;          pwm_right&lt;=(pwm_cnt&lt;compare_right)?1:0;&#xa;        end&#xa;          end&#xa;      end&#xa;      assign IN1=(en==0||final_duty_l==0)?0:dir_left;&#xa;      assign IN2=(en==0||final_duty_l==0)?0:~dir_left;&#xa;      &#xa;      assign IN3=(en==0||final_duty_r==0)?0:~dir_right;&#xa;      assign IN4=(en==0||final_duty_r==0)?0:dir_right;&#xa;    assign stall_alarm=0;&#xa;      //USB-UART测试&#xa;      &#xa;    &#xa;  " Color="aqua" Comment="" Height="246" Name="PWM2" Parameters="" Parent="CORE_CONTROL_TOP" Type="model" Width="1143" X="35" Y="747">
  <Port Color="#faebd7" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="car_state" Parent="PWM2" Side="left" Width="30" X="-0.0262467" Y="0.682927"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="PWM2" Side="left" Width="30" X="-0.0262467" Y="0.186992"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_left" Parent="PWM2" Side="bottom" Width="30" X="0.0699913" Y="0.878049"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en" Parent="PWM2" Side="left" Width="30" X="-0.0262467" Y="0.430894"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_right" Parent="PWM2" Side="bottom" Width="30" X="0.153106" Y="0.878049"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="PWM2" Side="bottom" Width="30" X="0.235346" Y="0.878049"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="en_1k" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.670732"/>
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="IN1" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.0569106"/>
  <Port Color="#deb887" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="IN2" Parent="PWM2" Side="top" Width="30" X="0.0577428" Y="-0.121951"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="IN3" Parent="PWM2" Side="bottom" Width="30" X="0.31846" Y="0.878049"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="IN4" Parent="PWM2" Side="bottom" Width="30" X="0.40245" Y="0.878049"/>
  <Port Color="#d2691e" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="error_mag" Parent="PWM2" Side="top" Width="30" X="0.128609" Y="-0.121951"/>
  <Port Color="#ff7f50" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="turn_dir" Parent="PWM2" Side="top" Width="30" X="0.1986" Y="-0.121951"/>
  <Port Color="#6495ed" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_lock" Parent="PWM2" Side="bottom" Width="30" X="0.484689" Y="0.878049"/>
  <Port Color="#fff8dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enc_left_a" Parent="PWM2" Side="top" Width="30" X="0.269466" Y="-0.121951"/>
  <Port Color="#dc143c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enc_left_b" Parent="PWM2" Side="top" Width="30" X="0.340332" Y="-0.121951"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enc_right_a" Parent="PWM2" Side="bottom" Width="30" X="0.568679" Y="0.878049"/>
  <Port Color="#00008b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enc_right_b" Parent="PWM2" Side="bottom" Width="30" X="0.651794" Y="0.878049"/>
  <Port Color="#008b8b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="mpu_dir" Parent="PWM2" Side="bottom" Width="30" X="0.734033" Y="0.878049"/>
  <Port Color="#00008b" Connect="" Datasize="4" Datatype="wire" Description="" Height="30" Inout="input" Name="error_mpu" Parent="PWM2" Side="bottom" Width="30" X="0.818023" Y="0.878049"/>
  <Port Color="#008b8b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_lost" Parent="PWM2" Side="top" Width="30" X="0.411199" Y="-0.121951"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="force_stop" Parent="PWM2" Side="top" Width="30" X="0.48294" Y="-0.121951"/>
  <Port Color="#006400" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="target_speed_l" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.182927"/>
  <Port Color="#a9a9a9" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="target_speed_r" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.792683"/>
  <Port Color="#bdb76b" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="actual_speed_left" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.544715"/>
  <Port Color="#8b008b" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="actual_speed_right" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.422764"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="heavy_load_state" Parent="PWM2" Side="right" Width="30" X="0.973753" Y="0.300813"/>
  <Port Color="#ff8c00" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="cfg_addr" Parent="PWM2" Side="top" Width="30" X="0.553806" Y="-0.121951"/>
  <Port Color="#9932cc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="cfg_data" Parent="PWM2" Side="top" Width="30" X="0.624672" Y="-0.121951"/>
  <Port Color="#8b0000" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="track_control_mode" Parent="PWM2" Side="top" Width="30" X="0.694663" Y="-0.121951"/>
  <Port Color="#a9a9a9" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="distance_vld_go" Parent="PWM2" Side="top" Width="30" X="0.765529" Y="-0.121951"/>
  <Port Color="#e9967a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="stall_state" Parent="PWM2" Side="top" Width="30" X="0.836395" Y="-0.121951"/>
  <Port Color="#8fbc8f" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="stall_alarm" Parent="PWM2" Side="bottom" Width="30" X="0.900262" Y="0.878049"/>
  <Port Color="#e9967a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="cfg_vld" Parent="PWM2" Side="top" Width="30" X="0.907262" Y="-0.121951"/>
 </Module>
 <Module Category="Current" Class="BT_CTRL" Code="/*localparam CLOCK=50_000_000;//系统时钟频率&#xa;localparam BAUD=115200;//波特率；&#xa;localparam CHECK_BIT=&quot;None&quot;;//无校验位&#xa;parameter MAX_1BAUD=CLOCK/BAUD;//一个波特率所要经历的时钟周期&#xa;parameter IDLE=5'b00000;&#xa;parameter START=5'b00001;&#xa;parameter DATA=5'b00010;&#xa;parameter CHECK=5'b00100;&#xa;reg [15:0]cnt_baud;//计算baud有没有到达MAX_1BAUD&#xa;reg [3:0]cnt_bit;//计算bit有没有达到max_bit;&#xa;reg [3:0]max_bit;//bit的最大值，根据不同状态所决定&#xa;reg [4:0]cstate;//当前状态&#xa;reg [4:0]nstate;//下一时钟状态&#xa;reg rx_check;//校验位的实际值&#xa;reg [7:0]rx_temp;//类似于仓库，存储要发送的数据&#xa;reg rx_r1;&#xa;reg rx_r2; &#xa;wire rx_nege;//用于rx下降沿检测&#xa;wire add_baud;&#xa;wire end_baud;//波特率开始，结束计算&#xa;wire add_bit;&#xa;wire end_bit;//bit开始，结束运算&#xa;wire IDLE_START=(cstate==IDLE) &amp;&amp; rx_nege;&#xa;wire START_DATA=(cstate==START)&amp;&amp; end_bit;&#xa;wire DATA_CHECK=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT!=&quot;None&quot;);&#xa;wire DATA_IDLE=(cstate==DATA)&amp;&amp; end_bit &amp;&amp; (CHECK_BIT==&quot;None&quot;);&#xa;wire CHECK_IDLE=(cstate==CHECK)&amp;&amp; end_bit;&#xa;//wire check_val;//校验位的正确值;经计算得到&#xa;wire add_bit1;&#xa;wire add_bit2;//检测end_baud的上升沿&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;rx_r1&lt;=1;&#xa;        rx_r2&lt;=1;&#xa;            end&#xa;     else begin&#xa;    &#x9;    rx_r1&lt;=rx;&#xa;        rx_r2&lt;=rx_r1;&#xa;    end&#xa;end&#xa;assign rx_nege=~rx_r1 &amp;&amp; rx_r2;//检测rx刚刚经历了下降沿  &#xa;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_baud&lt;=0;&#xa;     else if(add_baud)begin&#xa;    &#x9;&#x9;&#x9;if(end_baud)&#xa;                cnt_baud&lt;=0; &#xa;            else cnt_baud&lt;=cnt_baud+1;                &#xa;    end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_baud&lt;=0;    &#xa;end&#xa;assign add_baud=cstate!=IDLE;&#xa;assign end_baud=add_baud &amp;&amp; (cnt_baud==MAX_1BAUD-1);&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:max_bit=0;&#xa;    START:max_bit=1;&#xa;    DATA:max_bit=8;&#xa;    CHECK:max_bit=1;&#xa;        default: max_bit=0   ;&#xa;    endcase&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin&#xa;&#x9;if(rst)&#xa;    &#x9;&#x9; cnt_bit&lt;=0;&#xa;     else if(add_bit)begin&#xa;    &#x9;&#x9;&#x9;if(end_bit)&#xa;                cnt_bit&lt;=0; &#xa;            else cnt_bit&lt;=cnt_bit+1;                &#xa;    &#x9;&#x9;&#x9;end&#xa;&#x9;else&#xa;    &#x9;&#x9;cnt_bit&lt;=cnt_bit;    &#xa;end&#xa;assign add_bit=end_baud;&#xa;assign end_bit=add_bit &amp;&amp; (cnt_bit==max_bit-1);&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;cstate&lt;=IDLE;&#xa;    else cstate&lt;=nstate;&#xa;end&#xa;always @ ( * )&#xa;begin &#xa;&#x9;case( cstate)&#xa;    IDLE:if(IDLE_START)&#xa;    &#x9;&#x9;&#x9;nstate=START;&#xa;         else nstate=cstate;&#xa;    START:if( cnt_baud==MAX_1BAUD>>1 &amp;&amp; rx_r2==1)&#xa;    &#x9;&#x9;&#x9;nstate&lt;=IDLE;&#xa;   else begin if(START_DATA)&#xa;    &#x9;&#x9;&#x9;nstate=DATA;&#xa;          else nstate=cstate;&#xa;        end&#xa;    &#x9;DATA:if(DATA_CHECK)&#xa;        &#x9;&#x9;nstate=CHECK;&#xa;          else  begin if(DATA_IDLE)&#xa;        &#x9;&#x9;&#x9;nstate=IDLE;&#xa;                    else nstate=cstate;&#xa;                    end&#xa;    &#x9;CHECK:if(CHECK_IDLE)&#xa;        &#x9;&#x9;nstate=IDLE;&#xa;           else nstate=cstate;&#x9;&#x9;   &#xa;        default: nstate=IDLE;&#xa;    endcase&#xa;end &#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst)&#xa;    &#x9;&#x9;rx_temp&lt;=0;&#xa;    else  begin if(cstate==DATA &amp;&amp; cnt_baud== MAX_1BAUD>>1)&#xa;    rx_temp[cnt_bit]&lt;=rx_r2;&#xa;    else rx_temp&lt;=rx_temp;&#xa;    end&#xa;end&#xa;assign rx_data=rx_temp;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)&#xa;    rx_check&lt;=0;&#xa;    else if(cstate==CHECK &amp;&amp; cnt_baud==MAX_1BAUD>>1)&#xa;    &#x9;&#x9;rx_check&lt;=rx_r2;&#xa;end&#xa;assign rx_data_vld=DATA_IDLE;&#xa;//原来的CMD_PARSER模块&#xa;always @ ( posedge clk_50m or posedge rst)&#xa;begin if(rst)&#xa;&#x9;key_cmd&lt;=9'b111_111_111;&#xa;    else  begin if(rx_data_vld) begin&#xa;&#x9;&#x9;case( rx_data)&#xa;        8'h46 : key_cmd &lt;= 9'b111_111_101; // 'F' GO&#xa;        8'h42 : key_cmd &lt;= 9'b101_111_111; // 'B' BACK&#xa;        8'h4C : key_cmd &lt;= 9'b111_110_111; // 'L' LEFT&#xa;        8'h52 : key_cmd &lt;= 9'b111_011_111; // 'R' RIGHT&#xa;        8'h53 : key_cmd &lt;= 9'b111_101_111; // 'S'：停车&#xa;8'h54 : key_cmd &lt;= 9'b011_111_111; // 'T'：进入循迹模式&#xa;8'h4D : key_cmd &lt;= 9'b111_111_011; // 'M'：返回蓝牙手动模式&#xa;8'h43: key_cmd&lt;=9'b111_111_100;//C:清除WEIGHT_SENSOR漏货的故障锁存&#xa;8'h45:key_cmd&lt;=9'b111_111_000;//E:清除瓦斯风险&#xa;8'h47:key_cmd&lt;=9'b111_100_000;//G:重新设置HX711零点&#xa;            default: key_cmd&lt;=key_cmd;&#xa;        endcase&#xa;        end&#xa;        else key_cmd&lt;=key_cmd; &#xa;        end&#xa;end*/&#xa; &#xa;  localparam integer CLOCK     = 50_000_000;&#xa;  localparam integer BAUD      = 115200;&#xa;  localparam integer ONE_BAUD  = CLOCK / BAUD;&#xa;  localparam integer HALF_BAUD = ONE_BAUD / 2;&#xa;&#xa;  localparam UART_IDLE  = 2'd0;&#xa;  localparam UART_START = 2'd1;&#xa;  localparam UART_DATA  = 2'd2;&#xa;  localparam UART_STOP  = 2'd3;&#xa;&#xa;  reg        rx_r1;&#xa;  reg        rx_r2;&#xa;  reg [1:0]  uart_state;&#xa;  reg [15:0] baud_cnt;&#xa;  reg [2:0]  bit_cnt;&#xa;  reg [7:0]  rx_shift;&#xa;  reg [7:0]  rx_data_reg;&#xa;  reg        rx_data_vld_reg;&#xa;&#xa;  assign rx_data     = rx_data_reg;&#xa;  assign rx_data_vld = rx_data_vld_reg;&#xa;&#xa;  // 两级同步，降低异步蓝牙 RX 输入带来的亚稳态风险。&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      rx_r1 &lt;= 1'b1;&#xa;      rx_r2 &lt;= 1'b1;&#xa;    end&#xa;    else begin&#xa;      rx_r1 &lt;= rx;&#xa;      rx_r2 &lt;= rx_r1;&#xa;    end&#xa;  end&#xa;&#xa;  // 固定 115200、8N1 UART 接收器。数据位在各自中心采样，完整停止位正确后才给出 vld。&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      uart_state      &lt;= UART_IDLE;&#xa;      baud_cnt        &lt;= 16'd0;&#xa;      bit_cnt         &lt;= 3'd0;&#xa;      rx_shift        &lt;= 8'd0;&#xa;      rx_data_reg     &lt;= 8'd0;&#xa;      rx_data_vld_reg &lt;= 1'b0;&#xa;    end&#xa;    else begin&#xa;      rx_data_vld_reg &lt;= 1'b0;&#xa;      case (uart_state)&#xa;        UART_IDLE: begin&#xa;          baud_cnt &lt;= 16'd0;&#xa;          bit_cnt  &lt;= 3'd0;&#xa;          if (!rx_r2)&#xa;            uart_state &lt;= UART_START;&#xa;        end&#xa;&#xa;        UART_START: begin&#xa;          if (baud_cnt == HALF_BAUD-1) begin&#xa;            baud_cnt &lt;= 16'd0;&#xa;            if (!rx_r2)&#xa;              uart_state &lt;= UART_DATA;&#xa;            else&#xa;              uart_state &lt;= UART_IDLE;&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        UART_DATA: begin&#xa;          if (baud_cnt == ONE_BAUD-1) begin&#xa;            baud_cnt         &lt;= 16'd0;&#xa;            rx_shift[bit_cnt] &lt;= rx_r2;&#xa;            if (bit_cnt == 3'd7) begin&#xa;              bit_cnt    &lt;= 3'd0;&#xa;              uart_state &lt;= UART_STOP;&#xa;            end&#xa;            else&#xa;              bit_cnt &lt;= bit_cnt + 1'b1;&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        UART_STOP: begin&#xa;          if (baud_cnt == ONE_BAUD-1) begin&#xa;            baud_cnt   &lt;= 16'd0;&#xa;            uart_state &lt;= UART_IDLE;&#xa;            if (rx_r2) begin&#xa;              rx_data_reg     &lt;= rx_shift;&#xa;              rx_data_vld_reg &lt;= 1'b1;&#xa;            end&#xa;          end&#xa;          else&#xa;            baud_cnt &lt;= baud_cnt + 1'b1;&#xa;        end&#xa;&#xa;        default: uart_state &lt;= UART_IDLE;&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  // --------------------------------------------------------------------------&#xa;  // 命令与实时调参协议&#xa;  //&#xa;  // 原有运动/维护命令仍为单字节 ASCII。&#xa;  // 调参帧固定 5 字节：A5, addr, data_l, data_h, checksum&#xa;  // checksum = A5 ^ addr ^ data_l ^ data_h&#xa;  // TRIM_GO/TRIM_BACK 的 data 为 16 位二补码，其余参数为无符号数。&#xa;  // --------------------------------------------------------------------------&#xa;  localparam CFG_HEAD      = 8'hA5;&#xa;  localparam CFG_WAIT_HEAD = 3'd0;&#xa;  localparam CFG_WAIT_ADDR = 3'd1;&#xa;  localparam CFG_WAIT_LOW  = 3'd2;&#xa;  localparam CFG_WAIT_HIGH = 3'd3;&#xa;  localparam CFG_WAIT_XOR  = 3'd4;&#xa;&#xa;  reg [2:0]  cfg_state;&#xa;  reg [7:0]  cfg_addr_buf;&#xa;  reg [7:0]  cfg_low_buf;&#xa;  reg [7:0]  cfg_high_buf;&#xa;  reg [15:0] cfg_data_reg;&#xa;&#xa;  assign cfg_data = cfg_data_reg;&#xa;&#xa;  always @(posedge clk_50m or posedge rst)&#xa;  begin&#xa;    if (rst) begin&#xa;      key_cmd       &lt;= 9'b111_111_111;&#xa;      cfg_vld       &lt;= 1'b0;&#xa;      cfg_addr      &lt;= 8'd0;&#xa;      cfg_data_reg  &lt;= 16'd0;&#xa;      cfg_state     &lt;= CFG_WAIT_HEAD;&#xa;      cfg_addr_buf  &lt;= 8'd0;&#xa;      cfg_low_buf   &lt;= 8'd0;&#xa;      cfg_high_buf  &lt;= 8'd0;&#xa;    end&#xa;    else begin&#xa;      // cfg_vld 只保持一个系统时钟周期。&#xa;      cfg_vld &lt;= 1'b0;&#xa;      if (rx_data_vld_reg) begin&#xa;        case (cfg_state)&#xa;          CFG_WAIT_HEAD: begin&#xa;            if (rx_data_reg == CFG_HEAD)&#xa;              cfg_state &lt;= CFG_WAIT_ADDR;&#xa;            else begin&#xa;              // 仅在调参帧之外解释单字节命令，参数载荷不会误触发运动。&#xa;              case (rx_data_reg)&#xa;                8'h46: key_cmd &lt;= 9'b111_111_101; // F: GO&#xa;                8'h42: key_cmd &lt;= 9'b101_111_111; // B: BACK&#xa;                8'h4C: key_cmd &lt;= 9'b111_110_111; // L: LEFT&#xa;                8'h52: key_cmd &lt;= 9'b111_011_111; // R: RIGHT&#xa;                8'h53: key_cmd &lt;= 9'b111_101_111; // S: STOP&#xa;                8'h54: key_cmd &lt;= 9'b011_111_111; // T: TRACKING&#xa;                8'h4D: key_cmd &lt;= 9'b111_111_011; // M: BLUETOOTH MANUAL&#xa;                8'h43: key_cmd &lt;= 9'b111_111_100; // C: CLEAR LOAD FAULT&#xa;                8'h45: key_cmd &lt;= 9'b111_111_000; // E: CLEAR GAS RISK&#xa;                8'h47: key_cmd &lt;= 9'b111_100_000; // G: HX711 TARE&#xa;                default: key_cmd &lt;= key_cmd;&#xa;              endcase&#xa;            end&#xa;          end&#xa;&#xa;          CFG_WAIT_ADDR: begin&#xa;            cfg_addr_buf &lt;= rx_data_reg;&#xa;            cfg_state    &lt;= CFG_WAIT_LOW;&#xa;          end&#xa;&#xa;          CFG_WAIT_LOW: begin&#xa;            cfg_low_buf &lt;= rx_data_reg;&#xa;            cfg_state   &lt;= CFG_WAIT_HIGH;&#xa;          end&#xa;&#xa;          CFG_WAIT_HIGH: begin&#xa;            cfg_high_buf &lt;= rx_data_reg;&#xa;            cfg_state    &lt;= CFG_WAIT_XOR;&#xa;          end&#xa;&#xa;          CFG_WAIT_XOR: begin&#xa;            cfg_state &lt;= CFG_WAIT_HEAD;&#xa;            if (rx_data_reg == (CFG_HEAD ^ cfg_addr_buf ^ cfg_low_buf ^ cfg_high_buf)) begin&#xa;              cfg_addr     &lt;= cfg_addr_buf;&#xa;              cfg_data_reg &lt;= {cfg_high_buf, cfg_low_buf};&#xa;              cfg_vld      &lt;= 1'b1;&#xa;            end&#xa;          end&#xa;&#xa;          default: cfg_state &lt;= CFG_WAIT_HEAD;&#xa;        endcase&#xa;      end&#xa;    end&#xa;  end" Color="aquamarine" Comment="" Height="220" Name="BT_CTRL3" Parameters="" Parent="CORE_CONTROL_TOP" Type="model" Width="1036" X="544.5" Y="105">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.127413" Y="0.863636"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rx" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.271236" Y="0.863636"/>
  <Port Color="#f0ffff" Connect="" Datasize="9" Datatype="reg" Description="" Height="30" Inout="output" Name="key_cmd" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.414093" Y="0.863636"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.55695" Y="0.863636"/>
  <Port Color="#f5f5dc" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.699807" Y="0.863636"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="rx_data_vld" Parent="BT_CTRL3" Side="bottom" Width="30" X="0.841699" Y="0.863636"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="cfg_vld" Parent="BT_CTRL3" Side="top" Width="30" X="0.484556" Y="-0.136364"/>
  <Port Color="#ffebcd" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="cfg_addr" Parent="BT_CTRL3" Side="left" Width="30" X="-0.0289575" Y="0.259091"/>
  <Port Color="#0000ff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="cfg_data" Parent="BT_CTRL3" Side="left" Width="30" X="-0.0289575" Y="0.595455"/>
 </Module>
