<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="//因为cnt_warmup是从0开始计算的，我的设想是cnt_warmup==WARMUP_TIME-1时就达到了最大值，下一步应该在时序逻辑里cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;,也就是说我第一次cnt_warmup==WARMUP_TIME-1的时候，啥都没发生，因为cnt_warmup&lt;=WARMUP_TIME-1;warmup_done&lt;=1;是非阻塞赋值，我下一时钟到达的时候我cnt_warmup第二次等于WARMUP_TIME-1，也就是相当于上一个周期结束了，这是第二个周期的第1秒（从1开始算），此时warmup_done为1，比较合理&#xa;parameter WARMUP_TIME=250_000_000;//预热时间为5s，先让MQ4内部化学反应充分&#xa;parameter FILTER_TIME=500_000;//数字滤波时间为10ms,尽量减少毛刺的影响，防止出现小车抽搐等现象的发生&#xa;reg [27:0]cnt_warmup;//计算有没有过预热时间&#xa;reg warmup_done;//1表示过了预热时间&#xa;reg [19:0]cnt_filter;//计算有没有过数字滤波时间&#xa;reg filter_done;//1表示过了数字滤波时间&#xa;reg do1;&#xa;reg do2;&#xa;wire gas_clear=(key_cmd==9'b111_111_000);//中控台已经确定瓦斯风险消除&#xa;reg gas_clear1;&#xa;reg gas_clear2;&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst)begin&#xa;    gas_clear1&lt;=0;&#xa;    gas_clear2&lt;=0;&#xa;    end&#xa;    else begin gas_clear1&lt;=gas_clear;&#xa;    &#x9;&#x9;gas_clear2&lt;=gas_clear1;end &#xa;end&#xa;wire clear_pulse=gas_clear1 &amp;&amp; ~gas_clear2;&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    do1&lt;=1;&#xa;    do2&lt;=1;&#xa;    end &#xa;    else begin&#xa;    &#x9;do2&lt;=do1;&#xa;    do1&lt;=do;&#xa;    end&#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_warmup&lt;=0;&#xa;    warmup_done&lt;=0;&#xa;    end&#xa;    else if(~warmup_done) begin&#xa;    &#x9;&#x9;if(cnt_warmup&lt;WARMUP_TIME-1) &#xa;    &#x9;&#x9;&#x9;cnt_warmup&lt;=cnt_warmup+1;&#xa;          else begin&#xa;        &#x9;&#x9;cnt_warmup&lt;=WARMUP_TIME-1;&#xa;             warmup_done&lt;=1;&#xa;            end&#xa;        end&#xa;end&#xa;always @ (posedge clk_50m or posedge rst  )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    cnt_filter&lt;=0;&#xa;    filter_done&lt;=0;&#xa;    end&#xa;    else if(warmup_done) begin&#xa;    &#x9;&#x9;&#x9;if(~do2) begin&#xa;    &#x9;&#x9;&#x9;&#x9;if(cnt_filter&lt;FILTER_TIME-1) begin&#xa;                    cnt_filter&lt;=cnt_filter+1;&#xa;                    filter_done&lt;=filter_done;&#xa;//上面filter_done&lt;=filter_done的意思是还没完成数字滤波的时候filter_done保持原值，比如在系统刚开始的时候&#xa;//瓦斯浓度达标，但是还没完成数字滤波，filter_done为复位时的0&#xa;//瓦斯浓度超标，并且迟迟未退散，那我filter_done保持第一次数字滤波后的值，也就是1，防止发生脉冲信号，导致小车一抽一抽的&#xa;                    end&#xa;                 else begin&#xa;                &#x9;&#x9;cnt_filter&lt;=0;&#xa;                     filter_done&lt;=1;&#xa;                end&#xa;    &#x9;&#x9;end&#xa;            else begin&#xa;            &#x9;&#x9;filter_done&lt;=0;&#xa;                 cnt_filter&lt;=0;&#xa;            end  &#xa;            end          &#xa;end&#xa;always @ ( posedge clk_50m or posedge rst )&#xa;begin &#xa;&#x9;if(rst) begin&#xa;    &#x9;&#x9;gas_alarm&lt;=0;&#xa;        force_stop&lt;=0;&#xa;    end&#xa;    else if(filter_done)begin&#xa;    &#x9;&#x9;gas_alarm&lt;=1;&#xa;        force_stop&lt;=1;    &#xa;    end&#xa;    &#x9;&#x9;else begin&#xa;            if(clear_pulse)&#xa;    &#x9;&#x9;gas_alarm&lt;=0;&#xa;        force_stop&lt;=0;    &#xa;    end  &#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="GAS_SENSOR" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_50m" Parent="GAS_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.386111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst" Parent="GAS_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="do" Parent="GAS_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="gas_alarm" Parent="GAS_SENSOR" Side="right" Width="30" X="0.98125" Y="0.319444"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="force_stop" Parent="GAS_SENSOR" Side="right" Width="30" X="0.98125" Y="0.652778"/>
 <Port Color="#ffe4c4" Connect="" Datasize="9" Datatype="wire" Description="" Height="30" Inout="input" Name="key_cmd" Parent="GAS_SENSOR" Side="left" Width="30" X="-0.01875" Y="0.186111"/>
</Module>
